<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ncf</ToolCommandName>
    <PackageId>NightCodeForge.Cli</PackageId>
    <Version>1.0.0</Version>
    <Authors>Pmad</Authors>
    <Description>NightCodeForge CLI — Deterministic repository preparation, onboarding, and readiness audit.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jetelain/NightCodeForge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jetelain/NightCodeForge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NightCodeForge.Core\NightCodeForge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <EmbeddedResource Include="..\..\skills\**\*" LogicalName="skills/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>

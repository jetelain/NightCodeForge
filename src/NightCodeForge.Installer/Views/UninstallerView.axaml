<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NightCodeForge.Installer.ViewModels"
             xmlns:m="using:NightCodeForge.Installer.Core.Models"
             xmlns:conv="using:NightCodeForge.Installer.Converters"
             x:Class="NightCodeForge.Installer.Views.UninstallerView"
             x:DataType="vm:UninstallerViewModel">

  <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">

    <Border Grid.Row="0"
            Padding="14"
            CornerRadius="8"
            Background="{DynamicResource NightCodeBgSurface}"
            BorderBrush="{DynamicResource SemiColorBorder}"
            BorderThickness="1">
      <StackPanel Spacing="8">
        <TextBlock Text="Uninstall NightCodeForge" FontSize="16" FontWeight="Bold" />
        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto" RowSpacing="4" ColumnSpacing="10">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Install Directory:" Foreground="{DynamicResource SemiColorText2}" />
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InstallDirectory}" TextWrapping="Wrap" />
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Installed Version:" Foreground="{DynamicResource SemiColorText2}" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InstalledVersion}" FontWeight="SemiBold" />
        </Grid>

        <StackPanel Spacing="6" Margin="0,6,0,0">
          <CheckBox Content="Keep user databases, logs, and configuration (data/, config/, logs/)"
                    IsChecked="{Binding KeepData}"
                    IsEnabled="{Binding CanUninstall}" />
          <CheckBox Content="Also uninstall companion .NET global tools (ncf, nightcodeassay, csnav, mdfetch, codecondenser)"
                    IsChecked="{Binding RemoveCompanionTools}"
                    IsEnabled="{Binding CanUninstall}" />
          <CheckBox Content="Also uninstall OllamaRouter (ollamarouter-server, ollamarouter, ollamarouter-app, and ollamarouter:// protocol)"
                    IsChecked="{Binding RemoveOllamaRouter}"
                    IsEnabled="{Binding CanUninstall}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="1"
            Padding="12"
            CornerRadius="8"
            Background="{DynamicResource NightCodeBgSurface}"
            BorderBrush="{DynamicResource SemiColorBorder}"
            BorderThickness="1">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap" />
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="8" />
        <TextBlock Text="{Binding ErrorMessage}"
                   IsVisible="{Binding HasError}"
                   Foreground="{DynamicResource NightCodeAccentCrimsonLightText}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
      <Border Grid.Column="0"
              Padding="12"
              CornerRadius="8"
              Background="{DynamicResource NightCodeBgSurface}"
              BorderBrush="{DynamicResource SemiColorBorder}"
              BorderThickness="1">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Uninstallation Steps" FontWeight="SemiBold" Margin="0,0,0,8" />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Steps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="m:UninstallStepResult">
                  <Border Padding="8" Margin="0,0,0,6" CornerRadius="6" Background="{DynamicResource NightCodeBgInput}">
                    <StackPanel Spacing="2">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding StepName}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Status}"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding Status, Converter={x:Static conv:ProvisioningStatusToBrushConverter.Instance}}" />
                      </Grid>
                      <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{DynamicResource SemiColorText2}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Border Grid.Column="1"
              Padding="12"
              CornerRadius="8"
              Background="{DynamicResource NightCodeBgInput}"
              BorderBrush="{DynamicResource SemiColorBorder}"
              BorderThickness="1">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Uninstaller Log" FontWeight="SemiBold" Margin="0,0,0,8" />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding LogLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" FontFamily="Consolas,Menlo,monospace" FontSize="11" TextWrapping="Wrap" Margin="0,1" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Uninstall" Classes="Danger" Command="{Binding UninstallCommand}" IsEnabled="{Binding CanUninstall}" />
      <Button Content="Cancel" Command="{Binding CancelCommand}" IsEnabled="{Binding CanCancel}" />
      <Button Content="Close" Classes="Primary" Command="{Binding CloseCommand}" IsVisible="{Binding CanClose}" IsEnabled="{Binding CanClose}" />
    </StackPanel>

  </Grid>
</UserControl>

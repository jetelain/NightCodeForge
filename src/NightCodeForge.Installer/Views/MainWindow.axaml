<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NightCodeForge.Installer.ViewModels"
        xmlns:conv="using:NightCodeForge.Installer.Converters"
        xmlns:views="using:NightCodeForge.Installer.Views"
        xmlns:wviews="using:NightCodeForge.Installer.Views.Wizard"
        x:Class="NightCodeForge.Installer.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Icon="avares://NightCodeForge.Installer/Assets/icon.png"
        Width="980"
        Height="760"
        MinWidth="820"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="Auto,Auto,*" Margin="18" RowSpacing="14">

    <!-- Branding Header -->
    <Border Grid.Row="0"
            Padding="14"
            CornerRadius="8"
            Background="{DynamicResource NightCodeBgSurface}"
            BorderBrush="{DynamicResource SemiColorBorder}"
            BorderThickness="1">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <Image Grid.Column="0"
               Source="avares://NightCodeForge.Installer/Assets/icon.png"
               Width="30"
               Height="30"
               VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="0">
            <TextBlock Text="NightCode" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="Forge" FontSize="18" FontWeight="ExtraBold" Foreground="{DynamicResource NightCodeAccentIndigoLightText}" />
          </StackPanel>
          <TextBlock Text="Installer, Maintenance Hub &amp; Environment Manager"
                     FontSize="11"
                     Foreground="{DynamicResource SemiColorText2}" />
        </StackPanel>
        <Border Grid.Column="2"
                Padding="10,4"
                CornerRadius="6"
                Background="{DynamicResource NightCodeBgInput}"
                BorderBrush="{DynamicResource SemiColorBorder}"
                BorderThickness="1"
                VerticalAlignment="Center">
          <TextBlock Text="{Binding RuntimeBadge}"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource SemiColorText1}" />
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="1"
            IsVisible="{Binding HasInitializationError}"
            Padding="10,8"
            CornerRadius="6"
            Background="{DynamicResource SemiColorDangerLight}"
            BorderBrush="{DynamicResource SemiColorDanger}"
            BorderThickness="1">
      <TextBlock Text="{Binding InitializationErrorMessage}"
                 FontSize="12"
                 Foreground="{DynamicResource NightCodeAccentCrimsonLightText}"
                 TextWrapping="Wrap" />
    </Border>

    <!-- 3-Mode Active Workspace -->
    <Grid Grid.Row="2">
      <Border IsVisible="{Binding CurrentMode, Converter={x:Static conv:UiModeToVisibilityConverter.Instance}, ConverterParameter=OobeWizard}">
        <wviews:SetupWizardView DataContext="{Binding Wizard}" />
      </Border>

      <Border IsVisible="{Binding CurrentMode, Converter={x:Static conv:UiModeToVisibilityConverter.Instance}, ConverterParameter=MaintenanceHub}">
        <views:MaintenanceHubView DataContext="{Binding MaintenanceHub}" />
      </Border>

      <Border IsVisible="{Binding CurrentMode, Converter={x:Static conv:UiModeToVisibilityConverter.Instance}, ConverterParameter=InteractiveUninstaller}">
        <views:UninstallerView DataContext="{Binding Uninstaller}" />
      </Border>
    </Grid>

  </Grid>
</Window>

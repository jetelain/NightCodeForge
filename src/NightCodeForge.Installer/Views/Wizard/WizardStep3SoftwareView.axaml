<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wvm="using:NightCodeForge.Installer.ViewModels.Wizard"
             xmlns:conv="using:NightCodeForge.Installer.Converters"
             x:Class="NightCodeForge.Installer.Views.Wizard.WizardStep3SoftwareView"
             x:DataType="wvm:WizardStep3SoftwareViewModel">

  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">

    <Border Grid.Row="0"
            Padding="14"
            CornerRadius="8"
            Background="{DynamicResource NightCodeBgSurface}"
            BorderBrush="{DynamicResource SemiColorBorder}"
            BorderThickness="1">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Text="Software, Companion NuGet Tools &amp; OS Registration" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource SemiColorText2}" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="1"
                  Content="Install / Retry"
                  Classes="Primary"
                  Command="{Binding RunInstallationCommand}"
                  IsEnabled="{Binding !IsRunning}" />
        </Grid>

        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="8" />

        <CheckBox Content="Create Desktop shortcut alongside Start Menu / XDG registration"
                  IsChecked="{Binding CreateDesktopShortcut}"
                  IsEnabled="{Binding !IsRunning}" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1"
            IsVisible="{Binding HasError}"
            Padding="12"
            CornerRadius="8"
            Background="{DynamicResource SemiColorDangerLight}"
            BorderBrush="{DynamicResource SemiColorDanger}"
            BorderThickness="1">
      <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
      <Border Grid.Column="0"
              Padding="12"
              CornerRadius="8"
              Background="{DynamicResource NightCodeBgSurface}"
              BorderBrush="{DynamicResource SemiColorBorder}"
              BorderThickness="1">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Deployed Components" FontWeight="SemiBold" Margin="0,0,0,8" />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Components}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="wvm:WizardChecklistItemViewModel">
                  <Border Padding="8,7" Margin="0,0,0,6" CornerRadius="6" Background="{DynamicResource NightCodeBgInput}">
                    <Grid ColumnDefinitions="22,*" ColumnSpacing="8">
                      <TextBlock Grid.Column="0"
                                 Text="{Binding StatusGlyph}"
                                 FontSize="14"
                                 FontWeight="Bold"
                                 VerticalAlignment="Top"
                                 Margin="0,1,0,0"
                                 Foreground="{Binding Status, Converter={x:Static conv:ProvisioningStatusToBrushConverter.Instance}}" />
                      <StackPanel Grid.Column="1" Spacing="2">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Grid.Column="1"
                                     Text="{Binding StatusLabel}"
                                     FontSize="11"
                                     FontWeight="SemiBold"
                                     Foreground="{Binding Status, Converter={x:Static conv:ProvisioningStatusToBrushConverter.Instance}}" />
                        </Grid>
                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource SemiColorText2}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Border Grid.Column="1"
              Padding="12"
              CornerRadius="8"
              Background="{DynamicResource NightCodeBgInput}"
              BorderBrush="{DynamicResource SemiColorBorder}"
              BorderThickness="1">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Installation Log" FontWeight="SemiBold" Margin="0,0,0,8" />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding LogLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" FontFamily="Consolas,Menlo,monospace" FontSize="11" TextWrapping="Wrap" Margin="0,1" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>

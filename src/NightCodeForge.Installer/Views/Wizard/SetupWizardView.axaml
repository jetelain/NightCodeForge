<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wvm="using:NightCodeForge.Installer.ViewModels.Wizard"
             xmlns:wviews="using:NightCodeForge.Installer.Views.Wizard"
             xmlns:conv="using:NightCodeForge.Installer.Converters"
             x:Class="NightCodeForge.Installer.Views.Wizard.SetupWizardView"
             x:DataType="wvm:SetupWizardViewModel">

  <DockPanel>
    <!-- 5-Step Progress Indicator -->
    <Border DockPanel.Dock="Top"
            Padding="14,10"
            Margin="0,0,0,12"
            CornerRadius="8"
            Background="{DynamicResource NightCodeBgSurface}"
            BorderBrush="{DynamicResource SemiColorBorder}"
            BorderThickness="1">
      <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center">
        <TextBlock Text="1 · Welcome &amp; Source"
                   FontWeight="{Binding SelectedStep, Converter={x:Static conv:IntEqualityToFontWeightConverter.Instance}, ConverterParameter=0}" />
        <TextBlock Text="2 · Host Provisioning"
                   FontWeight="{Binding SelectedStep, Converter={x:Static conv:IntEqualityToFontWeightConverter.Instance}, ConverterParameter=1}" />
        <TextBlock Text="3 · Software &amp; Tools"
                   FontWeight="{Binding SelectedStep, Converter={x:Static conv:IntEqualityToFontWeightConverter.Instance}, ConverterParameter=2}" />
        <TextBlock Text="4 · AI Fleet (OllamaRouter)"
                   FontWeight="{Binding SelectedStep, Converter={x:Static conv:IntEqualityToFontWeightConverter.Instance}, ConverterParameter=3}" />
        <TextBlock Text="5 · Ready to Forge"
                   FontWeight="{Binding SelectedStep, Converter={x:Static conv:IntEqualityToFontWeightConverter.Instance}, ConverterParameter=4}" />
      </StackPanel>
    </Border>

    <!-- Navigation Footer -->
    <Border DockPanel.Dock="Bottom"
            Padding="12,10"
            Margin="0,12,0,0"
            CornerRadius="8"
            Background="{DynamicResource NightCodeBgSurface}"
            BorderBrush="{DynamicResource SemiColorBorder}"
            BorderThickness="1">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0"
                   Text="NightCodeForge OOBE Setup Wizard"
                   FontSize="12"
                   Foreground="{DynamicResource SemiColorText2}"
                   VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="Back" Command="{Binding BackCommand}" />
          <Button Content="Next" Classes="Primary" Command="{Binding NextCommand}" />
          <Button Content="Finish" Classes="Primary" Command="{Binding FinishCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Step Content Panels -->
    <Grid>
      <Border IsVisible="{Binding SelectedStep, Converter={x:Static conv:IntEqualityToVisibilityConverter.Instance}, ConverterParameter=0}">
        <wviews:WizardStep1WelcomeView DataContext="{Binding Step1}" />
      </Border>
      <Border IsVisible="{Binding SelectedStep, Converter={x:Static conv:IntEqualityToVisibilityConverter.Instance}, ConverterParameter=1}">
        <wviews:WizardStep2ProvisioningView DataContext="{Binding Step2}" />
      </Border>
      <Border IsVisible="{Binding SelectedStep, Converter={x:Static conv:IntEqualityToVisibilityConverter.Instance}, ConverterParameter=2}">
        <wviews:WizardStep3SoftwareView DataContext="{Binding Step3}" />
      </Border>
      <Border IsVisible="{Binding SelectedStep, Converter={x:Static conv:IntEqualityToVisibilityConverter.Instance}, ConverterParameter=3}">
        <wviews:WizardStep4AiFleetView DataContext="{Binding Step4}" />
      </Border>
      <Border IsVisible="{Binding SelectedStep, Converter={x:Static conv:IntEqualityToVisibilityConverter.Instance}, ConverterParameter=4}">
        <wviews:WizardStep5ReadyView DataContext="{Binding Step5}" />
      </Border>
    </Grid>
  </DockPanel>
</UserControl>

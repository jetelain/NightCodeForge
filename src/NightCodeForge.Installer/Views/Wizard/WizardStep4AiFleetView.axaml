<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wvm="using:NightCodeForge.Installer.ViewModels.Wizard"
             xmlns:m="using:NightCodeForge.Installer.Core.Models"
             x:Class="NightCodeForge.Installer.Views.Wizard.WizardStep4AiFleetView"
             x:DataType="wvm:WizardStep4AiFleetViewModel">

  <Grid RowDefinitions="Auto,*" RowSpacing="12">

    <!-- Header, Mode Selector & Error Banner -->
    <Border Grid.Row="0"
            Padding="14"
            CornerRadius="8"
            Background="{DynamicResource NightCodeBgSurface}"
            BorderBrush="{DynamicResource SemiColorBorder}"
            BorderThickness="1">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Text="AI Provider &amp; Model Setup" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource SemiColorText2}" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="1"
                  Content="Skip (Configure Later)"
                  VerticalAlignment="Top"
                  Command="{Binding SkipAiSetupCommand}"
                  IsEnabled="{Binding !IsRunning}" />
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="20">
          <RadioButton GroupName="WizardAiSetupMode"
                       Content="OllamaRouter (Local / Fleet Setup Wizard)"
                       IsChecked="{Binding IsOllamaRouterMode}"
                       IsEnabled="{Binding !IsRunning}" />
          <RadioButton GroupName="WizardAiSetupMode"
                       Content="OpenAI Compatible (Provider, API Key &amp; Models)"
                       IsChecked="{Binding IsOpenAiCompatibleMode}"
                       IsEnabled="{Binding !IsRunning}" />
        </StackPanel>

        <Border IsVisible="{Binding HasError}"
                Padding="10,8"
                CornerRadius="6"
                Background="{DynamicResource SemiColorDangerLight}"
                BorderBrush="{DynamicResource SemiColorDanger}"
                BorderThickness="1">
          <TextBlock Text="{Binding ErrorMessage}"
                     FontSize="12"
                     Foreground="{DynamicResource NightCodeAccentCrimsonLightText}"
                     TextWrapping="Wrap" />
        </Border>
      </StackPanel>
    </Border>

    <!-- Active Mode Content -->
    <Grid Grid.Row="1">

      <!-- Option 1: Delegated OllamaRouter Wizard -->
      <Grid IsVisible="{Binding IsOllamaRouterMode}" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Border Grid.Row="0"
                Padding="12"
                CornerRadius="8"
                Background="{DynamicResource NightCodeBgSurface}"
                BorderBrush="{DynamicResource SemiColorBorder}"
                BorderThickness="1">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{Binding PrimaryButtonLabel}"
                    Classes="Primary"
                    Command="{Binding LaunchOllamaRouterWizardCommand}"
                    IsEnabled="{Binding !IsRunning}" />
            <Button Content="Sync Recommendations Only"
                    Command="{Binding SyncRecommendationsOnlyCommand}"
                    IsEnabled="{Binding !IsRunning}" />
          </StackPanel>
        </Border>

        <Border Grid.Row="1"
                IsVisible="{Binding HasSyncedRecommendations}"
                Padding="12"
                CornerRadius="8"
                Background="{DynamicResource NightCodeBgSurface}"
                BorderBrush="{DynamicResource SemiColorBorder}"
                BorderThickness="1">
          <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="10">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Architect / Reviewer:" Foreground="{DynamicResource SemiColorText2}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ArchitectModelDisplay}" FontWeight="SemiBold" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Coder / Implementation:" Foreground="{DynamicResource SemiColorText2}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CoderModelDisplay}" FontWeight="SemiBold" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Agentic Chat / Default:" Foreground="{DynamicResource SemiColorText2}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DefaultModelDisplay}" FontWeight="SemiBold" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Baseline Context:" Foreground="{DynamicResource SemiColorText2}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ContextWindowDisplay}" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Config Overlay:" Foreground="{DynamicResource SemiColorText2}" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ConfigPathDisplay}" FontSize="11" TextWrapping="Wrap" />
          </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
          <Border Grid.Column="0"
                  Padding="12"
                  CornerRadius="8"
                  Background="{DynamicResource NightCodeBgSurface}"
                  BorderBrush="{DynamicResource SemiColorBorder}"
                  BorderThickness="1">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Imported Role Assignments &amp; Node Ceilings" FontWeight="SemiBold" Margin="0,0,0,8" />
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding RoleAssignments}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:RouterRoleAssignmentSummary">
                      <Border Padding="8" Margin="0,0,0,6" CornerRadius="6" Background="{DynamicResource NightCodeBgInput}">
                        <StackPanel Spacing="4">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding Role}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding Model}" Foreground="{DynamicResource NightCodeAccentIndigoLightText}" FontWeight="SemiBold" />
                          </Grid>
                          <TextBlock Text="{Binding RecommendedContextWindow, StringFormat='Recommended Context: {0:N0} tokens'}"
                                     FontSize="11"
                                     Foreground="{DynamicResource SemiColorText2}" />
                          <ItemsControl ItemsSource="{Binding Nodes}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="m:RouterNodeCeilingSummary">
                                <TextBlock FontSize="11" Foreground="{DynamicResource SemiColorText1}">
                                  <Run Text="• " />
                                  <Run Text="{Binding Target}" />
                                  <Run Text=" — ceiling " />
                                  <Run Text="{Binding ContextCeiling, StringFormat='{}{0:N0}'}" />
                                  <Run Text=" ctx @ " />
                                  <Run Text="{Binding TokensPerSecond, StringFormat='{}{0:F1}'}" />
                                  <Run Text=" t/s" />
                                </TextBlock>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </Border>

          <Border Grid.Column="1"
                  Padding="12"
                  CornerRadius="8"
                  Background="{DynamicResource NightCodeBgInput}"
                  BorderBrush="{DynamicResource SemiColorBorder}"
                  BorderThickness="1">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Handoff Activity Log" FontWeight="SemiBold" Margin="0,0,0,8" />
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding LogLines}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Text="{Binding}" FontFamily="Consolas,Menlo,monospace" FontSize="11" TextWrapping="Wrap" Margin="0,1" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Grid>
      </Grid>

      <!-- Option 2: OpenAI Compatible Provider & Models -->
      <ScrollViewer IsVisible="{Binding IsOpenAiCompatibleMode}">
        <StackPanel Spacing="12">

          <!-- Provider, Endpoint & Keyring Credentials Card -->
          <Border Padding="14"
                  CornerRadius="8"
                  Background="{DynamicResource NightCodeBgSurface}"
                  BorderBrush="{DynamicResource SemiColorBorder}"
                  BorderThickness="1">
            <StackPanel Spacing="10">
              <TextBlock Text="Provider &amp; Credentials" FontSize="13" FontWeight="SemiBold" />

              <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Provider:" VerticalAlignment="Center" Foreground="{DynamicResource SemiColorText2}" />
                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                  <ComboBox HorizontalAlignment="Stretch"
                            ItemsSource="{Binding OpenAiProviders}"
                            SelectedItem="{Binding SelectedOpenAiProvider}"
                            IsEnabled="{Binding !IsRunning}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="m:OpenAiProviderPreset">
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="{Binding SelectedOpenAiProvider.Description}"
                             FontSize="11"
                             Foreground="{DynamicResource SemiColorText2}"
                             TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Endpoint URL:" VerticalAlignment="Center" Foreground="{DynamicResource SemiColorText2}" />
                <TextBox Grid.Row="1" Grid.Column="1"
                         Text="{Binding OpenAiEndpointUrl}"
                         PlaceholderText="https://api.openai.com/v1"
                         IsEnabled="{Binding !IsRunning}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="API Key:" VerticalAlignment="Top" Margin="0,7,0,0" Foreground="{DynamicResource SemiColorText2}" />
                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0"
                             Text="{Binding OpenAiApiKeyInput}"
                             PasswordChar="•"
                             RevealPassword="{Binding ShowApiKey}"
                             PlaceholderText="{Binding OpenAiApiKeyPlaceholder}"
                             IsEnabled="{Binding !IsRunning}" />
                    <Button Grid.Column="1"
                            Content="{Binding ShowApiKeyButtonLabel}"
                            Command="{Binding ToggleShowApiKeyCommand}"
                            IsEnabled="{Binding !IsRunning}" />
                    <Button Grid.Column="2"
                            Content="Clear Key"
                            IsVisible="{Binding HasStoredOpenAiApiKey}"
                            Command="{Binding ClearStoredOpenAiApiKeyCommand}"
                            IsEnabled="{Binding !IsRunning}" />
                  </Grid>
                  <TextBlock Text="{Binding OpenAiCredentialStatusText}"
                             FontSize="11"
                             Foreground="{DynamicResource SemiColorText2}"
                             TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Text="Organization ID:"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SemiColorText2}"
                           IsVisible="{Binding ShowOpenAiOrganizationId}" />
                <TextBox Grid.Row="3" Grid.Column="1"
                         Text="{Binding OpenAiOrganizationId}"
                         PlaceholderText="Optional (OpenAI-Organization header)"
                         IsVisible="{Binding ShowOpenAiOrganizationId}"
                         IsEnabled="{Binding !IsRunning}" />
              </Grid>

              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Content="Test Connection &amp; Load Models"
                        Command="{Binding TestAndDiscoverOpenAiModelsCommand}"
                        IsEnabled="{Binding !IsRunning}" />
                <Border Grid.Column="1"
                        IsVisible="{Binding HasOpenAiDiscoveryStatus}"
                        Padding="10,6"
                        CornerRadius="6"
                        Background="{DynamicResource NightCodeBgInput}"
                        BorderBrush="{DynamicResource SemiColorBorder}"
                        BorderThickness="1">
                  <TextBlock Text="{Binding OpenAiDiscoveryStatusText}"
                             FontSize="12"
                             VerticalAlignment="Center"
                             TextWrapping="Wrap" />
                </Border>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Model Selection Card -->
          <Border Padding="14"
                  CornerRadius="8"
                  Background="{DynamicResource NightCodeBgSurface}"
                  BorderBrush="{DynamicResource SemiColorBorder}"
                  BorderThickness="1">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="Model Selection" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1"
                           Text="{Binding DiscoveredModelCountDisplay}"
                           FontSize="11"
                           Foreground="{DynamicResource SemiColorText2}"
                           VerticalAlignment="Center" />
              </Grid>

              <TextBox IsVisible="{Binding HasDiscoveredOpenAiModels}"
                       Text="{Binding OpenAiModelFilter}"
                       PlaceholderText="Filter discovered models by ID or name..."
                       IsEnabled="{Binding !IsRunning}" />

              <Grid ColumnDefinitions="150,*" ColumnSpacing="12">
                <TextBlock Grid.Column="0" Text="Default Model *:" VerticalAlignment="Top" Margin="0,7,0,0" Foreground="{DynamicResource SemiColorText2}" />
                <StackPanel Grid.Column="1" Spacing="6">
                  <ComboBox HorizontalAlignment="Stretch"
                            IsVisible="{Binding HasDiscoveredOpenAiModels}"
                            ItemsSource="{Binding FilteredDiscoveredModels}"
                            SelectedItem="{Binding SelectedDefaultDiscoveredModel}"
                            PlaceholderText="Select a discovered model..."
                            IsEnabled="{Binding !IsRunning}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="m:OpenAiDiscoveredModel">
                        <TextBlock Text="{Binding DisplayLabel}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBox Text="{Binding OpenAiDefaultModelId}"
                           PlaceholderText="Model ID (e.g. gpt-4o, deepseek-chat, anthropic/claude-sonnet-4)"
                           IsEnabled="{Binding !IsRunning}" />
                </StackPanel>
              </Grid>

              <CheckBox Content="Differentiate Architect / Reviewer and Coder / Implementation models"
                        IsChecked="{Binding DifferentiateOpenAiRoles}"
                        IsEnabled="{Binding !IsRunning}" />

              <Grid IsVisible="{Binding DifferentiateOpenAiRoles}"
                    ColumnDefinitions="*,*"
                    ColumnSpacing="12">
                <StackPanel Grid.Column="0" Spacing="6">
                  <TextBlock Text="Architect / Reviewer Model" FontSize="12" Foreground="{DynamicResource SemiColorText2}" />
                  <ComboBox HorizontalAlignment="Stretch"
                            IsVisible="{Binding HasDiscoveredOpenAiModels}"
                            ItemsSource="{Binding FilteredDiscoveredModels}"
                            SelectedItem="{Binding SelectedArchitectDiscoveredModel}"
                            PlaceholderText="Inherit Default Model"
                            IsEnabled="{Binding !IsRunning}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="m:OpenAiDiscoveredModel">
                        <TextBlock Text="{Binding DisplayLabel}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBox Text="{Binding OpenAiArchitectModelId}"
                           PlaceholderText="Inherit Default Model (optional)"
                           IsEnabled="{Binding !IsRunning}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="6">
                  <TextBlock Text="Coder / Implementation Model" FontSize="12" Foreground="{DynamicResource SemiColorText2}" />
                  <ComboBox HorizontalAlignment="Stretch"
                            IsVisible="{Binding HasDiscoveredOpenAiModels}"
                            ItemsSource="{Binding FilteredDiscoveredModels}"
                            SelectedItem="{Binding SelectedCoderDiscoveredModel}"
                            PlaceholderText="Inherit Default Model"
                            IsEnabled="{Binding !IsRunning}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="m:OpenAiDiscoveredModel">
                        <TextBlock Text="{Binding DisplayLabel}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBox Text="{Binding OpenAiCoderModelId}"
                           PlaceholderText="Inherit Default Model (optional)"
                           IsEnabled="{Binding !IsRunning}" />
                </StackPanel>
              </Grid>

              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Grid.Column="0"
                           IsVisible="{Binding HasSavedOpenAiConfiguration}"
                           Text="{Binding OpenAiSavedSummaryText}"
                           FontSize="12"
                           Foreground="{DynamicResource SemiColorSuccess}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <Button Grid.Column="1"
                        Content="Save Provider Configuration"
                        Classes="Primary"
                        Command="{Binding SaveOpenAiConfigurationCommand}"
                        IsEnabled="{Binding !IsRunning}" />
              </Grid>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>

    </Grid>
  </Grid>
</UserControl>

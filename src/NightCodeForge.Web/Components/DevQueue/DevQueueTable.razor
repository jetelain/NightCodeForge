@namespace NightCodeForge.Web.Components.DevQueue
@using NightCodeForge.Core.Domain
@using NightCodeForge.Infrastructure.BackgroundJobs
@using NightCodeForge.Web.Services
@inject NightCodeForge.Core.Interfaces.IOperationsControlService OperationsControl
@implements IDisposable

<div class="card-surface p-4" style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm);" id="dev-queue-table-card">
    @if (OperationsControl.IsPaused)
    {
        <div class="alert alert-warning d-flex align-items-center mb-3" role="alert" id="dev-queue-paused-banner" style="background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.4); color: #fbbf24; border-radius: var(--radius-md);">
            <span class="me-2" style="font-size: 1.25rem;">⏸️</span>
            <div>
                <strong>Global Operations Paused (Gamer / Dedicated Workload Mode):</strong> Queue advancement is temporarily suspended. Host GPU VRAM is reclaimed. Click "Resume Operations" in the top bar to resume execution.
            </div>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h4 class="m-0" style="font-weight: 700; color: var(--text-primary); font-size: 1.15rem;">Sequential GPU Queue Schedule</h4>
        <div class="d-flex align-items-center flex-wrap gap-2">
            @if (OldestTaskReviewAge.HasValue)
            {
                <span class="badge" style="background: rgba(20, 184, 166, 0.15); color: #2dd4bf; border: 1px solid rgba(20, 184, 166, 0.3); font-size: 0.78rem;" title="Oldest waiting job in Task Review tier">
                    Task Review Wait: @FormatAge(OldestTaskReviewAge.Value)
                </span>
            }
            @if (OldestImplementationAge.HasValue)
            {
                <span class="badge" style="background: rgba(59, 130, 246, 0.15); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.3); font-size: 0.78rem;" title="Oldest waiting job in Implementation tier">
                    Impl Wait: @FormatAge(OldestImplementationAge.Value)
                </span>
            }
            @if (OldestCodeReviewAge.HasValue)
            {
                <span class="badge" style="background: rgba(168, 85, 247, 0.15); color: #c084fc; border: 1px solid rgba(168, 85, 247, 0.3); font-size: 0.78rem;" title="Oldest waiting job in Code Review tier">
                    Review Wait: @FormatAge(OldestCodeReviewAge.Value)
                </span>
            }
            <span class="badge" style="background: var(--bg-card); color: var(--text-secondary); font-family: var(--font-mono); font-size: 0.85rem;">
                @(Jobs?.Count ?? 0) Total Scheduled
            </span>
        </div>
    </div>

    @if (Jobs == null || Jobs.Count == 0)
    {
        <div class="p-4 text-center text-muted" style="background: var(--bg-card); border-radius: var(--radius-md);" id="no-queued-jobs-msg">
            No pending tasks in GPU queue. The sequential worker is idle.
        </div>
    }
    else
    {
        <div class="queue-table-container font-mono">
            <div class="table-responsive">
                <table class="table table-dark table-hover m-0" style="background: transparent;" id="sequential-queue-table">
                    <thead>
                        <tr style="border-bottom: 1px solid var(--border-subtle); color: var(--text-secondary); font-size: 0.85rem;">
                            <th>Priority</th>
                            <th>Queue</th>
                            <th>ForgeTask</th>
                            <th>Stage</th>
                            <th>Enqueued</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in Jobs)
                        {
                            <tr style="vertical-align: middle; border-bottom: 1px solid rgba(255,255,255,0.05);" id="job-row-@job.JobId">
                                <td>
                                    @if (job.Priority == TaskPriority.Critical || job.QueueName == HangfireQueues.LlmUrgent)
                                    {
                                        <span class="forge-badge badge-priority-1"
                                              style="padding: 0.25rem 0.6rem; border-radius: var(--radius-sm); font-size: 0.78rem; font-weight: 700;"
                                              title="Critical / Urgent">
                                            🚨 P1 (URGENT)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="forge-badge badge-priority-@job.Priority"
                                              style="padding: 0.25rem 0.6rem; border-radius: var(--radius-sm); font-size: 0.78rem; font-weight: 700;"
                                              title="@TaskPriority.GetLabel(job.Priority)">
                                            @if (job.Priority == TaskPriority.Normal)
                                            {
                                                <span>P3 (NORMAL)</span>
                                            }
                                            else
                                            {
                                                <span>P@(job.Priority)</span>
                                            }
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (job.QueueName == HangfireQueues.LlmUrgent)
                                    {
                                        <span class="badge" style="background: rgba(239, 68, 68, 0.2); color: #f87171; border: 1px solid #ef4444; font-size: 0.78rem;" title="Critical / Urgent Queue">
                                            🚨 llm-urgent
                                        </span>
                                    }
                                    else if (job.QueueName == HangfireQueues.LlmCodeReview)
                                    {
                                        <span class="badge" style="background: rgba(168, 85, 247, 0.2); color: #c084fc; border: 1px solid #a855f7; font-size: 0.78rem;" title="Tier 1: Code Review &amp; Post-Review">
                                            🔍 llm-code-review
                                        </span>
                                    }
                                    else if (job.QueueName == HangfireQueues.LlmImplementation)
                                    {
                                        <span class="badge" style="background: rgba(59, 130, 246, 0.2); color: #60a5fa; border: 1px solid #3b82f6; font-size: 0.78rem;" title="Tier 2: Implementation &amp; Pre/Post Gates">
                                            💻 llm-implementation
                                        </span>
                                    }
                                    else if (job.QueueName == HangfireQueues.LlmTaskReview)
                                    {
                                        <span class="badge" style="background: rgba(20, 184, 166, 0.2); color: #2dd4bf; border: 1px solid #14b8a6; font-size: 0.78rem;" title="Tier 3: Task Review &amp; Triage">
                                            📝 llm-task-review
                                        </span>
                                    }
                                    else
                                    {
                                        <code style="color: var(--accent-indigo);">@job.QueueName</code>
                                    }
                                </td>
                                <td>
                                    @if (job.TaskId > 0)
                                    {
                                        <a href="/inspector/@job.TaskId" style="color: var(--text-primary); text-decoration: none; font-weight: 600;">
                                            #@job.TaskId: @job.TaskTitle
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">@job.TaskTitle</span>
                                    }
                                </td>
                                <td>
                                    <span class="text-muted">@job.StageId</span>
                                </td>
                                <td class="text-secondary">
                                    <div>@job.EnqueuedAt.ToString("HH:mm:ss")</div>
                                    @{
                                        var wait = DateTime.UtcNow - job.EnqueuedAt;
                                        if (wait.TotalSeconds >= 1)
                                        {
                                            <div style="font-size: 0.75rem; color: var(--text-muted);">
                                                @FormatAge(wait) wait
                                            </div>
                                        }
                                    }
                                </td>
                                <td class="text-end">
                                    @if (job.QueueName != HangfireQueues.LlmUrgent)
                                    {
                                        <button class="btn btn-sm btn-outline-danger me-2"
                                                style="border: 1px solid #ef4444; color: #f87171; background: transparent; font-size: 0.8rem; padding: 0.25rem 0.65rem; border-radius: var(--radius-sm);"
                                                @onclick="() => OnPrioritize.InvokeAsync(job)"
                                                id="prioritize-btn-@job.JobId"
                                                title="Promote to top urgent queue (llm-urgent)">
                                            ⬆️ Promote to Urgent
                                        </button>
                                    }
                                    @if (job.TaskId > 0)
                                    {
                                        <a href="/inspector/@job.TaskId"
                                           class="btn btn-sm btn-secondary me-2"
                                           style="border: 1px solid var(--border-subtle); color: var(--text-secondary); background: var(--bg-card); font-size: 0.8rem; padding: 0.25rem 0.65rem; border-radius: var(--radius-sm); text-decoration: none;"
                                           title="Inspect task execution">
                                            🔍 Inspect
                                        </a>
                                    }
                                    <button class="btn btn-sm btn-secondary"
                                            style="border: 1px solid var(--border-subtle); color: var(--text-secondary); background: var(--bg-card); font-size: 0.8rem; padding: 0.25rem 0.65rem; border-radius: var(--radius-sm);"
                                            @onclick="() => OnCancel.InvokeAsync(job)"
                                            id="cancel-btn-@job.JobId">
                                        ✕ Cancel
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<QueuedJobItem> Jobs { get; set; } = Array.Empty<QueuedJobItem>();
    [Parameter] public TimeSpan? OldestUrgentAge { get; set; }
    [Parameter] public TimeSpan? OldestCodeReviewAge { get; set; }
    [Parameter] public TimeSpan? OldestImplementationAge { get; set; }
    [Parameter] public TimeSpan? OldestTaskReviewAge { get; set; }
    [Parameter] public EventCallback<QueuedJobItem> OnPrioritize { get; set; }
    [Parameter] public EventCallback<QueuedJobItem> OnCancel { get; set; }

    private static string FormatAge(TimeSpan age)
    {
        if (age.TotalDays >= 1) return $"{(int)age.TotalDays}d {age.Hours}h";
        if (age.TotalHours >= 1) return $"{(int)age.TotalHours}h {age.Minutes}m";
        if (age.TotalMinutes >= 1) return $"{(int)age.TotalMinutes}m {age.Seconds:D2}s";
        return $"{(int)age.TotalSeconds}s";
    }

    protected override void OnInitialized()
    {
        OperationsControl.OnOperationsStateChanged += HandleOperationsStateChanged;
    }

    private void HandleOperationsStateChanged(bool isPaused)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        OperationsControl.OnOperationsStateChanged -= HandleOperationsStateChanged;
    }
}

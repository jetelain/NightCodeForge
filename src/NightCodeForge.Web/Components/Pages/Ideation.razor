@page "/ideation"
@inject IIdeationService IdeationService
@inject WorkspaceStateService WorkspaceState
@inject ITaskRepository TaskRepository
@inject IWorkflowRepository WorkflowRepository
@inject IWorkspaceRepository WorkspaceRepository
@inject ITaskMarkdownSyncService MarkdownSync
@inject ToastService ToastService
@inject IdeationSessionState Session
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Ideation Chat - NightCodeForge</PageTitle>

<div class="ideation-page-layout">
    <!-- Page Header & Agent Config Toolbar -->
    <div class="ideation-header">
        <div class="ideation-header-title">
            <span class="ideation-title-icon">💡</span>
            <div>
                <h1>Ideation &amp; Codebase Discovery Chat</h1>
                <p>Interactive requirement elicitation, architecture brainstorming, and automatic backlog task formulation.</p>
            </div>
        </div>
        <div class="ideation-header-status">
            @if (_workspaceSessions != null && _workspaceSessions.Count > 0)
            {
                <div class="session-dropdown-container">
                    <select class="form-control-dark session-select"
                            value="@Session.ActiveConversationId"
                            @onchange="HandleSessionSelectedAsync"
                            disabled="@Session.IsGenerating"
                            title="Switch Ideation Session">
                        @foreach (var s in _workspaceSessions)
                        {
                            <option value="@s.Id">
                                @(s.Status == StageExecutionStatus.Running ? "🟢" : "📁") @(string.IsNullOrWhiteSpace(s.Title) ? $"Session #{s.Id}" : s.Title) (@s.StartedAt.ToLocalTime().ToString("MMM d, HH:mm"))
                            </option>
                        }
                    </select>
                </div>
            }

            <span class="forge-badge @(Session.IsGenerating ? "badge-indigo" : "badge-agentic")">
                <span class="status-dot @(Session.IsGenerating ? "running" : "idle")"></span>
                @(Session.IsGenerating ? "Architect Deliberating..." : "Architect Agent Ready")
            </span>
            <span class="forge-badge @(Session.SelectedRoutingTarget == OllamaRoutingTarget.Local ? "badge-teal" : (Session.SelectedRoutingTarget == OllamaRoutingTarget.Remote ? "badge-indigo" : (Session.SelectedRoutingTarget == OllamaRoutingTarget.Cloud ? "badge-amber" : "badge-gray")))" 
                  title="OllamaRouter Target Backend (Click ⚙️ Config to change)">
                @switch (Session.SelectedRoutingTarget)
                {
                    case OllamaRoutingTarget.Local:
                        <text>🖥️ Host GPU</text>
                        break;
                    case OllamaRoutingTarget.Remote:
                        <text>🌐 LAN Server</text>
                        break;
                    case OllamaRoutingTarget.Cloud:
                        <text>☁️ Cloud Overflow</text>
                        break;
                    default:
                        <text>🔀 Auto Target</text>
                        break;
                }
            </span>
            <button type="button" 
                    class="forge-btn forge-btn-secondary transcript-btn" 
                    @onclick="OpenTranscriptModal"
                    title="View Full Execution Transcript">
                📄 Transcript
            </button>
            <button type="button" 
                    class="forge-btn forge-btn-secondary prompt-config-toggle-btn" 
                    @onclick="() => _showCustomPromptConfig = !_showCustomPromptConfig"
                    title="Customize System Prompt &amp; Inference Target">
                ⚙️ Config
            </button>
        </div>
    </div>

    @if (_showTranscriptModal)
    {
        <div class="transcript-modal-overlay" @onclick="() => _showTranscriptModal = false">
            <div class="transcript-modal-dialog" @onclick:stopPropagation="true">
                <div class="transcript-modal-header">
                    <div class="transcript-modal-title">
                        <span style="font-size: 1.25rem;">📄</span>
                        <h3>Ideation Session Transcript</h3>
                        @if (!string.IsNullOrEmpty(Session.LatestTranscriptPath))
                        {
                            <span class="transcript-path-badge font-mono">@Path.GetFileName(Session.LatestTranscriptPath)</span>
                        }
                    </div>
                    <button type="button" class="forge-btn forge-btn-secondary close-btn" @onclick="() => _showTranscriptModal = false">✕</button>
                </div>
                <div class="transcript-modal-body">
                    @if (!string.IsNullOrWhiteSpace(Session.LatestFullTranscriptMarkdown))
                    {
                        <div class="transcript-actions-bar">
                            <button type="button" class="forge-btn forge-btn-secondary btn-sm" @onclick="CopyTranscriptAsync">
                                📋 Copy Markdown
                            </button>
                            @if (!string.IsNullOrEmpty(Session.LatestTranscriptPath))
                            {
                                <span class="font-mono text-muted" style="font-size: 0.75rem;">File: @Session.LatestTranscriptPath</span>
                            }
                        </div>
                        <pre class="transcript-pre font-mono">@Session.LatestFullTranscriptMarkdown</pre>
                    }
                    else
                    {
                        <div class="text-muted" style="padding: 2rem; text-align: center;">
                            No transcript generated yet for this session. Send a message to the architect agent to generate a full turn-by-turn markdown transcript.
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Optional Custom System Prompt & OllamaRouter Target Config Accordion -->
    @if (_showCustomPromptConfig)
    {
        <div class="system-prompt-card">
            <div class="system-prompt-header">
                <span class="system-prompt-title">Custom Architect System Prompt (Optional)</span>
                <span class="font-mono text-muted" style="font-size: 0.75rem;">Overrides default discovery instructions</span>
            </div>
            <textarea class="form-control-dark font-mono system-prompt-textarea" 
                      rows="2" 
                      @bind="Session.CustomSystemPrompt" 
                      placeholder="e.g. Focus exclusively on performance optimizations in src/NightCodeForge.Core..."></textarea>
            
            <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border-subtle); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                <div style="flex: 1; min-width: 260px;">
                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
                        <span style="font-size: 1.1rem;">🔀</span>
                        <strong style="font-size: 0.92rem; color: var(--text-primary);">OllamaRouter Target Backend</strong>
                    </div>
                    <p style="margin: 0; font-size: 0.82rem; color: var(--text-secondary); line-height: 1.4;">
                        Select <strong>Host GPU</strong> to chat concurrently without waiting if a background task is occupying the LAN server. Select <strong>Cloud Overflow</strong> for complex chats with zero local VRAM.
                    </p>
                </div>
                <select class="forge-input font-mono" style="width: auto; min-width: 280px; padding: 0.45rem 0.75rem; font-size: 0.88rem;" @bind="Session.SelectedRoutingTarget">
                    <option value="@OllamaRoutingTarget.Auto">🔀 Auto (Dynamic Routing)</option>
                    <option value="@OllamaRoutingTarget.Local">🖥️ Host GPU (Concurrent Workstation Execution)</option>
                    <option value="@OllamaRoutingTarget.Remote">🌐 LAN GPU Server (Dedicated High-VRAM)</option>
                    <option value="@OllamaRoutingTarget.Cloud">☁️ Cloud Overflow (Zero Local VRAM / No Waiting)</option>
                </select>
            </div>
        </div>
    }

    @if (WorkspaceState.ActiveWorkspace == null)
    {
        <div style="margin-bottom: 1.5rem;">
            <WorkspaceEmptyStateHero />
        </div>
    }

    <!-- Two-Pane Main Workspace Grid -->
    <div class="ideation-grid">
        <!-- LEFT PANE: Conversational Stream & Chat Input (~60%) -->
        <div class="chat-pane">
            <!-- Quick Preset Prompts Bar -->
            <div class="quick-prompts-bar">
                <span class="quick-prompts-label">Quick Prompts:</span>
                <button type="button" class="prompt-chip" @onclick='() => ApplyPresetPrompt("Explore the codebase architecture, project layout, and key entry points.")' disabled="@Session.IsGenerating">
                    🏛️ Explore Architecture
                </button>
                <button type="button" class="prompt-chip" @onclick='() => ApplyPresetPrompt("Scan the repository for unused files, redundant dependencies, or dead code to clean up.")' disabled="@Session.IsGenerating">
                    🔍 Find Dead Code
                </button>
                <button type="button" class="prompt-chip" @onclick='() => ApplyPresetPrompt("Identify technical debt, error handling gaps, and reliability risks, and propose tasks with dependencies.")' disabled="@Session.IsGenerating">
                    🛡️ Propose Tech Debt
                </button>
                <button type="button" class="prompt-chip" @onclick='() => ApplyPresetPrompt("Help me plan and break down a new feature into modular, incremental backlog tasks with clear acceptance criteria.")' disabled="@Session.IsGenerating">
                    ✨ Plan New Feature
                </button>
            </div>

            <!-- Scrollable Message Transcript -->
            <div class="chat-messages-wrapper">
                <div id="chatMessagesContainer" class="chat-messages-container">
                @if (Session.Messages.Count == 0 && !Session.IsGenerating)
                {
                    <div class="chat-empty-state">
                        <div class="chat-empty-icon">💡</div>
                        <div class="chat-empty-title">Codebase Discovery &amp; Ideation</div>
                        <p class="chat-empty-desc">
                            Ask architectural questions, explore code structure with read-only tools, or brainstorm new features.
                            Any backlog tasks formulated by the agent will appear in the <strong>Discovered Proposals</strong> panel.
                        </p>
                        @if (WorkspaceState.ActiveWorkspace == null)
                        {
                            <div class="workspace-warning-callout">
                                ⚠️ No active workspace selected. Please select a workspace from the top bar to begin.
                            </div>
                        }
                    </div>
                }

                @foreach (var msg in Session.Messages)
                {
                    <div class="chat-bubble @(msg.Role.ToLowerInvariant())">
                        <div class="chat-avatar">
                            @(msg.Role.Equals("user", StringComparison.OrdinalIgnoreCase) ? "👤" : "💡")
                        </div>
                        <div class="chat-bubble-body">
                            <div class="chat-bubble-header">
                                <span class="chat-author">@(msg.Role.Equals("user", StringComparison.OrdinalIgnoreCase) ? "You" : "Architect Agent")</span>
                                @if (msg.Timestamp.HasValue)
                                {
                                    <span class="chat-timestamp font-mono">@msg.Timestamp.Value.ToLocalTime().ToString("HH:mm:ss")</span>
                                }
                            </div>

                            @if (msg.Parts != null && msg.Parts.Count > 0)
                            {
                                @foreach (var part in msg.Parts)
                                {
                                    if (part is ThinkingContentPart thinkPart && !string.IsNullOrWhiteSpace(thinkPart.Thinking))
                                    {
                                        <details class="think-trace">
                                            <summary>
                                                <span>🧠 Reasoning Trace</span>
                                                <span class="font-mono text-muted">(@thinkPart.Thinking.Length chars)</span>
                                            </summary>
                                            <div class="think-content font-mono">@thinkPart.Thinking</div>
                                        </details>
                                    }
                                    else if (part is ToolCallContentPart tcp)
                                    {
                                        var tool = tcp.ToolCall;
                                        <details class="tool-trace @(tool.IsError ? "error" : "completed")" open="@tool.IsError">
                                            <summary>
                                                <span class="tool-trace-title">
                                                    <span>@(GetToolIcon(tool.ToolName))</span>
                                                    <span class="font-mono font-semibold">@tool.ToolName</span>
                                                    <span class="text-muted font-mono tool-summary-text">@GetToolSummary(tool.Arguments)</span>
                                                </span>
                                                <span class="tool-trace-status">
                                                    @if (tool.IsError)
                                                    {
                                                        <span class="forge-badge badge-danger tool-trace-badge">Failed</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="forge-badge badge-success tool-trace-badge">✓ @(tool.DurationMs)ms</span>
                                                    }
                                                </span>
                                            </summary>
                                            <div class="tool-trace-content">
                                                @if (!string.IsNullOrWhiteSpace(tool.Arguments))
                                                {
                                                    <div class="tool-trace-block">
                                                        <span class="tool-trace-label">Parameters</span>
                                                        <pre class="tool-trace-pre font-mono">@tool.Arguments</pre>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(tool.Result))
                                                {
                                                    <div class="tool-trace-block">
                                                        <span class="tool-trace-label">Result @(tool.IsError ? "(Error)" : "")</span>
                                                        <pre class="tool-trace-pre font-mono @(tool.IsError ? "result-error" : "")">@tool.Result</pre>
                                                    </div>
                                                }
                                            </div>
                                        </details>
                                    }
                                    else if (part is QuestionContentPart qp)
                                    {
                                        <div class="agent-question-card @(qp.IsAnswered ? "answered" : "pending")">
                                            <div class="agent-question-header">
                                                <span class="agent-question-title">
                                                    @(qp.IsAnswered ? "✓ Agent Clarification" : "❓ Agent Question")
                                                </span>
                                                @if (qp.IsAnswered)
                                                {
                                                    <span class="forge-badge badge-success tool-trace-badge">Answered</span>
                                                }
                                                else
                                                {
                                                    <span class="forge-badge badge-indigo tool-trace-badge">Pending</span>
                                                }
                                            </div>
                                            <div class="agent-question-prompt">@qp.Prompt</div>
                                            @if (!string.IsNullOrWhiteSpace(qp.Rationale))
                                            {
                                                <div class="agent-question-rationale text-muted">@qp.Rationale</div>
                                            }
                                            @if (qp.Options != null && qp.Options.Count > 0)
                                            {
                                                <div class="agent-question-options">
                                                    @foreach (var option in qp.Options)
                                                    {
                                                        var isSelected = qp.IsAnswered && string.Equals(qp.Answer, option, StringComparison.OrdinalIgnoreCase);
                                                        <span class="agent-choice-pill @(isSelected ? "selected" : "muted")">
                                                            @(isSelected ? "✓ " : "")@option
                                                        </span>
                                                    }
                                                </div>
                                            }
                                            @if (qp.IsAnswered)
                                            {
                                                <div class="agent-answer-summary">
                                                    <span class="agent-answer-label">Your Answer:</span>
                                                    <span class="agent-answer-value font-mono">@qp.Answer</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else if (part is TextContentPart textPart && !string.IsNullOrWhiteSpace(textPart.Text))
                                    {
                                        <div class="chat-content-wrap">
                                            <MarkdownRenderer Content="@textPart.Text" />
                                        </div>
                                    }
                                }
                            }
                            else
                            {
                                @if (!string.IsNullOrEmpty(msg.ThinkingTrace))
                                {
                                    <details class="think-trace">
                                        <summary>
                                            <span>🧠 Reasoning Trace</span>
                                            <span class="font-mono text-muted">(@msg.ThinkingTrace.Length chars)</span>
                                        </summary>
                                        <div class="think-content font-mono">@msg.ThinkingTrace</div>
                                    </details>
                                }

                                @if (msg.ToolCalls != null && msg.ToolCalls.Count > 0)
                                {
                                    <div class="tool-calls-list">
                                        @foreach (var tool in msg.ToolCalls)
                                        {
                                            <details class="tool-trace @(tool.IsError ? "error" : "completed")" open="@tool.IsError">
                                                <summary>
                                                    <span class="tool-trace-title">
                                                        <span>@(GetToolIcon(tool.ToolName))</span>
                                                        <span class="font-mono font-semibold">@tool.ToolName</span>
                                                        <span class="text-muted font-mono tool-summary-text">@GetToolSummary(tool.Arguments)</span>
                                                    </span>
                                                    <span class="tool-trace-status">
                                                        @if (tool.IsError)
                                                        {
                                                            <span class="forge-badge badge-danger tool-trace-badge">Failed</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="forge-badge badge-success tool-trace-badge">✓ @(tool.DurationMs)ms</span>
                                                        }
                                                    </span>
                                                </summary>
                                                <div class="tool-trace-content">
                                                    @if (!string.IsNullOrWhiteSpace(tool.Arguments))
                                                    {
                                                        <div class="tool-trace-block">
                                                            <span class="tool-trace-label">Parameters</span>
                                                            <pre class="tool-trace-pre font-mono">@tool.Arguments</pre>
                                                        </div>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(tool.Result))
                                                    {
                                                        <div class="tool-trace-block">
                                                            <span class="tool-trace-label">Result @(tool.IsError ? "(Error)" : "")</span>
                                                            <pre class="tool-trace-pre font-mono @(tool.IsError ? "result-error" : "")">@tool.Result</pre>
                                                        </div>
                                                    }
                                                </div>
                                            </details>
                                        }
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(msg.Content))
                                {
                                    <div class="chat-content-wrap">
                                        <MarkdownRenderer Content="@msg.Content" />
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }

                <!-- Active Live Streaming Bubble -->
                @if (Session.IsGenerating)
                {
                    <div class="chat-bubble assistant streaming">
                        <div class="chat-avatar">💡</div>
                        <div class="chat-bubble-body">
                            <div class="chat-bubble-header">
                                <span class="chat-author">Architect Agent</span>
                                <span class="forge-badge badge-indigo live-badge">Streaming</span>
                            </div>

                            @if (Session.CurrentParts.Count > 0)
                            {
                                @foreach (var part in Session.CurrentParts)
                                {
                                    if (part is ThinkingContentPart thinkPart && !string.IsNullOrWhiteSpace(thinkPart.Thinking))
                                    {
                                        <details class="think-trace" open>
                                            <summary>
                                                <span>🧠 Reasoning Trace</span>
                                                @if (part == Session.CurrentParts.LastOrDefault())
                                                {
                                                    <span class="status-dot running" style="margin-left: 0.25rem;"></span>
                                                }
                                            </summary>
                                            <div class="think-content font-mono">@thinkPart.Thinking @(part == Session.CurrentParts.LastOrDefault() ? "▌" : "")</div>
                                        </details>
                                    }
                                    else if (part is ToolCallContentPart toolPart)
                                    {
                                        var tool = toolPart.ToolCall;
                                        <details class="tool-trace @(tool.IsError ? "error" : (tool.IsCompleted ? "completed" : "running"))" open="@(tool.IsError || !tool.IsCompleted)">
                                            <summary>
                                                <span class="tool-trace-title">
                                                    <span>@(GetToolIcon(tool.ToolName))</span>
                                                    <span class="font-mono font-semibold">@tool.ToolName</span>
                                                    <span class="text-muted font-mono tool-summary-text">@GetToolSummary(tool.Arguments)</span>
                                                </span>
                                                <span class="tool-trace-status">
                                                    @if (!tool.IsCompleted)
                                                    {
                                                        <span class="status-dot running" style="margin-right: 0.35rem;"></span>
                                                        <span class="forge-badge badge-indigo tool-trace-badge">Running</span>
                                                    }
                                                    else if (tool.IsError)
                                                    {
                                                        <span class="forge-badge badge-danger tool-trace-badge">Failed</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="forge-badge badge-success tool-trace-badge">✓ @(tool.DurationMs)ms</span>
                                                    }
                                                </span>
                                            </summary>
                                            <div class="tool-trace-content">
                                                @if (!string.IsNullOrWhiteSpace(tool.Arguments))
                                                {
                                                    <div class="tool-trace-block">
                                                        <span class="tool-trace-label">Parameters</span>
                                                        <pre class="tool-trace-pre font-mono">@tool.Arguments</pre>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(tool.Result))
                                                {
                                                    <div class="tool-trace-block">
                                                        <span class="tool-trace-label">Result @(tool.IsError ? "(Error)" : "")</span>
                                                        <pre class="tool-trace-pre font-mono @(tool.IsError ? "result-error" : "")">@tool.Result</pre>
                                                    </div>
                                                }
                                            </div>
                                        </details>
                                    }
                                    else if (part is QuestionContentPart qp)
                                    {
                                        <div class="agent-question-card @(qp.IsAnswered ? "answered" : "pending")">
                                            <div class="agent-question-header">
                                                <span class="agent-question-title">
                                                    @(qp.IsAnswered ? "✓ Agent Clarification" : "❓ The Agent Needs Your Input")
                                                </span>
                                                @if (qp.IsAnswered)
                                                {
                                                    <span class="forge-badge badge-success tool-trace-badge">Answered</span>
                                                }
                                                else
                                                {
                                                    <span class="forge-badge badge-indigo tool-trace-badge">Waiting for Answer</span>
                                                }
                                            </div>
                                            <div class="agent-question-prompt">@qp.Prompt</div>
                                            @if (!string.IsNullOrWhiteSpace(qp.Rationale))
                                            {
                                                <div class="agent-question-rationale text-muted">@qp.Rationale</div>
                                            }
                                            @if (qp.Options != null && qp.Options.Count > 0)
                                            {
                                                <div class="agent-question-options">
                                                    @foreach (var option in qp.Options)
                                                    {
                                                        var captured = option;
                                                        var isSelected = qp.IsAnswered && string.Equals(qp.Answer, option, StringComparison.OrdinalIgnoreCase);
                                                        if (qp.IsAnswered)
                                                        {
                                                            <span class="agent-choice-pill @(isSelected ? "selected" : "muted")">
                                                                @(isSelected ? "✓ " : "")@captured
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <button type="button" class="forge-btn forge-btn-secondary" @onclick="() => SubmitQuestionAnswer(captured)">@captured</button>
                                                        }
                                                    }
                                                </div>
                                            }
                                            @if (qp.IsAnswered)
                                            {
                                                <div class="agent-answer-summary">
                                                    <span class="agent-answer-label">Your Answer:</span>
                                                    <span class="agent-answer-value font-mono">@qp.Answer</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="agent-question-freetext">
                                                    <input type="text" class="form-control-dark" placeholder="Type your answer..."
                                                           @bind="_questionAnswer" @bind:event="oninput"
                                                           @onkeydown="HandleQuestionKeyDownAsync"
                                                           aria-label="Answer to agent question" />
                                                    <button type="button" class="forge-btn forge-btn-primary"
                                                            disabled="@string.IsNullOrWhiteSpace(_questionAnswer)"
                                                            @onclick="() => SubmitQuestionAnswer(_questionAnswer)">Answer</button>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else if (part is TextContentPart textPart && !string.IsNullOrWhiteSpace(textPart.Text))
                                    {
                                        <div class="chat-content-wrap">
                                            <MarkdownRenderer Content="@textPart.Text" />
                                            @if (part == Session.CurrentParts.LastOrDefault())
                                            {
                                                <span class="cursor-blink">▌</span>
                                            }
                                        </div>
                                    }
                                }
                            }
                            else
                            {
                                <div class="generating-wait-box">
                                    <span class="status-dot running"></span>
                                    <span>Agent is inspecting codebase files and deliberating...</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Scroll to bottom floating button -->
            <button id="chatScrollToBottomBtn" 
                    type="button" 
                    class="chat-scroll-bottom-btn" 
                    title="Scroll to latest messages" 
                    aria-label="Scroll to latest messages">
                <span>↓</span>
            </button>
        </div>

            <!-- Chat Input Area -->
            <div class="chat-input-area">
                <textarea class="form-control-dark chat-textarea" 
                          rows="3" 
                          @bind="_userInput" 
                          @bind:event="oninput" 
                          @onkeydown="HandleKeyDownAsync"
                          placeholder="Ask the Architect agent or describe requirements... (Press Enter to send, Shift+Enter for new line)"
                          disabled="@(Session.IsGenerating || WorkspaceState.ActiveWorkspace == null)"
                          aria-label="Ideation Chat Prompt"></textarea>

                <div class="chat-actions-row">
                    <div class="chat-actions-left">
                        <button type="button" 
                                class="forge-btn forge-btn-secondary reset-session-btn" 
                                @onclick="ResetSession" 
                                disabled="@Session.IsGenerating"
                                title="Clear conversation turns and proposals">
                            🔄 Clear Chat
                        </button>
                        <span class="text-muted font-mono prompt-length-counter">
                            @_userInput.Length chars
                        </span>
                    </div>

                    <div class="chat-actions-right">
                        @if (Session.IsGenerating)
                        {
                            <button type="button" class="forge-btn cancel-btn" @onclick="CancelGenerationAsync">
                                ⏹️ Stop Generating
                            </button>
                        }
                        else
                        {
                            <button type="button" 
                                    class="forge-btn forge-btn-primary send-btn" 
                                    @onclick="SendMessageAsync" 
                                    disabled="@(string.IsNullOrWhiteSpace(_userInput) || WorkspaceState.ActiveWorkspace == null)">
                                🚀 Send
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT PANE: Discovered Proposals Grid (~40%) -->
        <div class="proposals-pane">
            <div class="proposals-header">
                <div class="proposals-header-left">
                    <span class="proposals-header-icon">📋</span>
                    <h2>Discovered Proposals</h2>
                </div>
                <div class="proposals-header-right">
                    @if (Session.Proposals.Any(p => !p.IsAdded))
                    {
                        <button type="button" 
                                class="forge-btn forge-btn-xs forge-btn-primary add-all-btn"
                                @onclick="AddAllProposalsToBacklogAsync"
                                title="Add all proposals sequentially to backlog">
                            ➕ Ingest All (@Session.Proposals.Count(p => !p.IsAdded))
                        </button>
                    }
                    <span class="forge-badge badge-indigo font-mono">@Session.Proposals.Count</span>
                    @if (Session.Proposals.Any(p => p.IsAdded))
                    {
                        <span class="forge-badge badge-teal font-mono">@Session.Proposals.Count(p => p.IsAdded) Ingested</span>
                    }
                </div>
            </div>

            <div class="proposals-list-scroll">
                @if (Session.Proposals.Count == 0)
                {
                    <div class="proposals-empty-box">
                        <div class="proposals-empty-icon">💡</div>
                        <div class="proposals-empty-title">No Proposals Yet</div>
                        <p class="proposals-empty-text">
                            When the Architect Agent discovers backlog opportunities or you ask to formulate tasks, interactive proposal cards will appear here.
                        </p>
                        <div class="proposals-empty-hint">
                            Try asking: <em>"Propose 3 backlog tasks to refactor error handling in src/NightCodeForge.Infrastructure"</em>
                        </div>
                    </div>
                }
                else
                {
                    @foreach (var proposal in Session.Proposals)
                    {
                        <IdeationProposalCard @key="proposal.ClientId" 
                                              Proposal="proposal" 
                                              WorkspaceTasks="_workspaceTasks" 
                                              OnAddToBacklog="AddProposalToBacklogAsync" 
                                              OnDismiss="DismissProposal" />
                    }
                }
            </div>
        </div>
    </div>
</div>

@code {
    private string _userInput = string.Empty;
    private bool _showCustomPromptConfig;
    private CancellationTokenSource? _cts;
    private IReadOnlyList<ForgeTask> _workspaceTasks = Array.Empty<ForgeTask>();
    private IReadOnlyList<Conversation> _workspaceSessions = Array.Empty<Conversation>();

    protected override async Task OnInitializedAsync()
    {
        WorkspaceState.OnWorkspaceChanged += HandleWorkspaceChanged;
        Session.OnChange += HandleSessionChanged;

        await ReloadWorkspaceContextAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("NightCodeForge.initAutoScroll", "chatMessagesContainer", "chatScrollToBottomBtn");
            }
            catch
            {
                // In non-interactive or test rendering
            }
        }
    }

    private async Task ReloadWorkspaceContextAsync()
    {
        var active = WorkspaceState.ActiveWorkspace;
        if (active != null)
        {
            try
            {
                _workspaceTasks = await TaskRepository.GetByWorkspaceIdAsync(active.Id);
                _workspaceSessions = await TaskRepository.GetIdeationConversationsAsync(active.Id);

                if (Session.BoundWorkspaceId != active.Id)
                {
                    var activeConv = await TaskRepository.GetActiveIdeationConversationAsync(active.Id);
                    if (activeConv != null)
                    {
                        LoadConversationIntoSession(activeConv);
                    }
                    else
                    {
                        var newConv = await TaskRepository.StartIdeationConversationAsync(
                            active.Id,
                            title: $"Discovery Chat #{DateTime.UtcNow:MMdd-HHmm}");
                        Session.Reset();
                        Session.BoundWorkspaceId = active.Id;
                        Session.ActiveConversationId = newConv.Id;
                        Session.ActiveConversationTitle = newConv.Title;
                        _workspaceSessions = await TaskRepository.GetIdeationConversationsAsync(active.Id);
                    }
                }
                else if (!Session.ActiveConversationId.HasValue)
                {
                    var activeConv = await TaskRepository.GetActiveIdeationConversationAsync(active.Id);
                    if (activeConv != null && Session.Messages.Count == 0)
                    {
                        LoadConversationIntoSession(activeConv);
                    }
                    else if (activeConv != null)
                    {
                        Session.ActiveConversationId = activeConv.Id;
                        Session.ActiveConversationTitle = activeConv.Title;
                    }
                    else
                    {
                        var newConv = await TaskRepository.StartIdeationConversationAsync(
                            active.Id,
                            title: $"Discovery Chat #{DateTime.UtcNow:MMdd-HHmm}");
                        Session.ActiveConversationId = newConv.Id;
                        Session.ActiveConversationTitle = newConv.Title;
                        _workspaceSessions = await TaskRepository.GetIdeationConversationsAsync(active.Id);
                    }
                }
            }
            catch
            {
                _workspaceTasks = Array.Empty<ForgeTask>();
                _workspaceSessions = Array.Empty<Conversation>();
            }
        }
        else
        {
            _workspaceTasks = Array.Empty<ForgeTask>();
            _workspaceSessions = Array.Empty<Conversation>();
        }

        await InvokeAsync(StateHasChanged);
    }

    private void LoadConversationIntoSession(Conversation conv)
    {
        Session.Reset();
        Session.BoundWorkspaceId = conv.WorkspaceId;
        Session.ActiveConversationId = conv.Id;
        Session.ActiveConversationTitle = conv.Title;

        var pendingTools = new List<IdeationToolCallViewModel>();
        var pendingParts = new List<ChatContentPart>();

        foreach (var turn in conv.Turns.OrderBy(t => t.TurnIndex))
        {
            if (turn.Role == StageTurnRole.User)
            {
                Session.Messages.Add(new ChatMessage(
                    "user",
                    turn.Content ?? string.Empty,
                    Timestamp: turn.Timestamp,
                    Parts: [new TextContentPart(turn.Content ?? string.Empty)]));
            }
            else if (turn.Role == StageTurnRole.ToolResult)
            {
                var vm = new IdeationToolCallViewModel
                {
                    ToolCallId = Guid.NewGuid().ToString("N")[..8],
                    ToolName = turn.ToolName ?? "tool",
                    Arguments = turn.ToolArguments ?? string.Empty,
                    Result = turn.ToolResult ?? turn.Content,
                    IsCompleted = true,
                    IsError = turn.IsError,
                    DurationMs = turn.DurationMs ?? 0
                };
                pendingTools.Add(vm);
                pendingParts.Add(new ToolCallContentPart(vm));
            }
            else if (turn.Role == StageTurnRole.Assistant)
            {
                var parts = new List<ChatContentPart>();
                if (!string.IsNullOrEmpty(turn.ThinkingTrace))
                {
                    parts.Add(new ThinkingContentPart(turn.ThinkingTrace));
                }

                var tools = new List<IdeationToolCallViewModel>(pendingTools);
                parts.AddRange(pendingParts);
                pendingTools.Clear();
                pendingParts.Clear();

                if (!string.IsNullOrEmpty(turn.ToolName) && !tools.Any(t => t.ToolName == turn.ToolName && t.Arguments == turn.ToolArguments))
                {
                    var vm = new IdeationToolCallViewModel
                    {
                        ToolCallId = Guid.NewGuid().ToString("N")[..8],
                        ToolName = turn.ToolName,
                        Arguments = turn.ToolArguments ?? string.Empty,
                        Result = turn.ToolResult,
                        IsCompleted = true,
                        IsError = turn.IsError,
                        DurationMs = turn.DurationMs ?? 0
                    };
                    tools.Add(vm);
                    parts.Add(new ToolCallContentPart(vm));
                }

                if (!string.IsNullOrEmpty(turn.Content))
                {
                    parts.Add(new TextContentPart(turn.Content));
                }

                Session.Messages.Add(new ChatMessage(
                    "assistant",
                    turn.Content ?? string.Empty,
                    turn.ThinkingTrace,
                    turn.Timestamp,
                    tools.Count > 0 ? tools : null,
                    parts.Count > 0 ? parts : null));

                if (!string.IsNullOrWhiteSpace(turn.MetadataJson))
                {
                    try
                    {
                        var proposals = System.Text.Json.JsonSerializer.Deserialize<List<IdeationProposal>>(
                            turn.MetadataJson,
                            new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                        if (proposals != null)
                        {
                            foreach (var p in proposals)
                            {
                                if (!Session.Proposals.Any(existing => string.Equals(existing.Title, p.Title, StringComparison.OrdinalIgnoreCase)))
                                {
                                    Session.Proposals.Add(IdeationProposalViewModel.FromProposal(p, _workspaceTasks));
                                }
                            }
                        }
                    }
                    catch
                    {
                        // Ignore malformed metadata
                    }
                }
            }
        }
    }

    private async Task HandleSessionSelectedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var selectedId))
        {
            var conv = await TaskRepository.GetConversationWithTurnsAsync(selectedId);
            if (conv != null)
            {
                LoadConversationIntoSession(conv);
                ToastService.Show("Session Loaded", conv.Title ?? $"Session #{conv.Id}", ToastLevel.Info);
                StateHasChanged();
                _ = ScrollChatToBottomAsync(true);
            }
        }
    }

    private void HandleWorkspaceChanged()
    {
        if (Session.IsGenerating)
        {
            _cts?.Cancel();
        }

        _ = InvokeAsync(ReloadWorkspaceContextAsync);
    }

    private void HandleSessionChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void ApplyPresetPrompt(string promptText)
    {
        _userInput = promptText;
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            if (!Session.IsGenerating && !string.IsNullOrWhiteSpace(_userInput) && WorkspaceState.ActiveWorkspace != null)
            {
                await SendMessageAsync();
            }
        }
    }

    private string _questionAnswer = string.Empty;

    private void SubmitQuestionAnswer(string? answer)
    {
        if (string.IsNullOrWhiteSpace(answer))
            return;

        var cleanAnswer = answer.Trim();

        var qPart = Session.CurrentParts.OfType<QuestionContentPart>()
            .LastOrDefault(q => !q.IsAnswered);
        if (qPart != null)
        {
            qPart.Answer = cleanAnswer;
        }

        if (Session.PendingQuestion != null)
        {
            Session.PendingQuestion.Submit(cleanAnswer);
            Session.PendingQuestion = null;
        }

        _questionAnswer = string.Empty;
        StateHasChanged();
        _ = ScrollChatToBottomAsync(true);
    }

    private Task HandleQuestionKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            SubmitQuestionAnswer(_questionAnswer);
        }
        return Task.CompletedTask;
    }

    private bool _showTranscriptModal;

    private void OpenTranscriptModal()
    {
        _showTranscriptModal = true;
    }

    private async Task CopyTranscriptAsync()
    {
        if (!string.IsNullOrWhiteSpace(Session.LatestFullTranscriptMarkdown))
        {
            try
            {
                await JS.InvokeVoidAsync("navigator.clipboard.writeText", Session.LatestFullTranscriptMarkdown);
                ToastService.Show("Transcript Copied", "Markdown transcript copied to clipboard.", ToastLevel.Success);
            }
            catch
            {
                ToastService.Show("Copy Failed", "Unable to access clipboard.", ToastLevel.Warning);
            }
        }
    }

    private async Task SendMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(_userInput) || WorkspaceState.ActiveWorkspace == null)
            return;

        var prompt = _userInput.Trim();
        _userInput = string.Empty;

        var ws = WorkspaceState.ActiveWorkspace;
        if (!Session.ActiveConversationId.HasValue)
        {
            var newConv = await TaskRepository.StartIdeationConversationAsync(
                ws.Id,
                title: TruncateString(prompt, 50));
            Session.ActiveConversationId = newConv.Id;
            Session.ActiveConversationTitle = newConv.Title;
            _workspaceSessions = await TaskRepository.GetIdeationConversationsAsync(ws.Id);
        }

        // Persist User turn
        await TaskRepository.AddConversationTurnAsync(
            Session.ActiveConversationId.Value,
            StageTurnRole.User,
            content: prompt,
            cancellationToken: _cts?.Token ?? CancellationToken.None);

        // Build history from existing completed turns, retaining text & action summaries
        var history = Session.Messages
            .Select(m => (m.Role, m.GetEffectiveHistoryContent()))
            .Where(m => !string.IsNullOrWhiteSpace(m.Item2))
            .ToList();

        Session.Messages.Add(new ChatMessage("user", prompt, Timestamp: DateTime.UtcNow, Parts: [new TextContentPart(prompt)]));
        Session.IsGenerating = true;
        Session.CurrentThinkingBuffer = string.Empty;
        Session.CurrentMessageBuffer = string.Empty;
        Session.CurrentToolCalls.Clear();
        Session.CurrentParts.Clear();

        _cts?.Dispose();
        _cts = new CancellationTokenSource();

        await ScrollChatToBottomAsync();

        var discoveredProposalsThisTurn = new List<IdeationProposal>();

        try
        {
            ws = WorkspaceState.ActiveWorkspace;
            var baseProfile = ws != null ? await WorkspaceRepository.GetEffectiveAgentProfileAsync(ws.Id, StandardStageIds.Ideation) : null;
            if (baseProfile == null && ws != null)
            {
                baseProfile = ws.AgentProfiles?.FirstOrDefault(p =>
                    string.Equals(p.Id, StandardStageIds.Ideation, StringComparison.OrdinalIgnoreCase) ||
                    p.Name.Contains(StandardStageIds.Ideation, StringComparison.OrdinalIgnoreCase));
            }
            if (baseProfile == null)
            {
                throw new AgentProfileNotFoundException(StandardStageIds.Ideation, ws?.Id);
            }
            AgentProfile? effectiveProfile = null;
            if (Session.SelectedRoutingTarget != OllamaRoutingTarget.Auto || !string.IsNullOrEmpty(Session.SelectedModelOverride))
            {
                effectiveProfile = new AgentProfile
                {
                    Id = baseProfile.Id,
                    Name = baseProfile.Name,
                    WorkspaceId = baseProfile.WorkspaceId,
                    HarnessId = baseProfile.HarnessId,
                    ModelName = !string.IsNullOrEmpty(Session.SelectedModelOverride) ? Session.SelectedModelOverride : baseProfile.ModelName,
                    Mode = baseProfile.Mode,
                    SecurityTier = baseProfile.SecurityTier,
                    PermittedTools = baseProfile.PermittedTools,
                    OptimizationFlags = baseProfile.OptimizationFlags,
                    Temperature = baseProfile.Temperature,
                    ThinkingEffort = baseProfile.ThinkingEffort,
                    ThinkingTokenBudget = baseProfile.ThinkingTokenBudget,
                    MaxTurns = baseProfile.MaxTurns,
                    SystemPrompt = baseProfile.SystemPrompt,
                    RoutingTarget = Session.SelectedRoutingTarget
                };
            }

            await foreach (var update in IdeationService.ConverseStreamingAsync(
                WorkspaceState.ActiveWorkspace,
                prompt,
                history,
                agentProfile: effectiveProfile,
                customSystemPrompt: Session.CustomSystemPrompt,
                cancellationToken: _cts.Token))
            {
                switch (update.Kind)
                {
                    case IdeationStreamUpdateKind.ThinkingDelta:
                        if (!string.IsNullOrEmpty(update.TextDelta))
                        {
                            Session.CurrentThinkingBuffer += update.TextDelta;
                            if (Session.CurrentParts.LastOrDefault() is ThinkingContentPart lastThink)
                            {
                                var idx = Session.CurrentParts.Count - 1;
                                Session.CurrentParts[idx] = new ThinkingContentPart(lastThink.Thinking + update.TextDelta);
                            }
                            else
                            {
                                Session.CurrentParts.Add(new ThinkingContentPart(update.TextDelta));
                            }
                            StateHasChanged();
                        }
                        break;

                    case IdeationStreamUpdateKind.MessageDelta:
                        if (!string.IsNullOrEmpty(update.TextDelta))
                        {
                            Session.CurrentMessageBuffer += update.TextDelta;
                            if (Session.CurrentParts.LastOrDefault() is TextContentPart lastText)
                            {
                                var idx = Session.CurrentParts.Count - 1;
                                Session.CurrentParts[idx] = new TextContentPart(lastText.Text + update.TextDelta);
                            }
                            else
                            {
                                Session.CurrentParts.Add(new TextContentPart(update.TextDelta));
                            }
                            StateHasChanged();
                        }
                        break;

                    case IdeationStreamUpdateKind.ToolCallStarted when update.ToolCall != null:
                        var call = update.ToolCall;
                        var existing = Session.CurrentToolCalls.FirstOrDefault(t => t.ToolCallId == call.ToolCallId);
                        if (existing == null)
                        {
                            var vm = new IdeationToolCallViewModel
                            {
                                ToolCallId = call.ToolCallId,
                                ToolName = call.ToolName,
                                Arguments = call.Arguments,
                                IsCompleted = false
                            };
                            Session.CurrentToolCalls.Add(vm);
                            if (!string.Equals(call.ToolName, "ask", StringComparison.OrdinalIgnoreCase))
                            {
                                Session.CurrentParts.Add(new ToolCallContentPart(vm));
                            }
                        }
                        StateHasChanged();
                        break;

                    case IdeationStreamUpdateKind.ToolCallCompleted when update.ToolCall != null:
                        var comp = update.ToolCall;
                        var match = Session.CurrentToolCalls.FirstOrDefault(t => t.ToolCallId == comp.ToolCallId);
                        if (match != null)
                        {
                            match.Result = comp.Result;
                            match.IsCompleted = true;
                            match.IsError = comp.IsError;
                            match.DurationMs = comp.DurationMs;
                        }
                        var partMatch = Session.CurrentParts.OfType<ToolCallContentPart>().FirstOrDefault(p => p.ToolCall.ToolCallId == comp.ToolCallId);
                        if (partMatch != null)
                        {
                            partMatch.ToolCall.Result = comp.Result;
                            partMatch.ToolCall.IsCompleted = true;
                            partMatch.ToolCall.IsError = comp.IsError;
                            partMatch.ToolCall.DurationMs = comp.DurationMs;
                        }

                        if (string.Equals(comp.ToolName, "ask", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(comp.Result))
                        {
                            var qPart = Session.CurrentParts.OfType<QuestionContentPart>().LastOrDefault(q => !q.IsAnswered);
                            if (qPart != null)
                            {
                                var res = comp.Result;
                                if (res.StartsWith("User answered: ", StringComparison.OrdinalIgnoreCase))
                                {
                                    res = res.Substring("User answered: ".Length).Trim();
                                }
                                qPart.Answer = res;
                            }
                        }
                        StateHasChanged();
                        break;

                    case IdeationStreamUpdateKind.QuestionAsked when update.Question != null:
                        Session.PendingQuestion = update.Question;
                        _questionAnswer = string.Empty;
                        if (!Session.CurrentParts.OfType<QuestionContentPart>().Any(q => q.QuestionId == update.Question.Id))
                        {
                            Session.CurrentParts.Add(new QuestionContentPart
                            {
                                QuestionId = update.Question.Id,
                                Prompt = update.Question.Prompt,
                                Rationale = update.Question.Rationale,
                                Options = update.Question.Options ?? Array.Empty<string>()
                            });
                        }
                        StateHasChanged();
                        await ScrollChatToBottomAsync();
                        break;

                    case IdeationStreamUpdateKind.ProposalDiscovered when update.Proposal != null:
                        discoveredProposalsThisTurn.Add(update.Proposal);
                        var newVm = IdeationProposalViewModel.FromProposal(update.Proposal, _workspaceTasks);
                        if (!Session.Proposals.Any(p => string.Equals(p.Title, newVm.Title, StringComparison.OrdinalIgnoreCase)))
                        {
                            Session.Proposals.Add(newVm);
                            ToastService.Show("New Proposal Discovered", newVm.Title, ToastLevel.Info);
                            StateHasChanged();
                        }
                        break;

                    case IdeationStreamUpdateKind.Completed when update.FinalResult != null:
                        Session.LatestTranscriptPath = update.FinalResult.TranscriptPath;
                        Session.LatestFullTranscriptMarkdown = update.FinalResult.FullTranscriptMarkdown;

                        if (update.FinalResult.ProposedTasks != null)
                        {
                            foreach (var p in update.FinalResult.ProposedTasks)
                            {
                                if (!discoveredProposalsThisTurn.Any(d => string.Equals(d.Title, p.Title, StringComparison.OrdinalIgnoreCase)))
                                {
                                    discoveredProposalsThisTurn.Add(p);
                                }

                                if (!Session.Proposals.Any(existing => string.Equals(existing.Title, p.Title, StringComparison.OrdinalIgnoreCase)))
                                {
                                    Session.Proposals.Add(IdeationProposalViewModel.FromProposal(p, _workspaceTasks));
                                }
                            }
                        }
                        break;
                }
            }

            var toolsForMessage = Session.CurrentToolCalls.Count > 0
                ? Session.CurrentToolCalls.Select(t => new IdeationToolCallViewModel
                {
                    ToolCallId = t.ToolCallId,
                    ToolName = t.ToolName,
                    Arguments = t.Arguments,
                    Result = t.Result,
                    IsCompleted = t.IsCompleted,
                    IsError = t.IsError,
                    DurationMs = t.DurationMs
                }).ToList()
                : null;

            foreach (var qp in Session.CurrentParts.OfType<QuestionContentPart>().Where(q => !q.IsAnswered))
            {
                qp.Answer = "(No answer provided)";
            }

            var partsForMessage = Session.CurrentParts.Count > 0
                ? Session.CurrentParts.ToList()
                : null;

            if (!string.IsNullOrEmpty(Session.CurrentMessageBuffer) || !string.IsNullOrEmpty(Session.CurrentThinkingBuffer) || (toolsForMessage != null && toolsForMessage.Count > 0) || (partsForMessage != null && partsForMessage.Count > 0))
            {
                Session.Messages.Add(new ChatMessage(
                    "assistant",
                    Session.CurrentMessageBuffer,
                    string.IsNullOrEmpty(Session.CurrentThinkingBuffer) ? null : Session.CurrentThinkingBuffer,
                    DateTime.UtcNow,
                    toolsForMessage,
                    partsForMessage));

                if (Session.ActiveConversationId.HasValue)
                {
                    if (Session.CurrentToolCalls.Count > 0)
                    {
                        foreach (var tc in Session.CurrentToolCalls)
                        {
                            await TaskRepository.AddConversationTurnAsync(
                                Session.ActiveConversationId.Value,
                                StageTurnRole.ToolResult,
                                content: tc.Result,
                                toolName: tc.ToolName,
                                toolArguments: tc.Arguments,
                                toolResult: tc.Result,
                                durationMs: tc.DurationMs,
                                isError: tc.IsError,
                                cancellationToken: CancellationToken.None);
                        }
                    }

                    string? metadataJson = null;
                    if (discoveredProposalsThisTurn.Count > 0)
                    {
                        metadataJson = System.Text.Json.JsonSerializer.Serialize(discoveredProposalsThisTurn);
                    }

                    await TaskRepository.AddConversationTurnAsync(
                        Session.ActiveConversationId.Value,
                        StageTurnRole.Assistant,
                        content: Session.CurrentMessageBuffer,
                        thinkingTrace: string.IsNullOrEmpty(Session.CurrentThinkingBuffer) ? null : Session.CurrentThinkingBuffer,
                        metadataJson: metadataJson,
                        cancellationToken: CancellationToken.None);
                }
            }
        }
        catch (OperationCanceledException)
        {
            ToastService.Show("Generation Cancelled", "Exploration agent stopped.", ToastLevel.Warning);
            foreach (var qp in Session.CurrentParts.OfType<QuestionContentPart>().Where(q => !q.IsAnswered))
            {
                qp.Answer = "(Cancelled)";
            }

            var toolsForMessage = Session.CurrentToolCalls.Count > 0
                ? Session.CurrentToolCalls.Select(t => new IdeationToolCallViewModel
                {
                    ToolCallId = t.ToolCallId,
                    ToolName = t.ToolName,
                    Arguments = t.Arguments,
                    Result = t.Result,
                    IsCompleted = t.IsCompleted,
                    IsError = t.IsError,
                    DurationMs = t.DurationMs
                }).ToList()
                : null;

            var partsForMessage = Session.CurrentParts.Count > 0
                ? Session.CurrentParts.ToList()
                : null;

            if (!string.IsNullOrEmpty(Session.CurrentMessageBuffer) || (toolsForMessage != null && toolsForMessage.Count > 0))
            {
                Session.Messages.Add(new ChatMessage(
                    "assistant",
                    Session.CurrentMessageBuffer + "\n\n*(Generation stopped by user)*",
                    string.IsNullOrEmpty(Session.CurrentThinkingBuffer) ? null : Session.CurrentThinkingBuffer,
                    DateTime.UtcNow,
                    toolsForMessage,
                    partsForMessage));

                if (Session.ActiveConversationId.HasValue)
                {
                    await TaskRepository.AddConversationTurnAsync(
                        Session.ActiveConversationId.Value,
                        StageTurnRole.Assistant,
                        content: Session.CurrentMessageBuffer + "\n\n*(Generation stopped by user)*",
                        thinkingTrace: string.IsNullOrEmpty(Session.CurrentThinkingBuffer) ? null : Session.CurrentThinkingBuffer,
                        cancellationToken: CancellationToken.None);
                }
            }
        }
        catch (Exception ex)
        {
            ToastService.Show("Generation Error", ex.Message, ToastLevel.Error);
        }
        finally
        {
            Session.PendingQuestion?.Cancel();
            Session.PendingQuestion = null;
            Session.IsGenerating = false;
            Session.CurrentThinkingBuffer = string.Empty;
            Session.CurrentMessageBuffer = string.Empty;
            Session.CurrentToolCalls.Clear();
            Session.CurrentParts.Clear();
            StateHasChanged();
            await ScrollChatToBottomAsync();
        }
    }

    private Task CancelGenerationAsync()
    {
        try
        {
            _cts?.Cancel();
        }
        catch
        {
            // Ignored
        }
        return Task.CompletedTask;
    }

    private async Task ResetSession()
    {
        _cts?.Cancel();
        var ws = WorkspaceState.ActiveWorkspace;
        if (ws != null)
        {
            if (Session.ActiveConversationId.HasValue)
            {
                await TaskRepository.CompleteConversationAsync(
                    Session.ActiveConversationId.Value,
                    StageExecutionStatus.Completed,
                    summary: "Session archived by user via Clear Chat.");
            }

            var newConv = await TaskRepository.StartIdeationConversationAsync(
                ws.Id,
                title: $"Discovery Chat #{DateTime.UtcNow:MMdd-HHmm}");

            Session.Reset();
            Session.BoundWorkspaceId = ws.Id;
            Session.ActiveConversationId = newConv.Id;
            Session.ActiveConversationTitle = newConv.Title;

            _workspaceSessions = await TaskRepository.GetIdeationConversationsAsync(ws.Id);
            ToastService.Show("New Session Started", "Previous session archived and fresh chat initialized.", ToastLevel.Info);
        }
        else
        {
            Session.Reset();
        }

        _userInput = string.Empty;
        _ = ScrollChatToBottomAsync(true);
        StateHasChanged();
    }

    private async Task AddProposalToBacklogAsync(IdeationProposalViewModel proposal)
    {
        var workspace = WorkspaceState.ActiveWorkspace;
        if (workspace == null) return;

        try
        {
            int? workflowId = workspace.DefaultWorkflowId;
            if (!workflowId.HasValue || workflowId.Value <= 0)
            {
                try
                {
                    var defaultWorkflow = await WorkflowRepository.GetDefaultWorkflowWithStagesAsync();
                    workflowId = defaultWorkflow?.Id;
                }
                catch
                {
                    // Default fallback
                }
            }

            var newTask = new ForgeTask
            {
                WorkspaceId = workspace.Id,
                WorkflowId = workflowId,
                Title = proposal.Title.Trim(),
                Description = proposal.Description.Trim(),
                Status = TaskOverallStatus.Suggested,
                Priority = proposal.Priority,
                MergeMode = MergeMode.ManualReviewRequired,
                BaseBranch = string.IsNullOrWhiteSpace(workspace.DefaultBaseBranch) ? "main" : workspace.DefaultBaseBranch,
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            };

            var created = await TaskRepository.CreateAsync(newTask, proposal.SelectedDependencyIds);
            created.FeatureBranch = $"feature/task-{created.Id}";
            await TaskRepository.UpdateAsync(created, proposal.SelectedDependencyIds);

            // Sync markdown task file to docs/tasks/
            if (!string.IsNullOrWhiteSpace(workspace.RepositoryPath) && Directory.Exists(workspace.RepositoryPath))
            {
                try
                {
                    await MarkdownSync.SyncTaskToDiskAsync(created, workspace.RepositoryPath, proposal.SelectedDependencyIds);
                }
                catch (Exception syncEx)
                {
                    ToastService.Show("Markdown Sync Warning", $"Created task #{created.Id} in DB but failed writing markdown: {syncEx.Message}", ToastLevel.Warning);
                }
            }

            proposal.IsAdded = true;
            proposal.CreatedTaskId = created.Id;

            // Refresh existing workspace tasks so subsequent proposals can link to this new task
            _workspaceTasks = await TaskRepository.GetByWorkspaceIdAsync(workspace.Id);

            foreach (var pending in Session.Proposals.Where(p => !p.IsAdded))
            {
                pending.ResolveDependencies(_workspaceTasks);
            }

            ToastService.Show("Added to Backlog", $"ForgeTask #{created.Id} created with status Suggested.", ToastLevel.Success);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ToastService.Show("Creation Error", $"Failed to add proposal to backlog: {ex.Message}", ToastLevel.Error);
        }
    }

    private async Task AddAllProposalsToBacklogAsync()
    {
        var pendingProposals = Session.Proposals.Where(p => !p.IsAdded && !string.IsNullOrWhiteSpace(p.Title)).ToList();
        if (pendingProposals.Count == 0) return;

        int addedCount = 0;
        foreach (var proposal in pendingProposals)
        {
            await AddProposalToBacklogAsync(proposal);
            if (proposal.IsAdded)
            {
                addedCount++;
            }
        }

        ToastService.Show("All Proposals Ingested", $"Successfully added {addedCount} proposal(s) sequentially into the backlog.", ToastLevel.Success);
    }

    private void DismissProposal(IdeationProposalViewModel proposal)
    {
        Session.RemoveProposal(proposal);
        ToastService.Show("Proposal Dismissed", $"Proposal '{proposal.Title}' removed.", ToastLevel.Info);
    }


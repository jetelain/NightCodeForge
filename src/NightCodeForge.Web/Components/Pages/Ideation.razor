    private static string GetToolIcon(string toolName) => toolName.ToLowerInvariant() switch
    {
        "bash" or "run_command" or "exec" or "cmd" => "⚡",
        "read" or "read_file" or "view_file" or "cat" => "📄",
        "write" or "edit" or "write_file" or "replace_file_content" => "✏️",
        "grep_search" or "find_files" or "find" => "🔍",
        "list_dir" or "ls" => "📁",
        "web_search" => "🌐",
        "propose_tasks" => "📋",
        "ask" => "❓",
        _ => "⚙️"
    };

    private static string GetToolSummary(string? argumentsJson)
    {
        if (string.IsNullOrWhiteSpace(argumentsJson)) return string.Empty;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(argumentsJson);
            var root = doc.RootElement;
            if (root.ValueKind == System.Text.Json.JsonValueKind.Object)
            {
                if (root.TryGetProperty("command", out var cmd)) return $"({TruncateString(cmd.GetString(), 45)})";
                if (root.TryGetProperty("path", out var path)) return $"({TruncateString(path.GetString(), 45)})";
                if (root.TryGetProperty("query", out var query)) return $"(\"{TruncateString(query.GetString(), 35)}\")";
                if (root.TryGetProperty("prompt", out var prompt)) return $"(\"{TruncateString(prompt.GetString(), 35)}\")";
            }
        }
        catch { }
        return string.Empty;
    }

    private static string TruncateString(string? value, int maxLen)
    {
        if (string.IsNullOrEmpty(value)) return string.Empty;
        return value.Length <= maxLen ? value : value[..maxLen] + "...";
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        WorkspaceState.OnWorkspaceChanged -= HandleWorkspaceChanged;
        Session.OnChange -= HandleSessionChanged;
        try
        {
            _ = JS.InvokeVoidAsync("NightCodeForge.disposeAutoScroll", "chatMessagesContainer");
        }
        catch
        {
            // Circuit may already be disconnected
        }
    }

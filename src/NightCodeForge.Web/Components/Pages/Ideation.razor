@page "/ideation"
@page "/w/{WorkspaceId:int}/ideation"
@inject WorkspaceStateService WorkspaceState
@inject ToastService ToastService
@inject IdeationSessionState Session
@inject IJSRuntime JS
@inject ILogger<Ideation> Logger
@inject MemoryUpdateTracker MemoryTracker
@using NightCodeForge.Core.Domain
@using NightCodeForge.Core.Interfaces
@using NightCodeForge.Core.Memory
@using NightCodeForge.Web.Components.Memory
@using NightCodeForge.Web.Components.Transcripts
@using NightCodeForge.Web.Services
@implements IDisposable

<PageTitle>Ideation Chat - NightCodeForge</PageTitle>

<div class="ideation-page-layout">
    <!-- Page Header & Agent Config Toolbar -->
    <div class="ideation-header">
        <div class="ideation-header-title">
            <span class="ideation-title-icon">💡</span>
            <div>
                <h1>Ideation &amp; Codebase Discovery Chat</h1>
                <p>Interactive requirement elicitation, architecture brainstorming, and automatic backlog task formulation.</p>
            </div>
        </div>
        <div class="ideation-header-status">
            <button type="button" id="ideation-memory-btn" class="forge-btn-ghost" title="Inspect and manage agent memory" @onclick="OpenMemoryDrawer">
                @MemoryUiConstants.BadgeLabel
                @if (MemoryUpdateCount > 0)
                {
                    <span class="forge-badge badge-indigo" id="ideation-memory-indicator" data-testid="memory-indicator">@MemoryUpdateCount</span>
                }
            </button>
            @if (Session.WorkspaceSessions.Count > 0)
            {
                <div class="session-dropdown-container">
                    <select class="form-control-dark session-select"
                            value="@Session.ActiveConversationId"
                            @onchange="HandleSessionSelectedAsync"
                            disabled="@Session.IsGenerating"
                            title="Switch Ideation Session">
                        @foreach (var s in Session.WorkspaceSessions)
                        {
                            <option value="@s.Id">
                                @(s.Status == StageExecutionStatus.Running ? "🟢" : "📁") @(string.IsNullOrWhiteSpace(s.Title) ? $"Session #{s.Id}" : s.Title) (@s.StartedAt.ToLocalTime().ToString("MMM d, HH:mm"))
                            </option>
                        }
                    </select>
                </div>
            }

            <span class="forge-badge @(Session.IsGenerating ? "badge-indigo" : "badge-agentic")">
                <span class="status-dot @(Session.IsGenerating ? "running" : "idle")"></span>
                @(Session.IsGenerating ? "Architect Deliberating..." : "Architect Agent Ready")
            </span>
            <span class="forge-badge @(Session.SelectedRoutingTarget == OllamaRoutingTarget.Local ? "badge-teal" : (Session.SelectedRoutingTarget == OllamaRoutingTarget.Remote ? "badge-indigo" : (Session.SelectedRoutingTarget == OllamaRoutingTarget.Cloud ? "badge-amber" : "badge-gray")))" 
                  title="OllamaRouter Target Backend (Click ⚙️ Config to change)">
                @switch (Session.SelectedRoutingTarget)
                {
                    case OllamaRoutingTarget.Local:
                        <text>🖥️ Host GPU</text>
                        break;
                    case OllamaRoutingTarget.Remote:
                        <text>🌐 LAN Server</text>
                        break;
                    case OllamaRoutingTarget.Cloud:
                        <text>☁️ Cloud Overflow</text>
                        break;
                    default:
                        <text>🔀 Auto Target</text>
                        break;
                }
            </span>
            @if (Session.ActiveSessionCost.HasCostData)
            {
                <span class="forge-badge badge-neutral font-mono" title="@TaskCostPresentationHelper.BuildCostBreakdownTooltip(Session.ActiveSessionCost)">
                    💰 @TaskCostPresentationHelper.FormatCost(Session.ActiveSessionCost.TotalCost, Session.ActiveSessionCost.Currency)
                </span>
            }
            <button type="button" 
                    class="forge-btn forge-btn-secondary transcript-btn" 
                    @onclick="OpenTranscriptModal"
                    title="View Full Execution Transcript">
                📄 Transcript
            </button>
            <button type="button" 
                    class="forge-btn forge-btn-secondary prompt-config-toggle-btn" 
                    @onclick="() => _showCustomPromptConfig = !_showCustomPromptConfig"
                    title="Customize System Prompt &amp; Inference Target">
                ⚙️ Config
            </button>
        </div>
    </div>

    @if (_showTranscriptModal)
    {
        <div class="transcript-modal-overlay" @onclick="() => _showTranscriptModal = false">
            <div class="transcript-modal-dialog" @onclick:stopPropagation="true">
                <div class="transcript-modal-header">
                    <div class="transcript-modal-title">
                        <span style="font-size: 1.25rem;">📄</span>
                        <h3>Ideation Session Transcript</h3>
                        @if (!string.IsNullOrEmpty(Session.LatestTranscriptPath))
                        {
                            <span class="transcript-path-badge font-mono">@Path.GetFileName(Session.LatestTranscriptPath)</span>
                        }
                    </div>
                    <button type="button" class="forge-btn forge-btn-secondary close-btn" @onclick="() => _showTranscriptModal = false">✕</button>
                </div>
                <div class="transcript-modal-body">
                    @if (!string.IsNullOrWhiteSpace(Session.LatestFullTranscriptMarkdown))
                    {
                        <div class="transcript-actions-bar">
                            <button type="button" class="forge-btn forge-btn-secondary btn-sm" @onclick="CopyTranscriptAsync">
                                📋 Copy Markdown
                            </button>
                            @if (!string.IsNullOrEmpty(Session.LatestTranscriptPath))
                            {
                                <span class="font-mono text-muted" style="font-size: 0.75rem;">File: @Session.LatestTranscriptPath</span>
                            }
                        </div>
                        <pre class="transcript-pre font-mono">@Session.LatestFullTranscriptMarkdown</pre>
                    }
                    else
                    {
                        <div class="text-muted" style="padding: 2rem; text-align: center;">
                            No transcript generated yet for this session. Send a message to the architect agent to generate a full turn-by-turn markdown transcript.
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Optional Custom System Prompt & OllamaRouter Target Config Accordion -->
    @if (_showCustomPromptConfig)
    {
        <div class="system-prompt-card">
            <div class="system-prompt-header">
                <span class="system-prompt-title">Custom Architect System Prompt (Optional)</span>
                <span class="font-mono text-muted" style="font-size: 0.75rem;">Overrides default discovery instructions</span>
            </div>
            <textarea class="form-control-dark font-mono system-prompt-textarea" 
                      rows="2" 
                      @bind="Session.CustomSystemPrompt"
                      @bind:after="HandleConfigChangedAsync"
                      placeholder="e.g. Focus exclusively on performance optimizations in src/NightCodeForge.Core..."></textarea>
            
            <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border-subtle); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                <div style="flex: 1; min-width: 260px;">
                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
                        <span style="font-size: 1.1rem;">🔀</span>
                        <strong style="font-size: 0.92rem; color: var(--text-primary);">OllamaRouter Target Backend</strong>
                    </div>
                    <p style="margin: 0; font-size: 0.82rem; color: var(--text-secondary); line-height: 1.4;">
                        Select <strong>Host GPU</strong> to chat concurrently without waiting if a background task is occupying the LAN server. Select <strong>Cloud Overflow</strong> for complex chats with zero local VRAM.
                    </p>
                </div>
                <select class="forge-input font-mono"
                        style="width: auto; min-width: 280px; padding: 0.45rem 0.75rem; font-size: 0.88rem;"
                        @bind="Session.SelectedRoutingTarget"
                        @bind:after="HandleConfigChangedAsync">
                    <option value="@OllamaRoutingTarget.Auto">🔀 Auto (Dynamic Routing)</option>
                    <option value="@OllamaRoutingTarget.Local">🖥️ Host GPU (Concurrent Workstation Execution)</option>
                    <option value="@OllamaRoutingTarget.Remote">🌐 LAN GPU Server (Dedicated High-VRAM)</option>
                    <option value="@OllamaRoutingTarget.Cloud">☁️ Cloud Overflow (Zero Local VRAM / No Waiting)</option>
                </select>
            </div>

            <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border-subtle); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                <div style="flex: 1; min-width: 260px;">
                    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
                        <span style="font-size: 1.1rem;">🧠</span>
                        <strong style="font-size: 0.92rem; color: var(--text-primary);">Model Override (Optional)</strong>
                    </div>
                    <p style="margin: 0; font-size: 0.82rem; color: var(--text-secondary); line-height: 1.4;">
                        Override the workspace's configured Ideation model for this session (leave blank for workspace profile default).
                    </p>
                </div>
                <input id="ideation-model-override-input"
                       type="text"
                       class="forge-input font-mono"
                       style="width: auto; min-width: 280px; padding: 0.45rem 0.75rem; font-size: 0.88rem;"
                       @bind="Session.SelectedModelOverride"
                       @bind:after="HandleConfigChangedAsync"
                       placeholder="Workspace profile default"
                       aria-label="Ideation Model Override" />
            </div>
        </div>
    }

    @if (WorkspaceState.ActiveWorkspace == null)
    {
        <div style="margin-bottom: 1.5rem;">
            <WorkspaceEmptyStateHero />
        </div>
    }

    <!-- Mobile Pane Switcher (visible < 768px) -->
    <div class="ideation-mobile-switcher" role="tablist" aria-label="Ideation panes">
        <button type="button" role="tab" id="ideation-tab-chat" class="ideation-switch-btn @(_mobilePane == IdeationMobilePane.Chat ? "active" : "")" aria-selected="@(_mobilePane == IdeationMobilePane.Chat ? "true" : "false")" @onclick="() => _mobilePane = IdeationMobilePane.Chat">💬 Chat</button>
        <button type="button" role="tab" id="ideation-tab-proposals" class="ideation-switch-btn @(_mobilePane == IdeationMobilePane.Proposals && _activeSideTab == IdeationSideTab.Proposals ? "active" : "")" aria-selected="@(_mobilePane == IdeationMobilePane.Proposals && _activeSideTab == IdeationSideTab.Proposals ? "true" : "false")" @onclick="() => SelectMobileSideTab(IdeationSideTab.Proposals)">📋 Proposals (@Session.Proposals.Count)</button>
        <button type="button" role="tab" id="ideation-tab-attachments" class="ideation-switch-btn @(_mobilePane == IdeationMobilePane.Proposals && _activeSideTab == IdeationSideTab.Attachments ? "active" : "")" aria-selected="@(_mobilePane == IdeationMobilePane.Proposals && _activeSideTab == IdeationSideTab.Attachments ? "true" : "false")" @onclick="() => SelectMobileSideTab(IdeationSideTab.Attachments)">📎 Attachments (@Session.WorkspaceAttachments.Count)</button>
    </div>

    <!-- Two-Pane Main Workspace Grid -->
    <div class="ideation-grid @(_mobilePane == IdeationMobilePane.Chat ? "mobile-pane-chat" : "mobile-pane-proposals")">
        <!-- LEFT PANE: Conversational Stream & Chat Input (~60%) -->
        <div class="chat-pane">
            <!-- Quick Preset Prompts Bar -->
            <div class="quick-prompts-bar">
                <span class="quick-prompts-label">Quick Prompts:</span>
                <button type="button" class="prompt-chip" @onclick='() => ApplyPresetPrompt("Explore the codebase architecture, project layout, and key entry points.")' disabled="@Session.IsGenerating">
                    🏛️ Explore Architecture
                </button>
                <button type="button" class="prompt-chip" @onclick='() => ApplyPresetPrompt("Scan the repository for unused files, redundant dependencies, or dead code to clean up.")' disabled="@Session.IsGenerating">
                    🔍 Find Dead Code
                </button>
                <button type="button" class="prompt-chip" @onclick='() => ApplyPresetPrompt("Identify technical debt, error handling gaps, and reliability risks, and propose tasks with dependencies.")' disabled="@Session.IsGenerating">
                    🛡️ Propose Tech Debt
                </button>
                <button type="button" class="prompt-chip" @onclick='() => ApplyPresetPrompt("Help me plan and break down a new feature into modular, incremental backlog tasks with clear acceptance criteria.")' disabled="@Session.IsGenerating">
                    ✨ Plan New Feature
                </button>
            </div>

            <!-- Scrollable Message Transcript -->
            <div class="chat-messages-wrapper">
                <div id="@ChatPresentationHelper.ChatMessagesContainerId" class="chat-messages-container">
                @if (Session.Messages.Count == 0 && !Session.IsGenerating)
                {
                    <div class="chat-empty-state">
                        <div class="chat-empty-icon">💡</div>
                        <div class="chat-empty-title">Codebase Discovery &amp; Ideation</div>
                        <p class="chat-empty-desc">
                            Ask architectural questions, explore code structure with read-only tools, or brainstorm new features.
                            Any backlog tasks formulated by the agent will appear in the <strong>Discovered Proposals</strong> panel.
                        </p>
                        @if (WorkspaceState.ActiveWorkspace == null)
                        {
                            <div class="workspace-warning-callout">
                                ⚠️ No active workspace selected. Please select a workspace from the top bar to begin.
                            </div>
                        }
                    </div>
                }

                @foreach (var msg in Session.Messages)
                {
                    <div class="chat-bubble @(msg.Role.ToLowerInvariant())">
                        <div class="chat-avatar">
                            @(msg.Role.Equals("user", StringComparison.OrdinalIgnoreCase) ? "👤" : "💡")
                        </div>
                        <div class="chat-bubble-body">
                            <div class="chat-bubble-header">
                                <span class="chat-author">@(msg.Role.Equals("user", StringComparison.OrdinalIgnoreCase) ? "You" : "Architect Agent")</span>
                                @if (msg.Timestamp.HasValue)
                                {
                                    <span class="chat-timestamp font-mono">@msg.Timestamp.Value.ToLocalTime().ToString("HH:mm:ss")</span>
                                }
                            </div>

                            @if (msg.Parts != null && msg.Parts.Count > 0)
                            {
                                @foreach (var part in msg.Parts)
                                {
                                    if (part is ThinkingContentPart thinkPart && !string.IsNullOrWhiteSpace(thinkPart.Thinking))
                                    {
                                        <details class="think-trace">
                                            <summary>
                                                <span>🧠 Reasoning Trace</span>
                                                <span class="font-mono text-muted">(@thinkPart.Thinking.Length chars)</span>
                                            </summary>
                                            <div class="think-content font-mono">@thinkPart.Thinking</div>
                                        </details>
                                    }
                                    else if (part is ToolCallContentPart tcp)
                                    {
                                        var tool = tcp.ToolCall;
                                        var memoryTarget = MemoryPresentationHelper.TryGetToolTarget(tool.ToolName, tool.Arguments, tool.Result, tool.IsError);
                                        <IdeationToolCall ToolName="@tool.ToolName"
                                                      Arguments="@tool.Arguments"
                                                      Result="@tool.Result"
                                                      IsError="@tool.IsError"
                                                      Offset="@($"{tool.DurationMs}ms")"
                                                      MemoryBadgeText="@memoryTarget?.BadgeText"
                                                      MemoryBadgeTooltip="@memoryTarget?.BadgeTooltip"
                                                      OnMemoryBadgeClick="@(() => OpenMemoryDrawerForTarget(memoryTarget))" />
                                    }
                                    else if (part is QuestionContentPart qp)
                                    {
                                        <div class="turn-ask-tool" style="width: 100%;">
                                            <AgentQuestionTurnCard Questions="@qp.EffectiveQuestions"
                                                                   Answer="@qp.Answer"
                                                                   MetadataJson="@qp.MetadataJson"
                                                                   IsWaitingForAnswer="@(!qp.IsAnswered)"
                                                                   RequireAllAnswers="true"
                                                                   SubmitButtonText="@IdeationPresentationHelper.GetSubmitButtonLabel(qp.EffectiveQuestions.Count)"
                                                                   HelperText="⚡ Submitting will resume architect agent deliberation."
                                                                   OnBatchAnswersSubmitted="@(ans => HandleQuestionGroupAnswersSubmittedAsync(qp, ans))"
                                                                   OnAnswerSubmitted="@(ans => HandleQuestionGroupSingleAnswerSubmittedAsync(qp, ans))" />
                                        </div>
                                    }
                                    else if (part is OptimizationContentPart optPart)
                                    {
                                        <div class="compaction-notice-part text-muted font-mono">
                                            <span>🗜️ @optPart.Summary</span>
                                        </div>
                                    }
                                    else if (part is VisualInspectionContentPart visualPart)
                                    {
                                        <div class="visual-inspection-part">
                                            <span class="forge-badge badge-teal visual-inspection-badge">@VisionConstants.VisionBadgeLabel Inspection</span>
                                            @foreach (var imgRef in visualPart.Images)
                                            {
                                                <span class="forge-chip font-mono visual-image-ref-chip">
                                                    <span>🖼️ @(string.IsNullOrWhiteSpace(imgRef.SourcePath) ? imgRef.MediaType : imgRef.SourcePath)</span>
                                                    @if (imgRef.WidthPx is > 0 && imgRef.HeightPx is > 0)
                                                    {
                                                        <span class="text-muted">(@(imgRef.WidthPx)x@(imgRef.HeightPx), @imgRef.MediaType)</span>
                                                    }
                                                </span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(visualPart.Summary))
                                            {
                                                <span class="text-secondary">@visualPart.Summary</span>
                                            }
                                        </div>
                                    }
                                    else if (part is TextContentPart textPart && !string.IsNullOrWhiteSpace(textPart.Text))
                                    {
                                        <div class="chat-content-wrap">
                                            <MarkdownRenderer Content="@textPart.Text" />
                                        </div>
                                    }
                                }
                            }
                            else
                            {
                                @if (!string.IsNullOrEmpty(msg.ThinkingTrace))
                                {
                                    <details class="think-trace">
                                        <summary>
                                            <span>🧠 Reasoning Trace</span>
                                            <span class="font-mono text-muted">(@msg.ThinkingTrace.Length chars)</span>
                                        </summary>
                                        <div class="think-content font-mono">@msg.ThinkingTrace</div>
                                    </details>
                                }

                                @if (msg.ToolCalls != null && msg.ToolCalls.Count > 0)
                                {
                                    <div class="tool-calls-list">
                                        @foreach (var tool in msg.ToolCalls)
                                        {
                                            var memoryTarget = MemoryPresentationHelper.TryGetToolTarget(tool.ToolName, tool.Arguments, tool.Result, tool.IsError);
                                            <IdeationToolCall ToolName="@tool.ToolName"
                                                          Arguments="@tool.Arguments"
                                                          Result="@tool.Result"
                                                          IsError="@tool.IsError"
                                                          Offset="@($"{tool.DurationMs}ms")"
                                                          MemoryBadgeText="@memoryTarget?.BadgeText"
                                                          MemoryBadgeTooltip="@memoryTarget?.BadgeTooltip"
                                                          OnMemoryBadgeClick="@(() => OpenMemoryDrawerForTarget(memoryTarget))" />
                                        }
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(msg.Content))
                                {
                                    <div class="chat-content-wrap">
                                        <MarkdownRenderer Content="@msg.Content" />
                                    </div>
                                }
                            }

                            @if (msg.AttachmentChips is { Count: > 0 })
                            {
                                <div class="message-attachment-chips">
                                    @foreach (var chip in msg.AttachmentChips)
                                    {
                                        <button type="button"
                                                class="forge-chip attachment-chip @(chip.AttachmentId.HasValue ? "clickable" : "")"
                                                @onclick="() => HandleChipClick(chip)"
                                                disabled="@(!chip.AttachmentId.HasValue)"
                                                title="@chip.SourceRef">
                                            @if (!string.IsNullOrWhiteSpace(chip.ThumbnailDataUri))
                                            {
                                                <img src="@chip.ThumbnailDataUri" alt="@chip.Title" class="attachment-chip-thumb" style="width: 24px; height: 24px; object-fit: cover; border-radius: 3px;" />
                                            }
                                            @if (chip.AttachmentId.HasValue)
                                            {
                                                <span class="font-mono">#@chip.AttachmentId</span>
                                            }
                                            <span class="attachment-chip-title">@chip.Title</span>
                                            <span class="forge-badge @AttachmentPresentationHelper.GetIntakeStatusBadgeClass(chip.Status) font-mono attachment-status-badge">
                                                @AttachmentPresentationHelper.FormatIntakeStatusLabel(chip.Status)
                                            </span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Active Live Streaming Bubble -->
                @if (Session.IsGenerating)
                {
                    <div class="chat-bubble assistant streaming">
                        <div class="chat-avatar">💡</div>
                        <div class="chat-bubble-body">
                            <div class="chat-bubble-header">
                                <span class="chat-author">Architect Agent</span>
                                <span class="forge-badge badge-indigo live-badge">Streaming</span>
                            </div>

                            @if (Session.CurrentParts.Count > 0)
                            {
                                @foreach (var part in Session.CurrentParts)
                                {
                                    if (part is ThinkingContentPart thinkPart && !string.IsNullOrWhiteSpace(thinkPart.Thinking))
                                    {
                                        <details class="think-trace" open>
                                            <summary>
                                                <span>🧠 Reasoning Trace</span>
                                                @if (part == Session.CurrentParts.LastOrDefault())
                                                {
                                                    <span class="status-dot running" style="margin-left: 0.25rem;"></span>
                                                }
                                            </summary>
                                            <div class="think-content font-mono">@thinkPart.Thinking @(part == Session.CurrentParts.LastOrDefault() ? "▌" : "")</div>
                                        </details>
                                    }
                                    else if (part is ToolCallContentPart toolPart)
                                    {
                                        var tool = toolPart.ToolCall;
                                        var memoryTarget = MemoryPresentationHelper.TryGetToolTarget(tool.ToolName, tool.Arguments, tool.Result, tool.IsError);
                                        <IdeationToolCall ToolName="@tool.ToolName"
                                                      Arguments="@tool.Arguments"
                                                      Result="@tool.Result"
                                                      IsError="@tool.IsError"
                                                      IsRunning="@(!tool.IsCompleted)"
                                                      Offset="@($"{tool.DurationMs}ms")"
                                                      MemoryBadgeText="@memoryTarget?.BadgeText"
                                                      MemoryBadgeTooltip="@memoryTarget?.BadgeTooltip"
                                                      OnMemoryBadgeClick="@(() => OpenMemoryDrawerForTarget(memoryTarget))" />
                                    }
                                    else if (part is QuestionContentPart qp)
                                    {
                                        <div class="turn-ask-tool" style="width: 100%;">
                                            <AgentQuestionTurnCard Questions="@qp.EffectiveQuestions"
                                                                   Answer="@qp.Answer"
                                                                   MetadataJson="@qp.MetadataJson"
                                                                   IsWaitingForAnswer="@(!qp.IsAnswered)"
                                                                   RequireAllAnswers="true"
                                                                   SubmitButtonText="@IdeationPresentationHelper.GetSubmitButtonLabel(qp.EffectiveQuestions.Count)"
                                                                   HelperText="⚡ Submitting will resume architect agent deliberation."
                                                                   OnBatchAnswersSubmitted="@(ans => HandleQuestionGroupAnswersSubmittedAsync(qp, ans))"
                                                                   OnAnswerSubmitted="@(ans => HandleQuestionGroupSingleAnswerSubmittedAsync(qp, ans))" />
                                        </div>
                                    }
                                    else if (part is OptimizationContentPart optPart)
                                    {
                                        <div class="compaction-notice-part text-muted font-mono">
                                            <span>🗜️ @optPart.Summary</span>
                                        </div>
                                    }
                                    else if (part is VisualInspectionContentPart visualPart)
                                    {
                                        <div class="visual-inspection-part">
                                            <span class="forge-badge badge-teal visual-inspection-badge">@VisionConstants.VisionBadgeLabel Inspection</span>
                                            @foreach (var imgRef in visualPart.Images)
                                            {
                                                <span class="forge-chip font-mono visual-image-ref-chip">
                                                    <span>🖼️ @(string.IsNullOrWhiteSpace(imgRef.SourcePath) ? imgRef.MediaType : imgRef.SourcePath)</span>
                                                    @if (imgRef.WidthPx is > 0 && imgRef.HeightPx is > 0)
                                                    {
                                                        <span class="text-muted">(@(imgRef.WidthPx)x@(imgRef.HeightPx), @imgRef.MediaType)</span>
                                                    }
                                                </span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(visualPart.Summary))
                                            {
                                                <span class="text-secondary">@visualPart.Summary</span>
                                            }
                                        </div>
                                    }
                                    else if (part is TextContentPart textPart && !string.IsNullOrWhiteSpace(textPart.Text))
                                    {
                                        <div class="chat-content-wrap">
                                            <MarkdownRenderer Content="@textPart.Text" />
                                            @if (part == Session.CurrentParts.LastOrDefault())
                                            {
                                                <span class="cursor-blink">▌</span>
                                            }
                                        </div>
                                    }
                                }
                            }
                            else
                            {
                                <div class="generating-wait-box">
                                    <span class="status-dot running"></span>
                                    <span>Agent is inspecting codebase files and deliberating...</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Scroll to bottom floating button -->
            <button id="@ChatPresentationHelper.ChatScrollToBottomBtnId" 
                    type="button" 
                    class="chat-scroll-bottom-btn" 
                    title="Scroll to latest messages" 
                    aria-label="Scroll to latest messages">
                <span>↓</span>
            </button>
        </div>

            <!-- Chat Input Area -->
            <div class="chat-input-area">
                <div class="ideation-composer-attachments-bar">
                    <label class="forge-btn forge-btn-secondary btn-xs ideation-file-drop-zone"
                           title="Drop or select files to store as workspace attachments">
                        <InputFile id="ideation-attachment-file-input"
                                   class="ideation-input-file"
                                   accept="@AttachmentConstants.HtmlAcceptExtensions"
                                   OnChange="HandleIdeationFileDropAsync"
                                   multiple
                                   disabled="@(Session.IsGenerating || WorkspaceState.ActiveWorkspace == null)" />
                        <span>📎 Drop / Upload File</span>
                    </label>
                    <div class="ideation-host-file-group">
                        <input id="ideation-host-file-input"
                               type="text"
                               class="form-control-dark attach-host-file-input"
                               placeholder="Attach host file path (e.g. C:\dev\poc\router-spikes.md)..."
                               @bind="_hostFilePathInput"
                               @bind:event="oninput"
                               disabled="@(Session.IsGenerating || WorkspaceState.ActiveWorkspace == null)"
                               aria-label="Host File Path" />
                        <button id="btn-attach-host-file"
                                type="button"
                                class="forge-btn forge-btn-secondary btn-xs attach-host-file-btn"
                                @onclick="HandleAttachHostFileAsync"
                                disabled="@(Session.IsGenerating || WorkspaceState.ActiveWorkspace == null || string.IsNullOrWhiteSpace(_hostFilePathInput))">
                            🔗 Attach Host File
                        </button>
                    </div>
                    @if (Session.ActiveVisionStatus?.SupportsVision == true)
                    {
                        <span class="forge-badge badge-teal vision-capability-badge" title="Active model supports image inspection">@VisionConstants.VisionBadgeLabel</span>
                    }
                </div>

                @{
                    var hasPendingOrCitedImages = AttachmentPresentationHelper.HasPendingOrCitedImageAttachments(
                        Session.PendingComposerChips,
                        Session.WorkspaceAttachments,
                        _userInput);
                    var ideationVisionWarning = AttachmentPresentationHelper.BuildTextOnlyImageWarning(
                        Session.ActiveVisionStatus,
                        hasPendingOrCitedImages);
                }
                @if (!string.IsNullOrWhiteSpace(ideationVisionWarning))
                {
                    <div id="ideation-vision-warning" class="forge-alert forge-alert-amber vision-gating-warning" style="margin: 0.45rem 0; padding: 0.5rem 0.75rem; font-size: 0.82rem;">
                        ⚠️ @ideationVisionWarning
                    </div>
                }

                @if (Session.PendingComposerChips.Count > 0)
                {
                    <div class="composer-attachment-chips">
                        @foreach (var chip in Session.PendingComposerChips)
                        {
                            <div class="forge-chip attachment-chip composer-chip">
                                <button type="button"
                                        class="attachment-chip-main-btn"
                                        @onclick="() => HandleChipClick(chip)"
                                        disabled="@(!chip.AttachmentId.HasValue)"
                                        title="@chip.SourceRef">
                                    @if (!string.IsNullOrWhiteSpace(chip.ThumbnailDataUri))
                                    {
                                        <img src="@chip.ThumbnailDataUri" alt="@chip.Title" class="attachment-chip-thumb" style="width: 24px; height: 24px; object-fit: cover; border-radius: 3px;" />
                                    }
                                    @if (chip.AttachmentId.HasValue)
                                    {
                                        <span class="font-mono">#@chip.AttachmentId</span>
                                    }
                                    <span class="attachment-chip-title">@chip.Title</span>
                                    <span class="forge-badge @AttachmentPresentationHelper.GetIntakeStatusBadgeClass(chip.Status) font-mono attachment-status-badge">
                                        @AttachmentPresentationHelper.FormatIntakeStatusLabel(chip.Status)
                                    </span>
                                </button>
                                <button type="button"
                                        class="btn-chip-remove"
                                        @onclick="() => Session.RemovePendingChip(chip)"
                                        aria-label="Remove attachment chip">
                                    ✕
                                </button>
                            </div>
                        }
                    </div>
                }

                <textarea id="@ComposerTextareaElementId"
                          class="form-control-dark chat-textarea" 
                          rows="3" 
                          @bind="_userInput" 
                          @bind:event="oninput" 
                          @onkeydown="HandleKeyDownAsync"
                          placeholder="Ask the Architect agent or describe requirements... (Press Enter to send, Shift+Enter for new line)"
                          disabled="@(Session.IsGenerating || WorkspaceState.ActiveWorkspace == null)"
                          aria-label="Ideation Chat Prompt"></textarea>

                <div class="chat-actions-row">
                    <div class="chat-actions-left">
                        <button type="button" 
                                class="forge-btn forge-btn-secondary reset-session-btn" 
                                @onclick="ResetSession" 
                                disabled="@Session.IsGenerating"
                                title="Clear conversation turns and proposals">
                            🔄 Clear Chat
                        </button>
                        <span class="text-muted font-mono prompt-length-counter">
                            @_userInput.Length chars
                        </span>
                    </div>

                    <div class="chat-actions-right">
                        @if (Session.IsGenerating)
                        {
                            <button type="button" class="forge-btn cancel-btn" @onclick="CancelGenerationAsync">
                                ⏹️ Stop Generating
                            </button>
                        }
                        else
                        {
                            <button type="button" 
                                    class="forge-btn forge-btn-primary send-btn" 
                                    @onclick="SendMessageAsync" 
                                    disabled="@(!AttachmentPresentationHelper.CanSubmitIdeationComposer(_userInput, Session.PendingComposerChips, WorkspaceState.ActiveWorkspace != null, Session.IsGenerating))">
                                🚀 Send
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT PANE: Tabbed Discovered Proposals & Workspace Attachments (~40%) -->
        <div class="proposals-pane">
            <div class="proposals-header">
                <div class="ideation-side-tabs" role="tablist" aria-label="Workspace Side Panel Tabs">
                    <button type="button"
                            role="tab"
                            id="ideation-side-tab-proposals"
                            class="ideation-side-tab-btn @(_activeSideTab == IdeationSideTab.Proposals ? "active" : "")"
                            aria-selected="@(_activeSideTab == IdeationSideTab.Proposals ? "true" : "false")"
                            @onclick="() => _activeSideTab = IdeationSideTab.Proposals">
                        <span>📋 Proposals</span>
                        <span class="forge-badge badge-indigo font-mono">@Session.Proposals.Count</span>
                    </button>
                    <button type="button"
                            role="tab"
                            id="ideation-side-tab-attachments"
                            class="ideation-side-tab-btn @(_activeSideTab == IdeationSideTab.Attachments ? "active" : "")"
                            aria-selected="@(_activeSideTab == IdeationSideTab.Attachments ? "true" : "false")"
                            @onclick="() => _activeSideTab = IdeationSideTab.Attachments">
                        <span>📎 Attachments</span>
                        <span class="forge-badge badge-gray font-mono">@Session.WorkspaceAttachments.Count</span>
                    </button>
                </div>
                @if (_activeSideTab == IdeationSideTab.Proposals)
                {
                    <div class="proposals-header-right">
                        @if (Session.Proposals.Any(p => !p.IsAdded))
                        {
                            <button type="button" 
                                    class="forge-btn forge-btn-xs forge-btn-primary add-all-btn"
                                    @onclick="AddAllProposalsToBacklogAsync"
                                    title="Add all proposals sequentially to backlog">
                                ➕ Ingest All (@Session.Proposals.Count(p => !p.IsAdded))
                            </button>
                        }
                        @if (Session.Proposals.Any(p => p.IsAdded))
                        {
                            <span class="forge-badge badge-teal font-mono">@Session.Proposals.Count(p => p.IsAdded) Ingested</span>
                        }
                    </div>
                }
            </div>

            @if (_activeSideTab == IdeationSideTab.Proposals)
            {
                <div class="proposals-list-scroll">
                    @if (Session.Proposals.Count == 0)
                    {
                        <div class="proposals-empty-box">
                            <div class="proposals-empty-icon">💡</div>
                            <div class="proposals-empty-title">No Proposals Yet</div>
                            <p class="proposals-empty-text">
                                When the Architect Agent discovers backlog opportunities or you ask to formulate tasks, interactive proposal cards will appear here.
                            </p>
                            <div class="proposals-empty-hint">
                                Try asking: <em>"Propose 3 backlog tasks to refactor error handling in src/NightCodeForge.Infrastructure"</em>
                            </div>
                        </div>
                    }
                    else
                    {
                        @foreach (var proposal in Session.Proposals)
                        {
                            <IdeationProposalCard @key="proposal.ClientId" 
                                                  Proposal="proposal" 
                                                  WorkspaceTasks="Session.WorkspaceTasks"
                                                  WorkspaceAttachments="Session.WorkspaceAttachments"
                                                  OnPreviewAttachment="OpenAttachmentPreview"
                                                  OnAddToBacklog="AddProposalToBacklogAsync" 
                                                  OnDismiss="DismissProposalAsync" />
                        }
                    }
                </div>
            }
            else
            {
                <div class="workspace-attachments-panel side-pane-attachments">
                    <div class="workspace-attachments-body">
                        <div class="workspace-attachments-toolbar">
                            <input id="ideation-attachment-search-input"
                                   type="text"
                                   class="form-control-dark workspace-attachments-search"
                                   placeholder="Filter workspace attachments by title, source, or #id..."
                                   @bind="_attachmentSearchQuery"
                                   @bind:event="oninput" />
                        </div>

                        @{
                            var filteredWorkspaceAttachments = AttachmentPresentationHelper.FilterAttachments(
                                Session.WorkspaceAttachments,
                                _attachmentSearchQuery);
                        }

                        @if (filteredWorkspaceAttachments.Count == 0)
                        {
                            <div class="workspace-attachments-empty text-muted">
                                @(Session.WorkspaceAttachments.Count == 0
                                    ? "No workspace attachments yet. Drop/upload a file or attach a host file path from the chat composer."
                                    : "No attachments match the current filter.")
                            </div>
                        }
                        else
                        {
                            <div class="workspace-attachments-list">
                                @foreach (var att in filteredWorkspaceAttachments)
                                {
                                    <div class="workspace-attachment-row" @key="att.Id" data-attachment-id="@att.Id">
                                        <div class="workspace-attachment-info">
                                            <div class="workspace-attachment-title-line">
                                                <span class="font-mono text-secondary">#@att.Id</span>
                                                <span>@AttachmentPresentationHelper.GetContentKindIcon(att.ContentKind)</span>
                                                <strong class="attachment-row-title">@att.Title</strong>
                                                <span class="forge-badge badge-gray attachment-kind-badge">
                                                    @AttachmentPresentationHelper.FormatContentKindLabel(att.ContentKind)
                                                </span>
                                            </div>
                                            <div class="workspace-attachment-meta font-mono text-muted">
                                                <span>@att.SourceRef</span>
                                                <span>•</span>
                                                <span>@AttachmentPresentationHelper.FormatSizeBytes(att.SizeBytes)</span>
                                                <span>•</span>
                                                <span>@att.CreatedAt.ToLocalTime().ToString("g")</span>
                                            </div>
                                        </div>
                                        <div class="workspace-attachment-actions">
                                            <button type="button"
                                                    class="forge-btn forge-btn-secondary btn-xs attachment-cite-btn"
                                                    @onclick="() => CiteAttachmentInChat(att)"
                                                    disabled="@Session.IsGenerating"
                                                    title="Insert @AttachmentPresentationHelper.FormatCitationToken(att.Id) into composer">
                                                💬 Cite in Chat
                                            </button>
                                            <button type="button"
                                                    class="forge-btn forge-btn-secondary btn-xs attachment-preview-btn"
                                                    @onclick="() => OpenAttachmentPreview(att.Id)">
                                                👁️ Preview
                                            </button>
                                            <button type="button"
                                                    class="forge-btn forge-btn-danger btn-xs attachment-delete-btn"
                                                    @onclick="() => OpenAttachmentDeleteConfirm(att.Id)">
                                                🗑️ Delete
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <AttachmentPreviewDrawer IsOpen="_previewAttachmentId.HasValue"
                             AttachmentId="_previewAttachmentId"
                             StartInDeleteConfirmation="_previewStartInDelete"
                             OnClose="CloseAttachmentPreview"
                             OnDeleted="HandleAttachmentDeletedAsync"
                             OnCiteInChat="CiteAttachmentInChat" />
</div>

@if (_memoryDrawerOpen && ActiveMemoryWorkspaceId.HasValue)
{
    <WorkspaceMemoryDrawer WorkspaceId="@ActiveMemoryWorkspaceId.Value"
                           InitialScope="@_memoryScope"
                           InitialRelativePath="@_memoryPath"
                           OnClosed="CloseMemoryDrawer" />
}

@code {
    private bool _memoryDrawerOpen;
    private bool _disposed;
    private AgentMemoryScope _memoryScope = AgentMemoryScope.LocalWorkspace;
    private string? _memoryPath;

    private int? ActiveMemoryWorkspaceId => WorkspaceState.ActiveWorkspaceId;

    private int MemoryUpdateCount => ActiveMemoryWorkspaceId.HasValue ? MemoryTracker.GetCount(ActiveMemoryWorkspaceId.Value) : 0;

    private void OpenMemoryDrawer()
    {
        _memoryScope = AgentMemoryScope.LocalWorkspace;
        _memoryPath = null;
        _memoryDrawerOpen = true;
        if (ActiveMemoryWorkspaceId.HasValue)
        {
            MemoryTracker.Reset(ActiveMemoryWorkspaceId.Value);
        }
    }

    private void OpenMemoryDrawerForTarget(MemoryToolTarget? target)
    {
        if (target == null)
        {
            return;
        }

        _memoryScope = target.Scope;
        _memoryPath = target.RelativePath;
        _memoryDrawerOpen = true;
        if (ActiveMemoryWorkspaceId.HasValue)
        {
            MemoryTracker.Reset(ActiveMemoryWorkspaceId.Value);
        }
    }

    private void CloseMemoryDrawer() => _memoryDrawerOpen = false;

    private void HandleMemoryUpdated(MemoryUpdateNotice notice)
    {
        if (_disposed || notice.WorkspaceId != ActiveMemoryWorkspaceId)
        {
            return;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    [Parameter] public int? WorkspaceId { get; set; }

    [SupplyParameterFromQuery(Name = IdeationRefinementHelper.TaskIdQueryParameter)]
    public int? TaskId { get; set; }

    [SupplyParameterFromQuery(Name = IdeationRefinementHelper.DraftIdQueryParameter)]
    public string? DraftId { get; set; }

    private int? _handledRefinementTaskId;
    private string _userInput = string.Empty;
    private IdeationMobilePane _mobilePane = IdeationMobilePane.Chat;
    private IdeationSideTab _activeSideTab = IdeationSideTab.Proposals;
    private bool _showCustomPromptConfig;
    private string _attachmentSearchQuery = string.Empty;
    private string _hostFilePathInput = string.Empty;
    private int? _previewAttachmentId;
    private bool _previewStartInDelete;
    private bool _showTranscriptModal;
    private const string ComposerTextareaElementId = "ideation-chat-textarea";
    private DotNetObjectReference<Ideation>? _dotNetRef;

    protected override async Task OnInitializedAsync()
    {
        MemoryTracker.OnMemoryUpdated += HandleMemoryUpdated;
        if (WorkspaceId.HasValue)
        {
            WorkspaceState.TryActivateWorkspaceById(WorkspaceId.Value);
        }

        Session.AttachUiDispatcher(InvokeAsync);
        WorkspaceState.OnWorkspaceChanged += HandleWorkspaceChanged;
        Session.OnChange += HandleSessionChanged;
        Session.OnNotification += HandleSessionNotification;
        Session.OnScrollRequested += HandleScrollRequested;

        var result = await Session.ReloadWorkspaceContextAsync(WorkspaceState.ActiveWorkspace, TaskId, DraftId);
        _handledRefinementTaskId = result.HandledTaskId;
        if (!string.IsNullOrEmpty(result.SeedPrompt))
        {
            _userInput = result.SeedPrompt;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        var previousWorkspaceId = WorkspaceState.ActiveWorkspaceId;
        if (WorkspaceId.HasValue)
        {
            WorkspaceState.TryActivateWorkspaceById(WorkspaceId.Value);
        }

        if (!TaskId.HasValue)
        {
            _handledRefinementTaskId = null;
        }

        if (string.IsNullOrWhiteSpace(DraftId))
        {
            Session.ClearDraftDeduplication();
        }

        if (WorkspaceState.ActiveWorkspaceId != previousWorkspaceId)
        {
            return;
        }

        if (TaskId.HasValue && TaskId != _handledRefinementTaskId && WorkspaceState.ActiveWorkspace != null)
        {
            _handledRefinementTaskId = TaskId;
            var (handled, seedPrompt) = await Session.TryInitializeTaskRefinementAsync(WorkspaceState.ActiveWorkspace.Id, TaskId.Value);
            if (handled)
            {
                _userInput = seedPrompt ?? string.Empty;
            }
        }

        if (!string.IsNullOrWhiteSpace(DraftId) && WorkspaceState.ActiveWorkspace != null)
        {
            var (handled, seedPrompt) = await Session.TryInitializeCompanionDraftAsync(WorkspaceState.ActiveWorkspace.Id, DraftId);
            if (handled && !string.IsNullOrEmpty(seedPrompt))
            {
                _userInput = seedPrompt;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync(
                    "NightCodeForge.initAutoScroll",
                    ChatPresentationHelper.ChatMessagesContainerId,
                    ChatPresentationHelper.ChatScrollToBottomBtnId,
                    new { autoScrollOnByDefault = true });
                _dotNetRef ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync(
                    "NightCodeForge.initClipboardImagePaste",
                    ComposerTextareaElementId,
                    _dotNetRef,
                    VisionConstants.MaxVisionImageBytes);
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
            {
                // In non-interactive or test rendering
            }
        }
    }

    private async Task HandleSessionSelectedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var selectedId) && WorkspaceState.ActiveWorkspace != null)
        {
            await Session.SelectSessionAsync(WorkspaceState.ActiveWorkspace.Id, selectedId);
        }
    }

    private void HandleWorkspaceChanged()
    {
        _ = InvokeAsync(async () =>
        {
            var result = await Session.ReloadWorkspaceContextAsync(WorkspaceState.ActiveWorkspace, TaskId, DraftId);
            _handledRefinementTaskId = result.HandledTaskId;
            if (!string.IsNullOrEmpty(result.SeedPrompt))
            {
                _userInput = result.SeedPrompt;
            }

            StateHasChanged();
        });
    }

    private void HandleSessionChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleSessionNotification(string title, string message, ToastLevel level)
    {
        _ = InvokeAsync(() => ToastService.Show(title, message, level));
    }

    private void HandleScrollRequested(bool force)
    {
        _ = InvokeAsync(() => ScrollChatToBottomAsync(force));
    }

    private void ApplyPresetPrompt(string promptText)
    {
        _userInput = promptText;
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            if (AttachmentPresentationHelper.CanSubmitIdeationComposer(
                    _userInput,
                    Session.PendingComposerChips,
                    WorkspaceState.ActiveWorkspace != null,
                    Session.IsGenerating))
            {
                await SendMessageAsync();
            }
        }
    }

    [JSInvokable]
    public Task OnClipboardImagePastedAsync(string fileName, string contentType, string base64Data) =>
        Session.PasteImageFromClipboardAsync(WorkspaceState.ActiveWorkspace, fileName, contentType, base64Data);

    [JSInvokable]
    public Task OnClipboardImageRejectedAsync(string fileName, string errorMessage)
    {
        Session.ReportClipboardImageError(fileName, errorMessage);
        return Task.CompletedTask;
    }

    private Task HandleQuestionGroupAnswersSubmittedAsync(QuestionContentPart qp, IReadOnlyDictionary<int, string> answersByIndex) =>
        Session.SubmitQuestionAnswersAsync(qp, answersByIndex);

    private Task HandleQuestionGroupSingleAnswerSubmittedAsync(QuestionContentPart qp, string answer) =>
        Session.SubmitQuestionAnswersAsync(qp, new Dictionary<int, string> { [0] = answer });

    private void OpenTranscriptModal()
    {
        _showTranscriptModal = true;
    }

    private async Task CopyTranscriptAsync()
    {
        if (!string.IsNullOrWhiteSpace(Session.LatestFullTranscriptMarkdown))
        {
            try
            {
                await JS.InvokeVoidAsync("navigator.clipboard.writeText", Session.LatestFullTranscriptMarkdown);
                ToastService.Show("Transcript Copied", "Markdown transcript copied to clipboard.", ToastLevel.Success);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Unable to copy ideation transcript to clipboard.");
                ToastService.Show("Copy Failed", "Unable to access clipboard.", ToastLevel.Warning);
            }
        }
    }

    private async Task SendMessageAsync()
    {
        if (!AttachmentPresentationHelper.CanSubmitIdeationComposer(
                _userInput,
                Session.PendingComposerChips,
                WorkspaceState.ActiveWorkspace != null,
                Session.IsGenerating))
        {
            return;
        }

        var prompt = _userInput;
        _userInput = string.Empty;
        if (!await Session.SendMessageAsync(WorkspaceState.ActiveWorkspace, prompt))
        {
            _userInput = prompt;
        }
    }

    private Task CancelGenerationAsync() => Session.CancelGenerationAsync();

    private Task ResetSession() => Session.ResetSessionAsync(WorkspaceState.ActiveWorkspace);

    private Task HandleConfigChangedAsync() => Session.ApplyConfigChangeAsync();

    private Task AddProposalToBacklogAsync(IdeationProposalViewModel proposal) =>
        Session.AddProposalToBacklogAsync(WorkspaceState.ActiveWorkspace, proposal);

    private Task AddAllProposalsToBacklogAsync() =>
        Session.AddAllProposalsToBacklogAsync(WorkspaceState.ActiveWorkspace);

    private Task DismissProposalAsync(IdeationProposalViewModel proposal) =>
        Session.DismissProposalAsync(WorkspaceState.ActiveWorkspace, proposal);

    private async Task HandleIdeationFileDropAsync(InputFileChangeEventArgs e)
    {
        var ws = WorkspaceState.ActiveWorkspace;
        if (ws == null) return;

        IReadOnlyList<IBrowserFile> files;
        try
        {
            files = e.GetMultipleFiles(maximumFileCount: AttachmentPresentationHelper.MaxBatchUploadFiles);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Session.ReportAttachmentUploadError(null, ex.Message);
            return;
        }

        foreach (var file in files)
        {
            if (!AttachmentConstants.IsSupportedFileName(file.Name))
            {
                Session.ReportUnsupportedAttachmentUpload(file.Name);
                continue;
            }

            try
            {
                await using var stream = file.OpenReadStream(AttachmentConstants.MaxFileDropBytes);
                await Session.UploadAttachmentFileAsync(ws, file.Name, stream);
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                Session.ReportAttachmentUploadError(file.Name, ex.Message);
            }
        }
    }

    private void SelectMobileSideTab(IdeationSideTab tab)
    {
        _mobilePane = IdeationMobilePane.Proposals;
        _activeSideTab = tab;
    }

    private async Task HandleAttachHostFileAsync()
    {
        if (await Session.AttachHostFileAsync(WorkspaceState.ActiveWorkspace, _hostFilePathInput))
        {
            _hostFilePathInput = string.Empty;
        }
    }

    private void CiteAttachmentInChat(TaskAttachment attachment)
    {
        _userInput = AttachmentPresentationHelper.AppendCitationToPrompt(_userInput, attachment);
        _mobilePane = IdeationMobilePane.Chat;
    }

    private void HandleChipClick(ConversationAttachmentChipViewModel chip)
    {
        if (chip.AttachmentId.HasValue)
        {
            OpenAttachmentPreview(chip.AttachmentId.Value);
        }
    }

    private void OpenAttachmentPreview(int attachmentId)
    {
        _previewAttachmentId = attachmentId;
        _previewStartInDelete = false;
    }

    private void OpenAttachmentDeleteConfirm(int attachmentId)
    {
        _previewAttachmentId = attachmentId;
        _previewStartInDelete = true;
    }

    private void CloseAttachmentPreview()
    {
        _previewAttachmentId = null;
        _previewStartInDelete = false;
    }

    private async Task HandleAttachmentDeletedAsync(int deletedAttachmentId)
    {
        _userInput = await Session.HandleAttachmentDeletedAsync(
            WorkspaceState.ActiveWorkspace,
            deletedAttachmentId,
            _userInput);
    }

    private async Task ScrollChatToBottomAsync(bool force = true)
    {
        try
        {
            await JS.InvokeVoidAsync("NightCodeForge.scrollToBottom", ChatPresentationHelper.ChatMessagesContainerId, force);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
            // Suppress JS error if in non-interactive or testing environment
        }
    }

    public void Dispose()
    {
        _disposed = true;
        MemoryTracker.OnMemoryUpdated -= HandleMemoryUpdated;
        WorkspaceState.OnWorkspaceChanged -= HandleWorkspaceChanged;
        Session.OnChange -= HandleSessionChanged;
        Session.OnNotification -= HandleSessionNotification;
        Session.OnScrollRequested -= HandleScrollRequested;
        Session.DetachUiDispatcher();
        Session.DetachStreamSubscription();

        try
        {
            _ = JS.InvokeVoidAsync("NightCodeForge.disposeAutoScroll", ChatPresentationHelper.ChatMessagesContainerId);
            _ = JS.InvokeVoidAsync("NightCodeForge.disposeClipboardImagePaste", ComposerTextareaElementId);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
            // Circuit may already be disconnected
        }
        finally
        {
            _dotNetRef?.Dispose();
            _dotNetRef = null;
        }
    }
}

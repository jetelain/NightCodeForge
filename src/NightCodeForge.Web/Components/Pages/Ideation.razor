@page "/ideation"

<PageTitle>Ideation Chat - NightCodeForge</PageTitle>

<div class="page-header" style="margin-bottom: 1.5rem;">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span style="font-size: 1.75rem;">💡</span>
        <div>
            <h1>Ideation &amp; Discovery Chat</h1>
            <p>Interactive requirement elicitation, architecture brainstorming, and specification refinement.</p>
        </div>
    </div>
</div>

<div class="forge-card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <div style="font-weight: 600; font-size: 1.1rem;">Phase 5.3 Workspace Session</div>
        <span class="forge-badge badge-agentic">Architect Agent Ready</span>
    </div>
    <p style="margin-bottom: 1.25rem;">
        The Ideation Chat engine enables asynchronous requirement discovery and automatic conversion of user intent into structured Backlog tasks.
    </p>
    <div style="background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 1rem; font-family: var(--font-mono); font-size: 0.85rem; color: var(--text-secondary);">
        Active Workspace: <span style="color: var(--accent-indigo);">@(WorkspaceState.ActiveWorkspace?.Name ?? "None selected")</span>
    </div>
</div>

@code {
    [Inject]
    private WorkspaceStateService WorkspaceState { get; set; } = default!;
}

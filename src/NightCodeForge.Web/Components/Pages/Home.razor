@page "/"
@inject WorkspaceStateService WorkspaceState
@implements IDisposable

<PageTitle>Overview - NightCodeForge</PageTitle>

<div style="display: flex; flex-direction: column; gap: 2rem;">
    @if (WorkspaceState.ActiveWorkspace == null)
    {
        <WorkspaceEmptyStateHero />
    }

    <!-- Welcome Banner & Quick Status -->
    <div>
        <h1>NightCodeForge Console</h1>
        <p>Autonomous AI Software Engineering Forge with Human-in-the-Loop Orchestration.</p>
    </div>

    <!-- Active Workspace Card -->
    <div>
        <!-- Workspace Card -->
        <div class="forge-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                <span style="font-size: 0.8rem; font-weight: 600; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.05em;">Current Workspace</span>
                <span class="forge-badge badge-indigo">Active Circuit</span>
            </div>
            <div style="font-size: 1.3rem; font-weight: 700; margin-bottom: 0.5rem; color: var(--text-primary);">
                @(WorkspaceState.ActiveWorkspace?.Name ?? "No workspace selected")
            </div>
            <div class="font-mono" style="font-size: 0.82rem; color: var(--text-secondary); word-break: break-all;">
                @(WorkspaceState.ActiveWorkspace?.RepositoryPath ?? "Choose a workspace from the top-bar selector")
            </div>
            @if (WorkspaceState.ActiveWorkspace != null)
            {
                <div style="margin-top: 1rem; display: flex; gap: 0.5rem; flex-wrap: wrap;">
                    <span class="forge-badge badge-teal">Branch: @WorkspaceState.ActiveWorkspace.DefaultBaseBranch</span>
                    <span class="forge-badge badge-agentic">Mode: @WorkspaceState.ActiveWorkspace.ExecutionMode</span>
                </div>
            }
        </div>
    </div>

    <!-- Quick Navigation Hub -->
    <div>
        <h2 style="margin-bottom: 1rem;">Workspace Workflows</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem;">
            <NavLink href="ideation" class="forge-card" style="display: block; text-decoration: none; color: inherit;">
                <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;">
                    <span style="font-size: 1.5rem;">💡</span>
                    <div style="font-weight: 600; font-size: 1.05rem;">Ideation Chat</div>
                </div>
                <p style="font-size: 0.85rem; margin: 0;">Brainstorm and refine architectural features with the Architect Agent.</p>
            </NavLink>

            <NavLink href="backlog" class="forge-card" style="display: block; text-decoration: none; color: inherit;">
                <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;">
                    <span style="font-size: 1.5rem;">📋</span>
                    <div style="font-weight: 600; font-size: 1.05rem;">Backlog &amp; Visual DAG</div>
                </div>
                <p style="font-size: 0.85rem; margin: 0;">Visualize task graphs, pipeline topological stages, and task gates.</p>
            </NavLink>

            <NavLink href="monitoring" class="forge-card" style="display: block; text-decoration: none; color: inherit;">
                <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;">
                    <span style="font-size: 1.5rem;">⚡</span>
                    <div style="font-weight: 600; font-size: 1.05rem;">Live Telemetry</div>
                </div>
                <p style="font-size: 0.85rem; margin: 0;">Real-time GPU gauges, streaming agent thoughts, and tool dispatch logs.</p>
            </NavLink>

            <NavLink href="inbox" class="forge-card" style="display: block; text-decoration: none; color: inherit;">
                <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;">
                    <span style="font-size: 1.5rem;">📬</span>
                    <div style="font-weight: 600; font-size: 1.05rem;">Question Inbox</div>
                </div>
                <p style="font-size: 0.85rem; margin: 0;">Human-in-the-loop decisions, approval gates, and clarifications.</p>
            </NavLink>

            <NavLink href="review" class="forge-card" style="display: block; text-decoration: none; color: inherit;">
                <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;">
                    <span style="font-size: 1.5rem;">🔍</span>
                    <div style="font-weight: 600; font-size: 1.05rem;">Review Room</div>
                </div>
                <p style="font-size: 0.85rem; margin: 0;">Side-by-side git diff inspection, test reports, and squash merges.</p>
            </NavLink>

            <NavLink href="settings" class="forge-card" style="display: block; text-decoration: none; color: inherit;">
                <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;">
                    <span style="font-size: 1.5rem;">⚙️</span>
                    <div style="font-weight: 600; font-size: 1.05rem;">Settings</div>
                </div>
                <p style="font-size: 0.85rem; margin: 0;">Configure LLM inference models, agent profiles, workflows, and host SDKs.</p>
            </NavLink>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        WorkspaceState.OnWorkspaceChanged += HandleWorkspaceChanged;
    }

    private void HandleWorkspaceChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        WorkspaceState.OnWorkspaceChanged -= HandleWorkspaceChanged;
    }
}

@page "/"
@page "/w/{WorkspaceId:int}"
@using NightCodeForge.Core.Domain
@using NightCodeForge.Core.Interfaces
@using NightCodeForge.Core.Repositories
@using NightCodeForge.Web.Components.Monitoring
@using NightCodeForge.Web.Components.Workspaces
@using NightCodeForge.Web.Services
@inject IWorkspaceRepository WorkspaceRepository
@inject ITaskRepository TaskRepository
@inject IDevQueueService DevQueueService
@inject WorkspaceStateService WorkspaceState
@inject WorkerStateService WorkerState
@inject ILogger<Home> Logger
@implements IDisposable

<PageTitle>Overview - NightCodeForge</PageTitle>

<style>
    .dashboard-task-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.75rem;
        padding: 0.85rem 1rem;
        background: var(--bg-surface);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-md);
        transition: border-color 0.15s ease, background 0.15s ease;
    }

    .dashboard-task-row:hover {
        border-color: var(--border-hover, var(--border-subtle));
    }

    .dashboard-task-content {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        flex: 1;
        min-width: 0;
    }

    .dashboard-task-header-row {
        display: contents;
    }

    .dashboard-task-ws {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.75rem;
        min-width: 120px;
        max-width: 180px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        flex-shrink: 0;
    }

    .dashboard-task-ws-name {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .dashboard-task-priority {
        display: inline-flex;
        justify-content: center;
        min-width: 2.2rem;
        font-size: 0.75rem;
        flex-shrink: 0;
    }

    .dashboard-task-title-link {
        font-weight: 700;
        color: var(--text-primary);
        text-decoration: none;
        font-size: 0.95rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        flex: 1 1 auto;
        min-width: 0;
    }

    .dashboard-task-title-link:hover {
        color: var(--accent-indigo, #6366f1);
        text-decoration: underline;
    }

    .dashboard-task-meta {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        flex-shrink: 0;
    }

    .dashboard-task-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-shrink: 0;
        margin-left: auto;
    }

    @@media (max-width: 860px) {
        .dashboard-task-row {
            flex-direction: column;
            align-items: stretch;
            gap: 0.75rem;
        }

        .dashboard-task-content {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
            width: 100%;
        }

        .dashboard-task-header-row {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            flex-wrap: wrap;
            width: 100%;
        }

        .dashboard-task-ws {
            max-width: 100%;
            min-width: 0;
        }

        .dashboard-task-title-link {
            width: 100%;
            white-space: normal;
            word-break: break-word;
        }

        .dashboard-task-meta {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            flex-wrap: wrap;
            width: 100%;
        }

        .dashboard-task-actions {
            width: 100%;
            justify-content: flex-end;
            border-top: 1px solid var(--border-subtle);
            padding-top: 0.65rem;
            margin-left: 0;
        }
    }
</style>

<div class="home-dashboard" style="display: flex; flex-direction: column; gap: 2rem;">
    <!-- 1. Top Command Center Banner, Question Inbox, Live Telemetry & Setup New Workspace -->
    <div class="forge-card" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.25rem; padding: 1.5rem;">
        <div>
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.35rem;">
                <span style="font-size: 1.75rem;">🔥</span>
                <h1 style="margin: 0; font-size: 1.65rem; font-weight: 800;">NightCodeForge Console</h1>
            </div>
            <p style="margin: 0; color: var(--text-secondary); font-size: 0.92rem;">
                Workspace-agnostic command center for autonomous engineering, live hardware telemetry, and multi-repo orchestration.
            </p>
        </div>

        <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
            <a href="/inbox"
               id="home-inbox-btn"
               class="forge-btn @(_snapshot.PendingQuestionCount > 0 ? "forge-btn-warning" : "forge-btn-secondary")"
               style="text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem;">
                <span>📬</span>
                <span>Question Inbox</span>
                <span id="home-inbox-count-badge"
                      class="forge-badge @(_snapshot.PendingQuestionCount > 0 ? "badge-crimson" : "badge-gray")"
                      style="font-size: 0.75rem;">
                    @_snapshot.PendingQuestionCount
                </span>
            </a>
            <a href="/review"
               id="home-review-btn"
               class="forge-btn @(_snapshot.PendingReviewCount > 0 ? "forge-btn-primary" : "forge-btn-secondary")"
               style="text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem;">
                <span>🔍</span>
                <span>Review Room</span>
                <span id="home-review-count-badge"
                      class="forge-badge @(_snapshot.PendingReviewCount > 0 ? "badge-indigo" : "badge-gray")"
                      style="font-size: 0.75rem;">
                    @_snapshot.PendingReviewCount
                </span>
            </a>
            <a href="/monitoring"
               id="home-live-telemetry-btn"
               class="forge-btn forge-btn-secondary"
               style="text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem;">
                <span>⚡</span>
                <span>Live Telemetry</span>
            </a>
            <button type="button"
                    id="home-refresh-btn"
                    class="forge-btn forge-btn-outline"
                    @onclick="RefreshDashboardAsync"
                    disabled="@_isLoading">
                @(_isLoading ? "⏳ Refreshing..." : "🔄 Refresh")
            </button>
            <button type="button"
                    id="home-setup-workspace-btn"
                    class="forge-btn forge-btn-primary hero-launch-btn"
                    @onclick="() => WorkspaceState.RequestOpenWizard()">
                ➕ Setup New Workspace
            </button>
        </div>
    </div>

    @if (_snapshot.PendingQuestionCount > 0)
    {
        <div id="home-pending-questions-banner"
             class="forge-card"
             style="padding: 1.15rem 1.5rem; background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.4); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <span style="font-size: 1.5rem;">📬</span>
                <div>
                    <strong style="color: var(--accent-amber); font-size: 0.98rem;">
                        @_snapshot.PendingQuestionCount Question(s) Awaiting Human Clarification
                    </strong>
                    <div style="font-size: 0.85rem; color: var(--text-secondary);">
                        One or more autonomous agent tasks are paused waiting for your guidance in the Question Inbox.
                    </div>
                </div>
            </div>
            <a href="/inbox"
               id="home-banner-inbox-link"
               class="forge-btn forge-btn-warning btn-sm"
               style="text-decoration: none; white-space: nowrap;">
                📬 Open Question Inbox (@_snapshot.PendingQuestionCount) ➔
            </a>
        </div>
    }

    <!-- 2. Recent Workspaces (Direct Access to Backlog & Ideation Chat) -->
    <section id="home-workspaces-section">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.75rem;">
            <div style="display: flex; align-items: center; gap: 0.6rem;">
                <span style="font-size: 1.35rem;">🏢</span>
                <h2 style="margin: 0; font-size: 1.25rem; font-weight: 700;">Recent Workspaces</h2>
                <span class="forge-badge badge-indigo">@_snapshot.RecentWorkspaces.Count</span>
            </div>
        </div>

        @if (_snapshot.RecentWorkspaces.Count == 0)
        {
            <WorkspaceEmptyStateHero />
        }
        else
        {
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr)); gap: 1.25rem;">
                @foreach (var item in _snapshot.RecentWorkspaces)
                {
                    var ws = item.Workspace;
                    var wsEmoji = WorkspacePresentationHelper.ResolveEmoji(ws.Emoji);
                    var wsColor = WorkspacePresentationHelper.ResolveColor(ws.ColorCode);
                    <div class="forge-card workspace-summary-card" id="home-workspace-card-@ws.Id" style="display: flex; flex-direction: column; justify-content: space-between; gap: 1rem; border-left: 4px solid @wsColor;">
                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.5rem; margin-bottom: 0.5rem;">
                                <div style="font-size: 1.15rem; font-weight: 700; color: var(--text-primary); display: flex; align-items: center; gap: 0.4rem;">
                                    <span style="font-size: 1.25rem;">@wsEmoji</span>
                                    <span>@ws.Name</span>
                                </div>
                                <div style="display: flex; gap: 0.35rem; flex-wrap: wrap;">
                                    @if (item.RunningTaskCount > 0)
                                    {
                                        <span class="badge-running" style="font-size: 0.72rem;">
                                            <span class="pulse-dot"></span> @item.RunningTaskCount Running
                                        </span>
                                    }
                                    <span class="forge-badge badge-teal" style="font-size: 0.72rem;">@ws.DefaultBaseBranch</span>
                                </div>
                            </div>

                            <div class="font-mono" style="font-size: 0.78rem; color: var(--text-secondary); word-break: break-all; margin-bottom: 0.75rem;">
                                @ws.RepositoryPath
                            </div>

                            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                                <span class="forge-badge badge-gray" style="font-size: 0.75rem;">
                                    Open: @item.OpenTaskCount
                                </span>
                                <span class="forge-badge badge-gray" style="font-size: 0.75rem;">
                                    Suggested: @item.SuggestedTaskCount
                                </span>
                                @if (item.PendingQuestionCount > 0)
                                {
                                    <a href="@item.InboxUrl"
                                       id="home-ws-inbox-@ws.Id"
                                       class="forge-badge badge-crimson"
                                       style="font-size: 0.75rem; text-decoration: none;">
                                        📬 Questions: @item.PendingQuestionCount
                                    </a>
                                }
                                @if (item.PendingReviewCount > 0)
                                {
                                    <a href="@item.ReviewUrl"
                                       id="home-ws-review-@ws.Id"
                                       class="forge-badge badge-indigo"
                                       style="font-size: 0.75rem; text-decoration: none;">
                                        🔍 Review: @item.PendingReviewCount
                                    </a>
                                }
                                @if (item.PendingQuestionCount == 0 && item.PendingReviewCount == 0 && item.WaitingOrReviewTaskCount > 0)
                                {
                                    <span class="forge-badge badge-amber" style="font-size: 0.75rem;">
                                        Attention: @item.WaitingOrReviewTaskCount
                                    </span>
                                }
                            </div>
                        </div>

                        <div style="display: flex; gap: 0.65rem; padding-top: 0.75rem; border-top: 1px solid var(--border-subtle);">
                            <a href="@item.BacklogUrl"
                               id="home-ws-backlog-@ws.Id"
                               class="forge-btn forge-btn-primary"
                               style="flex: 1; text-align: center; text-decoration: none; font-size: 0.85rem; padding: 0.45rem 0.75rem;">
                                📋 Backlog
                            </a>
                            <a href="@item.IdeationUrl"
                               id="home-ws-ideation-@ws.Id"
                               class="forge-btn forge-btn-secondary"
                               style="flex: 1; text-align: center; text-decoration: none; font-size: 0.85rem; padding: 0.45rem 0.75rem;">
                                💡 Ideation Chat
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <!-- Activity Section -->
    <section id="home-activity-section" style="display: flex; flex-direction: column; gap: 1.5rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
            <div style="display: flex; align-items: center; gap: 0.6rem;">
                <span style="font-size: 1.35rem;">⚡</span>
                <h2 style="margin: 0; font-size: 1.25rem; font-weight: 700;">Activity</h2>
            </div>
        </div>

        <!-- 2b. Tasks Awaiting Human Code Review -->
        <section id="home-pending-reviews-section" class="forge-card" style="padding: 1.5rem;">
            <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.75rem;">
                <span style="font-size: 1.35rem;">🔍</span>
                <h2 style="margin: 0; font-size: 1.15rem; font-weight: 700;">Tasks Awaiting Human Code Review</h2>
                <span class="forge-badge badge-indigo">@_snapshot.PendingReviewCount</span>
            </div>

            @if (_snapshot.PendingReviewTasks.Count == 0)
            {
                <div id="home-no-pending-reviews" style="padding: 1.75rem; text-align: center; color: var(--text-muted); background: var(--bg-surface); border-radius: var(--radius-md); font-size: 0.9rem;">
                    No tasks are waiting for human code review.
                </div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 0.65rem;">
                    @foreach (var task in _snapshot.PendingReviewTasks)
                    {
                        <div class="pending-review-row dashboard-task-row"
                             id="home-pending-review-@task.TaskId">
                            <div class="dashboard-task-content">
                                <div class="dashboard-task-header-row">
                                    <!-- 1. Workspace -->
                                    <span class="forge-badge badge-teal dashboard-task-ws" title="@task.WorkspaceName">
                                        <span>@task.WorkspaceEmoji</span>
                                        <span class="dashboard-task-ws-name">@task.WorkspaceName</span>
                                    </span>

                                    <!-- 2. Priority -->
                                    <span class="forge-badge badge-priority-@task.Priority font-mono dashboard-task-priority">
                                        P@(task.Priority)
                                    </span>
                                </div>

                                <!-- 3. Task number and title -->
                                <a href="@task.ReviewUrl"
                                   class="dashboard-task-title-link"
                                   title="#@task.TaskId: @task.Title">
                                    #@task.TaskId: @task.Title
                                </a>

                                <!-- Branches, Conflict & Age -->
                                <div class="dashboard-task-meta">
                                    <span class="forge-badge badge-purple font-mono" style="font-size: 0.75rem;">
                                        @task.FeatureBranch ➔ @task.BaseBranch
                                    </span>
                                    @if (task.HasResolvedConflict)
                                    {
                                        <span class="forge-badge badge-amber font-mono" style="font-size: 0.75rem;">⚠️ Conflict Resolved</span>
                                    }
                                    <span class="forge-badge badge-gray font-mono" style="font-size: 0.75rem;" title="@task.UpdatedAt.ToString("u")">
                                        🕒 @TaskRecencyAndRetentionHelper.FormatRelativeAge(task.UpdatedAt)
                                    </span>
                                </div>
                            </div>

                            <!-- Buttons (aligned right, new line on mobile) -->
                            <div class="dashboard-task-actions">
                                <a href="@task.ReviewUrl"
                                   id="home-review-task-btn-@task.TaskId"
                                   class="forge-btn forge-btn-primary btn-xs"
                                   style="text-decoration: none; font-size: 0.78rem; padding: 0.3rem 0.65rem;">
                                    🔍 Review &amp; Merge
                                </a>
                                <a href="@task.InspectorUrl"
                                   class="forge-btn forge-btn-secondary btn-xs"
                                   style="text-decoration: none; font-size: 0.78rem; padding: 0.3rem 0.65rem;">
                                    🔍 Inspector
                                </a>
                                <a href="@task.TaskDetailUrl"
                                   class="forge-btn forge-btn-outline btn-xs"
                                   style="text-decoration: none; font-size: 0.78rem; padding: 0.3rem 0.65rem;">
                                    📋 Details
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

        <!-- 2c. Recent Failed & Closed Tasks (Last 24h) -->
        <section id="home-recent-terminal-tasks-section" class="forge-card" style="padding: 1.5rem;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.75rem; flex-wrap: wrap; gap: 0.75rem;">
                <div style="display: flex; align-items: center; gap: 0.6rem;">
                    <span style="font-size: 1.35rem;">⚡</span>
                    <h2 style="margin: 0; font-size: 1.15rem; font-weight: 700;">Recent Failed &amp; Closed Tasks (Last 24h)</h2>
                    <span class="forge-badge badge-gray">@_snapshot.RecentFailedAndClosedTasks.Count</span>
                </div>
                <a href="/tasks"
                   id="home-view-all-tasks-link"
                   class="forge-btn forge-btn-secondary"
                   style="font-size: 0.82rem; padding: 0.35rem 0.85rem; text-decoration: none;">
                    📜 View All Tasks ➔
                </a>
            </div>

            @if (_snapshot.RecentFailedAndClosedTasks.Count == 0)
            {
                <div id="home-no-recent-terminal-tasks" style="padding: 1.75rem; text-align: center; color: var(--text-muted); background: var(--bg-surface); border-radius: var(--radius-md); font-size: 0.9rem;">
                    No failed or closed tasks in the last 24 hours.
                </div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 0.65rem;">
                    @foreach (var task in _snapshot.RecentFailedAndClosedTasks)
                    {
                        <div class="recent-terminal-task-row dashboard-task-row"
                             id="home-recent-terminal-task-@task.TaskId">
                            <div class="dashboard-task-content">
                                <div class="dashboard-task-header-row">
                                    <!-- 1. Workspace -->
                                    <span class="forge-badge badge-teal dashboard-task-ws" title="@task.WorkspaceName">
                                        <span>@task.WorkspaceEmoji</span>
                                        <span class="dashboard-task-ws-name">@task.WorkspaceName</span>
                                    </span>

                                    <!-- 2. Priority -->
                                    <span class="forge-badge badge-priority-@task.Priority font-mono dashboard-task-priority">
                                        P@(task.Priority)
                                    </span>
                                </div>

                                <!-- 3. Task number and title -->
                                <a href="@task.TaskDetailUrl"
                                   class="dashboard-task-title-link"
                                   title="#@task.TaskId: @task.Title">
                                    #@task.TaskId: @task.Title
                                </a>

                                <!-- 4. Status, 5. {N}h ago & optional Commit -->
                                <div class="dashboard-task-meta">
                                    @if (task.Status == TaskOverallStatus.Failed)
                                    {
                                        <span class="forge-badge badge-crimson font-mono" style="font-size: 0.75rem;">
                                            ❌ Failed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="forge-badge badge-emerald font-mono" style="font-size: 0.75rem;">
                                            ✅ Closed
                                        </span>
                                    }

                                    <span class="forge-badge badge-gray font-mono" style="font-size: 0.75rem;" title="@task.UpdatedAt.ToString("u")">
                                        🕒 @TaskRecencyAndRetentionHelper.FormatRelativeAge(task.UpdatedAt)
                                    </span>

                                    @if (!string.IsNullOrWhiteSpace(task.SquashCommitSha))
                                    {
                                        <span class="forge-badge badge-purple font-mono" style="font-size: 0.72rem;" title="Squash commit: @task.SquashCommitSha">
                                            Commit: @(task.SquashCommitSha.Length > 8 ? task.SquashCommitSha[..8] : task.SquashCommitSha)
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- 6. Buttons (aligned right, new line on mobile) -->
                            <div class="dashboard-task-actions">
                                <a href="@task.InspectorUrl"
                                   id="home-recent-inspector-@task.TaskId"
                                   class="forge-btn forge-btn-secondary btn-xs"
                                   style="text-decoration: none; font-size: 0.78rem; padding: 0.3rem 0.65rem;">
                                    🔍 Inspector
                                </a>
                                <a href="@task.TaskDetailUrl"
                                   id="home-recent-details-@task.TaskId"
                                   class="forge-btn forge-btn-outline btn-xs"
                                   style="text-decoration: none; font-size: 0.78rem; padding: 0.3rem 0.65rem;">
                                    📋 Details
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

        <!-- 3. Running Tasks & Next Scheduled Tasks (Limit 5) -->
        <section id="home-scheduled-tasks-section" class="forge-card" style="padding: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.75rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.75rem;">
                <div style="display: flex; align-items: center; gap: 0.6rem;">
                    <span style="font-size: 1.35rem;">⏱️</span>
                    <div>
                        <h2 style="margin: 0; font-size: 1.15rem; font-weight: 700;">Running &amp; Next Scheduled Tasks</h2>
                        <span style="font-size: 0.8rem; color: var(--text-muted);">
                            Showing up to @HomeDashboardBuilder.MaxScheduledTasks active and upcoming tasks across all workspaces
                        </span>
                    </div>
                </div>
                <a href="/dev-queue"
                   id="home-open-devqueue-link"
                   class="forge-btn forge-btn-secondary"
                   style="font-size: 0.82rem; padding: 0.35rem 0.85rem; text-decoration: none;">
                    ⏱️ Open Dev-Queue &amp; Locks ➔
                </a>
            </div>

            @if (_snapshot.RunningAndNextTasks.Count == 0)
            {
                <div id="home-no-scheduled-tasks" style="padding: 1.75rem; text-align: center; color: var(--text-muted); background: var(--bg-surface); border-radius: var(--radius-md); font-size: 0.9rem;">
                    No running or queued tasks right now. Promote a task from any workspace backlog to start execution.
                </div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 0.65rem;">
                    @foreach (var task in _snapshot.RunningAndNextTasks)
                    {
                        <div class="scheduled-task-row dashboard-task-row"
                             id="home-scheduled-task-@task.TaskId">
                            <div class="dashboard-task-content">
                                <div class="dashboard-task-header-row">
                                    <!-- 1. Workspace -->
                                    <span class="forge-badge badge-teal dashboard-task-ws" title="@task.WorkspaceName">
                                        <span>@task.WorkspaceEmoji</span>
                                        <span class="dashboard-task-ws-name">@task.WorkspaceName</span>
                                    </span>

                                    <!-- 2. Priority -->
                                    <span class="forge-badge badge-priority-@task.Priority font-mono dashboard-task-priority">
                                        P@(task.Priority)
                                    </span>
                                </div>

                                <!-- 3. Task number and title -->
                                <a href="@task.TaskDetailUrl"
                                   class="dashboard-task-title-link"
                                   title="#@task.TaskId: @task.Title">
                                    #@task.TaskId: @task.Title
                                </a>

                                <!-- 5. Status, 6. Stage & 7. Time spent running -->
                                <div class="dashboard-task-meta">
                                    @if (task.IsRunning)
                                    {
                                        <span class="badge-running font-mono" style="font-size: 0.75rem;">
                                            <span class="pulse-dot"></span> Running
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="forge-badge badge-indigo font-mono" style="font-size: 0.75rem;" title="@task.QueueLabel">
                                            Queued
                                        </span>
                                    }

                                    @if (task.IsRunning)
                                    {
                                        <span class="forge-badge badge-purple font-mono" style="font-size: 0.75rem;" title="Current Stage">
                                            @task.StageId
                                        </span>
                                    }
                                    else if (task.IsPaused)
                                    {
                                        <span class="forge-badge badge-amber font-mono" style="font-size: 0.75rem;" title="Operations or task paused">
                                            ⏸️ Paused
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="forge-badge badge-purple font-mono" style="font-size: 0.75rem;" title="Next Stage">
                                            @task.StageId
                                        </span>
                                    }

                                    @if (task.IsRunning && !string.IsNullOrWhiteSpace(task.RunningDurationFormatted))
                                    {
                                        <span class="forge-badge badge-gray font-mono" style="font-size: 0.75rem;" title="Time spent running">
                                            ⏱️ @task.RunningDurationFormatted
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- 8. Buttons (aligned right, new line on mobile) -->
                            <div class="dashboard-task-actions">
                                <a href="@task.InspectorUrl"
                                   class="forge-btn forge-btn-secondary btn-xs"
                                   style="text-decoration: none; font-size: 0.78rem; padding: 0.3rem 0.65rem;">
                                    🔍 Inspector
                                </a>
                                <a href="@task.TaskDetailUrl"
                                   class="forge-btn forge-btn-outline btn-xs"
                                   style="text-decoration: none; font-size: 0.78rem; padding: 0.3rem 0.65rem;">
                                    📋 Details
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    </section>

    <!-- 4. Workspace-Independent Live Telemetry -->
    <section id="home-telemetry-section">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; flex-wrap: wrap; gap: 0.75rem;">
            <div style="display: flex; align-items: center; gap: 0.6rem;">
                <span style="font-size: 1.35rem;">⚡</span>
                <h2 style="margin: 0; font-size: 1.25rem; font-weight: 700;">Live System Telemetry</h2>
                <span class="forge-badge badge-teal" style="font-size: 0.75rem;">Global / Workspace-Independent</span>
            </div>
            <a href="/monitoring"
               id="home-full-telemetry-link"
               class="forge-btn forge-btn-secondary"
               style="font-size: 0.82rem; padding: 0.35rem 0.85rem; text-decoration: none;">
                📊 Open Full Live Telemetry &amp; VRAM Monitor ➔
            </a>
        </div>

        <ActiveOperationsHero />
    </section>
</div>

@code {
    [Parameter] public int? WorkspaceId { get; set; }
    [Parameter] public TimeSpan StateChangeDebounceInterval { get; set; } = HomeDashboardBuilder.DefaultStateChangeDebounceInterval;

    private HomeDashboardSnapshot _snapshot = new(
        Array.Empty<RecentWorkspaceSummary>(),
        Array.Empty<HomeScheduledTaskItem>(),
        0,
        0,
        Array.Empty<HomePendingReviewItem>(),
        0,
        Array.Empty<HomeRecentTerminalTaskItem>());
    private HomeStateChangeDebouncer? _stateChangeDebouncer;
    private bool _isLoading;
    private bool _refreshRequestedWhileLoading;
    private bool _isUpdatingPendingQuestions;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        _stateChangeDebouncer = new HomeStateChangeDebouncer(
            StateChangeDebounceInterval,
            ExecuteDebouncedRefreshAsync,
            Logger);

        if (WorkspaceId.HasValue)
        {
            WorkspaceState.TryActivateWorkspaceById(WorkspaceId.Value);
        }

        WorkspaceState.OnWorkspaceChanged += HandleStateChanged;
        WorkerState.OnWorkerStateChanged += HandleStateChanged;

        await RefreshDashboardAsync();
    }

    protected override void OnParametersSet()
    {
        if (WorkspaceId.HasValue)
        {
            WorkspaceState.TryActivateWorkspaceById(WorkspaceId.Value);
        }
    }

    private async Task RefreshDashboardAsync()
    {
        if (_disposed) return;
        if (_isLoading)
        {
            _refreshRequestedWhileLoading = true;
            return;
        }

        _refreshRequestedWhileLoading = false;
        _stateChangeDebouncer?.CancelPending();
        _isLoading = true;

        try
        {
            var cancellationToken = _stateChangeDebouncer?.DisposalToken ?? CancellationToken.None;
            _snapshot = await HomeDashboardBuilder.BuildSnapshotAsync(
                WorkspaceRepository,
                TaskRepository,
                DevQueueService,
                Logger,
                cancellationToken);

            _isUpdatingPendingQuestions = true;
            try
            {
                WorkerState.UpdatePendingQuestions(_snapshot.PendingQuestionCount);
                WorkerState.UpdatePendingReviews(_snapshot.PendingReviewCount);
            }
            finally
            {
                _isUpdatingPendingQuestions = false;
            }
        }
        catch (OperationCanceledException) when (_disposed)
        {
            Logger.LogDebug("Homepage dashboard refresh canceled due to component disposal.");
        }
        finally
        {
            _isLoading = false;
            if (_refreshRequestedWhileLoading && !_disposed)
            {
                _refreshRequestedWhileLoading = false;
                _stateChangeDebouncer?.NotifyStateChanged();
            }
        }
    }

    private Task ExecuteDebouncedRefreshAsync(CancellationToken cancellationToken)
    {
        if (_disposed || cancellationToken.IsCancellationRequested)
        {
            return Task.CompletedTask;
        }

        return InvokeAsync(async () =>
        {
            if (_disposed || cancellationToken.IsCancellationRequested) return;
            await RefreshDashboardAsync();
            if (!_disposed)
            {
                StateHasChanged();
            }
        });
    }

    private void HandleStateChanged()
    {
        if (_disposed || _isUpdatingPendingQuestions) return;
        _stateChangeDebouncer?.NotifyStateChanged();
    }

    public void Dispose()
    {
        _disposed = true;
        WorkspaceState.OnWorkspaceChanged -= HandleStateChanged;
        WorkerState.OnWorkerStateChanged -= HandleStateChanged;
        _stateChangeDebouncer?.Dispose();
    }
}

@page "/inbox"
@page "/w/{WorkspaceId:int}/inbox"
@using NightCodeForge.Core.Domain
@using NightCodeForge.Core.Repositories
@using NightCodeForge.Core.Workflow
@using NightCodeForge.Web.Components.Inbox
@inject ITaskRepository TaskRepository
@inject WorkspaceStateService WorkspaceState
@inject WorkerStateService WorkerState
@inject ToastService ToastService
@inject ILogger<Inbox> Logger
@implements IDisposable

<PageTitle>Question Inbox - NightCodeForge</PageTitle>

<div class="inbox-container">
    <div class="inbox-header mb-4">
        <div>
            <h2>📬 Question Inbox</h2>
            <p class="text-secondary">Questions requiring human clarification before autonomous execution can proceed.</p>
        </div>
        <div class="inbox-filter">
            <label class="checkbox-inline font-sans">
                <input type="checkbox" 
                       id="filter-workspace-checkbox"
                       @bind="_filterCurrentWorkspaceOnly" 
                       @bind:after="LoadQuestionsAsync" />
                <span>Filter to Active Workspace Only @(WorkspaceState.ActiveWorkspace != null ? $"({WorkspaceState.ActiveWorkspace.Name})" : "")</span>
            </label>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="loading-spinner text-muted" id="inbox-loading">
            <div class="spinner-border spinner-border-sm me-2" role="status"></div>
            Loading questions...
        </div>
    }
    else if (_pendingQuestions.Count == 0)
    {
        <div class="empty-inbox card-surface text-center p-5" id="inbox-empty-state">
            <span class="empty-icon" style="font-size: 3rem; display: block; margin-bottom: 1rem;">🎉</span>
            <h3>All clear! No questions pending.</h3>
            <p class="text-muted">Agents are progressing autonomously without any human blockers.</p>
        </div>
    }
    else
    {
        <div class="question-grid" id="inbox-question-grid">
            @foreach (var group in GroupedQuestions)
            {
                <QuestionCard @key="group.Key" 
                              Questions="group.Questions" 
                              OnAnswerSubmitted="HandleAnswerSubmitted" 
                              OnBatchSubmitted="HandleBatchSubmitted" />
            }
        </div>
    }
</div>

@code {
    [Parameter] public int? WorkspaceId { get; set; }

    private List<Question> _pendingQuestions = new();
    private bool _filterCurrentWorkspaceOnly;
    private bool _isLoading = true;
    private bool _disposed;

    private record QuestionGroup(string Key, IReadOnlyList<Question> Questions);

    private IEnumerable<QuestionGroup> GroupedQuestions
    {
        get
        {
            var groups = new List<QuestionGroup>();
            var batches = _pendingQuestions
                .GroupBy(q => !string.IsNullOrWhiteSpace(q.BatchId)
                    ? $"task-{q.TaskId}-batch-{q.BatchId}"
                    : $"task-{q.TaskId}-single-{q.Id}");

            foreach (var g in batches)
            {
                groups.Add(new QuestionGroup(g.Key, g.OrderBy(q => q.Id).ToList()));
            }
            return groups;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        WorkspaceState.OnWorkspaceChanged += HandleWorkspaceChanged;
        if (WorkspaceId.HasValue)
        {
            WorkspaceState.TryActivateWorkspaceById(WorkspaceId.Value);
        }
        await LoadQuestionsAsync();
    }

    protected override void OnParametersSet()
    {
        if (WorkspaceId.HasValue)
        {
            WorkspaceState.TryActivateWorkspaceById(WorkspaceId.Value);
        }
    }

    private void HandleWorkspaceChanged()
    {
        if (_disposed) return;

        _ = InvokeAsync(async () =>
        {
            try
            {
                if (_disposed) return;
                await LoadQuestionsAsync();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to reload questions on workspace change.");
                ToastService.Show("Error", "Failed to reload questions.", ToastLevel.Error);
            }
        });
    }

    private async Task LoadQuestionsAsync()
    {
        _isLoading = true;
        try
        {
            int? workspaceFilter = _filterCurrentWorkspaceOnly ? WorkspaceState.ActiveWorkspaceId : null;
            var list = await TaskRepository.GetQuestionsByStatusAsync(QuestionStatus.Pending, workspaceFilter);
            _pendingQuestions = list.ToList();
            
            // Sync WorkerState pending count
            WorkerState.UpdatePendingQuestions(_pendingQuestions.Count);
        }
        catch (Exception ex)
        {
            ToastService.Show("Error Loading Inbox", ex.Message, ToastLevel.Error);
            _pendingQuestions = new List<Question>();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleAnswerSubmitted(int questionId)
    {
        _pendingQuestions.RemoveAll(q => q.Id == questionId);
        WorkerState.UpdatePendingQuestions(_pendingQuestions.Count);
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleBatchSubmitted(IReadOnlyList<int> questionIds)
    {
        var idSet = new HashSet<int>(questionIds);
        _pendingQuestions.RemoveAll(q => idSet.Contains(q.Id));
        WorkerState.UpdatePendingQuestions(_pendingQuestions.Count);
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _disposed = true;
        WorkspaceState.OnWorkspaceChanged -= HandleWorkspaceChanged;
    }
}

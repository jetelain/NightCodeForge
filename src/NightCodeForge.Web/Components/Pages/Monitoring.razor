@page "/monitoring"
@page "/monitoring/{TaskId:int?}"
@implements IAsyncDisposable
@using NightCodeForge.Core.Workflow
@using NightCodeForge.Web.Components.Monitoring
@using NightCodeForge.Web.Services
@inject OperationsTelemetryUiService TelemetryUi
@inject OrchestratorHubClientConnection HubClient
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Logging.ILogger<Monitoring> Logger

<PageTitle>Live Operations Telemetry - NightCodeForge</PageTitle>

<!-- Page Header -->
<div class="page-header" style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span style="font-size: 1.75rem;">⚡</span>
        <div>
            <h1 style="margin: 0; font-size: 1.5rem;">Live Developer Operations &amp; Hardware Telemetry</h1>
            <p style="margin: 0.25rem 0 0 0; color: var(--text-secondary); font-size: 0.88rem;">
                System-wide real-time visibility into LLM inference calls, deterministic CLI execution, and OllamaRouter VRAM topology.
            </p>
        </div>
    </div>

    <!-- Connection State & Controls -->
    <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
        <!-- SignalR Connection Status Pill -->
        <div class="forge-badge @GetConnectionBadgeClass()" id="signalr-connection-badge">
            <span>@GetConnectionDot()</span>
            <span>@GetConnectionText()</span>
        </div>

        @if (HubClient.State == Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Disconnected)
        {
            <button class="forge-btn forge-btn-secondary" style="padding: 0.25rem 0.65rem; font-size: 0.78rem;" @onclick="ReconnectAsync">
                Reconnect
            </button>
        }

        <!-- Link to Task-Centric Inspector -->
        <a href="/inspector" class="forge-btn forge-btn-secondary" style="padding: 0.25rem 0.65rem; font-size: 0.78rem; text-decoration: none;">
            🔎 Task Inspector
        </a>
    </div>
</div>

<!-- 1. Active Operations Hero (Live in-flight LLM + Shell command) -->
<ActiveOperationsHero />

<!-- 2. OllamaRouter Cluster & Resident VRAM Telemetry -->
<OllamaRouterClusterMonitor />

<!-- 3. Operations History Streams (Tabs: LLM Inference Calls vs Shell CLI Commands) -->
<div class="forge-card" style="padding: 1.5rem; margin-bottom: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 1rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.75rem;">
        <div style="display: flex; gap: 0.5rem;" class="nav-tabs" role="tablist">
            <button id="tab-llm-calls" type="button" class="forge-tab @(_activeTab == "llm" ? "active" : "")" style="padding: 0.45rem 1rem; font-size: 0.88rem; font-weight: 600;" @onclick="@(() => _activeTab = "llm")">
                🧠 LLM Inference Stream (@TelemetryUi.RecentLlmCalls.Count)
            </button>
            <button id="tab-shell-ops" type="button" class="forge-tab @(_activeTab == "shell" ? "active" : "")" style="padding: 0.45rem 1rem; font-size: 0.88rem; font-weight: 600;" @onclick="@(() => _activeTab = "shell")">
                💻 Shell &amp; CLI Executions (@TelemetryUi.RecentShellCommands.Count)
            </button>
        </div>

        <button type="button" class="forge-btn forge-btn-outline" style="padding: 0.35rem 0.75rem; font-size: 0.8rem;" @onclick="() => TelemetryUi.HydrateFromService()">
            🔄 Refresh History
        </button>
    </div>

    @if (_activeTab == "llm")
    {
        <LlmCallsHistoryTable OnSelectCall="HandleSelectLlmCall" />
    }
    else
    {
        <ShellOperationsFeed OnSelectCommand="HandleSelectShellCommand" />
    }
</div>

<!-- Modals -->
<InferenceInspectionModal Call="TelemetryUi.SelectedLlmCall" OnClose="() => TelemetryUi.SelectedLlmCall = null" />
<ShellCommandOutputModal Command="TelemetryUi.SelectedShellCommand" OnClose="() => TelemetryUi.SelectedShellCommand = null" />

@code {
    [Parameter] public int? TaskId { get; set; }

    private string _activeTab = "llm";

    protected override async Task OnInitializedAsync()
    {
        TelemetryUi.OnChange += HandleTelemetryChanged;
        HubClient.OnConnectionStateChanged += HandleConnectionStateChanged;

        try
        {
            await HubClient.StartAsync();
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Failed to connect OrchestratorHub on Monitoring page initialization; will retry on demand or reconnect.");
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (TaskId.HasValue && TaskId.Value > 0)
        {
            Navigation.NavigateTo($"/inspector/{TaskId.Value}", replace: true);
        }
    }

    private void HandleTelemetryChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void HandleConnectionStateChanged(Microsoft.AspNetCore.SignalR.Client.HubConnectionState state)
    {
        InvokeAsync(StateHasChanged);
    }

    private void HandleSelectLlmCall(LlmCallRecord call)
    {
        TelemetryUi.SelectedLlmCall = call;
        StateHasChanged();
    }

    private void HandleSelectShellCommand(ShellCommandRecord command)
    {
        TelemetryUi.SelectedShellCommand = command;
        StateHasChanged();
    }

    private async Task ReconnectAsync()
    {
        try
        {
            await HubClient.StartAsync();
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Manual SignalR reconnect failed on Monitoring page.");
        }
        StateHasChanged();
    }

    private string GetConnectionBadgeClass() => HubClient.State switch
    {
        Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connected => "badge-teal",
        Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connecting or
        Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Reconnecting => "badge-amber",
        _ => "badge-crimson"
    };

    private string GetConnectionDot() => HubClient.State switch
    {
        Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connected => "●",
        Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connecting or
        Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Reconnecting => "◐",
        _ => "○"
    };

    private string GetConnectionText() => HubClient.State switch
    {
        Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connected => "SignalR Live",
        Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connecting => "Connecting...",
        Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Reconnecting => "Reconnecting...",
        _ => "SignalR Offline"
    };

    public async ValueTask DisposeAsync()
    {
        TelemetryUi.OnChange -= HandleTelemetryChanged;
        HubClient.OnConnectionStateChanged -= HandleConnectionStateChanged;
    }
}

@page "/backlog"
@namespace NightCodeForge.Web.Components.Pages
@using NightCodeForge.Core.Dependencies
@using NightCodeForge.Core.Domain
@using NightCodeForge.Core.Repositories
@using NightCodeForge.Core.Workflow
@using NightCodeForge.Web.Components.Backlog
@using NightCodeForge.Web.Components.Workspaces
@using NightCodeForge.Web.Services
@inject WorkspaceStateService WorkspaceState
@inject ITaskRepository TaskRepository
@inject ITaskDependencyStore DependencyStore
@inject OrchestratorHubClientConnection HubConnection
@inject ToastService ToastService
@inject ITaskDiskSyncCoordinator DiskSyncCoordinator
@inject NavigationManager Navigation
@inject ILogger<Backlog> Logger
@inject WorkerStateService WorkerState
@inject NightCodeForge.Core.Interfaces.IOperationsControlService OperationsControl
@implements IDisposable

<PageTitle>Backlog &amp; DAG - NightCodeForge</PageTitle>

<div class="backlog-page-container">
    @if (WorkspaceState.ActiveWorkspace == null)
    {
        <WorkspaceEmptyStateHero />
    }
    else
    {
        @if (OperationsControl.IsPaused)
        {
            <div class="alert alert-warning d-flex align-items-center mb-3" role="alert" id="backlog-paused-banner" style="background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.4); color: #fbbf24; border-radius: var(--radius-md); padding: 0.75rem 1rem;">
                <span class="me-2" style="font-size: 1.25rem;">⏸️</span>
                <div>
                    <strong>Global Operations Paused (Gamer / Dedicated Workload Mode):</strong> Task execution and queue advancement are currently suspended. Host GPU VRAM is reclaimed. Click "Resume Operations" in the top bar to resume execution.
                </div>
            </div>
        }

        <!-- Page Header & Action Controls -->
        <div class="backlog-header">
            <div class="backlog-header-left">
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <span style="font-size: 1.85rem;">📋</span>
                    <div>
                        <h1 style="margin: 0; font-size: 1.5rem; font-weight: 700; color: var(--text-primary);">Backlog &amp; Visual DAG</h1>
                        <p style="margin: 0.2rem 0 0 0; font-size: 0.875rem; color: var(--text-secondary);">
                            Interactive dependency graphs, priority queues, and deterministic execution pipelines for
                            <strong style="color: var(--accent-indigo);">@WorkspaceState.ActiveWorkspace.Name</strong>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Header Right Controls -->
            <div class="backlog-header-right">
                <!-- View Mode Switcher -->
                <div class="view-mode-toggle card-glass">
                    <button type="button"
                            class="view-toggle-btn @(_currentView == BacklogViewMode.Kanban ? "active" : "")"
                            @onclick="() => SetView(BacklogViewMode.Kanban)">
                        📊 Kanban Board
                    </button>
                    <button type="button"
                            class="view-toggle-btn @(_currentView == BacklogViewMode.Dag ? "active" : "")"
                            @onclick="() => SetView(BacklogViewMode.Dag)">
                        🕸️ Visual DAG
                    </button>
                </div>

                <a href="/tasks/new" class="forge-btn forge-btn-primary" id="btn-create-task" style="text-decoration: none;">
                    ➕ New Task
                </a>

                <a href="/ideation" class="forge-btn forge-btn-secondary">
                    💡 Ideate / Propose Tasks
                </a>

                <button type="button"
                        class="forge-btn forge-btn-secondary"
                        id="btn-sync-docs-tasks"
                        @onclick="SyncDocsTasksAsync"
                        disabled="@(_isSyncing || _isLoading)"
                        title="Immediate bidirectional synchronization with docs/tasks/*.md">
                    @if (_isSyncing)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="width: 0.85rem; height: 0.85rem; border-width: 0.15em; margin-right: 0.35rem; display: inline-block;"></span>
                        <span>Syncing...</span>
                    }
                    else
                    {
                        <span>⚡ Sync docs/tasks</span>
                    }
                </button>

                <button type="button" class="forge-btn forge-btn-secondary" id="btn-refresh-backlog" @onclick="ReloadTasksAsync" title="Refresh Backlog">
                    🔄 Refresh
                </button>
            </div>
        </div>

        <!-- Metrics & Quick Stats Bar -->
        <div class="backlog-stats-bar">
            <div class="stat-chip @(_statusFilter == null ? "active" : "")" @onclick="() => FilterByStatus(null)">
                <span class="stat-chip-label">Total</span>
                <span class="stat-chip-val">@_allTasks.Count</span>
            </div>
            <div class="stat-chip @(_statusFilter == TaskOverallStatus.Suggested ? "active" : "")" @onclick="() => FilterByStatus(TaskOverallStatus.Suggested)">
                <span class="stat-chip-label">💡 Suggested</span>
                <span class="stat-chip-val text-amber">@_allTasks.Count(t => t.Status == TaskOverallStatus.Suggested)</span>
            </div>
            <div class="stat-chip @(_statusFilter == TaskOverallStatus.Open ? "active" : "")" @onclick="() => FilterByStatus(TaskOverallStatus.Open)">
                <span class="stat-chip-label">📂 Open</span>
                <span class="stat-chip-val text-indigo">@_allTasks.Count(t => BacklogStatusClassifier.IsOpenBacklog(t, WorkerState.Current.ActiveTaskId))</span>
            </div>
            <div class="stat-chip @(_statusFilter == TaskOverallStatus.Reviewed ? "active" : "")" @onclick="() => FilterByStatus(TaskOverallStatus.Reviewed)">
                <span class="stat-chip-label">⚡ In-Flight</span>
                <span class="stat-chip-val text-purple">@_allTasks.Count(t => BacklogStatusClassifier.IsInFlight(t, WorkerState.Current.ActiveTaskId))</span>
            </div>
            <div class="stat-chip @(_statusFilter == TaskOverallStatus.Ready ? "active" : "")" @onclick="() => FilterByStatus(TaskOverallStatus.Ready)">
                <span class="stat-chip-label">🔍 Ready</span>
                <span class="stat-chip-val text-teal">@_allTasks.Count(t => t.Status == TaskOverallStatus.Ready)</span>
            </div>
            <div class="stat-chip @(_statusFilter == TaskOverallStatus.Closed ? "active" : "")" @onclick="() => FilterByStatus(TaskOverallStatus.Closed)">
                <span class="stat-chip-label">✅ Closed</span>
                <span class="stat-chip-val text-emerald">@_allTasks.Count(t => t.Status == TaskOverallStatus.Closed)</span>
            </div>
            <div class="stat-chip @(_statusFilter == TaskOverallStatus.Rejected ? "active" : "")" @onclick="() => FilterByStatus(TaskOverallStatus.Rejected)">
                <span class="stat-chip-label">🗑️ Rejected</span>
                <span class="stat-chip-val text-red">@_allTasks.Count(t => t.Status == TaskOverallStatus.Rejected)</span>
            </div>
        </div>

        <!-- Filter & Search Toolbar -->
        <div class="backlog-toolbar">
            <div class="search-input-wrap">
                <span class="search-icon">🔍</span>
                <input type="text"
                       class="form-control-dark backlog-search-input"
                       placeholder="Filter tasks by title, description, or #ID..."
                       @bind="_searchQuery"
                       @bind:event="oninput" />
                @if (!string.IsNullOrWhiteSpace(_searchQuery))
                {
                    <button type="button" class="search-clear-btn" @onclick="() => _searchQuery = string.Empty">✕</button>
                }
            </div>

            <!-- Priority Filter Chips -->
            <div class="priority-filter-chips" style="display: flex; align-items: center; gap: 0.35rem; flex-wrap: wrap;">
                <button type="button"
                        class="stat-chip priority-filter-btn @(_priorityFilter == PriorityFilterMode.All ? "active" : "")"
                        @onclick="() => FilterByPriority(PriorityFilterMode.All)">
                    All
                </button>
                <button type="button"
                        class="stat-chip priority-filter-btn @(_priorityFilter == PriorityFilterMode.P1Critical ? "active" : "")"
                        @onclick="() => FilterByPriority(PriorityFilterMode.P1Critical)"
                        style="@(_priorityFilter == PriorityFilterMode.P1Critical ? "border-color: #ef4444; color: #fca5a5;" : "")">
                    <span class="badge-dot" style="width: 7px; height: 7px; border-radius: 50%; background: #ef4444; display: inline-block;"></span>
                    P1 Critical
                </button>
                <button type="button"
                        class="stat-chip priority-filter-btn @(_priorityFilter == PriorityFilterMode.P1P2HighPlus ? "active" : "")"
                        @onclick="() => FilterByPriority(PriorityFilterMode.P1P2HighPlus)"
                        style="@(_priorityFilter == PriorityFilterMode.P1P2HighPlus ? "border-color: #f97316; color: #fed7aa;" : "")">
                    <span class="badge-dot" style="width: 7px; height: 7px; border-radius: 50%; background: #f97316; display: inline-block;"></span>
                    P1–P2 High+
                </button>
                <button type="button"
                        class="stat-chip priority-filter-btn @(_priorityFilter == PriorityFilterMode.P3Normal ? "active" : "")"
                        @onclick="() => FilterByPriority(PriorityFilterMode.P3Normal)"
                        style="@(_priorityFilter == PriorityFilterMode.P3Normal ? "border-color: #3b82f6; color: #93c5fd;" : "")">
                    <span class="badge-dot" style="width: 7px; height: 7px; border-radius: 50%; background: #3b82f6; display: inline-block;"></span>
                    P3 Normal
                </button>
                <button type="button"
                        class="stat-chip priority-filter-btn @(_priorityFilter == PriorityFilterMode.P4P5Low ? "active" : "")"
                        @onclick="() => FilterByPriority(PriorityFilterMode.P4P5Low)"
                        style="@(_priorityFilter == PriorityFilterMode.P4P5Low ? "border-color: #64748b; color: #cbd5e1;" : "")">
                    <span class="badge-dot" style="width: 7px; height: 7px; border-radius: 50%; background: #64748b; display: inline-block;"></span>
                    P4–P5 Low
                </button>
            </div>

            <div class="toolbar-right-filters">
                <select class="form-control-dark toolbar-filter-select"
                        value="@(_statusFilter?.ToString() ?? "ALL")"
                        @onchange="OnStatusFilterSelectChanged">
                    <option value="ALL">All Statuses</option>
                    <option value="@TaskOverallStatus.Suggested">Suggested (Triage)</option>
                    <option value="@TaskOverallStatus.Open">Open (Backlog)</option>
                    <option value="@TaskOverallStatus.Reviewed">In-Flight (Reviewed)</option>
                    <option value="@TaskOverallStatus.Implemented">In-Flight (Implemented)</option>
                    <option value="@TaskOverallStatus.Ready">Ready for Review</option>
                    <option value="@TaskOverallStatus.Closed">Closed &amp; Merged</option>
                    <option value="@TaskOverallStatus.Rejected">Rejected / Archived</option>
                    <option value="@TaskOverallStatus.Cancelled">Cancelled</option>
                    <option value="@TaskOverallStatus.Failed">Failed</option>
                </select>
            </div>
        </div>

        <!-- Main View Area -->
        <div class="backlog-main-surface">
            @{
                var filtered = GetFilteredTasks();
            }

            @if (_isLoading)
            {
                <div class="backlog-loading-state card-glass">
                    <span class="status-dot running"></span>
                    <span>Synchronizing workspace backlog and DAG topology...</span>
                </div>
            }
            else if (_currentView == BacklogViewMode.Kanban)
            {
                <KanbanBoard Tasks="filtered"
                             TaskDependencies="_dependenciesMap"
                             ActiveTaskId="@WorkerState.Current.ActiveTaskId"
                             OnTaskSelected="OpenTask"
                             OnInspectTask="OpenInspector"
                             OnPromoteTask="OpenPromoteModal"
                             OnRejectTask="OpenRejectModal"
                             OnLinkDependencies="OpenDependencyModal"
                             OnPriorityChanged="HandlePriorityChanged" />
            }
            else
            {
                <DagVisualizer Tasks="filtered"
                               Dependencies="_allDependencies"
                               ActiveTaskId="@WorkerState.Current.ActiveTaskId"
                               OnTaskSelected="OpenTask"
                               OnLinkDependencies="OpenDependencyModal" />
            }
        </div>

        <!-- Modals -->
        <TaskCreationModal IsOpen="_showCreateModal"
                           WorkspaceId="@(WorkspaceState.ActiveWorkspace?.Id ?? 0)"
                           DefaultBaseBranch="@(WorkspaceState.ActiveWorkspace?.DefaultBaseBranch)"
                           DefaultWorkflowId="@(WorkspaceState.ActiveWorkspace?.DefaultWorkflowId)"
                           RepositoryPath="@(WorkspaceState.ActiveWorkspace?.RepositoryPath)"
                           OnClosed="() => _showCreateModal = false"
                           OnTaskCreated="HandleTaskCreated" />

        <MaintainerPromotionModal IsOpen="_showPromoteModal"
                                  TargetTask="_selectedTask"
                                  OnClosed="ClosePromoteModal"
                                  OnPromoted="ReloadTasksAsync" />

        <DependencyLinkingModal IsOpen="_showDepModal"
                                TargetTask="_selectedTask"
                                AllTasks="_allTasks"
                                AllDependencies="_allDependencies"
                                OnClosed="CloseDepModal"
                                OnSaved="ReloadTasksAsync" />

        <TaskRejectionModal IsOpen="_showRejectModal"
                            TargetTask="_selectedTask"
                            OnClosed="CloseRejectModal"
                            OnRejected="ReloadTasksAsync" />
    }
</div>

@code {
    private enum BacklogViewMode { Kanban, Dag }

    public enum PriorityFilterMode
    {
        All,
        P1Critical,
        P1P2HighPlus,
        P3Normal,
        P4P5Low
    }

    private BacklogViewMode _currentView = BacklogViewMode.Kanban;
    private List<ForgeTask> _allTasks = new();
    private List<(int TaskId, int DependsOnTaskId)> _allDependencies = new();
    private Dictionary<int, IReadOnlyList<int>> _dependenciesMap = new();

    private string _searchQuery = string.Empty;
    private TaskOverallStatus? _statusFilter;
    private PriorityFilterMode _priorityFilter = PriorityFilterMode.All;
    private bool _isLoading = false;
    private bool _isSyncing = false;
    private bool _disposed;

    // Modals state
    private ForgeTask? _selectedTask;
    private bool _showCreateModal;
    private bool _showPromoteModal;
    private bool _showDepModal;
    private bool _showRejectModal;

    private async Task HandleTaskCreated(ForgeTask createdTask)
    {
        _showCreateModal = false;
        await ReloadTasksAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        WorkspaceState.OnWorkspaceChanged += HandleWorkspaceChanged;
        WorkerState.OnWorkerStateChanged += HandleWorkerStateChanged;

        HubConnection.OnStageTransitionReceived += HandleStageTransition;
        HubConnection.OnDeterministicGateResultReceived += HandleGateResult;
        HubConnection.OnWorkerStatusReceived += HandleWorkerStatus;
        OperationsControl.OnOperationsStateChanged += HandleOperationsStateChanged;

        try
        {
            await HubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Hub connection notice: {Message}", ex.Message);
        }

        await LoadDataAsync();
    }

    private void HandleWorkspaceChanged()
    {
        if (_disposed) return;
        _ = InvokeAsync(async () =>
        {
            try
            {
                if (_disposed) return;
                _selectedTask = null;
                _showPromoteModal = false;
                _showDepModal = false;
                await LoadDataAsync();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to update backlog on workspace change.");
                ToastService.Show("Error", "Failed to update backlog.", ToastLevel.Error);
            }
        });
    }

    private void HandleStageTransition(int taskId, string stageId, string stageKind, string status)
    {
        if (_disposed) return;
        _ = InvokeAsync(async () =>
        {
            try
            {
                if (_disposed) return;
                await LoadDataAsync();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to refresh backlog on stage transition for task #{TaskId}.", taskId);
            }
        });
    }

    private void HandleGateResult(int taskId, string gateName, bool passed, string metricsSummary)
    {
        if (_disposed) return;
        _ = InvokeAsync(async () =>
        {
            try
            {
                if (_disposed) return;
                await LoadDataAsync();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to refresh backlog on gate result for task #{TaskId}.", taskId);
            }
        });
    }

    private void HandleWorkerStateChanged()
    {
        if (_disposed) return;
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleWorkerStatus(string status, int? activeTaskId, string? stageId, string hardwareTarget)
    {
        if (_disposed) return;
        WorkerState.HandleWorkerStatus(status, activeTaskId, stageId, hardwareTarget);
        _ = InvokeAsync(async () =>
        {
            try
            {
                if (_disposed) return;
                await LoadDataAsync();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to refresh backlog on worker status update.");
            }
        });
    }

    private async Task LoadDataAsync()
    {
        var active = WorkspaceState.ActiveWorkspace;
        if (active == null)
        {
            _allTasks.Clear();
            _allDependencies.Clear();
            _dependenciesMap.Clear();
            return;
        }

        _isLoading = true;
        try
        {
            var tasks = await TaskRepository.GetByWorkspaceIdAsync(active.Id);
            _allTasks = tasks.OrderBy(t => t.Priority).ThenBy(t => t.CreatedAt).ToList();

            var deps = await DependencyStore.GetDependenciesForWorkspaceAsync(active.Id);
            _allDependencies = deps.ToList();

            var map = new Dictionary<int, IReadOnlyList<int>>();
            foreach (var task in _allTasks)
            {
                var prereqIds = _allDependencies
                    .Where(d => d.TaskId == task.Id)
                    .Select(d => d.DependsOnTaskId)
                    .ToList();
                map[task.Id] = prereqIds;
            }
            _dependenciesMap = map;

            // If a task is selected in the drawer, keep its instance updated
            if (_selectedTask != null)
            {
                _selectedTask = _allTasks.FirstOrDefault(t => t.Id == _selectedTask.Id);
            }
        }
        catch (Exception ex)
        {
            ToastService.Show("Backlog Sync Error", ex.Message, ToastLevel.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ReloadTasksAsync()
    {
        await LoadDataAsync();
        StateHasChanged();
    }

    private async Task SyncDocsTasksAsync()
    {
        var active = WorkspaceState.ActiveWorkspace;
        if (active == null || _isSyncing)
        {
            return;
        }

        _isSyncing = true;
        try
        {
            var result = await DiskSyncCoordinator.SyncWorkspaceDocsTasksAsync(active);
            await LoadDataAsync();
            var message = result.TasksWrittenToDisk > 0 || result.TasksIngestedOrUpdatedFromDisk > 0
                ? $"Successfully synced {result.TasksWrittenToDisk} task(s) with docs/tasks/ ({result.TasksIngestedOrUpdatedFromDisk} read from disk)."
                : "docs/tasks/ and database are in lockstep.";
            ToastService.Show("docs/tasks Synchronized", message, ToastLevel.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to synchronize docs/tasks for workspace {WorkspaceId}.", active.Id);
            ToastService.Show("docs/tasks Sync Error", ex.Message, ToastLevel.Error);
        }
        finally
        {
            _isSyncing = false;
            StateHasChanged();
        }
    }

    private void SetView(BacklogViewMode mode)
    {
        _currentView = mode;
    }

    private void FilterByStatus(TaskOverallStatus? status)
    {
        _statusFilter = status;
    }

    private void FilterByPriority(PriorityFilterMode mode)
    {
        _priorityFilter = mode;
    }

    private void OnStatusFilterSelectChanged(ChangeEventArgs e)
    {
        var str = e.Value?.ToString();
        if (string.IsNullOrEmpty(str) || str == "ALL")
        {
            _statusFilter = null;
        }
        else if (Enum.TryParse<TaskOverallStatus>(str, out var parsed))
        {
            _statusFilter = parsed;
        }
    }

    private List<ForgeTask> GetFilteredTasks()
    {
        var query = _allTasks.AsEnumerable();

        if (_statusFilter.HasValue)
        {
            if (_statusFilter == TaskOverallStatus.Reviewed || _statusFilter == TaskOverallStatus.Implemented)
            {
                // Group In-Flight stages
                query = query.Where(t => BacklogStatusClassifier.IsInFlight(t, WorkerState.Current.ActiveTaskId));
            }
            else if (_statusFilter == TaskOverallStatus.Open)
            {
                query = query.Where(t => BacklogStatusClassifier.IsOpenBacklog(t, WorkerState.Current.ActiveTaskId));
            }
            else
            {
                query = query.Where(t => t.Status == _statusFilter.Value);
            }
        }

        if (_priorityFilter == PriorityFilterMode.P1Critical)
        {
            query = query.Where(t => t.Priority == TaskPriority.Critical);
        }
        else if (_priorityFilter == PriorityFilterMode.P1P2HighPlus)
        {
            query = query.Where(t => t.Priority <= TaskPriority.High);
        }
        else if (_priorityFilter == PriorityFilterMode.P3Normal)
        {
            query = query.Where(t => t.Priority == TaskPriority.Normal);
        }
        else if (_priorityFilter == PriorityFilterMode.P4P5Low)
        {
            query = query.Where(t => t.Priority >= TaskPriority.Low);
        }

        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            var q = _searchQuery.Trim();
            if (int.TryParse(q.TrimStart('#'), out var idQuery))
            {
                query = query.Where(t => t.Id == idQuery || t.Title.Contains(q, StringComparison.OrdinalIgnoreCase));
            }
            else
            {
                query = query.Where(t =>
                    t.Title.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    t.Description.Contains(q, StringComparison.OrdinalIgnoreCase));
            }
        }

        return query.ToList();
    }

    private IReadOnlyList<int> GetPrerequisitesForSelected()
    {
        if (_selectedTask == null) return Array.Empty<int>();
        return _dependenciesMap.TryGetValue(_selectedTask.Id, out var deps) ? deps : Array.Empty<int>();
    }

    private IReadOnlyList<int> GetDependentsForSelected()
    {
        if (_selectedTask == null) return Array.Empty<int>();
        return _allDependencies
            .Where(d => d.DependsOnTaskId == _selectedTask.Id)
            .Select(d => d.TaskId)
            .Distinct()
            .ToList();
    }

    private void OpenTask(ForgeTask task)
    {
        Navigation.NavigateTo($"/tasks/{task.Id}");
    }

    private void OpenInspector(ForgeTask task)
    {
        Navigation.NavigateTo($"/inspector/{task.Id}");
    }

    private void OpenPromoteModal(ForgeTask task)
    {
        _selectedTask = task;
        _showPromoteModal = true;
    }

    private void ClosePromoteModal()
    {
        _showPromoteModal = false;
    }

    private void OpenRejectModal(ForgeTask task)
    {
        _selectedTask = task;
        _showRejectModal = true;
    }

    private void CloseRejectModal()
    {
        _showRejectModal = false;
    }

    private void OpenDependencyModal(ForgeTask task)
    {
        _selectedTask = task;
        _showDepModal = true;
    }

    private void CloseDepModal()
    {
        _showDepModal = false;
    }

    private async Task HandlePriorityChanged((ForgeTask Task, int NewPriority) args)
    {
        await ReloadTasksAsync();
    }

    private void HandleOperationsStateChanged(bool isPaused)
    {
        if (_disposed) return;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _disposed = true;
        WorkspaceState.OnWorkspaceChanged -= HandleWorkspaceChanged;
        WorkerState.OnWorkerStateChanged -= HandleWorkerStateChanged;
        HubConnection.OnStageTransitionReceived -= HandleStageTransition;
        HubConnection.OnDeterministicGateResultReceived -= HandleGateResult;
        HubConnection.OnWorkerStatusReceived -= HandleWorkerStatus;
        OperationsControl.OnOperationsStateChanged -= HandleOperationsStateChanged;
    }
}

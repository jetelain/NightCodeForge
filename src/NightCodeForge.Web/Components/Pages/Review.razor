@page "/review"
@page "/review/{TaskId:int}"
@using NightCodeForge.Core.Domain
@using NightCodeForge.Core.Workflow
@using NightCodeForge.Web.Components.Review
@using NightCodeForge.Web.Services
@inject ITaskOrchestrator TaskOrchestrator
@inject ITaskRepository TaskRepository
@inject ITaskReviewService TaskReviewService
@inject ReviewCommentStateService CommentState
@inject ToastService ToastService
@inject NavigationManager NavigationManager
@inject WorkspaceStateService WorkspaceState
@implements IDisposable

<PageTitle>Review Room - NightCodeForge</PageTitle>

<div class="review-room-container">
    @if (_isLoading)
    {
        <div class="card-surface p-5 text-center" id="review-loading-state">
            <span class="text-secondary">Loading review snapshot...</span>
        </div>
    }
    else if (_snapshot == null)
    {
        <div class="card-surface p-5 text-center" id="review-empty-state">
            <div style="font-size: 2.5rem; margin-bottom: 0.75rem;">🔍</div>
            <h3>No Tasks Awaiting Review</h3>
            <p class="text-secondary mb-3">Tasks in <code>Ready</code> status will appear here for maintainer code review and merge gate resolution.</p>
            <a href="/backlog" class="btn btn-secondary">Go to Backlog</a>
        </div>
    }
    else
    {
        <!-- Task Switcher (if multiple pending reviews exist) -->
        @if (_pendingReviews.Count > 1)
        {
            <div class="d-flex align-items-center justify-content-between mb-2 p-2 card-surface" style="font-size: 0.85rem;" id="task-switcher-bar">
                <span class="text-secondary">Pending Reviews (@_pendingReviews.Count):</span>
                <div class="d-flex gap-2">
                    @foreach (var review in _pendingReviews)
                    {
                        <button class="btn btn-sm @(review.TaskId == _snapshot.TaskId ? "btn-primary" : "btn-secondary")"
                                @onclick="() => SwitchTask(review.TaskId)">
                            #@review.TaskId: @Truncate(review.Title, 25)
                        </button>
                    }
                </div>
            </div>
        }

        @if (!TaskReviewService.IsPendingReview(_snapshot) && _snapshot.Status != TaskOverallStatus.Closed)
        {
            <div class="alert alert-info mb-3 p-3 d-flex align-items-center justify-content-between gap-3" id="alert-in-flight-review" style="border-left: 4px solid var(--accent-indigo, #6366f1); background-color: rgba(99, 102, 241, 0.1); border-radius: var(--radius-sm, 4px);">
                <div class="d-flex align-items-center gap-3">
                    <span style="font-size: 1.5rem;">⚙️</span>
                    <div>
                        <strong>Automated Quality Gates In-Flight</strong>
                        <div style="font-size: 0.9rem; margin-top: 0.25rem;">
                            Task #@_snapshot.TaskId is currently undergoing automated quality gates and code review before entering the Review Room.
                        </div>
                    </div>
                </div>
                <a href="/inspector/@_snapshot.TaskId" class="btn btn-sm btn-primary" style="white-space: nowrap;">
                    🔍 View in Inspector
                </a>
            </div>
        }

        @if (TaskReviewService.ShouldDisplayConflictResolvedBanner(_snapshot))
        {
            <div class="alert alert-warning mb-3 p-3 d-flex align-items-center gap-3" id="alert-re-review-conflict" style="border-left: 4px solid var(--accent-amber, #f59e0b); background-color: rgba(245, 158, 11, 0.1); border-radius: var(--radius-sm, 4px);">
                <span style="font-size: 1.5rem;">⚠️</span>
                <div>
                    <strong>@ConflictResolutionConstants.ReReviewBannerTitle</strong>
                    <div style="font-size: 0.9rem; margin-top: 0.25rem;">
                        @string.Format(ConflictResolutionConstants.ReReviewBannerMessageFormat, _snapshot.BaseBranch)
                    </div>
                </div>
            </div>
        }

        <!-- 1. Header & Quality Gate Summary Strip -->
        <div class="review-header card-surface mb-3" id="review-header-section">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h2>Review: ForgeTask #@_snapshot.TaskId - @_snapshot.Title</h2>
                    <div class="mt-2 d-flex align-items-center flex-wrap gap-1">
                        <span class="badge-branch"><code>@_snapshot.FeatureBranch</code> ➔ <code>@_snapshot.BaseBranch</code></span>
                        <span class="badge-mode">Mode: @_snapshot.MergeMode</span>
                        <span class="badge-status @GetStatusBadgeClass(_snapshot.Status)">Status: @_snapshot.Status</span>
                        @if (CommentState.CommentCount > 0)
                        {
                            <span class="badge-amber" id="header-comment-badge" style="padding: 0.25rem 0.6rem; border-radius: var(--radius-sm); font-size: 0.8rem;">
                                💬 @CommentState.CommentCount comments drafted
                            </span>
                        }
                    </div>
                </div>
                <div class="review-actions d-flex align-items-center gap-2">
                    <a href="/inspector/@_snapshot.TaskId" class="btn btn-secondary btn-sm" id="btn-header-inspector" title="Open Task Inspector">
                        🔍 Task Inspector
                    </a>
                    <a href="/tasks/@_snapshot.TaskId" class="btn btn-secondary btn-sm" id="btn-header-task-details" title="Open Task Details">
                        📄 Task Details
                    </a>
                    @if (_snapshot.MergeMode == MergeMode.Automatic && _snapshot.Status == TaskOverallStatus.Closed)
                    {
                        <span class="badge-success-large" id="badge-auto-merged">✅ Auto-Merged to @_snapshot.BaseBranch</span>
                    }
                    else if (_snapshot.Status == TaskOverallStatus.Closed)
                    {
                        <span class="badge-success-large" id="badge-merged">✅ Merged to @_snapshot.BaseBranch</span>
                    }
                    else if (TaskReviewService.IsPendingReview(_snapshot))
                    {
                        <button class="btn btn-warning-outline" id="btn-request-changes" @onclick="OpenChangeRequestModal">
                            📝 Request Changes @(CommentState.CommentCount > 0 ? $"({CommentState.CommentCount})" : "")
                        </button>
                        <button class="btn btn-success" id="btn-approve-merge" @onclick="OpenApproveModal">
                            🚀 Approve &amp; Merge
                        </button>
                    }
                </div>
            </div>

            <!-- Deterministic Quality Gate Metrics Cards -->
            <div class="gate-metrics-grid mt-3" id="gate-metrics-grid">
                <div class="gate-card @(_snapshot.GateMetrics.CoverageDelta >= 0 ? "gate-pass" : "gate-fail")" id="card-metric-coverage">
                    <span class="gate-title">Code Coverage</span>
                    <span class="gate-value">@_snapshot.GateMetrics.CurrentCoverage.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%</span>
                    <span class="gate-delta @(_snapshot.GateMetrics.CoverageDelta >= 0 ? "delta-positive" : "delta-negative")">
                        @(_snapshot.GateMetrics.CoverageDelta >= 0 ? "+" : "")@_snapshot.GateMetrics.CoverageDelta.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%
                    </span>
                </div>

                <div class="gate-card @(_snapshot.GateMetrics.WarningDelta <= 0 ? "gate-pass" : "gate-fail")" id="card-metric-warnings">
                    <span class="gate-title">Compiler Warnings</span>
                    <span class="gate-value">@_snapshot.GateMetrics.CurrentWarnings</span>
                    <span class="gate-delta @(_snapshot.GateMetrics.WarningDelta <= 0 ? "delta-positive" : "delta-negative")">
                        @(_snapshot.GateMetrics.WarningDelta > 0 ? "+" : "")@_snapshot.GateMetrics.WarningDelta
                    </span>
                </div>

                <div class="gate-card @(_snapshot.GateMetrics.FailedTests == 0 ? "gate-pass" : "gate-fail")" id="card-metric-tests">
                    <span class="gate-title">Test Suite</span>
                    <span class="gate-value">@_snapshot.GateMetrics.PassedTests / @_snapshot.GateMetrics.TotalTests</span>
                    <span class="gate-delta text-muted">@(_snapshot.GateMetrics.DurationMs)ms</span>
                </div>
            </div>
        </div>

        <!-- 2. Diff Navigation & DiffPlex Canvas -->
        <DiffWorkspace Files="_snapshot.Files" SelectedFile="_selectedFile" SelectedFileChanged="SelectFile" />
    }
</div>

@if (_showChangeRequestModal && _snapshot != null)
{
    <ChangeRequestModal
        TaskId="@_snapshot.TaskId"
        OnSubmitted="HandleChangesRequestedAsync"
        OnClosed="() => _showChangeRequestModal = false" />
}

@if (_showApproveModal && _snapshot != null)
{
    <ApproveMergeModal
        TaskId="@_snapshot.TaskId"
        BaseBranch="@_snapshot.BaseBranch"
        TaskTitle="@_snapshot.Title"
        OnApproved="HandleApprovedAsync"
        OnClosed="() => _showApproveModal = false" />
}

@code {
    [Parameter] public int? TaskId { get; set; }

    private TaskReviewSnapshot? _snapshot;
    private IReadOnlyList<TaskReviewSnapshot> _pendingReviews = Array.Empty<TaskReviewSnapshot>();
    private FileDiffSummary? _selectedFile;
    private bool _showChangeRequestModal;
    private bool _showApproveModal;
    private bool _isLoading = true;
    private bool _disposed;

    protected override void OnInitialized()
    {
        CommentState.OnCommentsChanged += HandleCommentsChanged;
        WorkspaceState.OnWorkspaceChanged += HandleWorkspaceChanged;
    }

    private void HandleCommentsChanged()
    {
        if (_disposed) return;
        InvokeAsync(() =>
        {
            if (!_disposed) StateHasChanged();
        });
    }

    private void HandleWorkspaceChanged()
    {
        if (_disposed) return;
        InvokeAsync(async () =>
        {
            if (_disposed) return;
            await LoadReviewDataAsync();
            if (!_disposed) StateHasChanged();
        });
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadReviewDataAsync();
    }

    private async Task LoadReviewDataAsync()
    {
        _isLoading = true;
        try
        {
            var workspaceId = WorkspaceState.ActiveWorkspaceId;
            _pendingReviews = await TaskReviewService.GetPendingReviewsAsync(workspaceId);

            if (TaskId.HasValue)
            {
                _snapshot = await TaskReviewService.GetSnapshotAsync(TaskId.Value);
            }
            else if (_pendingReviews.Count > 0)
            {
                _snapshot = _pendingReviews[0];
            }
            else
            {
                _snapshot = null;
            }

            if (_snapshot != null && _snapshot.Files.Count > 0)
            {
                if (_selectedFile == null || !_snapshot.Files.Any(f => f.Path == _selectedFile.Path))
                {
                    _selectedFile = _snapshot.Files[0];
                }
            }
            else
            {
                _selectedFile = null;
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void SelectFile(FileDiffSummary file)
    {
        _selectedFile = file;
    }

    private void SwitchTask(int taskId)
    {
        NavigationManager.NavigateTo($"/review/{taskId}");
    }

    private void OpenChangeRequestModal()
    {
        _showChangeRequestModal = true;
    }

    private void OpenApproveModal()
    {
        _showApproveModal = true;
    }

    private async Task HandleChangesRequestedAsync()
    {
        _showChangeRequestModal = false;
        await LoadReviewDataAsync();
    }

    private async Task HandleApprovedAsync()
    {
        _showApproveModal = false;
        await LoadReviewDataAsync();
    }

    private string GetStatusBadgeClass(TaskOverallStatus status) => status switch
    {
        TaskOverallStatus.Ready => "badge-status-ready",
        TaskOverallStatus.Closed => "badge-status-closed",
        TaskOverallStatus.Implemented => "badge-status-implemented",
        TaskOverallStatus.Reviewed => "badge-status-reviewed",
        _ => "badge-indigo"
    };

    private static string Truncate(string value, int maxLen) =>
        value.Length <= maxLen ? value : value[..maxLen] + "…";

    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;

        CommentState.OnCommentsChanged -= HandleCommentsChanged;
        WorkspaceState.OnWorkspaceChanged -= HandleWorkspaceChanged;
    }
}

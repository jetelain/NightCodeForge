@page "/settings"
@using NightCodeForge.Web.Components.Settings
@using NightCodeForge.Web.Components.Workspaces
@using NightCodeForge.Web.Services
@inject WorkspaceStateService WorkspaceState

<PageTitle>Settings &amp; Optimizations - NightCodeForge</PageTitle>

<div class="page-header mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="d-flex align-items-center gap-2">
            <span style="font-size: 1.75rem;">⚙️</span>
            <div>
                <h1 style="margin: 0; font-size: 1.5rem; font-weight: 700;">Settings &amp; Optimizations</h1>
                <p class="text-secondary mb-0">System defaults, workspace sandboxes, agent reasoning profiles, and model experimentation.</p>
            </div>
        </div>

        <!-- Scope Switcher Pill Bar -->
        <div class="scope-switcher" style="display: flex; background: var(--bg-surface-elevated); padding: 0.25rem; border-radius: var(--radius-lg); border: 1px solid var(--border-subtle); gap: 0.25rem;">
            <button type="button" 
                    class="forge-btn @(_activeScope == SettingsScope.Global ? "forge-btn-primary" : "forge-btn-ghost")" 
                    style="font-size: 0.85rem; padding: 0.35rem 0.85rem;"
                    @onclick="() => SetScope(SettingsScope.Global)">
                🌐 Global System Settings
            </button>
            <button type="button" 
                    class="forge-btn @(_activeScope == SettingsScope.Workspace ? "forge-btn-primary" : "forge-btn-ghost")" 
                    style="font-size: 0.85rem; padding: 0.35rem 0.85rem;"
                    @onclick="() => SetScope(SettingsScope.Workspace)">
                🏢 Workspace Settings @(WorkspaceState.ActiveWorkspace != null ? $"({WorkspaceState.ActiveWorkspace.Name})" : "(None)")
            </button>
        </div>
    </div>
</div>

@if (_activeScope == SettingsScope.Global)
{
    <!-- Global Tabs -->
    <div class="settings-tabs mb-4" style="display: flex; gap: 0.5rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.75rem; overflow-x: auto;">
        <button type="button" class="forge-btn @(_activeGlobalTab == "optimizations" ? "forge-btn-primary" : "forge-btn-outline")" @onclick='() => _activeGlobalTab = "optimizations"'>
            ⚡ Local LLM Optimizations
        </button>
        <button type="button" class="forge-btn @(_activeGlobalTab == "profiles" ? "forge-btn-primary" : "forge-btn-outline")" @onclick='() => _activeGlobalTab = "profiles"'>
            🤖 Global Agent Profiles
        </button>
        <button type="button" class="forge-btn @(_activeGlobalTab == "sdks" ? "forge-btn-primary" : "forge-btn-outline")" @onclick='() => _activeGlobalTab = "sdks"'>
            🔍 Host SDK Inspector
        </button>
        <button type="button" class="forge-btn @(_activeGlobalTab == "ollamarouter" ? "forge-btn-primary" : "forge-btn-outline")" @onclick='() => _activeGlobalTab = "ollamarouter"'>
            🦙 OllamaRouter Gateway &amp; VRAM
        </button>
        <button type="button" class="forge-btn @(_activeGlobalTab == "abtesting" ? "forge-btn-primary" : "forge-btn-outline")" @onclick='() => _activeGlobalTab = "abtesting"'>
            📊 A/B Testing Comparator
        </button>
    </div>

    <div class="settings-tab-content">
        @switch (_activeGlobalTab)
        {
            case "optimizations":
                <GlobalOptimizationSettingsTab />
                break;
            case "profiles":
                <AgentProfilesTab Scope="AgentProfilesTab.ProfileScope.Global" />
                break;
            case "sdks":
                <HostSdkInspectorTab />
                break;
            case "ollamarouter":
                <OllamaRouterGatewayCard />
                break;
            case "abtesting":
                <ABTestingComparatorTab />
                break;
        }
    </div>
}
else
{
    <!-- Workspace Scope -->
    @if (WorkspaceState.ActiveWorkspace != null)
    {
        <div class="settings-tabs mb-4" style="display: flex; gap: 0.5rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.75rem; overflow-x: auto;">
            <button type="button" class="forge-btn @(_activeWorkspaceTab == "confinement" ? "forge-btn-primary" : "forge-btn-outline")" @onclick='() => _activeWorkspaceTab = "confinement"'>
                🏢 Confinement &amp; Sandboxing
            </button>
            <button type="button" class="forge-btn @(_activeWorkspaceTab == "profiles" ? "forge-btn-primary" : "forge-btn-outline")" @onclick='() => _activeWorkspaceTab = "profiles"'>
                🤖 Workspace Agent Profiles
            </button>
        </div>

        <div class="settings-tab-content">
            @switch (_activeWorkspaceTab)
            {
                case "confinement":
                    <WorkspaceSettingsTab />
                    break;
                case "profiles":
                    <AgentProfilesTab Scope="AgentProfilesTab.ProfileScope.Workspace" 
                                      WorkspaceId="@WorkspaceState.ActiveWorkspace.Id" 
                                      WorkspaceName="@WorkspaceState.ActiveWorkspace.Name" />
                    break;
            }
        </div>
    }
    else
    {
        <div class="forge-card p-5 text-center mt-3">
            <h3>No Active Workspace Selected</h3>
            <p class="text-secondary mb-3">Please select or onboard a repository to configure workspace execution environments and dedicated agent profiles.</p>
            <button type="button" class="forge-btn forge-btn-primary" @onclick="() => WorkspaceState.RequestOpenWizard()">
                🧙 Launch Workspace Creation Wizard
            </button>
        </div>
    }
}

@code {
    public enum SettingsScope { Global, Workspace }
    private SettingsScope _activeScope = SettingsScope.Global;
    private string _activeGlobalTab = "optimizations";
    private string _activeWorkspaceTab = "confinement";

    public void SetScope(SettingsScope scope) => _activeScope = scope;
}

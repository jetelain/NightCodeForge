@page "/settings"

<PageTitle>Settings &amp; A/B - NightCodeForge</PageTitle>

<div class="page-header" style="margin-bottom: 1.5rem;">
    <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span style="font-size: 1.75rem;">⚙️</span>
        <div>
            <h1>Settings, Host SDKs &amp; A/B Testing</h1>
            <p>LLM inference providers, GPU runtime configurations, sandbox mounts, and agent model tournaments.</p>
        </div>
    </div>
</div>

<div class="forge-card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <div style="font-weight: 600; font-size: 1.1rem;">LLM Provider &amp; Model Configurations</div>
        <span class="forge-badge badge-indigo">A/B Evaluation Matrix</span>
    </div>
    <p style="margin-bottom: 1.25rem;">
        Tune temperature, context window size, model fallbacks, Ollama / vLLM local endpoints, and cloud API tokens.
    </p>
    <div style="background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 1rem; font-family: var(--font-mono); font-size: 0.85rem; color: var(--text-secondary);">
        Active Workspace: <span style="color: var(--accent-indigo);">@(WorkspaceState.ActiveWorkspace?.Name ?? "None selected")</span>
    </div>
</div>

@code {
    [Inject]
    private WorkspaceStateService WorkspaceState { get; set; } = default!;
}

</style>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<TranscriptAnalysis> Fleet { get; set; } = Array.Empty<TranscriptAnalysis>();
    [Parameter] public int? TotalAvailableCount { get; set; }
    [Parameter] public int? WindowLimit { get; set; } = TranscriptAnalysisDefaults.DefaultRecentLimit;
    [Parameter] public EventCallback<int?> OnWindowLimitChanged { get; set; }
    [Parameter] public EventCallback<string> OnSelectTranscript { get; set; }

    private string _tableFilter = string.Empty;

    private FleetAggregatedAnalysis Aggregated => TranscriptPresentationHelper.AggregateFleet(Fleet);

    private int EffectiveTotalCount => Math.Max(Fleet.Count, TotalAvailableCount ?? Fleet.Count);
    private string WindowBadgeText => TranscriptPresentationHelper.FormatWindowBadge(Fleet.Count, EffectiveTotalCount, WindowLimit);
    private string WindowSelectValue => WindowLimit.HasValue && WindowLimit.Value > 0
        ? WindowLimit.Value.ToString(CultureInfo.InvariantCulture)
        : string.Empty;

    private long TotalTokens => Aggregated.TotalTokens;
    private long TotalDurationMs => Aggregated.TotalDurationMs;
    private int TotalErrors => Aggregated.TotalErrors;
    private int FrictionSessionsCount => Aggregated.FrictionSessionsCount;

    private IReadOnlyList<string> AllFriction => Aggregated.AllFriction;
    private IReadOnlyList<FleetRecommendationItem> UserCodebaseRecommendations => Aggregated.UserCodebaseRecommendations;
    private IReadOnlyList<FleetRecommendationItem> NightCodeForgeRecommendations => Aggregated.NightCodeForgeRecommendations;

    private IReadOnlyList<TranscriptAnalysis> FilteredFleet =>
        TranscriptPresentationHelper.FilterFleet(Fleet, _tableFilter);

    private async Task HandleWindowLimitChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        int? nextLimit = int.TryParse(raw, NumberStyles.Integer, CultureInfo.InvariantCulture, out var parsed) && parsed > 0
            ? parsed
            : null;
        WindowLimit = nextLimit;
        if (OnWindowLimitChanged.HasDelegate)
        {
            await OnWindowLimitChanged.InvokeAsync(nextLimit);
        }
    }
}

@namespace NightCodeForge.Web.Components.Transcripts
@using Microsoft.JSInterop
@using NightCodeForge.Web.Services
@inject IJSRuntime JSRuntime

<details class="tool-trace @(IsError ? "error" : (IsRunning ? "running" : "completed"))" open="@(IsError || IsRunning || InitiallyExpanded)">
    <summary>
        <span class="tool-trace-title">
            <span>@(ChatPresentationHelper.GetToolIcon(ToolName))</span>
            <span class="font-mono font-semibold">@(ToolName ?? "Tool Invocation")</span>
            @if (!string.IsNullOrWhiteSpace(Arguments))
            {
                <span class="text-muted font-mono tool-summary-text">@ChatPresentationHelper.GetToolSummary(Arguments)</span>
            }
        </span>
        <span class="tool-trace-status" style="display: inline-flex; align-items: center; gap: 0.4rem;">
            @if (IsRunning)
            {
                <span class="status-dot running" style="margin-right: 0.35rem;"></span>
                <span class="forge-badge badge-indigo tool-trace-badge">Running</span>
            }
            else
            {
                <span class="forge-badge @(IsError ? "badge-crimson" : "badge-amber") tool-trace-badge">
                    @(IsError ? "Failed" : "TOOL_CALL")
                </span>
            }
            @if (!string.IsNullOrWhiteSpace(Offset))
            {
                <span class="badge-tag font-mono" style="margin: 0; font-size: 0.72rem;">@Offset</span>
            }
            @if (!string.IsNullOrWhiteSpace(Arguments))
            {
                <button type="button" 
                        class="forge-btn-ghost" 
                        style="padding: 0.15rem 0.4rem; font-size: 0.72rem;" 
                        title="Copy tool call arguments to clipboard" 
                        aria-label="Copy tool call arguments to clipboard" 
                        @onclick:stopPropagation="true" 
                        @onclick="CopyArgs">
                    @(_copiedArgs ? "✓ Args" : "📋 Args")
                </button>
            }
            @if (!string.IsNullOrWhiteSpace(Result))
            {
                <button type="button" 
                        class="forge-btn-ghost" 
                        style="padding: 0.15rem 0.4rem; font-size: 0.72rem;" 
                        title="Copy tool execution result to clipboard" 
                        aria-label="Copy tool execution result to clipboard" 
                        @onclick:stopPropagation="true" 
                        @onclick="CopyResult">
                    @(_copiedResult ? "✓ Output" : "📋 Output")
                </button>
            }
        </span>
    </summary>
    <div class="tool-trace-content">
        @if (!string.IsNullOrWhiteSpace(Arguments))
        {
            <div class="tool-trace-block">
                <span class="tool-trace-label">Parameters (Payload)</span>
                <pre class="tool-trace-pre font-mono" style="background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 0.5rem 0.75rem; font-size: 0.78rem; overflow-x: auto; color: #93c5fd; margin: 0;"><code>@Arguments</code></pre>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Result))
        {
            <div class="tool-trace-block">
                <span class="tool-trace-label">Output / Result</span>
                <pre class="tool-trace-pre font-mono" style="background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 0.5rem 0.75rem; font-size: 0.78rem; overflow-x: auto; color: @(IsError ? "#fca5a5" : "#86efac"); margin: 0; max-height: 250px;"><code>@Result</code></pre>
            </div>
        }
    </div>
</details>

@code {
    [Parameter] public string? ToolName { get; set; }
    [Parameter] public string? Arguments { get; set; }
    [Parameter] public string? Result { get; set; }
    [Parameter] public string? Offset { get; set; }
    [Parameter] public bool IsError { get; set; }
    [Parameter] public bool IsRunning { get; set; }
    [Parameter] public bool InitiallyExpanded { get; set; }

    private bool _copiedArgs;
    private bool _copiedResult;

    private async Task CopyArgs()
    {
        if (string.IsNullOrEmpty(Arguments)) return;
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", Arguments);
            _copiedArgs = true;
            StateHasChanged();
            await Task.Delay(2000);
            _copiedArgs = false;
        }
        catch (Exception)
        {
            // Clipboard API may be denied by browser security permissions
        }
    }

    private async Task CopyResult()
    {
        if (string.IsNullOrEmpty(Result)) return;
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", Result);
            _copiedResult = true;
            StateHasChanged();
            await Task.Delay(2000);
            _copiedResult = false;
        }
        catch (Exception)
        {
            // Clipboard API may be denied by browser security permissions
        }
    }
}

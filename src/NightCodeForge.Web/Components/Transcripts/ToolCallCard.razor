@namespace NightCodeForge.Web.Components.Transcripts
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime

<div class="tool-callout card-surface" style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 1.15rem; margin: 0.75rem 0;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem;">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
            <span style="font-size: 1.1rem;">@(IsError ? "❌" : "🔧")</span>
            <span class="font-mono" style="font-weight: 700; color: var(--text-primary); font-size: 0.95rem;">
                @(ToolName ?? "Tool Invocation")
            </span>
            <span class="forge-badge @(IsError ? "badge-crimson" : "badge-amber")">
                @(IsError ? "TOOL_ERROR" : "TOOL_CALL")
            </span>
            @if (!string.IsNullOrWhiteSpace(Offset))
            {
                <span class="badge-tag" style="margin: 0; font-size: 0.75rem;">@Offset</span>
            }
        </div>
        <div style="display: flex; gap: 0.5rem;">
            @if (!string.IsNullOrWhiteSpace(Arguments))
            {
                <button type="button" class="forge-btn-ghost" style="padding: 0.2rem 0.5rem; font-size: 0.75rem;" title="Copy tool call arguments to clipboard" aria-label="Copy tool call arguments to clipboard" @onclick="CopyArgs">
                    @(_copiedArgs ? "✓ Args Copied" : "📋 Args")
                </button>
            }
            @if (!string.IsNullOrWhiteSpace(Result))
            {
                <button type="button" class="forge-btn-ghost" style="padding: 0.2rem 0.5rem; font-size: 0.75rem;" title="Copy tool execution result to clipboard" aria-label="Copy tool execution result to clipboard" @onclick="CopyResult">
                    @(_copiedResult ? "✓ Output Copied" : "📋 Output")
                </button>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Arguments))
    {
        <div style="margin-bottom: 0.75rem;">
            <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.25rem;">
                Arguments (Payload)
            </div>
            <pre style="background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 0.75rem; font-size: 0.82rem; overflow-x: auto; color: #93c5fd; margin: 0;"><code>@Arguments</code></pre>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Result))
    {
        <div>
            <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.25rem;">
                Output / Result
            </div>
            <pre style="background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 0.75rem; font-size: 0.82rem; overflow-x: auto; color: @(IsError ? "#fca5a5" : "#86efac"); margin: 0; max-height: 250px;"><code>@Result</code></pre>
        </div>
    }
</div>

@code {
    [Parameter] public string? ToolName { get; set; }
    [Parameter] public string? Arguments { get; set; }
    [Parameter] public string? Result { get; set; }
    [Parameter] public string? Offset { get; set; }
    [Parameter] public bool IsError { get; set; }

    private bool _copiedArgs;
    private bool _copiedResult;

    private async Task CopyArgs()
    {
        if (string.IsNullOrEmpty(Arguments)) return;
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", Arguments);
            _copiedArgs = true;
            StateHasChanged();
            await Task.Delay(2000);
            _copiedArgs = false;
        }
        catch (Exception)
        {
            // Clipboard API may be denied by browser security permissions
        }
    }

    private async Task CopyResult()
    {
        if (string.IsNullOrEmpty(Result)) return;
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", Result);
            _copiedResult = true;
            StateHasChanged();
            await Task.Delay(2000);
            _copiedResult = false;
        }
        catch (Exception)
        {
            // Clipboard API may be denied by browser security permissions
        }
    }
}

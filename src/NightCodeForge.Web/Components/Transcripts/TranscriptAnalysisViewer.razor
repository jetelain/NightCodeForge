@code {
    [Parameter, EditorRequired] public TranscriptAnalysis Analysis { get; set; } = null!;

    private int TotalToolCalls => Analysis.ToolUsage.Count > 0 ? Analysis.ToolUsage.Values.Sum() : Analysis.ToolTurns;
    private IReadOnlyList<FrictionRecommendation> UserRecommendations => Analysis.UserCodebaseRecommendations;
    private IReadOnlyList<FrictionRecommendation> NightCodeForgeRecommendations => Analysis.NightCodeForgeRecommendations;
    private IReadOnlyList<BashCommandFrictionEntry> ProblematicBashCommands =>
        Analysis.BashCommandFriction.Where(b => b.FailureCount > 0 || b.HangOrTimeoutCount > 0 || b.OversizedOutputCount > 0).ToList();
}

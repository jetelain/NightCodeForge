@inject IWorkspaceRepository WorkspaceRepo
@inject WorkspaceStateService WorkspaceState
@inject WorkerStateService WorkerState
@inject NavigationManager Navigation
@inject NightCodeForge.Core.Interfaces.IOperationsControlService OperationsControl
@inject NightCodeForge.Core.Interfaces.IOllamaRouterGatewayService GatewayService
@inject ToastService ToastService
@inject ILogger<TopNavBar> Logger
@implements IDisposable

<header class="top-navbar">
    <div class="top-navbar-left">
        <!-- Workspace Selector -->
        <div class="workspace-select-wrapper">
            <span class="workspace-select-icon">📁</span>
            <select class="workspace-dropdown" 
                    value="@(WorkspaceState.ActiveWorkspaceId?.ToString() ?? "")" 
                    @onchange="OnWorkspaceSelected"
                    aria-label="Select active workspace">
                @if (_workspaces.Count == 0)
                {
                    <option value="" disabled selected>No Workspaces Found</option>
                }
                else
                {
                    @foreach (var ws in _workspaces)
                    {
                        <option value="@ws.Id">@ws.Name</option>
                    }
                }
            </select>
            <button type="button" 
                    class="forge-btn-icon-addon" 
                    title="Create or onboard a new workspace" 
                    @onclick="() => WorkspaceState.RequestOpenWizard()">
                ➕
            </button>
        </div>

        <!-- Dynamic Breadcrumb Trail -->
        <nav class="forge-breadcrumbs" aria-label="Breadcrumb">
            <span class="breadcrumb-item font-mono">
                @(WorkspaceState.ActiveWorkspace?.Name ?? "Default")
            </span>
            <span class="breadcrumb-separator">/</span>
            <span class="breadcrumb-item active">@_currentSection</span>
        </nav>
    </div>

    <div class="top-navbar-right">
        <!-- Global Operations Pause / Resume (Gamer Mode) -->
        @if (!OperationsControl.IsPaused)
        {
            @if (_deferredTaskCount > 0)
            {
                <button type="button"
                        class="forge-btn forge-btn-warning btn-sm"
                        id="nav-btn-retry-deferred"
                        disabled="@_isTogglingPause"
                        title="Retry dispatching @_deferredTaskCount deferred task(s)"
                        @onclick="RetryDeferredTasksAsync">
                    <span>🔄</span>
                    <span>Retry Deferred (@_deferredTaskCount)</span>
                </button>
            }

            <button type="button"
                    class="forge-btn forge-btn-secondary btn-sm"
                    id="nav-btn-pause-operations"
                    disabled="@_isTogglingPause"
                    title="@(GatewayService.ProviderType == NightCodeForge.Core.Domain.LlmProviderType.OpenAiCompatible ? "Pause background agent execution & operations" : "Pause background operations & unload GPU VRAM for gaming or dedicated workloads")"
                    @onclick="TogglePauseOperationsAsync">
                <span>⏸️</span>
                <span>@(_isTogglingPause ? "Pausing..." : "Pause Operations")</span>
            </button>
        }
        else
        {
            <button type="button"
                    class="forge-btn forge-btn-warning btn-sm btn-pulse-amber"
                    id="nav-btn-resume-operations"
                    disabled="@_isTogglingPause"
                    title="@(GatewayService.ProviderType == NightCodeForge.Core.Domain.LlmProviderType.OpenAiCompatible ? "Operations paused. Click to resume operations." : "Operations paused. Host GPU VRAM is free. Click to resume operations.")"
                    @onclick="TogglePauseOperationsAsync">
                <span>▶️</span>
                <span>@(_isTogglingPause ? "Resuming..." : "Resume Operations")</span>
            </button>
        }

        @if (OperationsControl.ReclaimStatus == NightCodeForge.Core.Domain.OperationsReclaimStatus.Failed && GatewayService.ProviderType != NightCodeForge.Core.Domain.LlmProviderType.OpenAiCompatible)
        {
            <span class="badge bg-danger-subtle text-danger border border-danger-subtle ms-1"
                  id="nav-badge-reclaim-failed"
                  title="@(OperationsControl.LastReclaimError ?? "VRAM reclaim incomplete")"
                  style="font-size: 0.75rem; padding: 0.25rem 0.5rem; display: inline-flex; align-items: center; gap: 0.25rem;">
                <span>⚠️</span>
                <span>GPU Reclaim Incomplete</span>
            </span>
        }

        <!-- Global + New Task Button -->
        <NavLink href="tasks/new" class="forge-btn forge-btn-primary btn-sm" id="nav-btn-new-task" style="text-decoration: none; display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.3rem 0.75rem; font-size: 0.82rem;" title="Create a new task">
            <span>➕</span>
            <span>New Task</span>
        </NavLink>

        <!-- Question Inbox Shortcut Pill -->
        @{
            var pendingQuestions = WorkerState.Current.PendingQuestionCount;
        }
        <NavLink href="inbox" class="@(pendingQuestions > 0 ? "question-inbox-pill" : "question-inbox-pill empty")" title="Pending Clarification Questions">
            <span class="pill-icon">📬</span>
            <span>@(pendingQuestions > 0 ? $"{pendingQuestions} Question{(pendingQuestions > 1 ? "s" : "")}" : "Inbox")</span>
        </NavLink>
    </div>
</header>

@code {
    private IReadOnlyList<Workspace> _workspaces = Array.Empty<Workspace>();
    private string _currentSection = "Overview";
    private bool _disposed;
    private bool _isTogglingPause;
    private int _deferredTaskCount;

    protected override async Task OnInitializedAsync()
    {
        WorkspaceState.OnWorkspaceChanged += HandleStateChanged;
        WorkerState.OnWorkerStateChanged += HandleStateChanged;
        Navigation.LocationChanged += HandleLocationChanged;
        OperationsControl.OnOperationsStateChanged += HandleOperationsStateChanged;

        await LoadWorkspacesAsync();
        UpdateCurrentSection(Navigation.Uri);
        await RefreshDeferredCountAsync();
    }

    private async void HandleOperationsStateChanged(bool isPaused)
    {
        if (_disposed) return;
        await RefreshDeferredCountAsync();
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task RefreshDeferredCountAsync()
    {
        try
        {
            _deferredTaskCount = await OperationsControl.GetDeferredTaskCountAsync();
        }
        catch
        {
            // Best-effort state hydration
        }
    }

    private async Task RetryDeferredTasksAsync()
    {
        if (_isTogglingPause) return;
        _isTogglingPause = true;
        try
        {
            await OperationsControl.ResumeOperationsAsync();
            await RefreshDeferredCountAsync();
            ToastService.Show("Operations Resumed", "Deferred tasks have been re-enqueued for execution.", ToastLevel.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to retry deferred operations.");
            ToastService.Show("Operations Control Error", ex.Message, ToastLevel.Error);
        }
        finally
        {
            _isTogglingPause = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task TogglePauseOperationsAsync()
    {
        if (_isTogglingPause) return;
        _isTogglingPause = true;
        try
        {
            if (OperationsControl.IsPaused)
            {
                await OperationsControl.ResumeOperationsAsync();
            }
            else
            {
                await OperationsControl.PauseOperationsAsync();
            }
            await RefreshDeferredCountAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to toggle operations pause state.");
            ToastService.Show("Operations Control Error", ex.Message, ToastLevel.Error);
        }
        finally
        {
            _isTogglingPause = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadWorkspacesAsync()
    {
        try
        {
            _workspaces = await WorkspaceRepo.GetAllAsync();
            if (WorkspaceState.ActiveWorkspace == null && _workspaces.Count > 0)
            {
                WorkspaceState.SetActiveWorkspace(_workspaces[0]);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load workspaces in TopNavBar");
            _workspaces = Array.Empty<Workspace>();
        }
    }

    private void OnWorkspaceSelected(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var selectedId))
        {
            var matched = _workspaces.FirstOrDefault(w => w.Id == selectedId);
            if (matched != null)
            {
                WorkspaceState.SetActiveWorkspace(matched);
            }
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateCurrentSection(e.Location);
        _ = InvokeAsync(StateHasChanged);
    }

    private void UpdateCurrentSection(string uri)
    {
        var relative = Navigation.ToBaseRelativePath(uri).Split('?')[0].Trim('/');
        _currentSection = relative.ToLowerInvariant() switch
        {
            "" => "Overview",
            "ideation" => "Ideation Chat",
            "backlog" => "Backlog & DAG",
            "monitoring" => "Live Telemetry",
            "inbox" => "Question Inbox",
            "review" => "Review Room",
            "settings" => "Settings",
            "transcripts" => "Transcripts & AI",
            _ => char.ToUpper(relative[0]) + relative[1..]
        };
    }

    private void HandleStateChanged()
    {
        if (_disposed) return;

        _ = InvokeAsync(async () =>
        {
            try
            {
                if (_disposed) return;
                await LoadWorkspacesAsync();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to refresh state in TopNavBar.");
            }
        });
    }

    public void Dispose()
    {
        _disposed = true;
        WorkspaceState.OnWorkspaceChanged -= HandleStateChanged;
        WorkerState.OnWorkerStateChanged -= HandleStateChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
        OperationsControl.OnOperationsStateChanged -= HandleOperationsStateChanged;
    }
}

@inherits LayoutComponentBase

<div class="forge-layout @(_isSidebarCollapsed ? "sidebar-collapsed" : "")">
    <NavMenu IsCollapsed="_isSidebarCollapsed" OnToggleSidebar="ToggleSidebar" />
    
    <TopNavBar />

    <main class="forge-main-content">
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent Context="ex">
                <div class="forge-card" style="margin: 2rem; border-color: var(--forge-border-danger, #ef4444); background: rgba(239, 68, 68, 0.08);">
                    <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem; color: #ef4444; font-weight: 600;">
                        <span class="bi bi-exclamation-triangle-fill"></span>
                        <span>An unexpected error occurred in this view</span>
                    </div>
                    <p style="margin: 0 0 1rem 0; font-size: 0.875rem; color: var(--forge-text-muted, #94a3b8);">@ex.Message</p>
                    <button class="forge-button forge-button-secondary" style="font-size: 0.8rem;" @onclick="() => _errorBoundary?.Recover()">
                        Try to recover
                    </button>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </main>

    <ToastHost />
    <WorkspaceCreationWizardModal />
</div>

<div id="blazor-error-ui" data-nosnippet>
    <span>An unhandled error has occurred.</span>
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _isSidebarCollapsed = false;
    private ErrorBoundary? _errorBoundary;

    private void ToggleSidebar()
    {
        _isSidebarCollapsed = !_isSidebarCollapsed;
    }
}

@inherits LayoutComponentBase
@inject IWorkspaceRepository WorkspaceRepo
@inject NightCodeForge.Core.Repositories.ITaskRepository TaskRepository
@inject WorkspaceStateService WorkspaceState
@inject NavigationManager Navigation
@inject WorkerStateService WorkerState
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="forge-layout @(_isSidebarCollapsed ? "sidebar-collapsed" : "") @(_isMobileNavOpen ? "mobile-nav-open" : "")">
    <NavMenu IsCollapsed="_isSidebarCollapsed"
             IsMobileOpen="_isMobileNavOpen"
             OnToggleSidebar="ToggleSidebar"
             OnNavigate="CloseMobileNav" />

    <TopNavBar IsMobileNavOpen="_isMobileNavOpen" OnToggleMobileNav="ToggleMobileNav" />

    @if (_isMobileNavOpen)
    {
        <div class="mobile-nav-backdrop" id="mobile-nav-backdrop" @onclick="CloseMobileNav" aria-hidden="true"></div>
    }

    <div id="components-reconnect-modal" role="status" aria-live="polite" data-nosnippet>
        <span class="reconnect-banner-spinner" aria-hidden="true"></span>
        <span>Reconnecting to Forge...</span>
    </div>

    <main class="forge-main-content">
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                @if (_isWorkspaceReady)
                {
                    @Body
                }
            </ChildContent>
            <ErrorContent Context="ex">
                <div class="forge-card" style="margin: 2rem; border-color: var(--forge-border-danger, #ef4444); background: rgba(239, 68, 68, 0.08);">
                    <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem; color: #ef4444; font-weight: 600;">
                        <span class="bi bi-exclamation-triangle-fill"></span>
                        <span>An unexpected error occurred in this view</span>
                    </div>
                    <p style="margin: 0 0 1rem 0; font-size: 0.875rem; color: var(--forge-text-muted, #94a3b8);">@ex.Message</p>
                    <button class="forge-button forge-button-secondary" style="font-size: 0.8rem;" @onclick="() => _errorBoundary?.Recover()">
                        Try to recover
                    </button>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </main>

    <ToastHost />
    <WorkspaceCreationWizardModal />
</div>

<div id="blazor-error-ui" data-nosnippet>
    <span>An unhandled error has occurred.</span>
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _isSidebarCollapsed = false;
    private bool _isMobileNavOpen = false;
    private DotNetObjectReference<MainLayout>? _selfReference;
    private bool _isWorkspaceReady = false;
    private const string ForegroundSyncRegisterFunction = "NightCodeForge.registerForegroundSync";
    private const string ForegroundSyncUnregisterFunction = "NightCodeForge.unregisterForegroundSync";
    private bool _disposed = false;
    private ErrorBoundary? _errorBoundary;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += HandleLocationChanged;
        WorkspaceState.OnWorkspaceChanged += HandleWorkspaceChanged;

        await HydrateWorkspaceFromUrlAsync(Navigation.Uri);
        await WorkerState.RefreshCountsFromRepositoryAsync(TaskRepository);
        _isWorkspaceReady = true;
    }

    private async Task HydrateWorkspaceFromUrlAsync(string uri)
    {
        var workspaces = await WorkspaceRepo.GetAllAsync();
        WorkspaceState.SetKnownWorkspaces(workspaces);

        var hasUrlWorkspace = WorkspaceUrlHelper.TryExtractWorkspaceId(
            uri,
            out var urlWorkspaceId,
            out var remainingPath,
            out var queryAndFragment);

        if (hasUrlWorkspace)
        {
            var matched = workspaces.FirstOrDefault(w => w.Id == urlWorkspaceId);
            if (matched != null)
            {
                WorkspaceState.SetActiveWorkspace(matched);
            }
            else if (workspaces.Count > 0)
            {
                WorkspaceState.SetActiveWorkspace(workspaces[0]);
                var fallbackUrl = WorkspaceUrlHelper.BuildPath(workspaces[0].Id, $"{remainingPath}{queryAndFragment}");
                Navigation.NavigateTo(fallbackUrl, replace: true);
            }
        }
        else
        {
            var isTaskRoute = WorkspaceUrlHelper.TryExtractTaskRoute(uri, out _, out _);
            if (WorkspaceState.ActiveWorkspace == null && workspaces.Count > 0 && !isTaskRoute)
            {
                WorkspaceState.SetActiveWorkspace(workspaces[0]);
            }

            if (WorkspaceState.ActiveWorkspaceId.HasValue &&
                !string.IsNullOrEmpty(remainingPath) &&
                !WorkspaceUrlHelper.IsNonWorkspaceRoute(remainingPath) &&
                !isTaskRoute)
            {
                var normalizedUrl = WorkspaceUrlHelper.BuildPath(
                    WorkspaceState.ActiveWorkspaceId.Value,
                    $"{remainingPath}{queryAndFragment}");
                Navigation.NavigateTo(normalizedUrl, replace: true);
            }
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_disposed) return;

        if (_isMobileNavOpen)
        {
            _isMobileNavOpen = false;
            _ = InvokeAsync(StateHasChanged);
        }

        if (WorkspaceUrlHelper.TryExtractWorkspaceId(e.Location, out var urlWsId, out var remainingPath, out var queryAndFragment))
        {
            if (!WorkspaceState.TryActivateWorkspaceById(urlWsId))
            {
                _ = InvokeAsync(async () =>
                {
                    if (_disposed) return;
                    await HydrateWorkspaceFromUrlAsync(e.Location);
                    StateHasChanged();
                });
            }
        }
        else if (WorkspaceState.ActiveWorkspaceId.HasValue &&
                 !string.IsNullOrEmpty(remainingPath) &&
                 !WorkspaceUrlHelper.IsNonWorkspaceRoute(remainingPath) &&
                 !WorkspaceUrlHelper.TryExtractTaskRoute(e.Location, out _, out _))
        {
            var normalizedUrl = WorkspaceUrlHelper.BuildPath(
                WorkspaceState.ActiveWorkspaceId.Value,
                $"{remainingPath}{queryAndFragment}");
            Navigation.NavigateTo(normalizedUrl, replace: true);
        }
    }

    private void HandleWorkspaceChanged()
    {
        if (_disposed || !WorkspaceState.ActiveWorkspaceId.HasValue) return;

        var hasUrlWs = WorkspaceUrlHelper.TryExtractWorkspaceId(
            Navigation.Uri,
            out _,
            out var remainingPath,
            out var queryAndFragment);

        if (!hasUrlWs &&
            !string.IsNullOrEmpty(remainingPath) &&
            !WorkspaceUrlHelper.IsNonWorkspaceRoute(remainingPath))
        {
            var normalizedUrl = WorkspaceUrlHelper.BuildPath(
                WorkspaceState.ActiveWorkspaceId.Value,
                $"{remainingPath}{queryAndFragment}");
            Navigation.NavigateTo(normalizedUrl, replace: true);
        }
    }

    private void ToggleSidebar()
    {
        _isSidebarCollapsed = !_isSidebarCollapsed;
    }

    private void ToggleMobileNav()
    {
        _isMobileNavOpen = !_isMobileNavOpen;
    }

    private void CloseMobileNav()
    {
        _isMobileNavOpen = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfReference = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync(ForegroundSyncRegisterFunction, _selfReference);
        }
    }

    /// <summary>Invoked from app.js when the browser tab returns to the foreground.</summary>
    [JSInvokable]
    public void OnTabForegrounded()
    {
        if (_disposed) return;
        WorkerState.RefreshFromTelemetry();
        _ = InvokeAsync(async () =>
        {
            if (_disposed) return;
            await WorkerState.RefreshCountsFromRepositoryAsync(TaskRepository);
            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Navigation.LocationChanged -= HandleLocationChanged;
        WorkspaceState.OnWorkspaceChanged -= HandleWorkspaceChanged;

        if (_selfReference != null)
        {
            try
            {
                await JS.InvokeVoidAsync(ForegroundSyncUnregisterFunction);
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone: nothing left to unregister client-side.
            }
            _selfReference.Dispose();
        }
    }
}

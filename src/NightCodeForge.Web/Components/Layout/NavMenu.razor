@inject WorkerStateService WorkerState
@implements IDisposable

<aside class="forge-sidebar">
    <div class="brand-header">
        <NavLink class="brand-logo-wrap" href="" Match="NavLinkMatch.All">
            <div class="brand-icon">⚡</div>
            <span class="brand-text">Night<span>CodeForge</span></span>
        </NavLink>
        <button class="sidebar-toggle-btn" @onclick="ToggleSidebar" title="Toggle Sidebar">
            ☰
        </button>
    </div>

    <div class="sidebar-nav-container">
        <div class="nav-section-label">Workflow</div>

        <NavLink class="forge-nav-link" href="ideation">
            <span class="nav-icon">💡</span>
            <span>Ideation Chat</span>
        </NavLink>

        <NavLink class="forge-nav-link" href="backlog">
            <span class="nav-icon">📋</span>
            <span>Backlog &amp; DAG</span>
        </NavLink>

        <NavLink class="forge-nav-link" href="triage">
            <span class="nav-icon">🛡️</span>
            <span>Untrusted Intake</span>
        </NavLink>

        <div class="nav-section-label">Execution</div>

        <NavLink class="forge-nav-link" href="monitoring">
            <span class="nav-icon">⚡</span>
            <span>Live Telemetry</span>
        </NavLink>

        <NavLink class="forge-nav-link" href="inbox">
            <span class="nav-icon">📬</span>
            <span>Question Inbox</span>
            @if (WorkerState.Current.PendingQuestionCount > 0)
            {
                <span class="nav-badge">@WorkerState.Current.PendingQuestionCount</span>
            }
        </NavLink>

        <NavLink class="forge-nav-link" href="review">
            <span class="nav-icon">🔍</span>
            <span>Review Room</span>
        </NavLink>

        <div class="nav-section-label">System</div>

        <NavLink class="forge-nav-link" href="settings">
            <span class="nav-icon">⚙️</span>
            <span>Settings &amp; A/B</span>
        </NavLink>

        <NavLink class="forge-nav-link" href="transcripts">
            <span class="nav-icon">📜</span>
            <span>Transcripts &amp; AI</span>
        </NavLink>
    </div>

    <div class="sidebar-footer">
        <span class="font-mono">v1.0.0-rc</span>
        <span>Obsidian Theme</span>
    </div>
</aside>

@code {
    [Parameter]
    public EventCallback OnToggleSidebar { get; set; }

    protected override void OnInitialized()
    {
        WorkerState.OnWorkerStateChanged += HandleWorkerStateChanged;
    }

    private void HandleWorkerStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task ToggleSidebar()
    {
        if (OnToggleSidebar.HasDelegate)
        {
            await OnToggleSidebar.InvokeAsync();
        }
    }

    public void Dispose()
    {
        WorkerState.OnWorkerStateChanged -= HandleWorkerStateChanged;
    }
}

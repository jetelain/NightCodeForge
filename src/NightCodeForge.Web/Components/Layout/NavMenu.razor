@inject WorkerStateService WorkerState
@inject WorkspaceStateService WorkspaceState
@implements IDisposable

<aside class="forge-sidebar">
    <div class="brand-header">
        <NavLink class="brand-logo-wrap" href="" Match="NavLinkMatch.All">
            <img src="favicon.svg" alt="NightCodeForge" class="brand-favicon" />
            <span class="brand-text">NightCode<span>Forge</span></span>
        </NavLink>
        <button class="sidebar-toggle-btn"
                @onclick="ToggleSidebar"
                title="@(IsCollapsed ? "Expand Sidebar" : "Collapse Sidebar")"
                aria-expanded="@(!IsCollapsed ? "true" : "false")"
                aria-label="@(IsCollapsed ? "Expand Sidebar" : "Collapse Sidebar")">
            @(IsCollapsed ? "»" : "«")
        </button>
    </div>

    <div class="sidebar-nav-container">
        <div class="nav-section-label">Workflow</div>

        <NavLink class="forge-nav-link" href="@WorkspaceState.GetNavHref("ideation")">
            <span class="nav-icon">💡</span>
            <span>Ideation Chat</span>
        </NavLink>

        <NavLink class="forge-nav-link" href="@WorkspaceState.GetNavHref("backlog")">
            <span class="nav-icon">📋</span>
            <span>Backlog &amp; DAG</span>
        </NavLink>

        <NavLink class="forge-nav-link" href="@WorkspaceState.GetNavHref("triage")">
            <span class="nav-icon">🛡️</span>
            <span>Untrusted Intake</span>
        </NavLink>

        <div class="nav-section-label">Execution</div>

        <NavLink class="forge-nav-link" href="@WorkspaceState.GetNavHref("monitoring")">
            <span class="nav-icon">⚡</span>
            <span>Live Telemetry</span>
        </NavLink>

        <NavLink class="forge-nav-link" href="@WorkspaceState.GetNavHref("inspector")">
            <span class="nav-icon">🔎</span>
            <span>Task Inspector</span>
        </NavLink>

        <NavLink class="forge-nav-link" href="@WorkspaceState.GetNavHref("inbox")">
            <span class="nav-icon">📬</span>
            <span>Question Inbox</span>
            @if (WorkerState.Current.PendingQuestionCount > 0)
            {
                <span class="nav-badge">@WorkerState.Current.PendingQuestionCount</span>
            }
        </NavLink>

        <NavLink class="forge-nav-link" href="@WorkspaceState.GetNavHref("review")">
            <span class="nav-icon">🔍</span>
            <span>Review Room</span>
        </NavLink>

        <NavLink class="forge-nav-link" href="@WorkspaceState.GetNavHref("git-sync")">
            <span class="nav-icon">🌿</span>
            <span>Git &amp; Host Sync</span>
        </NavLink>

        <NavLink class="forge-nav-link" href="@WorkspaceState.GetNavHref("dev-queue")">
            <span class="nav-icon">⏱️</span>
            <span>Dev-Queue &amp; Locks</span>
        </NavLink>

        <div class="nav-section-label">System</div>

        <NavLink class="forge-nav-link" href="@WorkspaceState.GetNavHref("settings")">
            <span class="nav-icon">⚙️</span>
            <span>Settings</span>
        </NavLink>

        <NavLink class="forge-nav-link" href="@WorkspaceState.GetNavHref("transcripts")">
            <span class="nav-icon">📜</span>
            <span>Transcripts &amp; AI</span>
        </NavLink>
    </div>

    <div class="sidebar-footer">
        <span class="font-mono">v1.0.0-rc</span>
        <span>Obsidian Theme</span>
    </div>
</aside>

@code {
    [Parameter]
    public bool IsCollapsed { get; set; }

    [Parameter]
    public EventCallback OnToggleSidebar { get; set; }

    protected override void OnInitialized()
    {
        WorkerState.OnWorkerStateChanged += HandleStateChanged;
        WorkspaceState.OnWorkspaceChanged += HandleStateChanged;
    }

    private void HandleStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task ToggleSidebar()
    {
        if (OnToggleSidebar.HasDelegate)
        {
            await OnToggleSidebar.InvokeAsync();
        }
    }

    public void Dispose()
    {
        WorkerState.OnWorkerStateChanged -= HandleStateChanged;
        WorkspaceState.OnWorkspaceChanged -= HandleStateChanged;
    }
}

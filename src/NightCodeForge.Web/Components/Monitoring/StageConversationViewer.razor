@namespace NightCodeForge.Web.Components.Monitoring
@using NightCodeForge.Core.Domain
@using NightCodeForge.Core.Memory
@using NightCodeForge.Core.Repositories
@using NightCodeForge.Core.Workflow
@using NightCodeForge.Web.Components.Transcripts
@using NightCodeForge.Web.Services
@using System.Text.Json
@using Microsoft.Extensions.DependencyInjection
@inject IJSRuntime JSRuntime
@inject ITaskRepository TaskRepository
@inject ITaskOrchestrator TaskOrchestrator
@inject NavigationManager Navigation
@implements IAsyncDisposable

<div id="@ChatPresentationHelper.StageConversationContainerId" class="stage-conversation-viewer card-surface" style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 1.25rem; min-width: 0; position: relative;">
    @if (Conversation == null && string.IsNullOrEmpty(LiveStreamingThinking) && string.IsNullOrEmpty(LiveStreamingMessage))
    {
        var pendingQuestions = Task?.Questions?.Where(q => q.Status == QuestionStatus.Pending).OrderBy(q => q.Id).ToList();
        if (pendingQuestions is { Count: > 0 })
        {
            <AgentQuestionTurnCard Questions="@QuestionItemParser.ToQuestionItems(pendingQuestions)"
                                   QuestionIds="@pendingQuestions.Select(q => q.Id).ToList()"
                                   BatchIdentifier="@pendingQuestions[0].BatchId"
                                   TaskId="@Task!.Id"
                                   TaskTitle="@Task.Title"
                                   StageId="@pendingQuestions[0].StageId"
                                   AgentProfileId="@pendingQuestions[0].AgentProfileId"
                                   AskedAt="@pendingQuestions[0].AskedAt"
                                   QuestionId="@pendingQuestions[0].Id"
                                   IsWaitingForAnswer="true"
                                   RequireAllAnswers="@(pendingQuestions.Count > 1)"
                                   OnBatchAnswersSubmitted="@(ans => HandlePreStageAnswersSubmittedAsync(pendingQuestions, ans))" />
        }
        else
        {
            <div style="text-align: center; color: var(--text-muted); padding: 2rem 0;">
                <span style="font-size: 1.5rem; display: block; margin-bottom: 0.5rem;">💬</span>
                <span>No stage conversation selected. Please choose a stage or run above.</span>
            </div>
        }
    }
    else
    {
        <!-- Stage Header Metadata -->
        <div style="border-bottom: 1px solid var(--border-subtle); padding-bottom: 1rem; margin-bottom: 1.25rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
                <div>
                    <div style="display: flex; align-items: center; gap: 0.65rem; margin-bottom: 0.25rem;">
                        <h3 style="margin: 0; font-size: 1.15rem; color: var(--text-primary);">
                            @(Conversation != null ? StageConversationParser.FormatStageName(Conversation.StageId, WorkflowStages) : "Active Stage Execution")
                        </h3>
                        @if (Conversation != null)
                        {
                            <span class="forge-badge badge-indigo" style="font-size: 0.72rem;">
                                Run #@Conversation.AttemptIndex
                            </span>
                            <span class="forge-badge @(Conversation.StageKind == WorkflowStageKind.Deterministic ? "badge-teal" : "badge-indigo")" style="font-size: 0.72rem;">
                                @TaskDifficultyPresentationHelper.FormatStageComputeLabel(Conversation.StageKind, Conversation.HarnessId)
                            </span>
                            @if (Task != null && Task.Difficulty > TaskDifficulty.Standard && Conversation.StageKind == WorkflowStageKind.Agentic)
                            {
                                <span class="forge-badge escalation-badge @TaskDifficultyPresentationHelper.GetBadgeCssClass(Task.Difficulty)"
                                      style="font-size: 0.72rem; @TaskDifficultyPresentationHelper.GetBadgeStyle(Task.Difficulty)">
                                    @TaskDifficultyPresentationHelper.FormatEscalationBadge(Task.Difficulty, Conversation.HarnessId, Conversation.ModelName)
                                </span>
                            }
                            @if (Conversation.Status == StageExecutionStatus.WaitingForHuman)
                            {
                                @if (IsStageWaitingForAnswer)
                                {
                                    <span class="forge-badge badge-amber" style="font-size: 0.72rem;">Waiting for Answer</span>
                                }
                                else
                                {
                                    <span class="forge-badge badge-teal" style="font-size: 0.72rem;">Clarification Provided (Queued)</span>
                                }
                            }
                            else
                            {
                                <span class="forge-badge @StageConversationParser.GetStatusClass(Conversation.Status)" style="font-size: 0.72rem;">
                                    @Conversation.Status.ToString()
                                </span>
                            }
                        }
                        @if (IsActiveStage && (Conversation == null || Conversation.Status == StageExecutionStatus.Running || !string.IsNullOrEmpty(LiveStreamingThinking) || !string.IsNullOrEmpty(LiveStreamingMessage) || !string.IsNullOrEmpty(LiveRunningToolName)))
                        {
                            <span class="step-badge @(Conversation?.StageKind == WorkflowStageKind.Deterministic ? "badge-teal" : "badge-gpu")" style="font-size: 0.68rem;">
                                LIVE STREAMING
                                <span class="cursor-blink">▊</span>
                            </span>
                        }
                    </div>

                    @if (Conversation != null)
                    {
                        <div style="font-size: 0.78rem; color: var(--text-secondary); display: flex; align-items: center; flex-wrap: wrap; gap: 1rem;">
                            @if (!string.IsNullOrWhiteSpace(Conversation.ModelName))
                            {
                                <span>🧠 Model: <strong>@Conversation.ModelName</strong></span>
                            }
                            @if (!string.IsNullOrWhiteSpace(Conversation.HarnessId))
                            {
                                <span>⚙️ Harness: <strong>@Conversation.HarnessId</strong></span>
                            }
                            <span>🕒 Started: <strong>@Conversation.StartedAt.ToLocalTime().ToString("HH:mm:ss")</strong></span>
                            @if (Conversation.CompletedAt.HasValue)
                            {
                                <span>🏁 Finished: <strong>@Conversation.CompletedAt.Value.ToLocalTime().ToString("HH:mm:ss")</strong></span>
                                <span>⏱ Duration: <strong>@((Conversation.CompletedAt.Value - Conversation.StartedAt).TotalSeconds.ToString("F1"))s</strong></span>
                            }
                            @if (!string.IsNullOrWhiteSpace(Conversation.TranscriptFileName))
                            {
                                <span>📄 File: <code>@Conversation.TranscriptFileName</code></span>
                            }
                        </div>
                    }
                </div>

                @if (Conversation != null && !string.IsNullOrWhiteSpace(Conversation.Summary))
                {
                    <div class="stage-summary-box" style="background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 0.6rem 0.85rem; font-size: 0.82rem; max-width: 480px; flex: 1 1 300px;">
                        <span style="color: var(--text-muted); font-size: 0.72rem; text-transform: uppercase; font-weight: 600; display: block; margin-bottom: 0.25rem;">Summary</span>
                        <div class="forge-markdown stage-summary-markdown" style="font-size: 0.82rem; line-height: 1.5;">
                            @MarkdownHelper.ToMarkupString(Conversation.Summary)
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Turns Stream -->
        <div class="conversation-turns-list chat-messages-container" style="display: flex; flex-direction: column; gap: 0.85rem; min-width: 0;">
            @{
                var turns = Conversation?.Turns?.OrderBy(t => t.TurnIndex).ToList() ?? new List<ConversationTurn>();
                var (mergedResults, hiddenResults) = StageConversationParser.PairToolResults(turns);
            }

            @if (!turns.Any() && !IsActiveStage && Conversation != null && string.IsNullOrEmpty(LiveStreamingThinking) && string.IsNullOrEmpty(LiveStreamingMessage))
            {
                <div style="color: var(--text-muted); font-style: italic; font-size: 0.84rem;">
                    No turns recorded for this stage run.
                </div>
            }

            @foreach (var turn in turns)
            {
                if (hiddenResults.Contains(turn.Id))
                {
                    continue;
                }
                <div class="turn-item" style="display: flex; flex-direction: column; gap: 0.5rem; min-width: 0;">
                    @switch (turn.Role)
                    {
                        case StageTurnRole.User:
                        case StageTurnRole.System:
                            var visualMeta = turn.Role == StageTurnRole.User
                                ? StageConversationParser.ParseVisualTurnMetadata(turn)
                                : new VisualTurnMetadata(false, Array.Empty<ConversationHistorySerializer.SerializedImageRef>());
                            <div class="chat-bubble user turn-user @(visualMeta.IsInjectedVisual ? "turn-visual-inspection" : "")">
                                <div class="chat-avatar">
                                    @(turn.Role == StageTurnRole.System ? "⚙️" : visualMeta.IsInjectedVisual ? "👁️" : "👤")
                                </div>
                                <div class="chat-bubble-body">
                                    <div class="chat-bubble-header">
                                        <span class="chat-author">@(turn.Role == StageTurnRole.System ? "System Directive" : visualMeta.IsInjectedVisual ? "Visual Inspection" : "User / Orchestrator")</span>
                                        @if (visualMeta.IsInjectedVisual || visualMeta.ImageRefs.Count > 0)
                                        {
                                            <span class="forge-badge badge-teal visual-inspection-badge" style="font-size: 0.72rem; margin-left: 0.35rem;">@VisionConstants.VisionBadgeLabel Inspection</span>
                                        }
                                        <span class="chat-timestamp font-mono">
                                            @turn.Timestamp.ToLocalTime().ToString("HH:mm:ss")
                                        </span>
                                    </div>
                                    @if (visualMeta.ImageRefs.Count > 0)
                                    {
                                        <div class="visual-image-refs-strip" style="display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.4rem;">
                                            @foreach (var imgRef in visualMeta.ImageRefs)
                                            {
                                                <span class="forge-chip font-mono visual-image-ref-chip" style="font-size: 0.76rem;">
                                                    <span>🖼️ @(string.IsNullOrWhiteSpace(imgRef.SourcePath) ? imgRef.MediaType : imgRef.SourcePath)</span>
                                                    @if (imgRef.WidthPx is > 0 && imgRef.HeightPx is > 0)
                                                    {
                                                        <span class="text-muted">(@(imgRef.WidthPx)x@(imgRef.HeightPx), @imgRef.MediaType)</span>
                                                    }
                                                </span>
                                            }
                                        </div>
                                    }
                                    <div class="chat-content-wrap forge-markdown turn-content-markdown" style="font-size: 0.86rem; line-height: 1.55; max-height: 450px; overflow-y: auto; overflow-x: auto; max-width: 100%; min-width: 0; box-sizing: border-box;">
                                        @MarkdownHelper.ToMarkupString(turn.Content)
                                    </div>
                                </div>
                            </div>
                            break;

                        case StageTurnRole.Thinking:
                            var thinkText = turn.ThinkingTrace ?? turn.Content;
                            <div class="chat-bubble assistant turn-thinking">
                                <div class="chat-avatar">🧠</div>
                                <div class="chat-bubble-body" style="width: 100%;">
                                    <div class="chat-bubble-header">
                                        <span class="chat-author">Reasoning Deliberation</span>
                                        <span class="chat-timestamp font-mono">
                                            @turn.Timestamp.ToLocalTime().ToString("HH:mm:ss")
                                        </span>
                                    </div>
                                    <details class="think-trace" open="true">
                                        <summary>
                                            <span>🧠 Reasoning Trace</span>
                                            <span class="font-mono text-muted" style="margin-left: 0.4rem;">(@(thinkText?.Length ?? 0) chars)</span>
                                        </summary>
                                        <div class="think-content font-mono">@thinkText</div>
                                    </details>
                                </div>
                            </div>
                            break;

                        case StageTurnRole.Tool:
                        case StageTurnRole.ToolResult:
                            if (turn.Role == StageTurnRole.ToolResult && string.Equals(turn.ToolName, CanonicalToolNames.Ask, StringComparison.OrdinalIgnoreCase))
                            {
                                // Orphan / rogue ask tool result turn: do not render as raw tool card
                                break;
                            }

                            var pairedResult = mergedResults.TryGetValue(turn.Id, out var resultTurn) ? resultTurn : null;
                            var effectiveDuration = pairedResult?.DurationMs ?? turn.DurationMs;
                            var isAskError = StageConversationParser.IsAskError(turn, pairedResult);
                            if (StageConversationParser.IsAskToolTurn(turn) && !isAskError)
                            {
                                var questions = StageConversationParser.ExtractQuestions(turn);
                                var answer = pairedResult?.ToolResult ?? turn.ToolResult;
                                var metadataJson = pairedResult?.MetadataJson ?? turn.MetadataJson;

                                if (string.IsNullOrWhiteSpace(answer) && Task != null)
                                {
                                    var (fallbackAnswer, fallbackMeta) = StageConversationParser.ResolveAnswerFromTask(Task, Conversation?.StageId, questions);
                                    if (!string.IsNullOrWhiteSpace(fallbackAnswer))
                                    {
                                        answer = fallbackAnswer;
                                        metadataJson = fallbackMeta;
                                    }
                                }

                                var isWaiting = StageConversationParser.IsWaitingForHumanAnswer(Conversation, Task, answer);
                                <div class="chat-bubble assistant turn-ask-tool">
                                    <div class="chat-avatar">❓</div>
                                    <div class="chat-bubble-body" style="width: 100%;">
                                        <AgentQuestionTurnCard Questions="@questions"
                                                               Answer="@answer"
                                                               MetadataJson="@metadataJson"
                                                               IsWaitingForAnswer="@isWaiting"
                                                               OnBatchAnswersSubmitted="HandleBatchAnswersSubmittedAsync" />
                                    </div>
                                </div>
                            }
                            else
                            {
                                var isPrimed = StageConversationParser.IsPrimedTurn(turn) || (pairedResult != null && StageConversationParser.IsPrimedTurn(pairedResult));
                                var isRunning = !isPrimed &&
                                                IsActiveStage &&
                                                Conversation?.Status == StageExecutionStatus.Running &&
                                                pairedResult == null &&
                                                string.IsNullOrEmpty(turn.ToolResult);

                                var liveResult = isRunning &&
                                                 !string.IsNullOrEmpty(LiveRunningToolOutput) &&
                                                 (string.Equals(turn.ToolName, LiveRunningToolName, StringComparison.OrdinalIgnoreCase) ||
                                                  string.Equals(turn.Content, LiveRunningToolArguments, StringComparison.OrdinalIgnoreCase))
                                    ? LiveRunningToolOutput
                                    : (pairedResult?.ToolResult ?? turn.ToolResult);

                                var primingBadge = StageConversationParser.GetPrimingBadge(turn) ?? (pairedResult != null ? StageConversationParser.GetPrimingBadge(pairedResult) : null);
                                var primingTooltip = StageConversationParser.GetPrimingTooltip(turn) ?? (pairedResult != null ? StageConversationParser.GetPrimingTooltip(pairedResult) : null);

                                var isToolError = isAskError || turn.IsError || (pairedResult?.IsError ?? false);
                                var memoryTarget = MemoryPresentationHelper.TryGetToolTarget(turn.ToolName, turn.ToolArguments, liveResult, isToolError);

                                <div class="chat-bubble assistant turn-tool">
                                    <div class="chat-avatar">⚙️</div>
                                    <div class="chat-bubble-body" style="width: 100%;">
                                        <ToolCallCard ToolName="@turn.ToolName"
                                                      Arguments="@turn.ToolArguments"
                                                      Result="@liveResult"
                                                      IsRunning="@isRunning"
                                                      IsError="@isToolError"
                                                      Offset="@(effectiveDuration.HasValue ? $"{effectiveDuration.Value}ms" : null)"
                                                      BadgeText="@primingBadge"
                                                      BadgeTooltip="@primingTooltip"
                                                      MemoryBadgeText="@memoryTarget?.BadgeText"
                                                      MemoryBadgeTooltip="@memoryTarget?.BadgeTooltip"
                                                      OnMemoryBadgeClick="@(() => OpenMemoryPageForTarget(memoryTarget))" />
                                    </div>
                                </div>
                            }
                            break;

                        case StageTurnRole.Optimization:
                            var (actionType, desc, tokensSaved, details) = StageConversationParser.ParseOptimizationPayload(turn);
                            <div class="chat-bubble assistant turn-optimization">
                                <div class="chat-avatar">⚡</div>
                                <div class="chat-bubble-body" style="width: 100%;">
                                    <OptimizationMarkerCard ActionType="@actionType"
                                                            Description="@desc"
                                                            TokensOrBytesSaved="@tokensSaved"
                                                            Unit="@(tokensSaved > 0 && (actionType.Contains("Compaction") || turn.MetadataJson?.Contains("TokensSaved") == true) ? "tokens" : "chars")"
                                                            Timestamp="@turn.Timestamp"
                                                            Details="@details" />
                                </div>
                            </div>
                            break;

                        case StageTurnRole.Assistant:
                            <div class="chat-bubble assistant turn-assistant">
                                <div class="chat-avatar">🤖</div>
                                <div class="chat-bubble-body">
                                    <div class="chat-bubble-header">
                                        <span class="chat-author">Agent Response</span>
                                        <span class="chat-timestamp font-mono">
                                            @turn.Timestamp.ToLocalTime().ToString("HH:mm:ss")
                                        </span>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(turn.ThinkingTrace))
                                    {
                                        <details class="think-trace">
                                            <summary>
                                                <span>🧠 Reasoning Trace</span>
                                                <span class="font-mono text-muted" style="margin-left: 0.4rem;">(@turn.ThinkingTrace.Length chars)</span>
                                            </summary>
                                            <div class="think-content font-mono">@turn.ThinkingTrace</div>
                                        </details>
                                    }

                                    <div class="chat-content-wrap forge-markdown turn-content-markdown" style="font-size: 0.88rem; line-height: 1.6; overflow-x: auto; max-width: 100%; min-width: 0; box-sizing: border-box;">
                                        @MarkdownHelper.ToMarkupString(turn.Content)
                                    </div>
                                </div>
                            </div>
                            break;
                    }
                </div>
            }

            @if (IsActiveStage &&
                 (Conversation == null || Conversation.Status == StageExecutionStatus.Running) &&
                 !string.IsNullOrWhiteSpace(LiveRunningToolName) &&
                 !turns.Any(t => t.Role == StageTurnRole.Tool && string.Equals(t.ToolName, LiveRunningToolName, StringComparison.OrdinalIgnoreCase) && string.IsNullOrEmpty(t.ToolResult)))
            {
                <div class="chat-bubble assistant turn-tool">
                    <div class="chat-avatar">⚙️</div>
                    <div class="chat-bubble-body" style="width: 100%;">
                        <ToolCallCard ToolName="@LiveRunningToolName"
                                      Arguments="@LiveRunningToolArguments"
                                      Result="@LiveRunningToolOutput"
                                      IsRunning="true" />
                    </div>
                </div>
            }

            @if (IsActiveStage && (Conversation == null || Conversation.Status == StageExecutionStatus.Running) && !string.IsNullOrEmpty(LiveStreamingThinking))
            {
                <div class="chat-bubble assistant turn-live-thinking">
                    <div class="chat-avatar">🧠</div>
                    <div class="chat-bubble-body" style="width: 100%;">
                        <div class="chat-bubble-header">
                            <span class="chat-author">Reasoning Deliberation</span>
                            <span class="step-badge badge-gpu live-badge">
                                LIVE STREAMING
                                <span class="cursor-blink">▊</span>
                            </span>
                        </div>
                        <details class="think-trace" open="true">
                            <summary>
                                <span>🧠 Reasoning Trace</span>
                                <span class="cursor-blink">▊</span>
                            </summary>
                            <div class="think-content font-mono">@LiveStreamingThinking<span class="cursor-blink">▊</span></div>
                        </details>
                    </div>
                </div>
            }

            @if (IsActiveStage && (Conversation == null || Conversation.Status == StageExecutionStatus.Running) && !string.IsNullOrEmpty(LiveStreamingMessage))
            {
                <div class="chat-bubble assistant streaming turn-live-message">
                    <div class="chat-avatar">🤖</div>
                    <div class="chat-bubble-body">
                        <div class="chat-bubble-header">
                            <span class="chat-author">Agent Response</span>
                            <span class="step-badge badge-gpu live-badge">LIVE STREAMING</span>
                            <span class="cursor-blink">▊</span>
                        </div>
                        <div class="chat-content-wrap forge-markdown turn-content-markdown" style="font-size: 0.88rem; line-height: 1.6; overflow-x: auto; max-width: 100%; min-width: 0; box-sizing: border-box;">
                            @MarkdownHelper.ToMarkupString(LiveStreamingMessage)
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Follow-Trail Floating Action Button -->
    <button id="@ChatPresentationHelper.StageConversationScrollBtnId"
            type="button"
            class="chat-scroll-bottom-btn stage-scroll-bottom-btn"
            title="@ChatPresentationHelper.FollowTrailTooltip"
            aria-label="@ChatPresentationHelper.FollowTrailAriaLabel"
            role="button">
        <span>@ChatPresentationHelper.FollowTrailButtonText</span>
    </button>
</div>

@code {
    private void OpenMemoryPageForTarget(MemoryToolTarget? target)
    {
        if (target == null || Task == null)
        {
            return;
        }

        Navigation.NavigateTo(MemoryPresentationHelper.BuildMemoryPageUrl(
            Task.WorkspaceId,
            target.Scope,
            target.RelativePath));
    }

    [Parameter] public Conversation? Conversation { get; set; }
    [Parameter] public ForgeTask? Task { get; set; }
    [Parameter] public bool IsActiveStage { get; set; }
    [Parameter] public string? LiveStreamingThinking { get; set; }
    [Parameter] public string? LiveStreamingMessage { get; set; }
    [Parameter] public string? LiveRunningToolName { get; set; }
    [Parameter] public string? LiveRunningToolArguments { get; set; }
    [Parameter] public string? LiveRunningToolOutput { get; set; }
    [Parameter] public IReadOnlyList<StageDefinition>? WorkflowStages { get; set; }
    [Parameter] public EventCallback OnConversationUpdated { get; set; }

    private int? _previousConversationId;
    private bool _shouldResetAutoScrollAfterRender;

    private bool IsStageWaitingForAnswer => StageConversationParser.IsStageWaitingForAnswer(Conversation, Task);

    protected override void OnParametersSet()
    {
        if (_previousConversationId != null && Conversation?.Id != _previousConversationId)
        {
            _previousConversationId = Conversation?.Id;
            _shouldResetAutoScrollAfterRender = true;
        }
        else if (_previousConversationId == null && Conversation?.Id != null)
        {
            _previousConversationId = Conversation.Id;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync(
                    "NightCodeForge.initAutoScroll",
                    ChatPresentationHelper.StageConversationContainerId,
                    ChatPresentationHelper.StageConversationScrollBtnId,
                    new {
                        scrollContainerSelector = ChatPresentationHelper.MainContentScrollSelector,
                        autoScrollOnByDefault = false
                    });
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
            {
                // Non-interactive or test rendering resilience per AGENTS.md
            }
        }

        if (_shouldResetAutoScrollAfterRender)
        {
            _shouldResetAutoScrollAfterRender = false;
            try
            {
                await JSRuntime.InvokeVoidAsync(
                    "NightCodeForge.resetAutoScroll",
                    ChatPresentationHelper.StageConversationContainerId,
                    false);
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
            {
                // Non-interactive or test rendering resilience per AGENTS.md
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync(
                "NightCodeForge.disposeAutoScroll",
                ChatPresentationHelper.StageConversationContainerId);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException)
        {
            // Circuit may already be disconnected
        }
    }

    private async Task HandlePreStageAnswersSubmittedAsync(
        IReadOnlyList<Question> pendingQuestions,
        IReadOnlyDictionary<int, string> answersByIndex)
    {
        if (Task == null || pendingQuestions.Count == 0 || answersByIndex.Count == 0)
        {
            return;
        }

        var dict = StageConversationParser.MapAnswersToQuestionIds(pendingQuestions, answersByIndex);
        if (dict.Count > 0)
        {
            await TaskOrchestrator.SubmitAnswersAsync(Task.Id, dict);
            foreach (var question in pendingQuestions)
            {
                if (dict.TryGetValue(question.Id, out var answer))
                {
                    question.Answer = answer;
                    question.Status = QuestionStatus.Answered;
                    question.AnsweredAt = DateTime.UtcNow;
                }
            }

            if (OnConversationUpdated.HasDelegate)
            {
                await OnConversationUpdated.InvokeAsync();
            }
            StateHasChanged();
        }
    }

    private async Task HandleBatchAnswersSubmittedAsync(IReadOnlyDictionary<int, string> answersByIndex)
    {
        if (Conversation?.TaskId == null || answersByIndex.Count == 0)
        {
            return;
        }

        var task = await TaskRepository.GetByIdAsync(Conversation.TaskId.Value);
        if (task == null) return;

        var batchQuestions = StageConversationParser.ResolvePendingBatchQuestions(task.Questions, Conversation.StageId);
        var dict = StageConversationParser.MapAnswersToQuestionIds(batchQuestions, answersByIndex);

        if (dict.Count > 0)
        {
            await TaskOrchestrator.SubmitAnswersAsync(task.Id, dict);
            var updatedConv = await TaskRepository.GetConversationWithTurnsAsync(Conversation.Id);
            if (updatedConv != null)
            {
                Conversation = updatedConv;
            }
            if (OnConversationUpdated.HasDelegate)
            {
                await OnConversationUpdated.InvokeAsync();
            }
            StateHasChanged();
        }
    }
}

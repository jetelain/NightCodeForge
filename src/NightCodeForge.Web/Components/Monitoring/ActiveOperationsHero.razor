@namespace NightCodeForge.Web.Components.Monitoring
@implements IDisposable
@using NightCodeForge.Core.Workflow
@using NightCodeForge.Web.Services
@inject OperationsTelemetryUiService TelemetryUi
@inject NightCodeForge.Core.Interfaces.IOperationsControlService OperationsControl
@inject ToastService ToastService
@inject Microsoft.Extensions.Logging.ILogger<ActiveOperationsHero> Logger

<div id="active-operations-hero" class="forge-card" style="margin-bottom: 1.5rem; padding: 1.25rem 1.5rem;">
    @if (OperationsControl.IsPaused)
    {
        <div id="gamer-mode-paused-card" style="margin-bottom: 1.25rem; padding: 1.15rem 1.35rem; background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.4); border-radius: var(--radius-md);">
            <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
                <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
                    <span style="font-size: 1.6rem; line-height: 1;">⏸️</span>
                    <div>
                        <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.35rem; flex-wrap: wrap;">
                            <strong style="color: var(--accent-amber); font-size: 1rem; font-weight: 700;">Global Operations Paused (Gamer / Dedicated Workload Mode)</strong>
                            <span class="forge-badge @(OperationsControl.ReclaimStatus == NightCodeForge.Core.Domain.OperationsReclaimStatus.Evicted ? "badge-emerald" : (OperationsControl.ReclaimStatus == NightCodeForge.Core.Domain.OperationsReclaimStatus.Failed ? "badge-crimson" : "badge-amber"))" style="font-size: 0.75rem;">
                                GPU VRAM: @OperationsControl.ReclaimStatus
                            </span>
                        </div>
                        <p style="margin: 0; color: var(--text-secondary); font-size: 0.85rem; line-height: 1.4;">
                            Background agent execution, inference pipelines, and Hangfire worker queues are paused. GPU VRAM has been reclaimed for games or external heavy workloads.
                        </p>
                        @if (!string.IsNullOrWhiteSpace(OperationsControl.LastReclaimError))
                        {
                            <div style="margin-top: 0.4rem; font-size: 0.8rem; color: var(--accent-crimson); font-weight: 500;">
                                ⚠️ VRAM Reclaim Issue: @OperationsControl.LastReclaimError
                            </div>
                        }
                    </div>
                </div>
                <button type="button" class="forge-btn forge-btn-warning btn-sm" id="btn-hero-resume-operations" @onclick="ResumeOperationsAsync" style="white-space: nowrap;">
                    ▶️ Resume Operations
                </button>
            </div>
        </div>
    }

    @if (!OperationsControl.IsPaused && _deferredTaskCount > 0)
    {
        <div id="deferred-tasks-retry-card" style="margin-bottom: 1.25rem; padding: 1.15rem 1.35rem; background: rgba(239, 68, 68, 0.08); border: 1px solid rgba(239, 68, 68, 0.35); border-radius: var(--radius-md);">
            <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
                <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
                    <span style="font-size: 1.6rem; line-height: 1;">⚠️</span>
                    <div>
                        <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.35rem; flex-wrap: wrap;">
                            <strong style="color: var(--accent-crimson); font-size: 1rem; font-weight: 700;">
                                @_deferredTaskCount Deferred Task(s) Pending Dispatch
                            </strong>
                            <span class="forge-badge badge-crimson" style="font-size: 0.75rem;">
                                Retry Needed
                            </span>
                        </div>
                        <p style="margin: 0; color: var(--text-secondary); font-size: 0.85rem; line-height: 1.4;">
                            These tasks were held during operations pause and could not be re-enqueued automatically on resume. You can retry dispatching them all, or manage individual tasks in the DevQueue.
                        </p>
                    </div>
                </div>
                <button type="button" class="forge-btn forge-btn-warning btn-sm" id="btn-hero-retry-deferred" @onclick="ResumeOperationsAsync" style="white-space: nowrap;">
                    🔄 Retry Dispatch (@_deferredTaskCount)
                </button>
            </div>
        </div>
    }

    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.75rem;">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
            <span style="font-size: 1.25rem;">⚡</span>
            <h3 style="margin: 0; font-size: 1.1rem; font-weight: 700; color: var(--text-primary);">Active System Operations</h3>
        </div>
        <div style="font-size: 0.8rem; color: var(--text-muted);">
            Universal runtime interception across all tasks, background jobs &amp; CLI tools
        </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 1.25rem;">
        <!-- In-Flight LLM Inference Card -->
        <div id="active-llm-card" class="forge-subcard" style="padding: 1.25rem; border-radius: var(--radius-md); background: var(--bg-surface); border: 1px solid var(--border-subtle); display: flex; flex-direction: column; justify-content: space-between;">
            <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span style="font-size: 1.3rem;">🧠</span>
                        <strong style="font-size: 0.95rem; color: var(--text-primary);">In-Flight LLM Inference</strong>
                    </div>
                    @if (TelemetryUi.ActiveLlmCall != null)
                    {
                        <span class="forge-badge badge-amber" style="font-size: 0.78rem; font-weight: 600;">
                            ● Inferring
                        </span>
                    }
                    else
                    {
                        <span class="forge-badge badge-gray" style="font-size: 0.78rem;">
                            ○ Idle
                        </span>
                    }
                </div>

                @if (TelemetryUi.ActiveLlmCall != null)
                {
                    var call = TelemetryUi.ActiveLlmCall;
                    <div style="margin-bottom: 0.75rem;">
                        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.35rem;">
                            <span style="font-weight: 700; color: var(--text-primary); font-size: 0.92rem;">@call.Model</span>
                            <span class="forge-badge @OperationsTelemetryUiService.GetRouteBadgeClass(call.TargetBackend)" style="font-size: 0.75rem;">
                                @call.TargetBackend
                            </span>
                        </div>
                        <div style="display: flex; gap: 1.25rem; font-size: 0.82rem; color: var(--text-secondary); margin-bottom: 0.5rem; flex-wrap: wrap;">
                            <span title="Context Size (Prompt Tokens)">Context: <strong style="color: var(--text-primary);">@call.PromptTokens tokens</strong></span>
                            <span>Speed: <strong style="color: var(--accent-teal);">@OperationsTelemetryUiService.FormatSpeed(call.TokensPerSecond)</strong></span>
                            <span>Tokens: <strong>@call.CompletionTokens</strong></span>
                            @if (call.ReasoningTokens > 0)
                            {
                                <span title="Reasoning / Thinking Tokens">Reasoning: <strong style="color: var(--accent-amber);">🧠 @call.ReasoningTokens</strong></span>
                            }
                            <span>Elapsed: <strong>@OperationsTelemetryUiService.FormatLiveLlmDuration(call)</strong></span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(call.PromptPreview))
                        {
                            <div class="font-mono" style="padding: 0.5rem 0.75rem; border-radius: var(--radius-sm); background: var(--bg-input); font-size: 0.78rem; color: var(--text-muted); max-height: 58px; overflow: hidden; text-overflow: ellipsis; white-space: pre-wrap; line-height: 1.4;">
                                "@call.PromptPreview"
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div style="padding: 1.25rem 0.5rem; text-align: center; color: var(--text-muted); font-size: 0.88rem;">
                        No LLM inference calls currently in flight.<br/>
                        <span style="font-size: 0.78rem;">Ready for agent prompts, ideation chats, or quality gates.</span>
                    </div>
                }
            </div>
        </div>

        <!-- In-Flight Shell Operation Card -->
        <div id="active-shell-card" class="forge-subcard" style="padding: 1.25rem; border-radius: var(--radius-md); background: var(--bg-surface); border: 1px solid var(--border-subtle); display: flex; flex-direction: column; justify-content: space-between;">
            <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span style="font-size: 1.3rem;">💻</span>
                        <strong style="font-size: 0.95rem; color: var(--text-primary);">In-Flight Shell Operation</strong>
                    </div>
                    @if (TelemetryUi.ActiveShellCommand != null)
                    {
                        <span class="forge-badge badge-amber" style="font-size: 0.78rem; font-weight: 600;">
                            ● Executing
                        </span>
                    }
                    else
                    {
                        <span class="forge-badge badge-gray" style="font-size: 0.78rem;">
                            ○ Idle
                        </span>
                    }
                </div>

                @if (TelemetryUi.ActiveShellCommand != null)
                {
                    var cmd = TelemetryUi.ActiveShellCommand;
                    <div style="margin-bottom: 0.75rem;">
                        <div class="font-mono" style="font-weight: 700; color: var(--text-primary); font-size: 0.85rem; margin-bottom: 0.35rem; word-break: break-all;">
                            $ @cmd.CommandLine
                        </div>
                        <div style="display: flex; gap: 1.25rem; font-size: 0.82rem; color: var(--text-secondary); margin-bottom: 0.5rem;">
                            <span>Cwd: <strong class="font-mono" style="font-size: 0.78rem;">@cmd.WorkingDirectory</strong></span>
                            <span>Elapsed: <strong>@OperationsTelemetryUiService.FormatLiveShellDuration(cmd)</strong></span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(cmd.OutputPreview))
                        {
                            <div class="font-mono" style="padding: 0.5rem 0.75rem; border-radius: var(--radius-sm); background: var(--bg-input); font-size: 0.76rem; color: var(--text-secondary); max-height: 58px; overflow: hidden; text-overflow: ellipsis; white-space: pre-wrap; line-height: 1.3;">
                                @cmd.OutputPreview
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div style="padding: 1.25rem 0.5rem; text-align: center; color: var(--text-muted); font-size: 0.88rem;">
                        No shell commands currently running.<br/>
                        <span style="font-size: 0.78rem;">Ready for dotnet build, test passes, bash tools, or git CLI.</span>
                    </div>
                }
            </div>
        </div>

        <!-- In-Flight Autonomous Task Card -->
        <div id="active-task-card" class="forge-subcard" style="padding: 1.25rem; border-radius: var(--radius-md); background: var(--bg-surface); border: 1px solid var(--border-subtle); display: flex; flex-direction: column; justify-content: space-between;">
            <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span style="font-size: 1.3rem;">🎯</span>
                        <strong style="font-size: 0.95rem; color: var(--text-primary);">In-Flight Autonomous Task</strong>
                    </div>
                    @if (TelemetryUi.ActiveTask != null)
                    {
                        <span class="badge-running" id="badge-active-task-running">
                            <span class="pulse-dot"></span> Running
                        </span>
                    }
                    else
                    {
                        <span class="forge-badge badge-gray" style="font-size: 0.78rem;">
                            ○ Idle
                        </span>
                    }
                </div>

                @if (TelemetryUi.ActiveTask != null)
                {
                    var active = TelemetryUi.ActiveTask;
                    <div style="margin-bottom: 0.75rem;">
                        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.35rem;">
                            <span class="font-mono text-secondary" style="font-weight: 700;">#@active.TaskId</span>
                            <span style="font-weight: 700; color: var(--text-primary); font-size: 0.92rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                @active.TaskTitle
                            </span>
                        </div>
                        <div style="display: flex; gap: 1.25rem; font-size: 0.82rem; color: var(--text-secondary); margin-bottom: 0.5rem; flex-wrap: wrap;">
                            <span>Stage: <strong class="forge-badge badge-purple" style="font-size: 0.75rem;">@active.CurrentStageId</strong></span>
                            <span>Queue: <strong>@active.QueueName</strong></span>
                            <span>Priority: <strong>P@(active.Priority)</strong></span>
                        </div>
                        <div style="display: flex; gap: 0.5rem; margin-top: 0.75rem;">
                            <a href="/inspector/@active.TaskId" class="forge-btn forge-btn-secondary btn-xs" style="text-decoration: none;">
                                🔍 Inspector
                            </a>
                            <a href="/tasks/@active.TaskId" class="forge-btn forge-btn-secondary btn-xs" style="text-decoration: none;">
                                📋 Details
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <div style="padding: 1.25rem 0.5rem; text-align: center; color: var(--text-muted); font-size: 0.88rem;">
                        No autonomous task currently in flight.<br/>
                        <span style="font-size: 0.78rem;">DevQueue dispatcher is awaiting scheduled tasks.</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private CancellationTokenSource? _timerCts;
    private bool _isDisposed;
    private int _deferredTaskCount;

    protected override async Task OnInitializedAsync()
    {
        TelemetryUi.OnChange += HandleChange;
        OperationsControl.OnOperationsStateChanged += HandleOperationsChanged;
        StartLiveTimer();
        await RefreshDeferredCountAsync();
    }

    private async void HandleOperationsChanged(bool isPaused)
    {
        if (_isDisposed) return;
        await RefreshDeferredCountAsync();
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task RefreshDeferredCountAsync()
    {
        try
        {
            _deferredTaskCount = await OperationsControl.GetDeferredTaskCountAsync();
        }
        catch
        {
            // Best effort state hydration
        }
    }

    private async Task ResumeOperationsAsync()
    {
        try
        {
            await OperationsControl.ResumeOperationsAsync();
            await RefreshDeferredCountAsync();
            ToastService.Show("Operations Resumed", "Deferred tasks have been re-enqueued for execution.", ToastLevel.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to resume operations from ActiveOperationsHero.");
            ToastService.Show("Operations Control Error", ex.Message, ToastLevel.Error);
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private void StartLiveTimer()
    {
        _timerCts = new CancellationTokenSource();
        _ = RunLiveTickerAsync(_timerCts.Token);
    }

    private async Task RunLiveTickerAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(500));
        try
        {
            while (!token.IsCancellationRequested && await timer.WaitForNextTickAsync(token))
            {
                if (_isDisposed) break;
                if (TelemetryUi.ActiveLlmCall != null || TelemetryUi.ActiveShellCommand != null || TelemetryUi.ActiveTask != null)
                {
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Expected on component disposal
        }
        catch (ObjectDisposedException)
        {
            // Expected if component is disposed while awaiting invoke or tick
        }
    }

    private void HandleChange()
    {
        if (_isDisposed) return;
        try
        {
            _ = InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // Expected if component was disposed immediately before event handling
        }
    }

    public void Dispose()
    {
        _isDisposed = true;
        TelemetryUi.OnChange -= HandleChange;
        OperationsControl.OnOperationsStateChanged -= HandleOperationsChanged;
        if (_timerCts != null)
        {
            _timerCts.Cancel();
            _timerCts.Dispose();
            _timerCts = null;
        }
    }
}

@namespace NightCodeForge.Web.Components.Monitoring
@using NightCodeForge.Core.Domain

<div class="stage-run-selector card-surface" style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 1rem; margin-bottom: 1rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.85rem; flex-wrap: wrap; gap: 0.5rem;">
        <div style="font-weight: 700; font-size: 0.95rem; color: var(--text-primary); display: flex; align-items: center; gap: 0.5rem;">
            <span>🧭</span>
            <span>Pipeline Stages &amp; Runs</span>
            <span class="forge-badge badge-indigo" style="font-size: 0.72rem;">@Conversations.Count run(s)</span>
        </div>
        <div style="font-size: 0.76rem; color: var(--text-muted);">
            Select a stage run to inspect turns, prompts, reasoning, and tool executions.
        </div>
    </div>

    @if (!Conversations.Any())
    {
        <div style="color: var(--text-muted); font-size: 0.82rem; font-style: italic; padding: 0.5rem 0;">
            No stage conversations recorded yet.
        </div>
    }
    else
    {
        var grouped = GroupConversationsByStage();
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
            @foreach (var group in grouped)
            {
                var stageId = group.Key;
                var runs = group.Value;
                var isDeterministic = runs.FirstOrDefault()?.StageKind == WorkflowStageKind.Deterministic;

                <div style="border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 0.65rem 0.85rem; background: var(--bg-input);">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.45rem; flex-wrap: wrap; gap: 0.35rem;">
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <span style="font-weight: 600; font-size: 0.84rem; color: var(--text-primary);">
                                @FormatStageName(stageId)
                            </span>
                            <span class="forge-badge @(isDeterministic ? "badge-teal" : "badge-indigo")" style="font-size: 0.68rem;">
                                @(isDeterministic ? "Deterministic CPU" : "Agentic GPU")
                            </span>
                        </div>
                    </div>

                    <!-- Run Attempt Pills -->
                    <div style="display: flex; flex-wrap: wrap; gap: 0.4rem;">
                        @foreach (var conv in runs)
                        {
                            var isSelected = SelectedConversation?.Id == conv.Id;
                            var statusBadge = GetStatusBadge(conv.Status);
                            var modelTag = !string.IsNullOrWhiteSpace(conv.ModelName) ? conv.ModelName : conv.AgentProfileId;

                            <button type="button"
                                    class="forge-btn @(isSelected ? "forge-btn-primary" : "forge-btn-secondary")"
                                    style="padding: 0.25rem 0.65rem; font-size: 0.76rem; display: flex; align-items: center; gap: 0.4rem; border-radius: 9999px;"
                                    @onclick="() => SelectConversation(conv)">
                                <span>Run @conv.AttemptIndex</span>
                                <span>@statusBadge.Icon</span>
                                @if (!string.IsNullOrWhiteSpace(modelTag))
                                {
                                    <span style="opacity: 0.75; font-size: 0.68rem; font-family: var(--font-mono);">[@modelTag]</span>
                                }
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<StageConversation> Conversations { get; set; } = Array.Empty<StageConversation>();
    [Parameter] public StageConversation? SelectedConversation { get; set; }
    [Parameter] public EventCallback<StageConversation> OnConversationSelected { get; set; }

    private async Task SelectConversation(StageConversation conversation)
    {
        if (OnConversationSelected.HasDelegate)
        {
            await OnConversationSelected.InvokeAsync(conversation);
        }
    }

    private Dictionary<string, List<StageConversation>> GroupConversationsByStage()
    {
        var dict = new Dictionary<string, List<StageConversation>>(StringComparer.OrdinalIgnoreCase);
        foreach (var conv in Conversations.OrderBy(c => c.StartedAt).ThenBy(c => c.AttemptIndex))
        {
            if (!dict.TryGetValue(conv.StageId, out var list))
            {
                list = new List<StageConversation>();
                dict[conv.StageId] = list;
            }
            list.Add(conv);
        }
        return dict;
    }

    private static string FormatStageName(string stageId)
    {
        return stageId switch
        {
            "task-review" => "1. ForgeTask Review",
            "deterministic-pre-check" or "deterministic-pre-impl" => "2. Pre-Check Gate",
            "implementation" => "3. Implementation",
            "deterministic-post-check" or "deterministic-post-impl" => "4. Post-Check Gate",
            "pr-review" or "code-review-fix" => "5. Pull Request Review",
            "deterministic-post-review" => "6. Post-Review Verification",
            "merge" => "7. Squash & Merge",
            _ => stageId
        };
    }

    private static (string Icon, string CssClass) GetStatusBadge(StageExecutionStatus status)
    {
        return status switch
        {
            StageExecutionStatus.Completed => ("✅", "badge-emerald"),
            StageExecutionStatus.Running => ("⏳", "badge-amber"),
            StageExecutionStatus.Failed => ("❌", "badge-crimson"),
            StageExecutionStatus.Skipped => ("⏭", "badge-zinc"),
            StageExecutionStatus.Pending => ("⚪", "badge-zinc"),
            _ => ("⚪", "badge-zinc")
        };
    }
}

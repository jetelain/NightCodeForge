@namespace NightCodeForge.Web.Components.Monitoring
@using NightCodeForge.Core.Domain

<div class="pipeline-stepper-container card-surface">
    <div class="pipeline-stepper">
        @foreach (var stage in Stages)
        {
            var isClickable = OnStageSelected.HasDelegate;
            <div class="step-item @GetStepClass(stage) @(isClickable ? "step-clickable" : "")"
                 id="stage-step-@stage.Order"
                 style="@(isClickable ? "cursor: pointer;" : "")"
                 @onclick="() => HandleStageClick(stage.Id)"
                 title="@(isClickable ? $"Select {stage.Name} conversation" : stage.Name)">
                <div class="step-header">
                    <span class="step-badge @(stage.IsAgentic ? "badge-gpu" : (stage.Order == 7 ? "badge-gate" : "badge-cpu"))">
                        @(stage.IsAgentic ? "⚡ GPU" : (stage.Order == 7 ? "🔀 Gate" : "⚙️ CPU"))
                    </span>
                    <span class="step-index">#@stage.Order</span>
                </div>
                <div class="step-icon-circle">
                    @if (stage.Status == StageExecutionStatus.Running)
                    {
                        <div class="spinner-pulse"></div>
                    }
                    else if (stage.Status == StageExecutionStatus.Completed)
                    {
                        <span>✓</span>
                    }
                    else if (stage.Status == StageExecutionStatus.Failed)
                    {
                        <span>✕</span>
                    }
                    else if (stage.Status == StageExecutionStatus.WaitingForHuman)
                    {
                        <span>✋</span>
                    }
                    else
                    {
                        <span>@stage.Order</span>
                    }
                </div>
                <div class="step-title">@stage.Name</div>
                <div class="step-status">@stage.StatusText</div>
                @if (!string.IsNullOrEmpty(stage.MetricsSummary))
                {
                    <div class="step-metrics-badge">@stage.MetricsSummary</div>
                }
            </div>
            @if (stage.Order < 7)
            {
                <div class="step-connector @(IsConnectorActive(stage) ? "connector-completed" : "")"></div>
            }
        }
    </div>
</div>

@code {
    [Parameter] public int? TaskId { get; set; }
    [Parameter] public string? CurrentStageId { get; set; }
    [Parameter] public StageExecutionStatus? CurrentStageStatus { get; set; }
    [Parameter] public TaskOverallStatus? OverallStatus { get; set; }
    [Parameter] public IEnumerable<Conversation>? Conversations { get; set; }
    [Parameter] public EventCallback<string> OnStageSelected { get; set; }

    public class StageDefinition
    {
        public int Order { get; set; }
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public bool IsAgentic { get; set; }
        public StageExecutionStatus Status { get; set; } = StageExecutionStatus.Pending;
        public string StatusText { get; set; } = "Pending";
        public string? MetricsSummary { get; set; }
    }

    public List<StageDefinition> Stages { get; set; } = CreateDefaultStages();

    private static List<StageDefinition> CreateDefaultStages() => new()
    {
        new StageDefinition { Order = 1, Id = "task-review", Name = "ForgeTask Review", IsAgentic = true, StatusText = "Awaiting review" },
        new StageDefinition { Order = 2, Id = "deterministic-pre-impl", Name = "Pre-Impl Baseline", IsAgentic = false, StatusText = "Baseline build & tests" },
        new StageDefinition { Order = 3, Id = "implementation", Name = "Implementation", IsAgentic = true, StatusText = "Code modification" },
        new StageDefinition { Order = 4, Id = "deterministic-post-impl", Name = "Post-Impl Gates", IsAgentic = false, StatusText = "Ratchets & coverage" },
        new StageDefinition { Order = 5, Id = "code-review-fix", Name = "Code Review", IsAgentic = true, StatusText = "Gap analysis & fixes" },
        new StageDefinition { Order = 6, Id = "deterministic-post-review", Name = "Post-Review Verification", IsAgentic = false, StatusText = "Deterministic validation" },
        new StageDefinition { Order = 7, Id = "merge", Name = "Merge Resolution", IsAgentic = false, StatusText = "Squash & merge gate" }
    };

    private int? _lastTaskId;

    protected override void OnParametersSet()
    {
        if (OverallStatus.HasValue || (Conversations != null && Conversations.Any()) || (TaskId.HasValue && TaskId != _lastTaskId))
        {
            Stages = CreateDefaultStages();
            _lastTaskId = TaskId;

            if (OverallStatus == TaskOverallStatus.Closed)
            {
                foreach (var st in Stages)
                {
                    st.Status = StageExecutionStatus.Completed;
                    st.StatusText = "Completed";
                }
                return;
            }
            if (OverallStatus == TaskOverallStatus.Ready)
            {
                foreach (var st in Stages)
                {
                    st.Status = StageExecutionStatus.Completed;
                    st.StatusText = st.Order < 7 ? "Completed" : "Ready to Merge";
                }
                return;
            }

            if (Conversations != null && Conversations.Any())
            {
                foreach (var conv in Conversations.OrderByDescending(c => c.StartedAt))
                {
                    var order = ResolveStageOrder(conv.StageId);
                    var st = Stages.FirstOrDefault(s => s.Order == order);
                    if (st != null)
                    {
                        if (conv.Status is StageExecutionStatus.Completed or StageExecutionStatus.Failed
                            or StageExecutionStatus.Running or StageExecutionStatus.WaitingForHuman)
                        {
                            st.Status = conv.Status;
                            st.StatusText = GetDefaultStatusText(conv.Status);
                        }
                        if (!string.IsNullOrWhiteSpace(conv.Summary))
                        {
                            st.MetricsSummary = conv.Summary;
                        }
                    }
                }
            }

            if (OverallStatus == TaskOverallStatus.Failed)
            {
                var failedStage = Stages.FirstOrDefault(s => s.Status == StageExecutionStatus.Failed);
                if (failedStage == null && !string.IsNullOrEmpty(CurrentStageId))
                {
                    var order = ResolveStageOrder(CurrentStageId);
                    var target = Stages.FirstOrDefault(s => s.Order == order);
                    if (target != null)
                    {
                        target.Status = StageExecutionStatus.Failed;
                        target.StatusText = "Failed";
                    }
                }
            }
        }

        if (!string.IsNullOrEmpty(CurrentStageId) && OverallStatus != TaskOverallStatus.Closed && OverallStatus != TaskOverallStatus.Ready && OverallStatus != TaskOverallStatus.Failed)
        {
            ApplyStageTransition(CurrentStageId, CurrentStageStatus ?? StageExecutionStatus.Running);
        }
    }

    private async Task HandleStageClick(string stageId)
    {
        if (OnStageSelected.HasDelegate)
        {
            await OnStageSelected.InvokeAsync(stageId);
        }
    }

    /// <summary>
    /// Applies a stage transition received as a raw string (e.g. from SignalR).
    /// Unknown status values are treated as <see cref="StageExecutionStatus.Pending"/>.
    /// </summary>
    public void ApplyStageTransition(string stageId, string status)
    {
        var parsed = Enum.TryParse<StageExecutionStatus>(status, ignoreCase: true, out var value)
            ? value
            : StageExecutionStatus.Pending;
        ApplyStageTransition(stageId, parsed);
    }

    public void ApplyStageTransition(string stageId, StageExecutionStatus status)
    {
        var order = ResolveStageOrder(stageId);
        if (order == 0) return;

        for (int i = 0; i < Stages.Count; i++)
        {
            var st = Stages[i];
            if (st.Order < order)
            {
                if (st.Status != StageExecutionStatus.Failed)
                {
                    st.Status = StageExecutionStatus.Completed;
                    st.StatusText = "Completed";
                }
            }
            else if (st.Order == order)
            {
                st.Status = status;
                st.StatusText = GetDefaultStatusText(status);
            }
            else
            {
                if (st.Status != StageExecutionStatus.Completed)
                {
                    st.Status = StageExecutionStatus.Pending;
                    st.StatusText = "Pending";
                }
            }
        }
        StateHasChanged();
    }

    private static string GetDefaultStatusText(StageExecutionStatus status) => status switch
    {
        StageExecutionStatus.Running => "In Progress",
        StageExecutionStatus.WaitingForHuman => "Waiting for Human",
        _ => status.ToString()
    };

    public void ApplyGateResult(string gateName, bool passed, string metricsSummary)
    {
        var order = gateName.Contains("Pre", StringComparison.OrdinalIgnoreCase) || gateName.Contains("Baseline", StringComparison.OrdinalIgnoreCase) ? 2 : 4;
        if (gateName.Contains("Review", StringComparison.OrdinalIgnoreCase)) order = 6;
        if (gateName.Contains("Merge", StringComparison.OrdinalIgnoreCase)) order = 7;

        var stage = Stages.FirstOrDefault(s => s.Order == order);
        if (stage != null)
        {
            stage.Status = passed ? StageExecutionStatus.Completed : StageExecutionStatus.Failed;
            stage.StatusText = passed ? "Passed" : "Failed";
            stage.MetricsSummary = metricsSummary;
        }
        StateHasChanged();
    }

    public void Reset()
    {
        Stages = CreateDefaultStages();
        StateHasChanged();
    }

    private int ResolveStageOrder(string? stageId)
    {
        if (string.IsNullOrWhiteSpace(stageId)) return 0;
        var s = stageId.Trim().ToLowerInvariant().Replace("-", "").Replace("_", "");
        if (s.Contains("merge") || s == "7") return 7;
        if (s.Contains("taskreview") || s.Contains("reviewtask") || s == "1") return 1;
        if (s.Contains("preimpl") || s.Contains("baseline") || s == "2") return 2;
        if (s.Contains("postreview") || s == "6") return 6;
        if (s.Contains("codereview") || s == "5") return 5;
        if (s.Contains("postimpl") || s.Contains("ratchet") || s.Contains("coverage") || s == "4") return 4;
        if (s.Contains("implementation") || s.Contains("implement") || s == "3") return 3;

        var match = Stages.FirstOrDefault(st => st.Id.Equals(stageId, StringComparison.OrdinalIgnoreCase) || st.Name.Equals(stageId, StringComparison.OrdinalIgnoreCase));
        return match?.Order ?? 0;
    }

    private string GetStepClass(StageDefinition stage)
    {
        return stage.Status switch
        {
            StageExecutionStatus.Running => "step-active",
            StageExecutionStatus.Completed => "step-completed",
            StageExecutionStatus.Failed => "step-failed",
            StageExecutionStatus.WaitingForHuman => "step-waiting",
            _ => "step-pending"
        };
    }

    private bool IsConnectorActive(StageDefinition stage)
    {
        var next = Stages.FirstOrDefault(s => s.Order == stage.Order + 1);
        return stage.Status == StageExecutionStatus.Completed || (next != null && next.Status == StageExecutionStatus.Running);
    }
}


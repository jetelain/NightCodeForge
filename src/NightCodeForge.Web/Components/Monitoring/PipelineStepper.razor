@namespace NightCodeForge.Web.Components.Monitoring
@using NightCodeForge.Core.Domain

<div class="pipeline-stepper-container card-surface">
    <div class="pipeline-stepper">
        @for (int i = 0; i < Stages.Count; i++)
        {
            var stage = Stages[i];
            var isClickable = OnStageSelected.HasDelegate;
            var isLast = i == Stages.Count - 1;
            var isMergeStage = stage.StageId.Equals(MergeStageId, StringComparison.OrdinalIgnoreCase);
            var accessibleDescription = $"{stage.DisplayName} - {stage.StatusText}";
            var tooltipText = isClickable
                ? $"Select {stage.DisplayName} ({stage.StatusText})"
                : accessibleDescription;

            <div class="step-item @GetStepClass(stage) @(isClickable ? "step-clickable" : "")"
                 id="stage-step-@stage.SequenceOrder"
                 role="@(isClickable ? "button" : null)"
                 tabindex="@(isClickable ? 0 : null)"
                 style="@(isClickable ? "cursor: pointer;" : "")"
                 aria-label="@accessibleDescription"
                 title="@tooltipText"
                 @onclick="() => HandleStageClick(stage.StageId)"
                 @onkeydown="e => HandleKeyDown(e, stage.StageId)"
                 @onkeydown:preventDefault="_preventSpaceDefault"
                 @onkeyup="HandleKeyUp">
                @* Note: native tooltips do not cover touch devices; status remains conveyed on touch by icon overlays (not color alone). *@
                <span class="visually-hidden" aria-hidden="true">@accessibleDescription</span>
                <div class="step-header">
                    <span class="step-badge @(stage.IsAgentic ? "badge-gpu" : "badge-cpu")">
                        @(stage.IsAgentic ? "⚡ GPU" : "⚙️ CPU")
                    </span>
                    @* <span class="step-index">#@stage.SequenceOrder</span> *@
                </div>
                <div class="step-icon-circle">
                    @if (stage.Status == StageExecutionStatus.Running)
                    {
                        <div class="spinner-pulse"></div>
                        <span class="stage-icon-text">@stage.Icon</span>
                    }
                    else if (stage.Status == StageExecutionStatus.Completed)
                    {
                        <span class="stage-icon-text">@stage.Icon</span>
                        <span class="status-overlay status-overlay-success">✓</span>
                    }
                    else if (stage.Status == StageExecutionStatus.Failed)
                    {
                        <span class="stage-icon-text">@stage.Icon</span>
                        <span class="status-overlay status-overlay-failed">✕</span>
                    }
                    else if (stage.Status == StageExecutionStatus.WaitingForHuman)
                    {
                        <span class="stage-icon-text">@stage.Icon</span>
                        <span class="status-overlay status-overlay-waiting">✋</span>
                    }
                    else
                    {
                        <span class="stage-icon-text">@stage.Icon</span>
                    }
                </div>
                <div class="step-title">@stage.DisplayName</div>
                @if (!string.IsNullOrEmpty(stage.MetricsSummary))
                {
                    <div class="step-metrics-badge">@stage.MetricsSummary</div>
                }
            </div>
            @if (!isLast)
            {
                <div class="step-connector @(IsConnectorActive(stage) ? "connector-completed" : "")"></div>
            }
        }
    </div>
</div>

@code {
    public const string MergeStageId = StandardStageIds.Merge;
    public const string MergeStageDisplayName = "Merge Resolution";
    public const string MergeStageIcon = "🔀";

    [Parameter] public int? TaskId { get; set; }
    [Parameter] public IReadOnlyList<StageDefinition>? WorkflowStages { get; set; }
    [Parameter] public string? CurrentStageId { get; set; }
    [Parameter] public StageExecutionStatus? CurrentStageStatus { get; set; }
    [Parameter] public TaskOverallStatus? OverallStatus { get; set; }
    [Parameter] public IEnumerable<Conversation>? Conversations { get; set; }
    [Parameter] public EventCallback<string> OnStageSelected { get; set; }

    public class StageStepItem
    {
        public int SequenceOrder { get; set; }
        public string StageId { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public string Icon { get; set; } = "⚙️";
        public WorkflowStageKind Kind { get; set; } = WorkflowStageKind.Agentic;
        public bool IsAgentic => Kind == WorkflowStageKind.Agentic;
        public StageExecutionStatus Status { get; set; } = StageExecutionStatus.Pending;
        public string StatusText { get; set; } = "Pending";
        public string? MetricsSummary { get; set; }

        public int Order => SequenceOrder;
        public string Id => StageId;
        public string Name => DisplayName;
    }

    public List<StageStepItem> Stages { get; set; } = new();

    private List<StageStepItem> InitializeStages()
    {
        if (WorkflowStages != null && WorkflowStages.Count > 0)
        {
            var items = WorkflowStages
                .OrderBy(s => s.SequenceOrder)
                .Select(s => new StageStepItem
                {
                    SequenceOrder = s.SequenceOrder,
                    StageId = s.StageId,
                    DisplayName = s.DisplayName,
                    Icon = string.IsNullOrWhiteSpace(s.Icon) ? (s.Kind == WorkflowStageKind.Agentic ? "⚡" : "⚙️") : s.Icon,
                    Kind = s.Kind,
                    Status = StageExecutionStatus.Pending,
                    StatusText = "Pending"
                })
                .ToList();

            // Merge is an implicit final stage of all workflows
            if (!items.Any(s => s.StageId.Equals(MergeStageId, StringComparison.OrdinalIgnoreCase)))
            {
                items.Add(new StageStepItem
                {
                    SequenceOrder = items.Count + 1,
                    StageId = MergeStageId,
                    DisplayName = MergeStageDisplayName,
                    Icon = MergeStageIcon,
                    Kind = WorkflowStageKind.Deterministic,
                    Status = StageExecutionStatus.Pending,
                    StatusText = "Squash & merge gate"
                });
            }

            return items;
        }

        return new List<StageStepItem>();
    }

    private int? _lastTaskId;

    protected override void OnParametersSet()
    {
        Stages = InitializeStages();
        _lastTaskId = TaskId;

        if (Stages.Count == 0) return;

        if (OverallStatus == TaskOverallStatus.Closed)
        {
            foreach (var st in Stages)
            {
                st.Status = StageExecutionStatus.Completed;
                st.StatusText = "Completed";
            }
            return;
        }

        if (OverallStatus == TaskOverallStatus.Ready)
        {
            for (int i = 0; i < Stages.Count; i++)
            {
                var st = Stages[i];
                st.Status = StageExecutionStatus.Completed;
                st.StatusText = (i == Stages.Count - 1) ? "Ready to Merge" : "Completed";
            }
            return;
        }

        if (Conversations != null && Conversations.Any())
        {
            foreach (var conv in Conversations.OrderByDescending(c => c.StartedAt))
            {
                var order = ResolveStageOrder(conv.StageId);
                var st = Stages.FirstOrDefault(s => s.SequenceOrder == order);
                if (st != null)
                {
                    if (conv.Status is StageExecutionStatus.Completed or StageExecutionStatus.Failed
                        or StageExecutionStatus.Running or StageExecutionStatus.WaitingForHuman)
                    {
                        st.Status = conv.Status;
                        st.StatusText = GetDefaultStatusText(conv.Status);
                    }
                }
            }
        }

        if (OverallStatus == TaskOverallStatus.Failed)
        {
            var failedStage = Stages.FirstOrDefault(s => s.Status == StageExecutionStatus.Failed);
            if (failedStage == null && !string.IsNullOrEmpty(CurrentStageId))
            {
                var order = ResolveStageOrder(CurrentStageId);
                var target = Stages.FirstOrDefault(s => s.SequenceOrder == order);
                if (target != null)
                {
                    target.Status = StageExecutionStatus.Failed;
                    target.StatusText = "Failed";
                }
            }
        }

        if (!string.IsNullOrEmpty(CurrentStageId) && OverallStatus != TaskOverallStatus.Closed && OverallStatus != TaskOverallStatus.Ready && OverallStatus != TaskOverallStatus.Failed)
        {
            ApplyStageTransition(CurrentStageId, CurrentStageStatus ?? StageExecutionStatus.Running);
        }
    }

    private bool _preventSpaceDefault;

    private async Task HandleStageClick(string stageId)
    {
        if (OnStageSelected.HasDelegate)
        {
            await OnStageSelected.InvokeAsync(stageId);
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e, string stageId)
    {
        if (!OnStageSelected.HasDelegate) return;

        if (e.Key is " " or "Spacebar")
        {
            _preventSpaceDefault = true;
            await HandleStageClick(stageId);
        }
        else if (e.Key == "Enter")
        {
            _preventSpaceDefault = false;
            await HandleStageClick(stageId);
        }
        else
        {
            _preventSpaceDefault = false;
        }
    }

    private void HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key is " " or "Spacebar")
        {
            _preventSpaceDefault = false;
        }
    }

    /// <summary>
    /// Applies a stage transition received as a raw string (e.g. from SignalR).
    /// Unknown status values are treated as <see cref="StageExecutionStatus.Pending"/>.
    /// </summary>
    public void ApplyStageTransition(string stageId, string status)
    {
        var parsed = Enum.TryParse<StageExecutionStatus>(status, ignoreCase: true, out var value)
            ? value
            : StageExecutionStatus.Pending;
        ApplyStageTransition(stageId, parsed);
    }

    public void ApplyStageTransition(string stageId, StageExecutionStatus status)
    {
        var order = ResolveStageOrder(stageId);
        if (order == 0) return;

        for (int i = 0; i < Stages.Count; i++)
        {
            var st = Stages[i];
            if (st.SequenceOrder < order)
            {
                if (st.Status != StageExecutionStatus.Failed)
                {
                    st.Status = StageExecutionStatus.Completed;
                    st.StatusText = "Completed";
                }
            }
            else if (st.SequenceOrder == order)
            {
                st.Status = status;
                st.StatusText = GetDefaultStatusText(status);
            }
            else
            {
                if (st.Status != StageExecutionStatus.Completed)
                {
                    st.Status = StageExecutionStatus.Pending;
                    st.StatusText = "Pending";
                }
            }
        }
        StateHasChanged();
    }

    private static string GetDefaultStatusText(StageExecutionStatus status) => status switch
    {
        StageExecutionStatus.Running => "In Progress",
        StageExecutionStatus.WaitingForHuman => "Waiting for Human",
        _ => status.ToString()
    };

    public void ApplyGateResult(string stageId, bool passed, string metricsSummary)
    {
        if (string.IsNullOrWhiteSpace(stageId)) return;

        var stage = Stages.FirstOrDefault(s =>
            s.StageId.Equals(stageId, StringComparison.OrdinalIgnoreCase) ||
            s.DisplayName.Equals(stageId, StringComparison.OrdinalIgnoreCase));

        if (stage != null)
        {
            stage.Status = passed ? StageExecutionStatus.Completed : StageExecutionStatus.Failed;
            stage.StatusText = passed ? "Passed" : "Failed";
            stage.MetricsSummary = metricsSummary;
            StateHasChanged();
        }
    }

    public void Reset()
    {
        Stages = InitializeStages();
        StateHasChanged();
    }

    private int ResolveStageOrder(string? stageId)
    {
        if (string.IsNullOrWhiteSpace(stageId)) return 0;

        var match = Stages.FirstOrDefault(st =>
            st.StageId.Equals(stageId, StringComparison.OrdinalIgnoreCase) ||
            st.DisplayName.Equals(stageId, StringComparison.OrdinalIgnoreCase));

        return match?.SequenceOrder ?? 0;
    }

    private string GetStepClass(StageStepItem stage)
    {
        return stage.Status switch
        {
            StageExecutionStatus.Running => "step-active",
            StageExecutionStatus.Completed => "step-completed",
            StageExecutionStatus.Failed => "step-failed",
            StageExecutionStatus.WaitingForHuman => "step-waiting",
            _ => "step-pending"
        };
    }

    private bool IsConnectorActive(StageStepItem stage)
    {
        var currentIndex = Stages.IndexOf(stage);
        if (currentIndex >= 0 && currentIndex < Stages.Count - 1)
        {
            var next = Stages[currentIndex + 1];
            return stage.Status == StageExecutionStatus.Completed || next.Status == StageExecutionStatus.Running;
        }
        return false;
    }
}

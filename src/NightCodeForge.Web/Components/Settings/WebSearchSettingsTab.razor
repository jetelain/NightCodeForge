@namespace NightCodeForge.Web.Components.Settings
@using NightCodeForge.Core.Domain
@using NightCodeForge.Core.Interfaces
@using NightCodeForge.Agents.Tools
@using NightCodeForge.Web.Services
@inject IWebSearchSettingsService SettingsService
@inject IWebSearchService WebSearchService
@inject ToastService ToastService

<div class="forge-card mt-3" style="padding: 2rem;">
    <!-- Header -->
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem; flex-wrap: wrap; gap: 1.5rem;">
        <div>
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.35rem; flex-wrap: wrap;">
                <span style="font-size: 1.75rem;">🌐</span>
                <h3 style="font-weight: 700; font-size: 1.35rem; margin: 0; color: var(--text-primary);">
                    Cloud &amp; Web Search Integration
                </h3>
                @if (IsCurrentlyConfigured)
                {
                    <span class="forge-badge badge-teal" style="padding: 0.3rem 0.75rem; font-size: 0.82rem;">
                        🟢 Search Active (Key Configured)
                    </span>
                }
                else
                {
                    <span class="forge-badge badge-gray" style="padding: 0.3rem 0.75rem; font-size: 0.82rem;">
                        🟡 Search Inactive (No API Key)
                    </span>
                }
            </div>
            <p style="margin: 0; font-size: 0.92rem; color: var(--text-secondary); line-height: 1.6; max-width: 820px;">
                Configure web search provider credentials (backed by Ollama Web Search API) for real-time technical documentation lookup, API verification, and error remediation during agent tasks.
            </p>
        </div>
        <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
            <button type="button" class="forge-btn forge-btn-outline" style="padding: 0.65rem 1.25rem; font-size: 0.92rem;" @onclick="ResetDefaults" disabled="@(_isSaving || _isTesting)">
                ↺ Reset Defaults
            </button>
            <button type="button" class="forge-btn forge-btn-primary" style="padding: 0.65rem 1.4rem; font-size: 0.92rem; font-weight: 600;" @onclick="SaveSettingsAsync" disabled="@(_isSaving || _isTesting)">
                @(_isSaving ? "Saving..." : "💾 Save Search Settings")
            </button>
        </div>
    </div>

    <!-- Agent Tool Advertising Policy Callout -->
    <div style="padding: 1.25rem 1.5rem; border-radius: var(--radius-lg); background: rgba(59, 130, 246, 0.08); border: 1px solid rgba(59, 130, 246, 0.25); display: flex; align-items: flex-start; gap: 1rem; margin-bottom: 2rem;">
        <span style="font-size: 1.5rem; line-height: 1;">🛡️</span>
        <div style="font-size: 0.9rem; color: var(--text-secondary); line-height: 1.6;">
            <strong style="color: var(--text-primary);">Automatic Tool Schema Advertising:</strong>
            When an API key is configured, the <code class="font-mono" style="color: var(--accent-indigo);">web_search</code> canonical tool is dynamically advertised to Crucible engineering agents and Ideation discovery sessions. When no API key is configured, <code class="font-mono">web_search</code> is cleanly omitted from the agent's function-calling toolset, avoiding runtime tool failures and LLM hallucination errors.
        </div>
    </div>

    <!-- Settings Configuration Form -->
    <div class="forge-subcard" style="padding: 1.75rem; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); margin-bottom: 2rem; box-shadow: var(--shadow-sm);">
        <h4 style="font-size: 1.05rem; font-weight: 700; margin: 0 0 1.25rem 0; color: var(--text-primary); display: flex; align-items: center; gap: 0.5rem;">
            ⚙️ Provider Credentials &amp; Endpoint
        </h4>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; margin-bottom: 1.5rem;">
            <!-- Provider Selection -->
            <div>
                <label class="forge-field-label" style="font-weight: 600; font-size: 0.88rem; color: var(--text-primary); display: block; margin-bottom: 0.4rem;">
                    Search Provider
                </label>
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <input type="text" class="forge-input" style="flex: 1;" value="@_settings.Provider" disabled readonly />
                    <span class="forge-badge badge-indigo" style="font-size: 0.8rem; padding: 0.35rem 0.65rem;">Cloud API</span>
                </div>
                <span style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.35rem; display: block;">
                    Official Ollama Web Search API provider.
                </span>
            </div>

            <!-- Endpoint URL -->
            <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
                    <label class="forge-field-label" style="font-weight: 600; font-size: 0.88rem; color: var(--text-primary); margin: 0;">
                        Endpoint URL
                    </label>
                    @if (_settings.Endpoint != WebSearchSettings.DefaultEndpoint)
                    {
                        <button type="button" class="forge-btn-ghost" style="font-size: 0.78rem; padding: 0.1rem 0.5rem; color: var(--accent-indigo);" @onclick="() => _settings.Endpoint = WebSearchSettings.DefaultEndpoint">
                            Reset to Default
                        </button>
                    }
                </div>
                <input type="text" class="forge-input font-mono" style="width: 100%; font-size: 0.88rem;" @bind="_settings.Endpoint" @bind:event="oninput" placeholder="https://ollama.com/api/web_search" />
                <span style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.35rem; display: block;">
                    Target POST endpoint for web search requests (default: <span class="font-mono">https://ollama.com/api/web_search</span>).
                </span>
            </div>
        </div>

        <!-- API Key Row -->
        <div style="margin-bottom: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
                <label class="forge-field-label" style="font-weight: 600; font-size: 0.88rem; color: var(--text-primary); margin: 0;">
                    Ollama API Key
                </label>
                @if (!string.IsNullOrWhiteSpace(_envKeyDetected) && string.IsNullOrWhiteSpace(_settings.ApiKey))
                {
                    <span class="forge-badge badge-teal" style="font-size: 0.78rem; padding: 0.2rem 0.5rem;">
                        Detected from OLLAMA_API_KEY environment variable
                    </span>
                }
            </div>

            <div style="display: flex; gap: 0.5rem; align-items: center;">
                <input type="@(_showApiKey ? "text" : "password")" 
                       class="forge-input font-mono" 
                       style="flex: 1; font-size: 0.9rem;" 
                       @bind="_settings.ApiKey" 
                       @bind:event="oninput" 
                       placeholder="@(!string.IsNullOrWhiteSpace(_envKeyDetected) ? $"Inherited from OLLAMA_API_KEY ({MaskKey(_envKeyDetected)})" : "Enter Ollama Cloud API Key...")" />
                
                <button type="button" 
                        class="forge-btn forge-btn-outline" 
                        style="padding: 0.6rem 0.9rem; font-size: 0.88rem; white-space: nowrap;" 
                        @onclick="() => _showApiKey = !_showApiKey">
                    @(_showApiKey ? "🙈 Hide" : "👁️ Show")
                </button>

                @if (!string.IsNullOrWhiteSpace(_settings.ApiKey))
                {
                    <button type="button" 
                            class="forge-btn forge-btn-outline" 
                            style="padding: 0.6rem 0.9rem; font-size: 0.88rem; color: var(--text-muted);" 
                            @onclick="() => _settings.ApiKey = string.Empty">
                        ✕ Clear
                    </button>
                }
            </div>
            <span style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.35rem; display: block;">
                Obtain your API key from <a href="https://ollama.com/settings/keys" target="_blank" style="color: var(--accent-indigo); text-decoration: underline;">ollama.com</a>. You can also export <span class="font-mono">OLLAMA_API_KEY</span> in your environment.
            </span>
        </div>

        <!-- Default Max Results -->
        <div style="max-width: 320px;">
            <label class="forge-field-label" style="font-weight: 600; font-size: 0.88rem; color: var(--text-primary); display: block; margin-bottom: 0.4rem;">
                Default Max Results per Query
            </label>
            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <input type="number" min="1" max="10" class="forge-input" style="width: 100px; text-align: right;" @bind="_settings.DefaultMaxResults" />
                <span style="font-size: 0.85rem; color: var(--text-secondary);">snippets (1–10)</span>
            </div>
        </div>
    </div>

    <!-- Live Connectivity & Search Tester Card -->
    <div class="forge-subcard" style="padding: 1.75rem; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; flex-wrap: wrap; gap: 0.75rem;">
            <div>
                <h4 style="font-size: 1.05rem; font-weight: 700; margin: 0 0 0.25rem 0; color: var(--text-primary); display: flex; align-items: center; gap: 0.5rem;">
                    🧪 Live Connectivity &amp; Search Tester
                </h4>
                <p style="margin: 0; font-size: 0.82rem; color: var(--text-secondary);">
                    Execute an immediate probe query against the configured endpoint to verify API key validity, latency, and response schemas.
                </p>
            </div>
            <button type="button" 
                    class="forge-btn forge-btn-primary" 
                    style="padding: 0.65rem 1.35rem; font-size: 0.92rem; font-weight: 600;" 
                    @onclick="TestConnectionAsync" 
                    disabled="@(_isTesting || !IsCurrentlyConfigured)">
                @(_isTesting ? "Testing API..." : "🔍 Test Search Connection")
            </button>
        </div>

        <div style="display: flex; gap: 0.75rem; margin-bottom: 1.25rem;">
            <input type="text" 
                   class="forge-input" 
                   style="flex: 1;" 
                   @bind="_testQuery" 
                   @bind:event="oninput" 
                   placeholder="Enter test search query (e.g. Ollama, .NET 10 Blazor)..." />
        </div>

        @if (_testRun)
        {
            <div style="padding: 1.25rem; border-radius: var(--radius-md); background: @(_testSuccess ? "rgba(16, 185, 129, 0.08)" : "rgba(239, 68, 68, 0.08)"); border: 1px solid @(_testSuccess ? "rgba(16, 185, 129, 0.3)" : "rgba(239, 68, 68, 0.3)"); margin-top: 1rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem;">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span style="font-size: 1.2rem;">@(_testSuccess ? "✅" : "❌")</span>
                        <strong style="color: var(--text-primary); font-size: 0.95rem;">@(_testSuccess ? "Search API Test Succeeded" : "Search API Test Failed")</strong>
                    </div>
                    <span class="forge-badge @(_testSuccess ? "badge-teal" : "badge-gray")" style="font-size: 0.8rem;">
                        @(_testElapsedMs)ms
                    </span>
                </div>
                <p style="margin: 0 0 0.75rem 0; font-size: 0.88rem; color: var(--text-secondary); line-height: 1.5;">
                    @_testMessage
                </p>

                @if (_testResults.Count > 0)
                {
                    <div style="display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1rem;">
                        <strong style="font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted);">
                            Returned Snippets (@_testResults.Count)
                        </strong>
                        @foreach (var item in _testResults)
                        {
                            <div style="background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 0.85rem;">
                                <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.3rem;">
                                    <strong style="font-size: 0.9rem; color: var(--accent-indigo);">@item.Title</strong>
                                    <a href="@item.Url" target="_blank" style="font-size: 0.78rem; color: var(--text-muted); text-decoration: underline; max-width: 320px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                        @item.Url
                                    </a>
                                </div>
                                <p style="margin: 0; font-size: 0.82rem; color: var(--text-secondary); line-height: 1.5;">
                                    @item.Content
                                </p>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private WebSearchSettings _settings = new();
    private string? _envKeyDetected;
    private bool _showApiKey;
    private bool _isSaving;
    private bool _isTesting;

    private string _testQuery = "Ollama";
    private bool _testRun;
    private bool _testSuccess;
    private string _testMessage = string.Empty;
    private long _testElapsedMs;
    private List<WebSearchResultItem> _testResults = new();

    private bool IsCurrentlyConfigured =>
        !string.IsNullOrWhiteSpace(_settings.ApiKey) || !string.IsNullOrWhiteSpace(_envKeyDetected);

    protected override void OnInitialized()
    {
        _settings = SettingsService.GetSettings().Clone();
        _envKeyDetected = Environment.GetEnvironmentVariable("OLLAMA_API_KEY");
    }

    private async Task SaveSettingsAsync()
    {
        if (_isSaving) return;
        _isSaving = true;

        try
        {
            if (string.IsNullOrWhiteSpace(_settings.Endpoint))
            {
                _settings.Endpoint = WebSearchSettings.DefaultEndpoint;
            }
            if (_settings.DefaultMaxResults < 1) _settings.DefaultMaxResults = 1;
            if (_settings.DefaultMaxResults > 10) _settings.DefaultMaxResults = 10;

            await SettingsService.UpdateSettingsAsync(_settings);
            ToastService.Show("Settings Saved", "Web search settings and credentials updated successfully.", ToastLevel.Success);
        }
        catch (Exception ex)
        {
            ToastService.Show("Save Error", ex.Message, ToastLevel.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void ResetDefaults()
    {
        _settings.Provider = "Ollama";
        _settings.Endpoint = WebSearchSettings.DefaultEndpoint;
        _settings.DefaultMaxResults = 5;
        ToastService.Show("Defaults Restored", "Endpoints and parameters reset to defaults. Click 'Save' to persist.", ToastLevel.Info);
    }

    private async Task TestConnectionAsync()
    {
        if (_isTesting) return;
        _isTesting = true;
        _testRun = false;
        _testResults.Clear();

        try
        {
            // Persist current settings first if modified
            await SettingsService.UpdateSettingsAsync(_settings);

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
            var sw = System.Diagnostics.Stopwatch.StartNew();
            var response = await WebSearchService.SearchAsync(_testQuery, _settings.DefaultMaxResults, cts.Token);
            sw.Stop();

            _testElapsedMs = sw.ElapsedMilliseconds;
            _testSuccess = true;
            _testResults = response.Results.ToList();
            _testMessage = $"Successfully retrieved {response.Results.Count} search results in {sw.ElapsedMilliseconds}ms.";
            _testRun = true;
            ToastService.Show("Test Succeeded", $"Found {response.Results.Count} search results.", ToastLevel.Success);
        }
        catch (Exception ex)
        {
            _testSuccess = false;
            _testMessage = ex.Message;
            _testRun = true;
            ToastService.Show("Test Failed", ex.Message, ToastLevel.Error);
        }
        finally
        {
            _isTesting = false;
        }
    }

    private static string MaskKey(string key)
    {
        if (string.IsNullOrEmpty(key) || key.Length <= 8) return "••••••••";
        return $"{key[..4]}••••{key[^4..]}";
    }
}

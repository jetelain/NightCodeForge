@namespace NightCodeForge.Web.Components.Settings
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.DependencyInjection
@using NightCodeForge.Core.Domain
@using NightCodeForge.Core.Interfaces
@using NightCodeForge.Infrastructure.Data
@using NightCodeForge.Web.Services
@inject IServiceScopeFactory ScopeFactory
@inject IOllamaModelCatalogService ModelCatalogService
@inject ToastService ToastService

<div class="forge-card mt-3" style="padding: 2rem;">
    <!-- Header with Scope Badge & Action Buttons -->
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem; flex-wrap: wrap; gap: 1.5rem;">
        <div>
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.35rem;">
                <span style="font-size: 1.75rem;">🤖</span>
                <h3 style="margin: 0; font-weight: 700; font-size: 1.35rem; color: var(--text-primary);">
                    @(Scope == ProfileScope.Global ? "Global Agent Reasoning Profiles" : $"Dedicated Profiles for {WorkspaceName ?? "Workspace"}")
                </h3>
                <span class="forge-badge @(Scope == ProfileScope.Global ? "badge-teal" : "badge-indigo")" style="padding: 0.3rem 0.75rem; font-size: 0.82rem;">
                    @(Scope == ProfileScope.Global ? "Global Defaults" : "Workspace Scoped")
                </span>
            </div>
            <p style="margin: 0; font-size: 0.92rem; color: var(--text-secondary); line-height: 1.6; max-width: 820px;">
                @(Scope == ProfileScope.Global 
                    ? "Base profiles inherited across all workspaces. Configured with generous turn limits (500 turns) for full agent autonomy."
                    : "Dedicated profiles overriding global defaults for this specific repository workspace.")
            </p>
        </div>

        <div style="display: flex; gap: 0.75rem; align-items: center;">
            @if (Scope == ProfileScope.Workspace)
            {
                @if (_hasDedicatedProfiles)
                {
                    <button type="button" class="forge-btn forge-btn-outline" style="padding: 0.65rem 1.25rem; font-size: 0.92rem; font-weight: 600;" @onclick="RevertToGlobalProfilesAsync" disabled="_isSaving">
                        ↺ Revert to Global Profiles
                    </button>
                }
                else
                {
                    <button type="button" class="forge-btn forge-btn-primary" style="padding: 0.65rem 1.25rem; font-size: 0.92rem; font-weight: 600;" @onclick="CreateDedicatedProfilesAsync" disabled="_isSaving">
                        ⚡ Create Dedicated Workspace Profiles
                    </button>
                }
            }
            <button type="button" class="forge-btn forge-btn-primary" style="padding: 0.65rem 1.4rem; font-size: 0.92rem; font-weight: 600;" @onclick="SaveProfilesAsync" disabled="_isSaving || (Scope == ProfileScope.Workspace && !_hasDedicatedProfiles)">
                @(_isSaving ? "Saving..." : "💾 Save Profiles")
            </button>
        </div>
    </div>

    <!-- OllamaRouter Connection & Model Refresh Strip -->
    <div style="display: flex; justify-content: space-between; align-items: center; padding: 1.15rem 1.5rem; border-radius: var(--radius-lg); background: var(--bg-surface); border: 1px solid var(--border-subtle); margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem;">
            <span class="status-dot @(_isOllamaOnline ? "running" : "blocked")"></span>
            <span style="font-size: 0.92rem; color: var(--text-primary); font-weight: 500;">
                @(_isOllamaOnline 
                    ? $"OllamaRouter Gateway connected ({_availableModels.Count} models available from /api/tags)" 
                    : "Gateway unreachable at http://localhost:11434 - fallback to manual model entry")
            </span>
        </div>
        <button type="button" class="forge-btn forge-btn-outline" style="padding: 0.45rem 1rem; font-size: 0.85rem;" @onclick="RefreshOllamaModelsAsync" disabled="_isLoadingModels">
            @(_isLoadingModels ? "Refreshing..." : "🔄 Refresh Models")
        </button>
    </div>

    @if (Scope == ProfileScope.Workspace && !_hasDedicatedProfiles)
    {
        <div style="padding: 3.5rem 2rem; text-align: center; border: 2px dashed var(--border-subtle); border-radius: var(--radius-xl); background: var(--bg-surface);">
            <div style="font-size: 2.5rem; margin-bottom: 1rem;">🌐</div>
            <p style="font-size: 1.15rem; color: var(--text-primary); margin-bottom: 0.5rem;">
                This workspace currently inherits the <strong>Global System Profiles</strong>.
            </p>
            <p style="font-size: 0.92rem; color: var(--text-secondary); max-width: 600px; margin: 0 auto 1.75rem auto; line-height: 1.6;">
                Click below to clone and customize dedicated models, target backends, turn budgets, and prompts for this repository.
            </p>
            <button type="button" class="forge-btn forge-btn-primary" style="padding: 0.75rem 1.75rem; font-size: 0.95rem; font-weight: 600;" @onclick="CreateDedicatedProfilesAsync">
                ⚡ Customize Profiles for this Workspace
            </button>
        </div>
    }
    else if (_isLoading)
    {
        <div style="padding: 4rem 2rem; text-align: center; color: var(--text-secondary); font-size: 1rem;">
            <div style="font-size: 2rem; margin-bottom: 0.75rem;">⏳</div>
            Loading agent profiles...
        </div>
    }
    else
    {
        <!-- Profile Cards List -->
        <div style="display: flex; flex-direction: column; gap: 2rem;">
            @foreach (var profile in _profiles)
            {
                <div class="forge-subcard" style="padding: 2rem; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm);">
                    <!-- Profile Header -->
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.75rem; flex-wrap: wrap; gap: 1rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 1.25rem;">
                        <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
                            <strong style="font-size: 1.2rem; color: var(--text-primary); font-weight: 700;">@profile.Name</strong>
                            <code class="forge-badge badge-indigo" style="font-size: 0.82rem; padding: 0.25rem 0.65rem;">@profile.Id</code>
                            <span class="forge-badge badge-teal" style="font-size: 0.82rem; padding: 0.25rem 0.65rem;">@profile.Mode</span>
                            <span class="forge-badge badge-amber" style="font-size: 0.82rem; padding: 0.25rem 0.65rem;">Harness: @profile.HarnessId</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 0.75rem;">
                            @if (profile.OptimizationFlags == null)
                            {
                                <span class="forge-badge badge-teal" style="font-size: 0.82rem; padding: 0.35rem 0.75rem;">⚡ Inheriting Global Optimizations</span>
                                <button type="button" class="forge-btn forge-btn-outline" style="padding: 0.45rem 1rem; font-size: 0.85rem; font-weight: 600;" @onclick="() => CustomizeFlags(profile)">
                                    Override
                                </button>
                            }
                            else
                            {
                                <span class="forge-badge badge-indigo" style="font-size: 0.82rem; padding: 0.35rem 0.75rem;">🔧 Custom Optimizations</span>
                                <button type="button" class="forge-btn forge-btn-outline" style="padding: 0.45rem 1rem; font-size: 0.85rem; font-weight: 600;" @onclick="() => RevertFlags(profile)">
                                    Revert to Global
                                </button>
                            }
                        </div>
                    </div>

                    <!-- Core Parameters Grid -->
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; font-size: 0.92rem;">
                        <!-- 1. Ollama Model Dropdown -->
                        <div>
                            <label class="forge-field-label">Ollama Model</label>
                            @if (_availableModels.Count > 0)
                            {
                                <select class="forge-input font-mono" style="width: 100%;" @bind="profile.ModelName">
                                    @foreach (var m in _availableModels)
                                    {
                                        <option value="@m.Name">@m.Name (@FormatBytes(m.Size))</option>
                                    }
                                    <option value="__custom__">Manual / Custom...</option>
                                </select>
                            }
                            else
                            {
                                <input type="text" class="forge-input font-mono" style="width: 100%;" @bind="profile.ModelName" placeholder="e.g. qwen2.5-coder:32b" />
                            }
                        </div>

                        <!-- 2. OllamaRouter Target Pinning -->
                        <div>
                            <label class="forge-field-label">OllamaRouter Target</label>
                            <select class="forge-input" style="width: 100%;" @bind="profile.RoutingTarget">
                                <option value="@OllamaRoutingTarget.Auto">Auto (Dynamic VRAM &amp; Context Routing)</option>
                                <option value="@OllamaRoutingTarget.Local">Host GPU (Local Workstation - On-Premise)</option>
                                <option value="@OllamaRoutingTarget.Remote">LAN GPU Server (Remote - Dedicated High-VRAM, ~95% Workloads)</option>
                                <option value="@OllamaRoutingTarget.Cloud">Cloud Overflow (Optional External / Zero Local VRAM)</option>
                            </select>
                            <span class="field-hint" style="display: block; font-size: 0.78rem; color: var(--text-muted); margin-top: 0.35rem;">
                                Host GPU and LAN Server are both 100% private local workloads.
                            </span>
                        </div>

                        <!-- 3. Thinking Effort -->
                        <div>
                            <label class="forge-field-label">Thinking Effort</label>
                            <select class="forge-input" style="width: 100%;" @bind="profile.ThinkingEffort">
                                <option value="@ThinkingEffort.None">None (Instant)</option>
                                <option value="@ThinkingEffort.Low">Low (~1k tokens)</option>
                                <option value="@ThinkingEffort.Medium">Medium (~4k tokens)</option>
                                <option value="@ThinkingEffort.High">High (~8k tokens)</option>
                                <option value="@ThinkingEffort.CustomBudget">Custom Token Budget</option>
                            </select>
                        </div>

                        <!-- 4. Max Turns Budget (Generous for Full Autonomy) -->
                        <div>
                            <label class="forge-field-label">Max Turns Budget</label>
                            <input type="number" min="10" max="2000" step="25" class="forge-input font-mono" style="width: 100%;" @bind="profile.MaxTurns" />
                        </div>

                        <!-- 5. Temperature -->
                        <div>
                            <label class="forge-field-label">Temperature</label>
                            <input type="number" min="0.0" max="2.0" step="0.1" class="forge-input font-mono" style="width: 100%;" @bind="profile.Temperature" />
                        </div>

                        <!-- 6. Sandbox Security Tier -->
                        <div>
                            <label class="forge-field-label">Security Tier</label>
                            <select class="forge-input" style="width: 100%;" @bind="profile.SecurityTier">
                                <option value="@SandboxSecurityTier.Standard">Standard (Full Sandbox)</option>
                                <option value="@SandboxSecurityTier.RestrictedReadOnly">Restricted Read-Only (Stage 0)</option>
                            </select>
                        </div>
                    </div>

                    <!-- Complete 12-Parameter Optimization Override Section -->
                    @if (profile.OptimizationFlags != null)
                    {
                        <div style="margin-top: 2rem; padding: 1.75rem; background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg);">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.75rem;">
                                <div>
                                    <h4 style="margin: 0 0 0.25rem 0; font-size: 1.05rem; font-weight: 700; color: var(--accent-indigo);">
                                        ⚡ Complete Profile Optimization Overrides
                                    </h4>
                                    <p style="margin: 0; font-size: 0.85rem; color: var(--text-secondary);">
                                        Custom runtime samplers and compaction thresholds applied specifically to this reasoning profile.
                                    </p>
                                </div>
                                <span class="forge-badge badge-indigo" style="font-size: 0.75rem; padding: 0.25rem 0.65rem;">Active Override</span>
                            </div>

                            <!-- Section A: 8 Boolean Switches -->
                            <div style="margin-bottom: 1.5rem;">
                                <label style="display: block; font-size: 0.82rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin-bottom: 0.85rem;">
                                    Runtime Optimization &amp; Sampler Flags (8 Switches)
                                </label>
                                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 0.85rem;">
                                    <label class="forge-checkbox-tile">
                                        <input type="checkbox" @bind="profile.OptimizationFlags.ThinkingTraceCompaction" />
                                        <div>
                                            <strong style="display: block; font-size: 0.9rem; color: var(--text-primary);">Thinking Trace Compaction</strong>
                                            <span style="font-size: 0.78rem; color: var(--text-muted);">Prunes &lt;think&gt; chains outside sliding window</span>
                                        </div>
                                    </label>
                                    <label class="forge-checkbox-tile">
                                        <input type="checkbox" @bind="profile.OptimizationFlags.CompactOlderToolResults" />
                                        <div>
                                            <strong style="display: block; font-size: 0.9rem; color: var(--text-primary);">Tool Result Compaction</strong>
                                            <span style="font-size: 0.78rem; color: var(--text-muted);">Summarizes historical stdout and execution results</span>
                                        </div>
                                    </label>
                                    <label class="forge-checkbox-tile">
                                        <input type="checkbox" @bind="profile.OptimizationFlags.LoopCircuitBreaker" />
                                        <div>
                                            <strong style="display: block; font-size: 0.9rem; color: var(--text-primary);">Loop Circuit Breaker</strong>
                                            <span style="font-size: 0.78rem; color: var(--text-muted);">Detects repeated identical tool calls or cycles</span>
                                        </div>
                                    </label>
                                    <label class="forge-checkbox-tile">
                                        <input type="checkbox" @bind="profile.OptimizationFlags.GuidedGrammarDecoding" />
                                        <div>
                                            <strong style="display: block; font-size: 0.9rem; color: var(--text-primary);">Guided Grammar Decoding</strong>
                                            <span style="font-size: 0.78rem; color: var(--text-muted);">Constrains tool call outputs to strict JSON schemas</span>
                                        </div>
                                    </label>
                                    <label class="forge-checkbox-tile">
                                        <input type="checkbox" @bind="profile.OptimizationFlags.DeterministicSymbolMap" />
                                        <div>
                                            <strong style="display: block; font-size: 0.9rem; color: var(--text-primary);">Deterministic Symbol Map</strong>
                                            <span style="font-size: 0.78rem; color: var(--text-muted);">Caches exact workspace syntax tree references</span>
                                        </div>
                                    </label>
                                    <label class="forge-checkbox-tile">
                                        <input type="checkbox" @bind="profile.OptimizationFlags.StructuredDiagnosticExtraction" />
                                        <div>
                                            <strong style="display: block; font-size: 0.9rem; color: var(--text-primary);">Structured Diagnostics</strong>
                                            <span style="font-size: 0.78rem; color: var(--text-muted);">Converts raw compiler errors into structured tokens</span>
                                        </div>
                                    </label>
                                    <label class="forge-checkbox-tile">
                                        <input type="checkbox" @bind="profile.OptimizationFlags.PrefixStabilization" />
                                        <div>
                                            <strong style="display: block; font-size: 0.9rem; color: var(--text-primary);">Prefix Stabilization</strong>
                                            <span style="font-size: 0.78rem; color: var(--text-muted);">Optimizes KV-cache hit rate across agent turns</span>
                                        </div>
                                    </label>
                                    <label class="forge-checkbox-tile">
                                        <input type="checkbox" @bind="profile.OptimizationFlags.JitModelPreload" />
                                        <div>
                                            <strong style="display: block; font-size: 0.9rem; color: var(--text-primary);">JIT Model Preload</strong>
                                            <span style="font-size: 0.78rem; color: var(--text-muted);">Pre-warms weights in VRAM before turn starts</span>
                                        </div>
                                    </label>
                                </div>
                            </div>

                            <!-- Section B: 4 Numeric Sliding-Window Compaction Inputs -->
                            <div style="border-top: 1px dashed var(--border-subtle); padding-top: 1.25rem;">
                                <label style="display: block; font-size: 0.82rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin-bottom: 0.85rem;">
                                    Sliding-Window Compaction Thresholds (4 Parameters)
                                </label>
                                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem;">
                                    <div>
                                        <label class="forge-field-label">Verbatim Thought Turns</label>
                                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                                            <input type="number" min="1" max="500" step="5" class="forge-input font-mono" style="width: 100%;" @bind="profile.OptimizationFlags.ThinkingKeepVerbatimCount" />
                                            <span style="font-size: 0.85rem; color: var(--text-muted); white-space: nowrap;">turns</span>
                                        </div>
                                    </div>
                                    <div>
                                        <label class="forge-field-label">Verbatim Tool Results</label>
                                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                                            <input type="number" min="1" max="500" step="5" class="forge-input font-mono" style="width: 100%;" @bind="profile.OptimizationFlags.ToolKeepVerbatimCount" />
                                            <span style="font-size: 0.85rem; color: var(--text-muted); white-space: nowrap;">results</span>
                                        </div>
                                    </div>
                                    <div>
                                        <label class="forge-field-label">Tool Max Char Length</label>
                                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                                            <input type="number" min="200" max="20000" step="100" class="forge-input font-mono" style="width: 100%;" @bind="profile.OptimizationFlags.ToolMaxResultLength" />
                                            <span style="font-size: 0.85rem; color: var(--text-muted); white-space: nowrap;">chars</span>
                                        </div>
                                    </div>
                                    <div>
                                        <label class="forge-field-label">Tool Truncate Char Length</label>
                                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                                            <input type="number" min="100" max="15000" step="50" class="forge-input font-mono" style="width: 100%;" @bind="profile.OptimizationFlags.ToolTruncateToLength" />
                                            <span style="font-size: 0.85rem; color: var(--text-muted); white-space: nowrap;">chars</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Expandable System Prompt -->
                    <details style="margin-top: 1.75rem; background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 1.15rem 1.35rem;">
                        <summary style="font-weight: 600; font-size: 0.92rem; color: var(--text-primary); cursor: pointer; outline: none; user-select: none;">
                            System Prompt &amp; Persona Instructions
                        </summary>
                        <div style="margin-top: 1rem;">
                            <textarea class="forge-input font-mono" rows="6" style="width: 100%; font-size: 0.88rem; line-height: 1.6; padding: 0.85rem;" @bind="profile.SystemPrompt" placeholder="Default persona and stage instructions..."></textarea>
                        </div>
                    </details>
                </div>
            }
        </div>
    }
</div>

@code {
    public enum ProfileScope { Global, Workspace }

    [Parameter] public ProfileScope Scope { get; set; } = ProfileScope.Global;
    [Parameter] public int? WorkspaceId { get; set; }
    [Parameter] public string? WorkspaceName { get; set; }

    private List<AgentProfile> _profiles = new();
    private List<OllamaModelInfo> _availableModels = new();
    private bool _hasDedicatedProfiles;
    private bool _isOllamaOnline;
    private bool _isLoading = true;
    private bool _isLoadingModels;
    private bool _isSaving;
    private int? _lastLoadedWorkspaceId;
    private ProfileScope? _lastLoadedScope;

    protected override async Task OnParametersSetAsync()
    {
        if (_lastLoadedScope != Scope || _lastLoadedWorkspaceId != WorkspaceId)
        {
            _lastLoadedScope = Scope;
            _lastLoadedWorkspaceId = WorkspaceId;
            await RefreshOllamaModelsAsync();
            await LoadProfilesAsync();
        }
    }

    private async Task RefreshOllamaModelsAsync()
    {
        _isLoadingModels = true;
        try
        {
            var models = await ModelCatalogService.GetAvailableModelsAsync();
            _availableModels = models.ToList();
            _isOllamaOnline = _availableModels.Count > 0;
        }
        catch
        {
            _isOllamaOnline = false;
        }
        finally
        {
            _isLoadingModels = false;
        }
    }

    private async Task LoadProfilesAsync()
    {
        _isLoading = true;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();

            if (Scope == ProfileScope.Global)
            {
                _profiles = await db.AgentProfiles.Where(p => p.WorkspaceId == null).OrderBy(p => p.Id).ToListAsync();
            }
            else if (WorkspaceId.HasValue)
            {
                var dedicated = await db.AgentProfiles.Where(p => p.WorkspaceId == WorkspaceId.Value).OrderBy(p => p.Id).ToListAsync();
                _hasDedicatedProfiles = dedicated.Count > 0;
                _profiles = _hasDedicatedProfiles 
                    ? dedicated 
                    : await db.AgentProfiles.Where(p => p.WorkspaceId == null).OrderBy(p => p.Id).ToListAsync();
            }
        }
        catch (Exception ex)
        {
            ToastService.Show("Error Loading Profiles", ex.Message, ToastLevel.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CreateDedicatedProfilesAsync()
    {
        if (!WorkspaceId.HasValue || _isSaving) return;
        _isSaving = true;

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();

            var globalProfiles = await db.AgentProfiles.Where(p => p.WorkspaceId == null).ToListAsync();
            if (globalProfiles.Count == 0)
            {
                globalProfiles = AgentProfile.CreateStandardGlobalProfiles("qwen2.5-coder:32b").ToList();
            }

            foreach (var g in globalProfiles)
            {
                var dedicated = new AgentProfile
                {
                    Id = $"ws-{WorkspaceId.Value}:{g.Id}",
                    WorkspaceId = WorkspaceId.Value,
                    Name = $"{g.Name} ({WorkspaceName ?? "Workspace"})",
                    HarnessId = g.HarnessId,
                    ModelName = g.ModelName,
                    Mode = g.Mode,
                    SecurityTier = g.SecurityTier,
                    RoutingTarget = g.RoutingTarget,
                    PermittedTools = g.PermittedTools,
                    StageDirectives = g.StageDirectives,
                    Temperature = g.Temperature,
                    ThinkingEffort = g.ThinkingEffort,
                    ThinkingTokenBudget = g.ThinkingTokenBudget,
                    MaxTurns = g.MaxTurns,
                    OptimizationFlags = g.OptimizationFlags?.Clone(),
                    SystemPrompt = g.SystemPrompt
                };
                db.AgentProfiles.Add(dedicated);
            }

            await db.SaveChangesAsync();
            ToastService.Show("Dedicated Profiles Created", $"Created dedicated reasoning profiles for {WorkspaceName ?? "workspace"}.", ToastLevel.Success);
            await LoadProfilesAsync();
        }
        catch (Exception ex)
        {
            ToastService.Show("Error Creating Dedicated Profiles", ex.Message, ToastLevel.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task RevertToGlobalProfilesAsync()
    {
        if (!WorkspaceId.HasValue || _isSaving) return;
        _isSaving = true;

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();

            var dedicated = await db.AgentProfiles.Where(p => p.WorkspaceId == WorkspaceId.Value).ToListAsync();
            if (dedicated.Count > 0)
            {
                db.AgentProfiles.RemoveRange(dedicated);
                await db.SaveChangesAsync();
            }

            ToastService.Show("Reverted to Global Profiles", $"Dedicated profiles removed. Workspace now inherits global system profiles.", ToastLevel.Success);
            await LoadProfilesAsync();
        }
        catch (Exception ex)
        {
            ToastService.Show("Error Reverting Profiles", ex.Message, ToastLevel.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SaveProfilesAsync()
    {
        if (_isSaving) return;
        _isSaving = true;

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();

            foreach (var p in _profiles)
            {
                var existing = await db.AgentProfiles.FindAsync(p.Id);
                if (existing != null)
                {
                    existing.ModelName = p.ModelName;
                    existing.RoutingTarget = p.RoutingTarget;
                    existing.ThinkingEffort = p.ThinkingEffort;
                    existing.ThinkingTokenBudget = p.ThinkingTokenBudget;
                    existing.Temperature = p.Temperature;
                    existing.MaxTurns = p.MaxTurns;
                    existing.SecurityTier = p.SecurityTier;
                    existing.SystemPrompt = p.SystemPrompt;
                    existing.OptimizationFlags = p.OptimizationFlags;
                }
            }

            await db.SaveChangesAsync();
            ToastService.Show("Profiles Saved", "Agent reasoning profiles successfully updated.", ToastLevel.Success);
        }
        catch (Exception ex)
        {
            ToastService.Show("Error Saving Profiles", ex.Message, ToastLevel.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void CustomizeFlags(AgentProfile profile) => profile.OptimizationFlags = new LocalOptimizationFlags();
    private void RevertFlags(AgentProfile profile) => profile.OptimizationFlags = null;

    private static string FormatBytes(long bytes) => $"{bytes / (1024.0 * 1024 * 1024):F1} GB";
}

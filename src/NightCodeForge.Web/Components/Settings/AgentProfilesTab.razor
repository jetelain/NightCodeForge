@using System.Collections.Concurrent
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Logging
@using Microsoft.Extensions.Options
@using NightCodeForge.Agents.Inference
@using NightCodeForge.Core.Domain
@using NightCodeForge.Core.Interfaces
@using NightCodeForge.Infrastructure.Data
@using NightCodeForge.Web.Services
@inject IServiceScopeFactory ScopeFactory
@inject ILlmModelCatalogService ModelCatalogService
@inject ILlmGatewayService GatewayService
@inject ILlmContextWindowCache ContextWindowCache
@inject IServiceProvider ServiceProvider
@inject IOptions<LlmProviderOptions> LlmOptions
@inject ToastService ToastService
@inject ILogger<AgentProfilesTab> Logger

<div class="forge-card mt-3" style="padding: 2rem;">
    <!-- Header with Scope Badge & Action Buttons -->
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem; flex-wrap: wrap; gap: 1.5rem;">
        <div>
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.35rem;">
                <span style="font-size: 1.75rem;">🤖</span>
                <h3 style="margin: 0; font-weight: 700; font-size: 1.35rem; color: var(--text-primary);">
                    @(Scope == ProfileScope.Global ? "Global Agent Reasoning Profiles" : $"Dedicated Profiles for {WorkspaceName ?? "Workspace"}")
                </h3>
                <span class="forge-badge @(Scope == ProfileScope.Global ? "badge-teal" : "badge-indigo")" style="padding: 0.3rem 0.75rem; font-size: 0.82rem;">
                    @(Scope == ProfileScope.Global ? "Global Defaults" : "Workspace Scoped")
                </span>
            </div>
            <p style="margin: 0; font-size: 0.92rem; color: var(--text-secondary); line-height: 1.6; max-width: 820px;">
                @(Scope == ProfileScope.Global 
                    ? "Base profiles inherited across all workspaces. Configured with generous turn limits (500 turns) for full agent autonomy."
                    : "Dedicated profiles overriding global defaults for this specific repository workspace.")
            </p>
        </div>

        <div style="display: flex; gap: 0.75rem; align-items: center;">
            @if (Scope == ProfileScope.Workspace)
            {
                @if (_hasDedicatedProfiles)
                {
                    <button type="button" class="forge-btn forge-btn-outline" style="padding: 0.65rem 1.25rem; font-size: 0.92rem; font-weight: 600;" @onclick="RevertToGlobalProfilesAsync" disabled="@_isSaving">
                        ↺ Revert to Global Profiles
                    </button>
                }
                else
                {
                    <button type="button" class="forge-btn forge-btn-primary" style="padding: 0.65rem 1.25rem; font-size: 0.92rem; font-weight: 600;" @onclick="CreateDedicatedProfilesAsync" disabled="@_isSaving">
                        ⚡ Create Dedicated Workspace Profiles
                    </button>
                }
            }
            <button type="button" class="forge-btn forge-btn-primary" style="padding: 0.65rem 1.4rem; font-size: 0.92rem; font-weight: 600;" @onclick="SaveProfilesAsync" disabled="@(_isSaving || _isLoading || (Scope == ProfileScope.Workspace && !_hasDedicatedProfiles))">
                @(_isSaving ? "Saving..." : "💾 Save Profiles")
            </button>
        </div>
    </div>

    <!-- Provider Connection & Model Refresh Strip -->
    <div style="display: flex; flex-direction: column; gap: 1rem; padding: 1.15rem 1.5rem; border-radius: var(--radius-lg); background: var(--bg-surface); border: 1px solid var(--border-subtle); margin-bottom: 2rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                @if (_isLoadingModels)
                {
                    <span class="status-dot waiting"></span>
                    <span style="font-size: 0.92rem; color: var(--text-secondary); font-weight: 500;">
                        Connecting to @GetProviderShortName(_providerType) and discovering models...
                    </span>
                }
                else if (_isOllamaOnline)
                {
                    <span class="status-dot running"></span>
                    <span style="font-size: 0.92rem; color: var(--text-primary); font-weight: 500;">
                        @($"{GetProviderTitle(_providerType)} connected ({_availableModels.Count} models available)")
                    </span>
                }
                else
                {
                    <span class="status-dot blocked"></span>
                    <span style="font-size: 0.92rem; color: var(--text-primary); font-weight: 500;">
                        @($"Inference endpoint unreachable at {(string.IsNullOrWhiteSpace(LlmOptions.Value.EffectiveEndpoint) ? "configured endpoint" : LlmOptions.Value.EffectiveEndpoint)} - fallback to manual model entry")
                    </span>
                }
            </div>
            <div style="display: flex; gap: 0.5rem; align-items: center;">
                <button type="button" class="forge-btn forge-btn-outline" style="padding: 0.45rem 1rem; font-size: 0.85rem;" @onclick="DetectProviderAsync" disabled="@(_isDetecting || _isLoadingModels)">
                    @(_isDetecting ? "Detecting..." : "🔍 Auto-Detect")
                </button>
                <button type="button" class="forge-btn forge-btn-outline" style="padding: 0.45rem 1rem; font-size: 0.85rem;" @onclick="RefreshOllamaModelsAsync" disabled="@_isLoadingModels">
                    @(_isLoadingModels ? "Refreshing..." : "🔄 Refresh Models")
                </button>
            </div>
        </div>

        @{
            var acpBadge = AgentProfileAcpPresentationHelper.FormatAntigravityBadge(_acpStatus, _isLoadingAcp);
        }
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; padding-top: 0.85rem; border-top: 1px solid var(--border-subtle);">
            <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
                <span class="status-dot @acpBadge.DotClass"></span>
                <span id="acp-status-badge" class="forge-badge @acpBadge.BadgeClass" style="font-size: 0.85rem; padding: 0.3rem 0.75rem;">
                    @acpBadge.Text
                </span>
            </div>
            <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
                <button type="button" id="btn-refresh-acp" class="forge-btn forge-btn-outline" style="padding: 0.45rem 1rem; font-size: 0.85rem;" @onclick="() => RefreshAcpStatusAsync(forceRefresh: true)" disabled="@_isLoadingAcp">
                    @(_isLoadingAcp ? "Probing ACP..." : "🔄 Refresh ACP Status & Models")
                </button>
                <button type="button" id="btn-acp-login-hints" class="forge-btn forge-btn-outline" style="padding: 0.45rem 1rem; font-size: 0.85rem;" @onclick="ToggleAcpLoginModal">
                    🔑 Login Hints / Test Connection
                </button>
            </div>
        </div>

        @if (_showAcpLoginModal)
        {
            <div id="acp-login-modal" style="margin-top: 0.5rem; padding: 1.25rem; border-radius: var(--radius-md); background: var(--bg-input); border: 1px solid var(--border-subtle);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                    <strong style="font-size: 0.98rem; color: var(--text-primary);">🔑 Google Antigravity CLI (`agy acp`) Diagnostics &amp; Authentication</strong>
                    <button type="button" class="forge-btn forge-btn-outline" style="padding: 0.25rem 0.65rem; font-size: 0.8rem;" @onclick="ToggleAcpLoginModal">
                        ✕ Close
                    </button>
                </div>
                <div style="font-size: 0.86rem; color: var(--text-secondary); line-height: 1.6;">
                    <div><strong>Detected Binary:</strong> <code>@(_acpStatus?.DetectedExecutablePath ?? "Not detected")</code></div>
                    <div><strong>Execution Target:</strong> @(_acpStatus?.ExecutionTargetDescription ?? "Unavailable")</div>
                    <div><strong>Server Version / Tier:</strong> @(_acpStatus?.ServerVersion ?? "Unknown") / @(_acpStatus?.AccountTierName ?? "Unknown")</div>
                    @if (!string.IsNullOrWhiteSpace(_acpStatus?.DiagnosticMessage))
                    {
                        <div style="margin-top: 0.4rem; color: var(--accent-amber, #f59e0b);"><strong>Diagnostic:</strong> @_acpStatus.DiagnosticMessage</div>
                    }
                    <div style="margin-top: 0.75rem;">
                        <strong>Sign-in Commands:</strong>
                        <ul style="margin: 0.35rem 0 0 1.25rem; padding: 0;">
                            <li>WSL2 (recommended for Container &amp; WSL2 execution): <code>wsl -e ~/.local/bin/agy login</code></li>
                            <li>Host OS: <code>agy login</code> (or <code>agy acp --login</code>)</li>
                        </ul>
                    </div>
                </div>
                <div style="margin-top: 0.85rem; display: flex; gap: 0.5rem;">
                    <button type="button" id="btn-test-acp-connection" class="forge-btn forge-btn-outline" style="padding: 0.45rem 1rem; font-size: 0.85rem;" @onclick="TestAcpConnectionAsync" disabled="@_isLoadingAcp">
                        @(_isLoadingAcp ? "Testing..." : "🧪 Test ACP Connection")
                    </button>
                </div>
            </div>
        }
    </div>

    @if (Scope == ProfileScope.Workspace && !_hasDedicatedProfiles)
    {
        <div style="padding: 3.5rem 2rem; text-align: center; border: 2px dashed var(--border-subtle); border-radius: var(--radius-xl); background: var(--bg-surface);">
            <div style="font-size: 2.5rem; margin-bottom: 1rem;">🌐</div>
            <p style="font-size: 1.15rem; color: var(--text-primary); margin-bottom: 0.5rem;">
                This workspace currently inherits the <strong>Global System Profiles</strong>.
            </p>
            <p style="font-size: 0.92rem; color: var(--text-secondary); max-width: 600px; margin: 0 auto 1.75rem auto; line-height: 1.6;">
                Click below to clone and customize dedicated models, target backends, turn budgets, and prompts for this repository.
            </p>
            <button type="button" class="forge-btn forge-btn-primary" style="padding: 0.75rem 1.75rem; font-size: 0.95rem; font-weight: 600;" @onclick="CreateDedicatedProfilesAsync">
                ⚡ Customize Profiles for this Workspace
            </button>
        </div>
    }
    else if (_isLoading)
    {
        <div style="padding: 4rem 2rem; text-align: center; color: var(--text-secondary); font-size: 1rem;">
            <div style="font-size: 2rem; margin-bottom: 0.75rem;">⏳</div>
            Loading agent profiles...
        </div>
    }
    else
    {
        @if (_profiles.Count > 0)
        {
            var crucibleModelIds = _availableModels.Select(m => m.ModelId).ToList();
            var acpModels = AgentProfileAcpPresentationHelper.GetEffectiveAcpModels(_acpStatus);

            <!-- Role-Based Task Difficulty Escalation Matrix -->
            <div id="difficulty-escalation-matrix" class="forge-subcard" style="padding: 1.5rem; margin-bottom: 2rem; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg);">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 1.25rem; flex-wrap: wrap;">
                    <div>
                        <h4 style="margin: 0 0 0.25rem 0; font-size: 1.05rem; font-weight: 700; color: var(--text-primary);">
                            ⚡ Role-Based Task Difficulty Escalation Matrix
                        </h4>
                        <p style="margin: 0; font-size: 0.84rem; color: var(--text-secondary);">
                            Configure automatic model &amp; harness escalation by task complexity. Architecture &amp; Review drives Task Review + Code Review Fix; Coder drives Implementation.
                        </p>
                    </div>
                </div>

                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    @foreach (var difficulty in TaskDifficultyPresentationHelper.AllDifficulties)
                    {
                        var isStandardTier = difficulty == TaskDifficulty.Standard;
                        var isSameAsArch = !isStandardTier && AgentProfileDifficultyMatrixHelper.IsCoderSameAsArchitect(_profiles, difficulty);

                        <div class="matrix-tier-row" data-difficulty="@difficulty" style="padding: 1rem 1.15rem; border-radius: var(--radius-md); border: 1px solid var(--border-subtle); background: var(--bg-card);">
                            <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; margin-bottom: 0.85rem; flex-wrap: wrap;">
                                <div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;">
                                    <span class="forge-badge @TaskDifficultyPresentationHelper.GetBadgeCssClass(difficulty)" style="@TaskDifficultyPresentationHelper.GetBadgeStyle(difficulty)">
                                        @TaskDifficultyPresentationHelper.GetDisplayLabel(difficulty)
                                    </span>
                                    <span style="font-size: 0.82rem; color: var(--text-secondary);">
                                        @TaskDifficultyPresentationHelper.GetShortDescription(difficulty)
                                    </span>
                                </div>
                            </div>

                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1rem;">
                                @foreach (var role in AgentProfileDifficultyMatrixHelper.AllRoles)
                                {
                                    var cell = AgentProfileDifficultyMatrixHelper.BuildCell(_profiles, difficulty, role, crucibleModelIds, _acpStatus);
                                    var cellIsAcp = string.Equals(cell.HarnessId, StandardHarnessIds.Acp, StringComparison.OrdinalIgnoreCase);
                                    var cellCustomMode = IsMatrixCellCustomModel(difficulty, role, cell);

                                    <div class="matrix-role-cell" data-difficulty="@difficulty" data-matrix-role="@role" style="padding: 0.9rem; border-radius: var(--radius-md); border: 1px solid var(--border-subtle); background: var(--bg-input); display: flex; flex-direction: column; gap: 0.7rem;">
                                        <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                                            <div>
                                                <div style="font-weight: 600; font-size: 0.88rem; color: var(--text-primary);">
                                                    @AgentProfileDifficultyMatrixHelper.GetRoleTitle(role)
                                                </div>
                                                <div style="font-size: 0.74rem; color: var(--text-muted);">
                                                    @AgentProfileDifficultyMatrixHelper.GetRoleStageHint(role)
                                                </div>
                                            </div>
                                            @if (!isStandardTier && role == EscalationMatrixRole.CoderImplementation)
                                            {
                                                <button type="button"
                                                        class="forge-btn forge-btn-secondary btn-xs matrix-copy-arch-btn"
                                                        style="font-size: 0.74rem; padding: 0.22rem 0.55rem;"
                                                        @onclick="() => CopyMatrixArchitectToCoder(difficulty)"
                                                        disabled="@isSameAsArch"
                                                        title="Copy Architecture &amp; Review settings for @difficulty">
                                                    @(isSameAsArch ? "✓ Same as Architecture & Review" : "Same as Architecture & Review")
                                                </button>
                                            }
                                        </div>

                                        <div style="display: grid; grid-template-columns: 1fr 1.4fr; gap: 0.6rem;">
                                            <div>
                                                <label class="forge-field-label" style="font-size: 0.75rem;">Harness</label>
                                                <select class="forge-input matrix-harness-select"
                                                        style="width: 100%; font-size: 0.82rem;"
                                                        value="@cell.HarnessId"
                                                        @onchange="(e) => OnMatrixHarnessChangedAsync(difficulty, role, e.Value?.ToString())">
                                                    <option value="@StandardHarnessIds.Crucible">Crucible</option>
                                                    <option value="@StandardHarnessIds.Acp">Antigravity ACP</option>
                                                </select>
                                            </div>
                                            <div>
                                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                                    <label class="forge-field-label" style="font-size: 0.75rem;">Model</label>
                                                    @if ((cellIsAcp && acpModels.Count > 0) || (!cellIsAcp && _availableModels.Count > 0))
                                                    {
                                                        <button type="button"
                                                                class="forge-btn forge-btn-secondary btn-xs"
                                                                style="font-size: 0.68rem; padding: 1px 5px;"
                                                                @onclick="() => ToggleMatrixCustomModel(difficulty, role, cell)">
                                                            @(cellCustomMode ? "List" : "Custom")
                                                        </button>
                                                    }
                                                </div>
                                                @if (cellIsAcp)
                                                {
                                                    @if (acpModels.Count > 0 && !cellCustomMode)
                                                    {
                                                        <select class="forge-input matrix-model-select"
                                                                style="width: 100%; font-size: 0.82rem; font-family: var(--font-mono);"
                                                                value="@cell.ModelName"
                                                                @onchange="(e) => OnMatrixModelChangedAsync(difficulty, role, e.Value?.ToString())">
                                                            @if (!string.IsNullOrWhiteSpace(cell.ModelName) && !acpModels.Any(m => string.Equals(m.ModelId, cell.ModelName, StringComparison.OrdinalIgnoreCase)))
                                                            {
                                                                <option value="@cell.ModelName">@cell.ModelName (Configured)</option>
                                                            }
                                                            @foreach (var m in acpModels)
                                                            {
                                                                <option value="@m.ModelId">@m.DisplayName (@m.ModelId)</option>
                                                            }
                                                        </select>
                                                    }
                                                    else
                                                    {
                                                        <input type="text"
                                                               class="forge-input matrix-model-input"
                                                               style="width: 100%; font-size: 0.82rem; font-family: var(--font-mono);"
                                                               value="@cell.ModelName"
                                                               @onchange="(e) => OnMatrixModelChangedAsync(difficulty, role, e.Value?.ToString())"
                                                               placeholder="e.g. gemini-4-argon" />
                                                    }
                                                }
                                                else
                                                {
                                                    @if (_availableModels.Count > 0 && !cellCustomMode)
                                                    {
                                                        <select class="forge-input matrix-model-select"
                                                                style="width: 100%; font-size: 0.82rem; font-family: var(--font-mono);"
                                                                value="@cell.ModelName"
                                                                @onchange="(e) => OnMatrixModelChangedAsync(difficulty, role, e.Value?.ToString())">
                                                            @if (!string.IsNullOrWhiteSpace(cell.ModelName) && !_availableModels.Any(m => string.Equals(m.ModelId, cell.ModelName, StringComparison.OrdinalIgnoreCase)))
                                                            {
                                                                <option value="@cell.ModelName">@cell.ModelName (Configured)</option>
                                                            }
                                                            @foreach (var m in _availableModels)
                                                            {
                                                                <option value="@m.ModelId">@m.DisplayName</option>
                                                            }
                                                        </select>
                                                    }
                                                    else
                                                    {
                                                        <input type="text"
                                                               class="forge-input matrix-model-input"
                                                               style="width: 100%; font-size: 0.82rem; font-family: var(--font-mono);"
                                                               value="@cell.ModelName"
                                                               @onchange="(e) => OnMatrixModelChangedAsync(difficulty, role, e.Value?.ToString())"
                                                               placeholder="e.g. qwen3.5:35b-a3b" />
                                                    }
                                                }
                                            </div>
                                        </div>

                                        <div style="display: grid; grid-template-columns: @(!cellIsAcp && _providerType == LlmProviderType.OllamaRouter ? "1fr 1fr" : "1fr"); gap: 0.6rem;">
                                            <div>
                                                <label class="forge-field-label" style="font-size: 0.75rem;">Thinking Effort</label>
                                                <select class="forge-input matrix-thinking-select"
                                                        style="width: 100%; font-size: 0.82rem;"
                                                        value="@cell.ThinkingEffort"
                                                        @onchange="(e) => OnMatrixThinkingEffortChanged(difficulty, role, e.Value?.ToString())">
                                                    @if (cellIsAcp)
                                                    {
                                                        @foreach (var opt in AgentProfileAcpPresentationHelper.GetSupportedAcpThinkingEfforts(_acpStatus, cell.ModelName))
                                                        {
                                                            <option value="@opt.Effort">@opt.DisplayLabel</option>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <option value="@ThinkingEffort.None">None (Instant)</option>
                                                        <option value="@ThinkingEffort.Low">Low (~1k tokens)</option>
                                                        <option value="@ThinkingEffort.Medium">Medium (~4k tokens)</option>
                                                        <option value="@ThinkingEffort.High">High (~8k tokens)</option>
                                                        <option value="@ThinkingEffort.CustomBudget">Custom Token Budget</option>
                                                    }
                                                </select>
                                            </div>

                                            @if (!cellIsAcp && _providerType == LlmProviderType.OllamaRouter)
                                            {
                                                <div>
                                                    <label class="forge-field-label" style="font-size: 0.75rem;">OllamaRouter Target</label>
                                                    <select class="forge-input matrix-routing-select"
                                                            style="width: 100%; font-size: 0.82rem;"
                                                            value="@cell.RoutingTarget"
                                                            @onchange="(e) => OnMatrixRoutingTargetChanged(difficulty, role, e.Value?.ToString())">
                                                        <option value="@OllamaRoutingTarget.Auto">Auto</option>
                                                        <option value="@OllamaRoutingTarget.Local">Host GPU (Local)</option>
                                                        <option value="@OllamaRoutingTarget.Remote">LAN GPU Server (Remote)</option>
                                                        <option value="@OllamaRoutingTarget.Cloud">Cloud Overflow</option>
                                                    </select>
                                                </div>
                                            }
                                        </div>

                                        @if (!cellIsAcp && cell.ThinkingEffort == ThinkingEffort.CustomBudget)
                                        {
                                            <div>
                                                <label class="forge-field-label" style="font-size: 0.75rem;">Custom Thinking Token Budget</label>
                                                <input type="number"
                                                       min="100"
                                                       max="64000"
                                                       step="500"
                                                       class="forge-input matrix-budget-input"
                                                       style="width: 100%; font-size: 0.82rem; font-family: var(--font-mono);"
                                                       value="@cell.ThinkingTokenBudget"
                                                       @onchange="(e) => OnMatrixThinkingBudgetChanged(difficulty, role, e.Value?.ToString())"
                                                       placeholder="e.g. 8192" />
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Profile Cards List -->
        <div style="display: flex; flex-direction: column; gap: 2rem;">
            @foreach (var profile in _profiles)
            {
                var isAcp = AgentProfileAcpPresentationHelper.IsAcpProfile(profile);
                var isHarnessSelectable = AgentProfileAcpPresentationHelper.IsStageHarnessSelectable(profile.Id);
                var acpModels = AgentProfileAcpPresentationHelper.GetEffectiveAcpModels(_acpStatus);

                <div class="forge-subcard" data-profile-id="@profile.Id" style="padding: 2rem; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm);">
                    <!-- Profile Header -->
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.75rem; flex-wrap: wrap; gap: 1rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 1.25rem;">
                        <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
                            <strong style="font-size: 1.2rem; color: var(--text-primary); font-weight: 700;">@profile.Name</strong>
                            <code class="forge-badge badge-indigo" style="font-size: 0.82rem; padding: 0.25rem 0.65rem;">@profile.Id</code>
                            <span class="forge-badge badge-teal" style="font-size: 0.82rem; padding: 0.25rem 0.65rem;">@profile.Mode</span>
                            @if (!isHarnessSelectable)
                            {
                                <span class="forge-badge badge-amber" style="font-size: 0.82rem; padding: 0.25rem 0.65rem;" title="@AgentProfileAcpPresentationHelper.GetPinnedHarnessReason(profile.Id)">
                                    Harness: @profile.HarnessId (Pinned)
                                </span>
                            }
                        </div>
                        <div style="display: flex; align-items: center; gap: 0.75rem;">
                            @if (!isAcp)
                            {
                                @if (profile.OptimizationFlags == null)
                                {
                                    <span class="forge-badge badge-teal" style="font-size: 0.82rem; padding: 0.35rem 0.75rem;">⚡ Inheriting Global Optimizations</span>
                                    <button type="button" class="forge-btn forge-btn-outline" style="padding: 0.45rem 1rem; font-size: 0.85rem; font-weight: 600;" @onclick="() => CustomizeFlags(profile)">
                                        Override
                                    </button>
                                }
                                else
                                {
                                    <span class="forge-badge badge-indigo" style="font-size: 0.82rem; padding: 0.35rem 0.75rem;">🔧 Custom Optimizations</span>
                                    <button type="button" class="forge-btn forge-btn-outline" style="padding: 0.45rem 1rem; font-size: 0.85rem; font-weight: 600;" @onclick="() => RevertFlags(profile)">
                                        Revert to Global
                                    </button>
                                }
                            }
                            else
                            {
                                <span class="forge-badge badge-indigo" style="font-size: 0.82rem; padding: 0.35rem 0.75rem;">
                                    🔌 External Antigravity ACP
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Core Parameters Grid -->
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; font-size: 0.92rem;">
                        <!-- 0. Harness Selector (Pipeline stages) or Pinned Info -->
                        @if (isHarnessSelectable)
                        {
                            <div>
                                <label class="forge-field-label">Execution Harness</label>
                                <select class="forge-input harness-select" style="width: 100%;" value="@profile.HarnessId" @onchange="(e) => OnHarnessChangedAsync(profile, e.Value?.ToString())">
                                    <option value="@StandardHarnessIds.Crucible">@AgentProfileAcpPresentationHelper.CrucibleHarnessDisplayLabel</option>
                                    <option value="@StandardHarnessIds.Acp">@AgentProfileAcpPresentationHelper.AcpHarnessDisplayLabel</option>
                                </select>
                            </div>
                        }

                        <!-- 1. Inference Model Dropdown -->
                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
                                <label class="forge-field-label" style="margin: 0;">Inference Model</label>
                                @if ((isAcp && acpModels.Count > 0) || (!isAcp && _availableModels.Count > 0))
                                {
                                    <button type="button" class="forge-btn forge-btn-outline" style="padding: 0.15rem 0.5rem; font-size: 0.72rem;"
                                            @onclick="() => ToggleCustomModel(profile.Id)">
                                        @(IsCustomModel(profile.Id) ? "Select from list" : "Enter custom name")
                                    </button>
                                }
                            </div>
                            @if (isAcp)
                            {
                                @if (acpModels.Count > 0 && !IsCustomModel(profile.Id))
                                {
                                    <select class="forge-input font-mono" style="width: 100%;" @bind="profile.ModelName" @bind:after="() => OnProfileModelChangedAsync(profile)">
                                        @if (!string.IsNullOrWhiteSpace(profile.ModelName) && !acpModels.Any(m => string.Equals(m.ModelId, profile.ModelName, StringComparison.OrdinalIgnoreCase)))
                                        {
                                            <option value="@profile.ModelName">@profile.ModelName (Configured)</option>
                                        }
                                        @foreach (var m in acpModels)
                                        {
                                            <option value="@m.ModelId">@m.DisplayName (@m.ModelId)</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input type="text" class="forge-input font-mono" style="width: 100%;" @bind="profile.ModelName" @bind:after="() => OnProfileModelChangedAsync(profile)" placeholder="e.g. gemini-4-argon" />
                                }
                            }
                            else
                            {
                                @if (_availableModels.Count > 0 && !IsCustomModel(profile.Id))
                                {
                                    <select class="forge-input font-mono" style="width: 100%;" @bind="profile.ModelName" @bind:after="() => OnProfileModelChangedAsync(profile)">
                                        @if (!string.IsNullOrWhiteSpace(profile.ModelName) && !_availableModels.Any(m => string.Equals(m.ModelId, profile.ModelName, StringComparison.OrdinalIgnoreCase)))
                                        {
                                            <option value="@profile.ModelName">@profile.ModelName (Configured)</option>
                                        }
                                        @foreach (var m in _availableModels)
                                        {
                                            <option value="@m.ModelId">@m.DisplayName @(!string.IsNullOrWhiteSpace(m.FormattedBadge) ? $"({m.FormattedBadge})" : "")</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input type="text" class="forge-input font-mono" style="width: 100%;" @bind="profile.ModelName" @bind:after="() => OnProfileModelChangedAsync(profile)" placeholder="e.g. qwen2.5-coder:32b" />
                                }

                                @if (!string.IsNullOrWhiteSpace(profile.ModelName) && _discoveredContextWindows.TryGetValue(profile.ModelName, out var pTokens))
                                {
                                    <span class="forge-badge badge-teal" style="font-size: 0.72rem; margin-top: 0.35rem; display: inline-block;">
                                        ⚡ @pTokens.ToString("N0") tokens discovered
                                    </span>
                                }
                                @if (GetThinkingBadge(profile.ModelName) is { Length: > 0 } thinkingBadge)
                                {
                                    <span class="forge-badge badge-indigo" style="font-size: 0.72rem; margin-top: 0.35rem; margin-left: 0.35rem; display: inline-block;">
                                        @thinkingBadge
                                    </span>
                                }
                            }
                        </div>

                        <!-- 2. OllamaRouter Target Pinning (Suppressed in Standalone Ollama, OpenAI, and ACP modes) -->
                        @if (!isAcp && _providerType == LlmProviderType.OllamaRouter)
                        {
                            <div>
                                <label class="forge-field-label">OllamaRouter Target</label>
                                <select class="forge-input" style="width: 100%;" @bind="profile.RoutingTarget">
                                    <option value="@OllamaRoutingTarget.Auto">Auto (Dynamic VRAM &amp; Context Routing)</option>
                                    <option value="@OllamaRoutingTarget.Local">Host GPU (Local Workstation - On-Premise)</option>
                                    <option value="@OllamaRoutingTarget.Remote">LAN GPU Server (Remote - Dedicated High-VRAM, ~95% Workloads)</option>
                                    <option value="@OllamaRoutingTarget.Cloud">Cloud Overflow (Optional External / Zero Local VRAM)</option>
                                </select>
                                <span class="field-hint" style="display: block; font-size: 0.78rem; color: var(--text-muted); margin-top: 0.35rem;">
                                    Host GPU and LAN Server are both 100% private local workloads.
                                </span>
                            </div>
                        }

                        <!-- 3. Thinking Effort -->
                        <div>
                            <label class="forge-field-label">Thinking Effort</label>
                            @if (isAcp)
                            {
                                <select class="forge-input" style="width: 100%;" @bind="profile.ThinkingEffort">
                                    @foreach (var opt in AgentProfileAcpPresentationHelper.GetSupportedAcpThinkingEfforts(_acpStatus, profile.ModelName))
                                    {
                                        <option value="@opt.Effort">@opt.DisplayLabel</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <select class="forge-input" style="width: 100%;" @bind="profile.ThinkingEffort">
                                    <option value="@ThinkingEffort.None">None (Instant)</option>
                                    <option value="@ThinkingEffort.Low">Low (~1k tokens)</option>
                                    <option value="@ThinkingEffort.Medium">Medium (~4k tokens)</option>
                                    <option value="@ThinkingEffort.High">High (~8k tokens)</option>
                                    <option value="@ThinkingEffort.CustomBudget">Custom Token Budget</option>
                                </select>
                            }
                        </div>

                        @if (!isAcp && profile.ThinkingEffort == ThinkingEffort.CustomBudget)
                        {
                            <div>
                                <label class="forge-field-label">Custom Thinking Token Budget</label>
                                <input type="number" min="100" max="64000" step="500" class="forge-input font-mono" style="width: 100%;" @bind="profile.ThinkingTokenBudget" placeholder="e.g. 8192" />
                            </div>
                        }

                        <!-- 4. Max Turns Budget (Generous for Full Autonomy) -->
                        <div>
                            <label class="forge-field-label">Max Turns Budget</label>
                            <input type="number" min="10" max="2000" step="25" class="forge-input font-mono" style="width: 100%;" @bind="profile.MaxTurns" />
                        </div>

                        <!-- 5. Temperature -->
                        <div>
                            <label class="forge-field-label">Temperature</label>
                            <input type="number" min="0.0" max="2.0" step="0.1" class="forge-input font-mono" style="width: 100%;" @bind="profile.Temperature" placeholder="Model default" />
                        </div>

                        <!-- 6. Sandbox Security Tier -->
                        <div>
                            <label class="forge-field-label">Security Tier</label>
                            <select class="forge-input" style="width: 100%;" @bind="profile.SecurityTier" disabled="@isAcp" title="@(isAcp ? "Antigravity ACP requires network access and host credential mounts (Standard Sandbox)." : null)">
                                <option value="@SandboxSecurityTier.Standard">Standard (Full Sandbox)</option>
                                @if (!isAcp)
                                {
                                    <option value="@SandboxSecurityTier.RestrictedReadOnly">Restricted Read-Only (Stage 0)</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Complete Optimization Override Section (Crucible only) -->
                    @if (!isAcp && profile.OptimizationFlags != null)
                    {
                        <div style="margin-top: 2rem; padding: 1.75rem; background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg);">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.75rem;">
                                <div>
                                    <h4 style="margin: 0 0 0.25rem 0; font-size: 1.05rem; font-weight: 700; color: var(--accent-indigo);">
                                        ⚡ Complete Profile Optimization Overrides
                                    </h4>
                                    <p style="margin: 0; font-size: 0.85rem; color: var(--text-secondary);">
                                        Custom runtime samplers and compaction thresholds applied specifically to this reasoning profile.
                                    </p>
                                </div>
                                <span class="forge-badge badge-indigo" style="font-size: 0.75rem; padding: 0.25rem 0.65rem;">Active Override</span>
                            </div>

                            <!-- Section A: 5 Boolean Switches -->
                            <div style="margin-bottom: 1.5rem;">
                                <label style="display: block; font-size: 0.82rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin-bottom: 0.85rem;">
                                    Runtime Optimization &amp; Sampler Flags (5 Switches)
                                </label>
                                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 0.85rem;">
                                    <label class="forge-checkbox-tile">
                                        <input type="checkbox" @bind="profile.OptimizationFlags.GuidedGrammarDecoding" />
                                        <div>
                                            <strong style="display: block; font-size: 0.9rem; color: var(--text-primary);">Guided Grammar Decoding</strong>
                                            <span style="font-size: 0.78rem; color: var(--text-muted);">Constrains tool call outputs to strict JSON schemas</span>
                                        </div>
                                    </label>
                                    <label class="forge-checkbox-tile">
                                        <input type="checkbox" @bind="profile.OptimizationFlags.DeterministicSymbolMap" />
                                        <div>
                                            <strong style="display: block; font-size: 0.9rem; color: var(--text-primary);">Deterministic Symbol Map</strong>
                                            <span style="font-size: 0.78rem; color: var(--text-muted);">Caches exact workspace syntax tree references</span>
                                        </div>
                                    </label>
                                    <label class="forge-checkbox-tile">
                                        <input type="checkbox" @bind="profile.OptimizationFlags.SmartCliOutputFiltering" />
                                        <div>
                                            <strong style="display: block; font-size: 0.9rem; color: var(--text-primary);">Smart CLI Output Filtering</strong>
                                            <span style="font-size: 0.78rem; color: var(--text-muted);">Relativizes paths, prunes SDK noise, and offloads raw logs to /tmp</span>
                                        </div>
                                    </label>
                                    <label class="forge-checkbox-tile">
                                        <input type="checkbox" @bind="profile.OptimizationFlags.JitModelPreload" />
                                        <div>
                                            <strong style="display: block; font-size: 0.9rem; color: var(--text-primary);">JIT Model Preload</strong>
                                            <span style="font-size: 0.78rem; color: var(--text-muted);">Pre-warms weights in VRAM before turn starts</span>
                                        </div>
                                    </label>
                                    <label class="forge-checkbox-tile">
                                        <input type="checkbox" @bind="profile.OptimizationFlags.SyntheticConversationPriming" />
                                        <div>
                                            <strong style="display: block; font-size: 0.9rem; color: var(--text-primary);">Synthetic Conversation Priming</strong>
                                            <span style="font-size: 0.78rem; color: var(--text-muted);">Seeds ChatHistory with deterministic stage results</span>
                                        </div>
                                    </label>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Expandable System Prompt -->
                    <details style="margin-top: 1.75rem; background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 1.15rem 1.35rem;">
                        <summary style="font-weight: 600; font-size: 0.92rem; color: var(--text-primary); cursor: pointer; outline: none; user-select: none;">
                            System Prompt &amp; Persona Instructions
                        </summary>
                        <div style="margin-top: 1rem;">
                            <textarea class="forge-input font-mono" rows="6" style="width: 100%; font-size: 0.88rem; line-height: 1.6; padding: 0.85rem;" @bind="profile.SystemPrompt" placeholder="Default persona and stage instructions..."></textarea>
                        </div>
                    </details>
                </div>
            }
        </div>
    }
</div>

@code {
    public enum ProfileScope { Global, Workspace }

    [Parameter] public ProfileScope Scope { get; set; } = ProfileScope.Global;
    [Parameter] public int? WorkspaceId { get; set; }
    [Parameter] public string? WorkspaceName { get; set; }

    private List<AgentProfile> _profiles = new();
    private List<AvailableModelInfo> _availableModels = new();
    private ConcurrentDictionary<string, int> _discoveredContextWindows = new(StringComparer.OrdinalIgnoreCase);
    private LlmProviderType _providerType = LlmProviderType.OllamaRouter;
    private AcpCatalogProviderStatus? _acpStatus;

    private bool _hasDedicatedProfiles;
    private bool _isOllamaOnline;
    private bool _isLoading = true;
    private bool _isLoadingModels = true;
    private bool _isLoadingAcp = true;
    private bool _showAcpLoginModal;
    private bool _isSaving;
    private bool _isDetecting;
    private int? _lastLoadedWorkspaceId;
    private ProfileScope? _lastLoadedScope;

    protected override async Task OnParametersSetAsync()
    {
        if (_lastLoadedScope != Scope || _lastLoadedWorkspaceId != WorkspaceId)
        {
            _lastLoadedScope = Scope;
            _lastLoadedWorkspaceId = WorkspaceId;
            _providerType = GatewayService.ProviderType;
            await RefreshOllamaModelsAsync();
            await RefreshAcpStatusAsync(forceRefresh: false);
            await LoadProfilesAsync();
        }
    }

    private async Task RefreshAcpStatusAsync(bool forceRefresh)
    {
        _isLoadingAcp = true;
        try
        {
            _acpStatus = await AgentProfileDifficultyMatrixHelper.TryGetAcpStatusAsync(ServiceProvider, forceRefresh);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Non-fatal ACP catalog probe failure");
            _acpStatus = null;
        }
        finally
        {
            _isLoadingAcp = false;
        }
    }

    private void ToggleAcpLoginModal() => _showAcpLoginModal = !_showAcpLoginModal;

    private async Task TestAcpConnectionAsync()
    {
        await RefreshAcpStatusAsync(forceRefresh: true);
        if (_acpStatus is { IsInstalled: true, IsAuthenticated: true })
        {
            ToastService.Show("Antigravity ACP Ready", $"Connected ({_acpStatus.ServerVersion ?? "v?"} | {_acpStatus.AccountTierName ?? "Authenticated"}).", ToastLevel.Success);
        }
        else if (_acpStatus is { IsInstalled: true })
        {
            ToastService.Show("Authentication Required", _acpStatus.DiagnosticMessage ?? "Run 'wsl -e ~/.local/bin/agy login' or 'agy login'.", ToastLevel.Warning);
        }
        else
        {
            ToastService.Show("Antigravity ACP Not Detected", _acpStatus?.DiagnosticMessage ?? "agy binary not found.", ToastLevel.Warning);
        }
    }

    private async Task OnHarnessChangedAsync(AgentProfile profile, string? selectedHarnessId)
    {
        var fallbackCrucibleModel = _availableModels.FirstOrDefault()?.ModelId ?? LlmOptions.Value.DefaultModelId;
        AgentProfileAcpPresentationHelper.ApplyHarnessChange(profile, selectedHarnessId, _acpStatus, fallbackCrucibleModel);
        _customModelProfiles.Remove(profile.Id);

        if (!AgentProfileAcpPresentationHelper.IsAcpProfile(profile) &&
            !string.IsNullOrWhiteSpace(profile.ModelName))
        {
            await ResolveModelContextWindowAsync(profile.ModelName);
            profile.ContextWindowTokens = _discoveredContextWindows.TryGetValue(profile.ModelName, out var ctxTokens)
                ? ctxTokens
                : null;
        }
    }

    private async Task DetectProviderAsync()
    {
        _isDetecting = true;
        try
        {
            var detected = await GatewayService.DetectProviderAsync();
            if (detected.HasValue && detected.Value == _providerType)
            {
                ToastService.Show("Provider Verified", $"The endpoint matches the configured provider ({detected.Value}).", ToastLevel.Success);
            }
            else if (detected.HasValue)
            {
                ToastService.Show("Provider Mismatch", $"The endpoint looks like {detected.Value} but {_providerType} is configured. Set LlmProvider:ProviderType and restart.", ToastLevel.Warning);
            }
            else
            {
                ToastService.Show("Endpoint Offline", $"Could not contact inference provider ({_providerType}) at the configured endpoint.", ToastLevel.Warning);
            }
        }
        catch (Exception ex)
        {
            ToastService.Show("Detection Error", ex.Message, ToastLevel.Error);
        }
        finally
        {
            _isDetecting = false;
        }
    }

    private async Task ResolveModelContextWindowAsync(string modelName)
    {
        if (!string.IsNullOrWhiteSpace(modelName))
        {
            if (ContextWindowCache.TryGetContextWindow(modelName, out var cached))
            {
                _discoveredContextWindows[modelName] = cached;
            }
            else if (!_discoveredContextWindows.ContainsKey(modelName))
            {
                try
                {
                    var tokens = await GatewayService.ResolveContextWindowAsync(modelName);
                    if (tokens > 0)
                    {
                        _discoveredContextWindows[modelName] = tokens;
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogDebug(ex, "Non-fatal probe failure resolving context window for '{Model}'.", modelName);
                }
            }

            if (!ContextWindowCache.TryGetThinkingCapability(modelName, out _))
            {
                try
                {
                    await GatewayService.ResolveThinkingCapabilityAsync(modelName);
                }
                catch (Exception ex)
                {
                    Logger.LogDebug(ex, "Non-fatal probe failure resolving thinking capability for '{Model}'.", modelName);
                }
            }

            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnProfileModelChangedAsync(AgentProfile profile)
    {
        profile.ContextWindowTokens = null;

        if (AgentProfileAcpPresentationHelper.IsAcpProfile(profile))
        {
            AgentProfileAcpPresentationHelper.NormalizeAcpProfileSettings(profile, _acpStatus);
            return;
        }

        await ResolveModelContextWindowAsync(profile.ModelName);
        if (!string.IsNullOrWhiteSpace(profile.ModelName) &&
            _discoveredContextWindows.TryGetValue(profile.ModelName, out var ctxTokens))
        {
            profile.ContextWindowTokens = ctxTokens;
        }
    }

    private async Task RefreshOllamaModelsAsync()
    {
        _isLoadingModels = true;
        try
        {
            var models = await ModelCatalogService.GetAvailableModelsAsync();
            _availableModels = models.ToList();
            _isOllamaOnline = _availableModels.Count > 0;
            foreach (var m in _availableModels)
            {
                if (m.ContextWindowTokens.HasValue)
                {
                    _discoveredContextWindows[m.ModelId] = m.ContextWindowTokens.Value;
                    ContextWindowCache.SetContextWindow(m.ModelId, m.ContextWindowTokens.Value);
                }
                if (m.ThinkingCapability != null)
                {
                    ContextWindowCache.SetThinkingCapability(m.ModelId, m.ThinkingCapability);
                }
            }
        }
        catch (Exception)
        {
            // Non-fatal probe failure: LLM provider is offline or unreachable
            _isOllamaOnline = false;
        }
        finally
        {
            _isLoadingModels = false;
        }
    }

    private async Task LoadProfilesAsync()
    {
        _isLoading = true;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();

            if (Scope == ProfileScope.Global)
            {
                _profiles = await db.AgentProfiles.Where(p => p.WorkspaceId == null).OrderBy(p => p.Id).ToListAsync();
            }
            else if (WorkspaceId.HasValue)
            {
                var dedicated = await db.AgentProfiles.Where(p => p.WorkspaceId == WorkspaceId.Value).OrderBy(p => p.Id).ToListAsync();
                _hasDedicatedProfiles = dedicated.Count > 0;
                _profiles = _hasDedicatedProfiles 
                    ? dedicated 
                    : await db.AgentProfiles.Where(p => p.WorkspaceId == null).OrderBy(p => p.Id).ToListAsync();
            }

            foreach (var p in _profiles)
            {
                if (AgentProfileAcpPresentationHelper.IsAcpProfile(p))
                {
                    AgentProfileAcpPresentationHelper.NormalizeAcpProfileSettings(p, _acpStatus);
                }
            }

            var distinctModels = AgentProfileDifficultyMatrixHelper.GetDistinctCrucibleModelNames(_profiles);

            var probeTasks = new List<Task>();
            foreach (var modelName in distinctModels)
            {
                var hasCachedContext = ContextWindowCache.TryGetContextWindow(modelName, out var cached);
                if (hasCachedContext)
                {
                    _discoveredContextWindows[modelName] = cached;
                }

                if (!hasCachedContext || !ContextWindowCache.TryGetThinkingCapability(modelName, out _))
                {
                    probeTasks.Add(ResolveModelContextWindowAsync(modelName));
                }
            }

            if (probeTasks.Count > 0)
            {
                await Task.WhenAll(probeTasks);
            }
        }
        catch (Exception ex)
        {
            ToastService.Show("Error Loading Profiles", ex.Message, ToastLevel.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CreateDedicatedProfilesAsync()
    {
        if (!WorkspaceId.HasValue || _isSaving) return;
        _isSaving = true;

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();

            var globalProfiles = await db.AgentProfiles.Where(p => p.WorkspaceId == null).ToListAsync();
            if (globalProfiles.Count == 0)
            {
                globalProfiles = AgentProfile.CreateStandardGlobalProfiles(LlmOptions.Value).ToList();
            }

            foreach (var g in globalProfiles)
            {
                var dedicated = AgentProfileAcpPresentationHelper.CloneToDedicatedProfile(g, WorkspaceId.Value, WorkspaceName);
                db.AgentProfiles.Add(dedicated);
            }

            await db.SaveChangesAsync();
            ToastService.Show("Dedicated Profiles Created", $"Created dedicated reasoning profiles for {WorkspaceName ?? "workspace"}.", ToastLevel.Success);
            await LoadProfilesAsync();
        }
        catch (Exception ex)
        {
            ToastService.Show("Error Creating Dedicated Profiles", ex.Message, ToastLevel.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task RevertToGlobalProfilesAsync()
    {
        if (!WorkspaceId.HasValue || _isSaving) return;
        _isSaving = true;

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();

            var dedicated = await db.AgentProfiles.Where(p => p.WorkspaceId == WorkspaceId.Value).ToListAsync();
            if (dedicated.Count > 0)
            {
                db.AgentProfiles.RemoveRange(dedicated);
                await db.SaveChangesAsync();
            }

            ToastService.Show("Reverted to Global Profiles", $"Dedicated profiles removed. Workspace now inherits global system profiles.", ToastLevel.Success);
            await LoadProfilesAsync();
        }
        catch (Exception ex)
        {
            ToastService.Show("Error Reverting Profiles", ex.Message, ToastLevel.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SaveProfilesAsync()
    {
        if (_isSaving) return;
        _isSaving = true;

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();

            foreach (var p in _profiles)
            {
                var existing = await db.AgentProfiles.FindAsync(p.Id);
                if (existing != null)
                {
                    AgentProfileAcpPresentationHelper.SynchronizeProfileForSave(existing, p, _providerType, _discoveredContextWindows, _acpStatus);
                    db.Entry(existing).State = EntityState.Modified;
                }
                else
                {
                    AgentProfileAcpPresentationHelper.SynchronizeProfileForSave(p, p, _providerType, _discoveredContextWindows, _acpStatus);
                    db.AgentProfiles.Add(p);
                }
            }

            await db.SaveChangesAsync();
            ToastService.Show("Profiles Saved", "Agent reasoning profiles successfully updated.", ToastLevel.Success);
        }
        catch (Exception ex)
        {
            ToastService.Show("Error Saving Profiles", ex.Message, ToastLevel.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private readonly HashSet<string> _customModelProfiles = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<(TaskDifficulty, EscalationMatrixRole)> _customMatrixCells = new();

    private bool IsMatrixCellCustomModel(
        TaskDifficulty difficulty,
        EscalationMatrixRole role,
        DifficultyMatrixCellModel cell)
    {
        if (_customMatrixCells.Contains((difficulty, role)) || cell.ModelName == AgentProfileAcpPresentationHelper.CustomModelSentinel)
        {
            return true;
        }

        return false;
    }

    private void ToggleMatrixCustomModel(TaskDifficulty difficulty, EscalationMatrixRole role, DifficultyMatrixCellModel cell)
    {
        var key = (difficulty, role);
        if (!_customMatrixCells.Remove(key) && cell.ModelName != AgentProfileAcpPresentationHelper.CustomModelSentinel)
        {
            _customMatrixCells.Add(key);
        }
        else if (cell.ModelName == AgentProfileAcpPresentationHelper.CustomModelSentinel)
        {
            cell.ModelName = string.Empty;
            ApplyMatrixCell(cell);
        }
    }

    private DifficultyMatrixCellModel BuildCurrentMatrixCell(TaskDifficulty difficulty, EscalationMatrixRole role)
    {
        var crucibleModelIds = _availableModels.Select(m => m.ModelId).ToList();
        return AgentProfileDifficultyMatrixHelper.BuildCell(_profiles, difficulty, role, crucibleModelIds, _acpStatus);
    }

    private void ApplyMatrixCell(DifficultyMatrixCellModel cell) =>
        AgentProfileDifficultyMatrixHelper.ApplyCellToProfiles(_profiles, cell, _providerType, _discoveredContextWindows, _acpStatus);

    private async Task OnMatrixHarnessChangedAsync(TaskDifficulty difficulty, EscalationMatrixRole role, string? selectedHarnessId)
    {
        var cell = BuildCurrentMatrixCell(difficulty, role);
        var fallbackCrucibleModel = _availableModels.FirstOrDefault()?.ModelId ?? LlmOptions.Value.DefaultModelId;
        AgentProfileDifficultyMatrixHelper.ApplyHarnessSwitch(cell, selectedHarnessId, fallbackCrucibleModel, _acpStatus);
        _customMatrixCells.Remove((difficulty, role));
        ApplyMatrixCell(cell);
        if (!string.Equals(cell.HarnessId, StandardHarnessIds.Acp, StringComparison.OrdinalIgnoreCase) &&
            !string.IsNullOrWhiteSpace(cell.ModelName))
        {
            await ResolveModelContextWindowAsync(cell.ModelName);
            ApplyMatrixCell(cell);
        }
    }

    private async Task OnMatrixModelChangedAsync(TaskDifficulty difficulty, EscalationMatrixRole role, string? selectedModel)
    {
        var cell = BuildCurrentMatrixCell(difficulty, role);
        cell.ModelName = selectedModel ?? string.Empty;
        cell.ContextWindowTokens = null;
        ApplyMatrixCell(cell);
        if (!string.Equals(cell.HarnessId, StandardHarnessIds.Acp, StringComparison.OrdinalIgnoreCase) &&
            !string.IsNullOrWhiteSpace(cell.ModelName))
        {
            await ResolveModelContextWindowAsync(cell.ModelName);
            ApplyMatrixCell(cell);
        }
    }

    private void OnMatrixThinkingEffortChanged(TaskDifficulty difficulty, EscalationMatrixRole role, string? rawEffort)
    {
        if (!Enum.TryParse<ThinkingEffort>(rawEffort, ignoreCase: true, out var effort))
        {
            return;
        }

        var cell = BuildCurrentMatrixCell(difficulty, role);
        cell.ThinkingEffort = effort;
        ApplyMatrixCell(cell);
    }

    private void OnMatrixThinkingBudgetChanged(TaskDifficulty difficulty, EscalationMatrixRole role, string? rawBudget)
    {
        var cell = BuildCurrentMatrixCell(difficulty, role);
        cell.ThinkingTokenBudget = int.TryParse(rawBudget, out var parsed) ? parsed : null;
        ApplyMatrixCell(cell);
    }

    private void OnMatrixRoutingTargetChanged(TaskDifficulty difficulty, EscalationMatrixRole role, string? rawTarget)
    {
        if (!Enum.TryParse<OllamaRoutingTarget>(rawTarget, ignoreCase: true, out var target))
        {
            return;
        }

        var cell = BuildCurrentMatrixCell(difficulty, role);
        cell.RoutingTarget = target;
        ApplyMatrixCell(cell);
    }

    private void CopyMatrixArchitectToCoder(TaskDifficulty difficulty)
    {
        AgentProfileDifficultyMatrixHelper.CopyArchitectToCoder(_profiles, difficulty, _providerType, _discoveredContextWindows, _acpStatus);
        _customMatrixCells.Remove((difficulty, EscalationMatrixRole.CoderImplementation));
    }

    private bool IsCustomModel(string profileId)
    {
        if (_customModelProfiles.Contains(profileId)) return true;
        var p = _profiles.FirstOrDefault(x => x.Id == profileId);
        return p != null && p.ModelName == AgentProfileAcpPresentationHelper.CustomModelSentinel;
    }

    private void ToggleCustomModel(string profileId)
    {
        if (!_customModelProfiles.Remove(profileId))
        {
            _customModelProfiles.Add(profileId);
            var p = _profiles.FirstOrDefault(x => x.Id == profileId);
            if (p != null && p.ModelName == AgentProfileAcpPresentationHelper.CustomModelSentinel)
            {
                p.ModelName = string.Empty;
            }
        }
    }

    private void CustomizeFlags(AgentProfile profile) => profile.OptimizationFlags = new LocalOptimizationFlags();
    private void RevertFlags(AgentProfile profile) => profile.OptimizationFlags = null;

    private string? GetThinkingBadge(string? modelName)
    {
        if (string.IsNullOrWhiteSpace(modelName))
        {
            return null;
        }

        if (ContextWindowCache.TryGetThinkingCapability(modelName, out var cached) && !string.IsNullOrWhiteSpace(cached.FormattedBadge))
        {
            return cached.FormattedBadge;
        }

        var available = _availableModels.FirstOrDefault(m => string.Equals(m.ModelId, modelName, StringComparison.OrdinalIgnoreCase));
        return available?.ThinkingCapability?.FormattedBadge;
    }

    private static string GetProviderShortName(LlmProviderType provider) => provider switch
    {
        LlmProviderType.OpenAiCompatible => "OpenAI-Compatible endpoint",
        LlmProviderType.OllamaRouter => "OllamaRouter",
        _ => "Ollama"
    };

    private static string GetProviderTitle(LlmProviderType provider) => provider switch
    {
        LlmProviderType.OpenAiCompatible => "OpenAI-Compatible Gateway",
        LlmProviderType.OllamaRouter => "OllamaRouter Gateway",
        _ => "Standalone Ollama"
    };
}

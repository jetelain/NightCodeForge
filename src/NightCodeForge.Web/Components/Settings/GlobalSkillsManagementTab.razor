@namespace NightCodeForge.Web.Components.Settings
@using NightCodeForge.Core.Domain
@using NightCodeForge.Web.Services
@inject IGlobalSkillsManagerService SkillsManager
@inject ToastService ToastService

<div class="forge-card mt-3">
    <!-- Header -->
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem; flex-wrap: wrap; gap: 1.5rem;">
        <div>
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.35rem; flex-wrap: wrap;">
                <span style="font-size: 1.75rem;">🧰</span>
                <h3 style="font-weight: 700; font-size: 1.35rem; margin: 0; color: var(--text-primary);">
                    Global Skills Store &amp; Stack Tooling
                </h3>
                <span class="forge-badge badge-indigo" style="padding: 0.3rem 0.75rem; font-size: 0.82rem;">
                    Global Store (~/.nightcodeforge/skills/)
                </span>
            </div>
            <p style="margin: 0; font-size: 0.92rem; color: var(--text-secondary); line-height: 1.6; max-width: 820px;">
                Manage global modular agent skills and companion toolchains. Built-in tools (csnav, mdfetch, codecondenser) are automatically seeded and mounted into sandboxes, while custom skills apply automatically across repositories matching their target tech stack.
            </p>
        </div>
        <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
            <button type="button" class="forge-btn forge-btn-outline" style="padding: 0.65rem 1.25rem; font-size: 0.92rem;" @onclick="RefreshSkillsAsync" disabled="@_isLoading">
                🔄 Refresh
            </button>
            <button type="button" class="forge-btn forge-btn-primary" style="padding: 0.65rem 1.4rem; font-size: 0.92rem; font-weight: 600;" @onclick="OpenAddModal">
                ➕ Add Custom Global Skill
            </button>
        </div>
    </div>

    @if (_isLoading)
    {
        <div style="padding: 3rem; text-align: center; color: var(--text-secondary);">
            <div style="font-size: 1.75rem; margin-bottom: 0.5rem;">🔍</div>
            <p>Scanning global skills store and bundled providers...</p>
        </div>
    }
    else
    {
        <!-- 1. .NET / C# Stack Skills -->
        var dotnetSkills = _skills.Where(s => s.Stack.Equals(CodeStack.DotNet, StringComparison.OrdinalIgnoreCase) || s.Stack.Equals("csharp", StringComparison.OrdinalIgnoreCase)).ToList();
        <!-- 2. Universal Skills -->
        var universalSkills = _skills.Where(s => s.Stack.Equals(CodeStack.Universal, StringComparison.OrdinalIgnoreCase)).ToList();
        <!-- 3. Other Stacks -->
        var otherSkills = _skills.Where(s => !dotnetSkills.Contains(s) && !universalSkills.Contains(s)).ToList();

        <div style="display: flex; flex-direction: column; gap: 2rem;">
            <!-- .NET Section -->
            <div class="forge-subcard" style="padding: 1.5rem; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.75rem;">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span style="font-size: 1.25rem;">🟣</span>
                        <strong style="font-size: 1.1rem; color: var(--text-primary);">.NET / C# Skills</strong>
                        <span class="forge-badge badge-indigo">dotnet</span>
                    </div>
                    <span class="forge-badge badge-teal">@dotnetSkills.Count skills</span>
                </div>
                @RenderSkillGrid(dotnetSkills)
            </div>

            <!-- Universal Section -->
            <div class="forge-subcard" style="padding: 1.5rem; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.75rem;">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span style="font-size: 1.25rem;">🌐</span>
                        <strong style="font-size: 1.1rem; color: var(--text-primary);">Universal Skills (All Stacks)</strong>
                        <span class="forge-badge badge-teal">universal</span>
                    </div>
                    <span class="forge-badge badge-teal">@universalSkills.Count skills</span>
                </div>
                @RenderSkillGrid(universalSkills)
            </div>

            <!-- Other Stacks Section -->
            @if (otherSkills.Count > 0)
            {
                <div class="forge-subcard" style="padding: 1.5rem; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg);">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.75rem;">
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <span style="font-size: 1.25rem;">🟢</span>
                            <strong style="font-size: 1.1rem; color: var(--text-primary);">Other Language Stacks (Python, Node, Rust, Go)</strong>
                        </div>
                        <span class="forge-badge badge-teal">@otherSkills.Count skills</span>
                    </div>
                    @RenderSkillGrid(otherSkills)
                </div>
            }
        </div>
    }
</div>

@RenderModal()

@code {
    private IReadOnlyList<GlobalSkillViewModel> _skills = Array.Empty<GlobalSkillViewModel>();
    private bool _isLoading = true;

    // Modal state
    private bool _showModal;
    private bool _isEditing;
    private string _modalName = string.Empty;
    private string _modalStack = CodeStack.DotNet;
    private string _modalDescription = string.Empty;
    private string _modalInstructions = string.Empty;
    private string? _modalError;

    protected override async Task OnInitializedAsync()
    {
        await RefreshSkillsAsync();
    }

    private async Task RefreshSkillsAsync()
    {
        _isLoading = true;
        try
        {
            _skills = await SkillsManager.GetGlobalSkillsAsync();
        }
        catch (Exception ex)
        {
            ToastService.Show("Skills Store Error", ex.Message, ToastLevel.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenAddModal()
    {
        _isEditing = false;
        _modalName = string.Empty;
        _modalStack = CodeStack.DotNet;
        _modalDescription = string.Empty;
        _modalInstructions = string.Empty;
        _modalError = null;
        _showModal = true;
    }

    private void OpenEditModal(GlobalSkillViewModel skill)
    {
        if (skill.IsBuiltIn) return;
        _isEditing = true;
        _modalName = skill.Name;
        _modalStack = skill.Stack;
        _modalDescription = skill.Description;
        _modalInstructions = skill.Instructions;
        _modalError = null;
        _showModal = true;
    }

    private async Task SaveSkillAsync()
    {
        _modalError = null;
        if (string.IsNullOrWhiteSpace(_modalName))
        {
            _modalError = "Skill name is required.";
            return;
        }

        try
        {
            if (_isEditing)
            {
                await SkillsManager.UpdateCustomSkillAsync(_modalName, new UpdateSkillRequest(_modalStack, _modalDescription, _modalInstructions));
                ToastService.Show("Skill Updated", $"Updated skill '{_modalName}'.", ToastLevel.Success);
            }
            else
            {
                await SkillsManager.CreateCustomSkillAsync(new CreateSkillRequest(_modalName, _modalStack, _modalDescription, _modalInstructions));
                ToastService.Show("Skill Created", $"Created custom global skill '{_modalName}'.", ToastLevel.Success);
            }
            _showModal = false;
            await RefreshSkillsAsync();
        }
        catch (Exception ex)
        {
            _modalError = ex.Message;
        }
    }

    private async Task DeleteSkillAsync(GlobalSkillViewModel skill)
    {
        if (skill.IsBuiltIn) return;
        try
        {
            await SkillsManager.DeleteCustomSkillAsync(skill.Name);
            ToastService.Show("Skill Deleted", $"Deleted custom global skill '{skill.Name}'.", ToastLevel.Success);
            await RefreshSkillsAsync();
        }
        catch (Exception ex)
        {
            ToastService.Show("Delete Error", ex.Message, ToastLevel.Error);
        }
    }

    private RenderFragment RenderSkillGrid(List<GlobalSkillViewModel> skills) => __builder =>
    {
        if (skills.Count == 0)
        {
            <div style="font-size: 0.85rem; color: var(--text-muted); padding: 1rem 0;">No skills configured for this category.</div>
        }
        else
        {
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1rem;">
                @foreach (var skill in skills)
                {
                    <div style="background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 1.25rem; display: flex; flex-direction: column; justify-content: space-between;">
                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; flex-wrap: wrap; gap: 0.5rem;">
                                <strong style="font-size: 1rem; color: var(--text-primary); font-family: monospace;">@skill.Name</strong>
                                @if (skill.IsBuiltIn)
                                {
                                    <span class="forge-badge badge-teal" style="font-size: 0.75rem;">🛡️ Built-In Tooling</span>
                                }
                                else
                                {
                                    <span class="forge-badge badge-indigo" style="font-size: 0.75rem;">✨ Custom Skill</span>
                                }
                            </div>
                            <p style="font-size: 0.85rem; color: var(--text-secondary); margin: 0 0 0.75rem 0; line-height: 1.4;">
                                @skill.Description
                            </p>
                        </div>
                        <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border-subtle); padding-top: 0.75rem; margin-top: 0.5rem;">
                            <span class="font-mono" style="font-size: 0.72rem; color: var(--text-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 180px;">
                                @skill.FilePath
                            </span>
                            @if (!skill.IsBuiltIn)
                            {
                                <div style="display: flex; gap: 0.5rem;">
                                    <button type="button" class="forge-btn forge-btn-outline" style="font-size: 0.75rem; padding: 0.25rem 0.6rem;" @onclick="() => OpenEditModal(skill)">
                                        ✏️ Edit
                                    </button>
                                    <button type="button" class="forge-btn forge-btn-outline" style="font-size: 0.75rem; padding: 0.25rem 0.6rem; color: var(--accent-red);" @onclick="() => DeleteSkillAsync(skill)">
                                        🗑️ Delete
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    };

    private RenderFragment RenderModal() => __builder =>
    {
        @if (_showModal)
        {
            <div class="forge-modal-backdrop" style="position: fixed; inset: 0; background: rgba(0,0,0,0.6); display: flex; align-items: center; justify-content: center; z-index: 1000; padding: 1rem;">
                <div class="forge-card" style="width: 100%; max-width: 640px; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); padding: 2rem; box-shadow: var(--shadow-lg);">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                        <h3 style="margin: 0; font-size: 1.25rem; font-weight: 700;">@(_isEditing ? "Edit Global Skill" : "Add Custom Global Skill")</h3>
                        <button type="button" class="forge-btn forge-btn-ghost" @onclick="() => _showModal = false">✕</button>
                    </div>

                    @if (!string.IsNullOrEmpty(_modalError))
                    {
                        <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid var(--accent-red); color: var(--accent-red); padding: 0.75rem 1rem; border-radius: var(--radius-sm); margin-bottom: 1rem; font-size: 0.85rem;">
                            @_modalError
                        </div>
                    }

                    <div style="display: flex; flex-direction: column; gap: 1rem;">
                        <div>
                            <label class="forge-field-label">Skill Identifier (Slug)</label>
                            <input type="text" class="forge-input font-mono" style="width: 100%;" @bind="_modalName" disabled="@_isEditing" placeholder="e.g. efcore-assistant" />
                        </div>

                        <div>
                            <label class="forge-field-label">Target Tech Stack</label>
                            <select class="forge-input" style="width: 100%;" @bind="_modalStack">
                                <option value="@CodeStack.DotNet">🟣 .NET / C# (@CodeStack.DotNet)</option>
                                <option value="@CodeStack.Universal">🌐 Universal (all stacks)</option>
                                <option value="@CodeStack.Node">🟢 Node.js / TypeScript (@CodeStack.Node)</option>
                                <option value="@CodeStack.Python">🐍 Python (@CodeStack.Python)</option>
                                <option value="@CodeStack.Rust">🦀 Rust (@CodeStack.Rust)</option>
                                <option value="@CodeStack.Go">🐹 Go (@CodeStack.Go)</option>
                            </select>
                        </div>

                        <div>
                            <label class="forge-field-label">1-2 Sentence Description</label>
                            <input type="text" class="forge-input" style="width: 100%;" @bind="_modalDescription" placeholder="Brief summary displayed in agent skills catalog" />
                        </div>

                        <div>
                            <label class="forge-field-label">Markdown Instructions (SKILL.md)</label>
                            <textarea class="forge-input font-mono" style="width: 100%; height: 180px; resize: vertical;" @bind="_modalInstructions" placeholder="# Instructions..."></textarea>
                        </div>
                    </div>

                    <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 1.5rem;">
                        <button type="button" class="forge-btn forge-btn-outline" @onclick="() => _showModal = false">Cancel</button>
                        <button type="button" class="forge-btn forge-btn-primary" @onclick="SaveSkillAsync">💾 Save Skill</button>
                    </div>
                </div>
            </div>
        }
    };
}


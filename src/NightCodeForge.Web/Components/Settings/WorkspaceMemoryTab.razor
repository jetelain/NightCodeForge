@namespace NightCodeForge.Web.Components.Settings
@using NightCodeForge.Web.Services

<div class="forge-card" id="workspace-memory-settings-tab" style="padding: 1.5rem;">
    <h3 class="mb-2">🧠 Agent Memory</h3>
    <p class="text-secondary">
        Inspect and manage what agents remember for <strong>@WorkspaceName</strong>: local workspace memory (out of Git)
        and committed repository memory (<code>AGENTS.md</code>, <code>.agents/memory/*.md</code>).
    </p>
    <a id="open-memory-page-link"
       class="forge-btn forge-btn-primary"
       href="@MemoryPresentationHelper.BuildMemoryPageUrl(WorkspaceId)">
        Open Agent Memory
    </a>
</div>

@code {
    [Parameter, EditorRequired] public int WorkspaceId { get; set; }
    [Parameter] public string? WorkspaceName { get; set; }
}

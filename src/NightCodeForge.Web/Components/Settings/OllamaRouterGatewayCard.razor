@namespace NightCodeForge.Web.Components.Settings
@using Microsoft.Extensions.Options
@using NightCodeForge.Agents.Inference
@using NightCodeForge.Core.Domain
@using NightCodeForge.Core.Interfaces
@using NightCodeForge.Infrastructure.Configuration
@using NightCodeForge.Web.Services
@inject ILlmGatewayService GatewayService
@inject ILlmModelCatalogService ModelCatalogService
@inject ILlmConfigurationWriter ConfigurationWriter
@inject IOptions<LlmProviderOptions> LlmOptions
@inject ToastService ToastService

<div class="forge-card mt-3" style="padding: 2rem;">
    <!-- Header -->
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem; flex-wrap: wrap; gap: 1.5rem;">
        <div>
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.35rem; flex-wrap: wrap;">
                <span style="font-size: 1.75rem;">@(_selectedProvider == LlmProviderType.OpenAiCompatible ? "🌐" : "🦙")</span>
                <h3 style="font-weight: 700; font-size: 1.35rem; margin: 0; color: var(--text-primary);">
                    @GetHeaderTitle()
                </h3>
                @if (_status != null)
                {
                    <span class="forge-badge @(_status.IsConnected ? "badge-teal" : "badge-gray")" style="padding: 0.3rem 0.75rem; font-size: 0.82rem;">
                        @(_status.IsConnected ? "🟢 Gateway Connected" : "🔴 Gateway Offline")
                    </span>
                    <span class="forge-badge @GetProviderBadgeClass()" style="padding: 0.3rem 0.75rem; font-size: 0.82rem;">
                        @GetActiveProviderBadgeText()
                    </span>
                }
            </div>
            <p style="margin: 0; font-size: 0.92rem; color: var(--text-secondary); line-height: 1.6; max-width: 820px;">
                @GetHeaderDescription()
            </p>
        </div>
        <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
            @if (_selectedProvider == LlmProviderType.OllamaRouter && _status?.ProviderType == LlmProviderType.OllamaRouter)
            {
                <a href="@GetRouterMonitorUrl()" target="_blank" class="forge-btn forge-btn-outline" style="padding: 0.65rem 1.25rem; font-size: 0.92rem;">
                    ↗ Open Router Monitor
                </a>
            }
            <button type="button" class="forge-btn forge-btn-outline" style="padding: 0.65rem 1.25rem; font-size: 0.92rem;" @onclick="RefreshAsync" disabled="@_isLoading">
                @(_isLoading ? "Refreshing..." : "🔄 Refresh")
            </button>
            @if (_selectedProvider != LlmProviderType.OpenAiCompatible)
            {
                <button type="button" class="forge-btn forge-btn-primary" style="padding: 0.65rem 1.4rem; font-size: 0.92rem; font-weight: 600;" @onclick="ReclaimVramAsync" disabled="@_isReclaiming">
                    @(_isReclaiming ? "Reclaiming VRAM..." : "🧹 Reclaim GPU VRAM")
                </button>
            }
        </div>
    </div>

    <!-- Provider Selection Strip -->
    <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); padding: 1.25rem 1.5rem; margin-bottom: 2rem;">
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
            <div style="display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap;" class="provider-radio-group">
                <strong style="font-size: 0.95rem; color: var(--text-primary);">LLM Provider Selection:</strong>
                <label style="display: inline-flex; align-items: center; gap: 0.4rem; cursor: pointer; font-size: 0.9rem;">
                    <input type="radio" name="providerOption" checked="@(_selectedProvider == LlmProviderType.Ollama)" @onchange="() => OnProviderSelectionChanged(LlmProviderType.Ollama)" />
                    <span>Standalone Ollama</span>
                </label>
                <label style="display: inline-flex; align-items: center; gap: 0.4rem; cursor: pointer; font-size: 0.9rem;">
                    <input type="radio" name="providerOption" checked="@(_selectedProvider == LlmProviderType.OllamaRouter)" @onchange="() => OnProviderSelectionChanged(LlmProviderType.OllamaRouter)" />
                    <span>OllamaRouter</span>
                </label>
                <label style="display: inline-flex; align-items: center; gap: 0.4rem; cursor: pointer; font-size: 0.9rem;">
                    <input type="radio" name="providerOption" checked="@(_selectedProvider == LlmProviderType.OpenAiCompatible)" @onchange="() => OnProviderSelectionChanged(LlmProviderType.OpenAiCompatible)" />
                    <span>OpenAI Compatible</span>
                </label>
            </div>
            @if (_selectedProvider != GatewayService.ProviderType)
            {
                <span class="forge-badge badge-amber" style="font-size: 0.78rem;">
                    ⚠️ Restart required after saving to activate @_selectedProvider
                </span>
            }
        </div>
    </div>

    <!-- Provider Content Section -->
    @if (_selectedProvider == LlmProviderType.OpenAiCompatible)
    {
        <!-- OpenAI Compatible Endpoint & Credentials Card -->
        <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); padding: 1.5rem; margin-bottom: 2rem;">
            <h4 style="font-size: 1.1rem; font-weight: 700; margin: 0 0 1.25rem 0; color: var(--text-primary);">
                🌐 OpenAI-Compatible Endpoint &amp; Credentials
            </h4>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; margin-bottom: 1.25rem;">
                <div>
                    <label class="forge-field-label">Endpoint URL *</label>
                    <input type="text" id="openai-endpoint-input" class="forge-input font-mono" style="width: 100%;" @bind="_openAiEndpoint" placeholder="https://api.openai.com/v1" />
                    <span class="field-hint" style="display: block; font-size: 0.75rem; color: var(--text-muted); margin-top: 0.35rem;">
                        Base completions URL (e.g. https://openrouter.ai/api/v1, http://localhost:1234/v1).
                    </span>
                </div>
                <div>
                    <label class="forge-field-label">API Key</label>
                    <div style="display: flex; gap: 0.5rem;">
                        <input type="@(_showApiKey ? "text" : "password")" id="openai-apikey-input" class="forge-input font-mono" style="flex: 1;" @bind="_openAiApiKey" placeholder="sk-... (leave empty for local runtimes)" />
                        <button type="button" class="forge-btn forge-btn-outline" style="padding: 0.5rem 0.85rem;" @onclick="() => _showApiKey = !_showApiKey">
                            @(_showApiKey ? "🔒 Hide" : "👁️ Show")
                        </button>
                    </div>
                    <span class="field-hint" style="display: block; font-size: 0.75rem; color: var(--text-muted); margin-top: 0.35rem;">
                        Optional for local unauthenticated runtimes (LM Studio, local vLLM).
                    </span>
                </div>
                <div>
                    <label class="forge-field-label">Organization ID (Optional)</label>
                    <input type="text" id="openai-orgid-input" class="forge-input font-mono" style="width: 100%;" @bind="_openAiOrgId" placeholder="e.g. org-..." />
                    <span class="field-hint" style="display: block; font-size: 0.75rem; color: var(--text-muted); margin-top: 0.35rem;">
                        Transmitted in the OpenAI-Organization request header.
                    </span>
                </div>
            </div>

            <!-- Dynamic Discovery Status Strip -->
            <div style="margin-top: 1rem; margin-bottom: 1rem;">
                @if (_isVerifying)
                {
                    <div class="forge-alert forge-alert-indigo" style="display: flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1rem;">
                        <span class="status-dot waiting"></span>
                        <span>Probing /api/v1/models and discovering available models...</span>
                    </div>
                }
                else if (_verificationResult != null)
                {
                    @if (_verificationResult.IsSuccess && _verificationResult.IsDiscoveryImplemented)
                    {
                        @if (_verificationResult.DiscoveredCount > 0)
                        {
                            <div id="discovery-status-badge" class="forge-alert forge-alert-teal" style="display: flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1rem;">
                                <span>✓</span>
                                <span>Probed /api/v1/models: @_verificationResult.DiscoveredCount models discovered automatically</span>
                            </div>
                        }
                        else
                        {
                            <div id="discovery-status-badge" class="forge-alert forge-alert-amber" style="display: flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1rem;">
                                <span>⚠️</span>
                                <span>@(_verificationResult.WarningMessage ?? "Probed /api/v1/models: 0 models returned by endpoint.")</span>
                            </div>
                        }
                    }
                    else if (IsDiscoveryNotImplemented(_verificationResult))
                    {
                        <div id="discovery-status-badge" class="forge-alert forge-alert-amber" style="display: flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1rem;">
                            <span>⚠️</span>
                            <span>/api/v1/models not implemented (HTTP 404/501). Manual model configuration required.</span>
                        </div>
                    }
                    else
                    {
                        <div id="discovery-status-badge" class="forge-alert forge-alert-crimson" style="display: flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1rem;">
                            <span>❌</span>
                            <span>Connection or probe failed: @(_verificationResult.ErrorMessage ?? _verificationResult.WarningMessage)</span>
                        </div>
                    }
                }
            </div>

            <!-- Model Selection & Role Differentiation -->
            <div style="border-top: 1px solid var(--border-subtle); padding-top: 1.25rem; margin-top: 1.25rem;">
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; margin-bottom: 1rem;">
                    <div>
                        <label class="forge-field-label">Default Model</label>
                        @if (_availableModels.Count > 0)
                        {
                            <select id="select-default-model" class="forge-input font-mono" style="width: 100%;" @bind="_defaultModelId">
                                <option value="">Auto-select (Strategy-based: lowest prompt cost)</option>
                                @if (!string.IsNullOrWhiteSpace(_defaultModelId) && !_availableModels.Any(m => string.Equals(m.ModelId, _defaultModelId, StringComparison.OrdinalIgnoreCase)))
                                {
                                    <option value="@_defaultModelId">@_defaultModelId (Configured)</option>
                                }
                                @foreach (var m in _availableModels)
                                {
                                    <option value="@m.ModelId">@m.DisplayName @(!string.IsNullOrWhiteSpace(m.FormattedBadge) ? $"({m.FormattedBadge})" : "")</option>
                                }
                            </select>
                        }
                        else if (_allowedModels.Count > 0)
                        {
                            <select id="select-default-model" class="forge-input font-mono" style="width: 100%;" @bind="_defaultModelId">
                                <option value="">Auto-select (Strategy-based: lowest prompt cost)</option>
                                @if (!string.IsNullOrWhiteSpace(_defaultModelId) && !_allowedModels.Any(m => string.Equals(m.ModelId, _defaultModelId, StringComparison.OrdinalIgnoreCase)))
                                {
                                    <option value="@_defaultModelId">@_defaultModelId (Configured)</option>
                                }
                                @foreach (var m in _allowedModels)
                                {
                                    <option value="@m.ModelId">@(string.IsNullOrWhiteSpace(m.DisplayName) ? m.ModelId : m.DisplayName) (@m.ContextWindowTokens.ToString("N0") tokens)</option>
                                }
                            </select>
                        }
                        else
                        {
                            <input type="text" id="select-default-model" class="forge-input font-mono" style="width: 100%;" @bind="_defaultModelId" placeholder="e.g. deepseek-chat" />
                        }
                        <span class="field-hint" style="display: block; font-size: 0.75rem; color: var(--text-muted); margin-top: 0.35rem;">
                            Primary model used across stages when not explicitly overridden.
                        </span>
                    </div>

                    <div>
                        <label class="forge-field-label">Role Differentiation</label>
                        <div style="padding-top: 0.5rem;">
                            <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.88rem; color: var(--text-primary); cursor: pointer;">
                                <input type="checkbox" id="chk-differentiate-roles" @bind="_differentiateRoles" />
                                <span>Differentiate Implementation &amp; Review Roles</span>
                            </label>
                        </div>
                    </div>
                </div>

                @if (_differentiateRoles)
                {
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; margin-top: 1rem; padding: 1rem; background: var(--bg-input); border-radius: var(--radius-md);">
                        <div>
                            <label class="forge-field-label">Coder Model</label>
                            @if (_availableModels.Count > 0)
                            {
                                <select id="select-coder-model" class="forge-input font-mono" style="width: 100%;" @bind="_coderModelId">
                                    <option value="">Inherit Default Model</option>
                                    @if (!string.IsNullOrWhiteSpace(_coderModelId) && !_availableModels.Any(m => string.Equals(m.ModelId, _coderModelId, StringComparison.OrdinalIgnoreCase)))
                                    {
                                        <option value="@_coderModelId">@_coderModelId (Configured)</option>
                                    }
                                    @foreach (var m in _availableModels)
                                    {
                                        <option value="@m.ModelId">@m.DisplayName @(!string.IsNullOrWhiteSpace(m.FormattedBadge) ? $"({m.FormattedBadge})" : "")</option>
                                    }
                                </select>
                            }
                            else if (_allowedModels.Count > 0)
                            {
                                <select id="select-coder-model" class="forge-input font-mono" style="width: 100%;" @bind="_coderModelId">
                                    <option value="">Inherit Default Model</option>
                                    @if (!string.IsNullOrWhiteSpace(_coderModelId) && !_allowedModels.Any(m => string.Equals(m.ModelId, _coderModelId, StringComparison.OrdinalIgnoreCase)))
                                    {
                                        <option value="@_coderModelId">@_coderModelId (Configured)</option>
                                    }
                                    @foreach (var m in _allowedModels)
                                    {
                                        <option value="@m.ModelId">@(string.IsNullOrWhiteSpace(m.DisplayName) ? m.ModelId : m.DisplayName) (@m.ContextWindowTokens.ToString("N0") tokens)</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <input type="text" id="select-coder-model" class="forge-input font-mono" style="width: 100%;" @bind="_coderModelId" placeholder="Inherit Default" />
                            }
                        </div>
                        <div>
                            <label class="forge-field-label">Architect Model</label>
                            @if (_availableModels.Count > 0)
                            {
                                <select id="select-architect-model" class="forge-input font-mono" style="width: 100%;" @bind="_architectModelId">
                                    <option value="">Inherit Default Model</option>
                                    @if (!string.IsNullOrWhiteSpace(_architectModelId) && !_availableModels.Any(m => string.Equals(m.ModelId, _architectModelId, StringComparison.OrdinalIgnoreCase)))
                                    {
                                        <option value="@_architectModelId">@_architectModelId (Configured)</option>
                                    }
                                    @foreach (var m in _availableModels)
                                    {
                                        <option value="@m.ModelId">@m.DisplayName @(!string.IsNullOrWhiteSpace(m.FormattedBadge) ? $"({m.FormattedBadge})" : "")</option>
                                    }
                                </select>
                            }
                            else if (_allowedModels.Count > 0)
                            {
                                <select id="select-architect-model" class="forge-input font-mono" style="width: 100%;" @bind="_architectModelId">
                                    <option value="">Inherit Default Model</option>
                                    @if (!string.IsNullOrWhiteSpace(_architectModelId) && !_allowedModels.Any(m => string.Equals(m.ModelId, _architectModelId, StringComparison.OrdinalIgnoreCase)))
                                    {
                                        <option value="@_architectModelId">@_architectModelId (Configured)</option>
                                    }
                                    @foreach (var m in _allowedModels)
                                    {
                                        <option value="@m.ModelId">@(string.IsNullOrWhiteSpace(m.DisplayName) ? m.ModelId : m.DisplayName) (@m.ContextWindowTokens.ToString("N0") tokens)</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <input type="text" id="select-architect-model" class="forge-input font-mono" style="width: 100%;" @bind="_architectModelId" placeholder="Inherit Default" />
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Allowed Models Table -->
            @if (IsDiscoveryNotImplemented(_verificationResult))
            {
                <div style="margin-top: 1.5rem;">
                    <AllowedModelsTable Models="_allowedModels" IsMandatory="true" ModelsChanged="OnAllowedModelsChanged" />
                </div>
            }
            else
            {
                <details style="margin-top: 1.5rem; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 1rem 1.25rem;">
                    <summary style="font-weight: 600; font-size: 0.92rem; color: var(--text-primary); cursor: pointer;">
                        Custom Model Overrides &amp; Explicit Restrictions (Optional - Click to expand)
                    </summary>
                    <AllowedModelsTable Models="_allowedModels" IsMandatory="false" ModelsChanged="OnAllowedModelsChanged" />
                </details>
            }

            <!-- Action buttons for OpenAI Provider -->
            <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 1.5rem; border-top: 1px solid var(--border-subtle); padding-top: 1.25rem;">
                <button type="button" id="btn-test-connection" class="forge-btn forge-btn-outline" style="padding: 0.65rem 1.25rem; font-size: 0.92rem;" @onclick="TestConnectionAsync" disabled="@_isVerifying">
                    @(_isVerifying ? "Verifying..." : "🔌 Test Connection & Verify Models")
                </button>
                <button type="button" id="btn-save-settings" class="forge-btn forge-btn-primary" style="padding: 0.65rem 1.4rem; font-size: 0.92rem; font-weight: 600;" @onclick="SaveSettingsAsync" disabled="@_isSaving">
                    @(_isSaving ? "Saving..." : "💾 Save Settings")
                </button>
            </div>
        </div>
    }
    else
    {
        <!-- Dual-Compute Topology Callout (Router mode only) -->
        @if (_selectedProvider == LlmProviderType.OllamaRouter)
        {
            <div style="padding: 1.25rem 1.5rem; border-radius: var(--radius-lg); background: rgba(59, 130, 246, 0.08); border: 1px solid rgba(59, 130, 246, 0.25); display: flex; align-items: flex-start; gap: 1rem; margin-bottom: 2rem;">
                <span style="font-size: 1.5rem; line-height: 1;">💡</span>
                <div style="font-size: 0.9rem; color: var(--text-secondary); line-height: 1.6;">
                    <strong style="color: var(--text-primary);">Fleet Architecture:</strong> Both <strong>Host GPU</strong> (Desktop) and <strong>Dedicated LAN Server</strong> (Remote) are 100% on-premise private resources. OllamaRouter dynamically routes heavy dev-queue tasks to high-capacity nodes, preserving local GPU for interactive <strong>Ideation Chat</strong> without queue contention.
                </div>
            </div>
        }

        <!-- Target Backends Status -->
        <div style="margin-bottom: 2rem;">
            <label style="display: block; font-size: 0.82rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin-bottom: 0.85rem;">
                @(_selectedProvider == LlmProviderType.OllamaRouter ? "Fleet Routing Endpoints & Hardware Topology" : "Host Inference Backend & Health")
            </label>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.25rem;">
                @if (_status?.FleetTargets != null && _status.FleetTargets.Count > 0)
                {
                    @foreach (var target in _status.FleetTargets)
                    {
                        <div class="forge-subcard" style="padding: 1.5rem; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); box-shadow: var(--shadow-sm);">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                                <strong style="font-size: 1.05rem; color: var(--text-primary); font-weight: 700;">@target.Name</strong>
                                <div style="display: flex; align-items: center; gap: 0.5rem;">
                                    @if (target.LatencyMs.HasValue)
                                    {
                                        <span class="font-mono" style="font-size: 0.8rem; color: var(--accent-teal); font-weight: 600;">@target.LatencyMs.Value ms</span>
                                    }
                                    <span class="forge-badge @OperationsTelemetryUiService.GetTargetBackendBadgeClass(target.State)" style="padding: 0.25rem 0.65rem; font-size: 0.8rem;">
                                        @target.State
                                    </span>
                                </div>
                            </div>
                            <div style="font-size: 0.85rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 0.5rem;">
                                @if (!string.IsNullOrWhiteSpace(target.Hardware?.HardwareHint))
                                {
                                    <span class="forge-badge badge-indigo" style="font-size: 0.75rem; margin-right: 0.35rem;">@target.Hardware.HardwareHint</span>
                                }
                                <span>@(target.Hardware?.GpuVendor ?? "Host")</span>
                                @if (target.Hardware?.MaxVramMB.HasValue == true)
                                {
                                    <span> • @(target.Hardware.MaxVramMB.Value / 1024) GB VRAM</span>
                                }
                            </div>
                            <div style="font-size: 0.8rem; color: var(--text-muted); display: flex; justify-content: space-between;">
                                <span>Active: @(target.Execution?.ActiveModel ?? "Idle")</span>
                                <span>@(target.Execution?.ContextAllocation ?? "Dynamic")</span>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div style="padding: 2.5rem; text-align: center; color: var(--text-muted); background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); grid-column: 1 / -1; font-size: 0.95rem;">
                        Querying gateway targets...
                    </div>
                }
            </div>
        </div>

        <!-- Resident VRAM Models Table (/api/ps) -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: gap: 0.5rem;">
            <h4 style="font-size: 1.15rem; font-weight: 700; margin: 0; color: var(--text-primary);">Resident Models in GPU Memory (/api/ps)</h4>
            <span class="forge-badge badge-indigo" style="font-size: 0.85rem; padding: 0.3rem 0.75rem;">
                @(_residentModels.Count == 1 ? "1 model resident in VRAM" : $"{_residentModels.Count} models resident in VRAM")
            </span>
        </div>

        <div style="border-radius: var(--radius-lg); border: 1px solid var(--border-subtle); overflow: hidden; background: var(--bg-surface); margin-bottom: 1.5rem;">
            <table class="font-mono" style="width: 100%; border-collapse: collapse; font-size: 0.92rem;">
                <thead>
                    <tr style="border-bottom: 1px solid var(--border-subtle); background: var(--bg-input);">
                        <th style="padding: 1rem 1.25rem; text-align: left; font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">Model</th>
                        <th style="padding: 1rem 1.25rem; text-align: left; font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">VRAM Footprint</th>
                        <th style="padding: 1rem 1.25rem; text-align: left; font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">Total Size</th>
                        <th style="padding: 1rem 1.25rem; text-align: left; font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted);">Expires At</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_residentModels.Count == 0)
                    {
                        <tr>
                            <td colspan="4" style="padding: 3rem 1.5rem; text-align: center; color: var(--text-muted); font-size: 0.95rem;">
                                @(_status?.IsConnected == true ? "No models currently resident in GPU VRAM." : "Gateway unreachable at " + (_status?.BaseUrl ?? "configured endpoint"))
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var rm in _residentModels)
                        {
                            <tr style="border-bottom: 1px solid var(--border-subtle);">
                                <td style="padding: 1.15rem 1.25rem; color: var(--text-primary); font-weight: 600;">@rm.Name</td>
                                <td style="padding: 1.15rem 1.25rem; color: var(--accent-teal); font-weight: 700;">@rm.SizeVramFormatted</td>
                                <td style="padding: 1.15rem 1.25rem; color: var(--text-secondary);">@rm.SizeTotalFormatted</td>
                                <td style="padding: 1.15rem 1.25rem; color: var(--text-muted);">@rm.ExpiresAtFormatted</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Ollama Endpoint Settings & Save -->
        <div style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); padding: 1.5rem;">
            <h4 style="font-size: 1.05rem; font-weight: 700; margin: 0 0 1rem 0; color: var(--text-primary);">
                ⚙️ Provider Endpoint &amp; Model Selection
            </h4>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem; margin-bottom: 1.25rem;">
                <div>
                    <label class="forge-field-label">Endpoint URL</label>
                    <input type="text" class="forge-input font-mono" style="width: 100%;" @bind="_ollamaEndpoint" placeholder="http://localhost:11434" />
                </div>
                <div>
                    <label class="forge-field-label">Default Model</label>
                    @if (_availableModels.Count > 0)
                    {
                        <select class="forge-input font-mono" style="width: 100%;" @bind="_defaultModelId">
                            <option value="">Auto-select (Most capable: largest context)</option>
                            @if (!string.IsNullOrWhiteSpace(_defaultModelId) && !_availableModels.Any(m => string.Equals(m.ModelId, _defaultModelId, StringComparison.OrdinalIgnoreCase)))
                            {
                                <option value="@_defaultModelId">@_defaultModelId (Configured)</option>
                            }
                            @foreach (var m in _availableModels)
                            {
                                <option value="@m.ModelId">@m.DisplayName @(!string.IsNullOrWhiteSpace(m.FormattedBadge) ? $"({m.FormattedBadge})" : "")</option>
                            }
                        </select>
                    }
                    else
                    {
                        <input type="text" class="forge-input font-mono" style="width: 100%;" @bind="_defaultModelId" placeholder="e.g. qwen2.5-coder:32b" />
                    }
                </div>
            </div>
            <div style="display: flex; justify-content: flex-end; gap: 0.75rem;">
                <button type="button" class="forge-btn forge-btn-primary" style="padding: 0.65rem 1.4rem; font-size: 0.92rem; font-weight: 600;" @onclick="SaveSettingsAsync" disabled="@_isSaving">
                    @(_isSaving ? "Saving..." : "💾 Save Settings")
                </button>
            </div>
        </div>
    }
</div>

@code {
    private GatewayStatusReport? _status;
    private List<ResidentModelInfo> _residentModels = new();
    private List<AvailableModelInfo> _availableModels = new();
    private List<OpenAiAllowedModel> _allowedModels = [];
    private EndpointVerificationResult? _verificationResult;

    private LlmProviderType _selectedProvider;
    private string _ollamaEndpoint = "http://localhost:11434";
    private string _openAiEndpoint = "https://api.openai.com/v1";
    private string _openAiApiKey = "";
    private string _openAiOrgId = "";
    private string _defaultModelId = "";
    private bool _differentiateRoles;
    private string _coderModelId = "";
    private string _architectModelId = "";

    private bool _isLoading;
    private bool _isReclaiming;
    private bool _isVerifying;
    private bool _isSaving;
    private bool _showApiKey;

    protected override async Task OnInitializedAsync()
    {
        var opts = LlmOptions.Value;
        _selectedProvider = opts.ProviderType;
        _ollamaEndpoint = !string.IsNullOrWhiteSpace(opts.Endpoint) ? opts.Endpoint : "http://localhost:11434";
        _openAiEndpoint = !string.IsNullOrWhiteSpace(opts.OpenAiCompatible?.Endpoint) ? opts.OpenAiCompatible.Endpoint : "https://api.openai.com/v1";
        _openAiApiKey = opts.OpenAiCompatible?.ApiKey ?? "";
        _openAiOrgId = opts.OpenAiCompatible?.OrganizationId ?? "";
        _defaultModelId = opts.DefaultModelId ?? "";
        _coderModelId = opts.CoderModelId ?? "";
        _architectModelId = opts.ArchitectModelId ?? "";
        _differentiateRoles = !string.IsNullOrWhiteSpace(_coderModelId) || !string.IsNullOrWhiteSpace(_architectModelId);

        _allowedModels = opts.OpenAiCompatible?.AllowedModels?
            .Select(m => new OpenAiAllowedModel
            {
                ModelId = m.ModelId,
                DisplayName = m.DisplayName,
                ContextWindowTokens = m.ContextWindowTokens,
                MaxOutputTokens = m.MaxOutputTokens,
                SupportsReasoning = m.SupportsReasoning,
                DefaultThinkingEffort = m.DefaultThinkingEffort,
                PromptCostPerMillion = m.PromptCostPerMillion,
                CompletionCostPerMillion = m.CompletionCostPerMillion
            }).ToList() ?? [];

        await RefreshAsync();

        if (_selectedProvider == LlmProviderType.OpenAiCompatible && _verificationResult == null)
        {
            await TestConnectionAsync();
        }
    }

    private string GetHeaderTitle()
    {
        return _selectedProvider switch
        {
            LlmProviderType.OpenAiCompatible => "OpenAI Compatible Gateway & Models",
            LlmProviderType.Ollama => "Standalone Ollama Gateway & VRAM Inspector",
            _ => "OllamaRouter Gateway & VRAM Inspector"
        };
    }

    private string GetHeaderDescription()
    {
        return _selectedProvider switch
        {
            LlmProviderType.OpenAiCompatible =>
                "Remote OpenAI-compatible completions endpoint, dynamic model discovery (/api/v1/models), context window limits, and credentials.",
            LlmProviderType.OllamaRouter =>
                "Multi-node reverse proxy gateway status, target fleet backends, resident GPU models, and non-destructive memory release.",
            _ =>
                "Direct standalone Ollama host connection, local resident GPU models, and instant VRAM memory release."
        };
    }

    private string GetProviderBadgeClass()
    {
        return _status?.ProviderType switch
        {
            LlmProviderType.OpenAiCompatible => "badge-teal",
            LlmProviderType.OllamaRouter => "badge-indigo",
            _ => "badge-teal"
        };
    }

    private string GetActiveProviderBadgeText()
    {
        return _status?.ProviderType switch
        {
            LlmProviderType.OpenAiCompatible => "OpenAI Compatible Active",
            LlmProviderType.OllamaRouter => "OllamaRouter Fleet Active",
            _ => "Standalone Ollama Active"
        };
    }

    private static bool IsDiscoveryNotImplemented(EndpointVerificationResult? result)
    {
        if (result == null) return false;
        if (result.IsSuccess && !result.IsDiscoveryImplemented) return true;
        if (!result.IsDiscoveryImplemented &&
            (result.ErrorMessage?.Contains("404") == true ||
             result.ErrorMessage?.Contains("501") == true ||
             result.ErrorMessage?.Contains("not implement", StringComparison.OrdinalIgnoreCase) == true))
        {
            return true;
        }
        return false;
    }

    private void OnProviderSelectionChanged(LlmProviderType provider)
    {
        _selectedProvider = provider;
        if (_selectedProvider == GatewayService.ProviderType)
        {
            _ = RefreshAsync();
        }
        else if (_selectedProvider == LlmProviderType.OpenAiCompatible)
        {
            _residentModels.Clear();
            if (_verificationResult?.VerifiedModels != null && _verificationResult.VerifiedModels.Count > 0)
            {
                _availableModels = _verificationResult.VerifiedModels.ToList();
            }
            else
            {
                _availableModels.Clear();
            }
        }
        else
        {
            _availableModels.Clear();
            _residentModels.Clear();
        }
    }

    private void OnAllowedModelsChanged(List<OpenAiAllowedModel> models)
    {
        _allowedModels = models;
    }

    private string GetRouterMonitorUrl()
    {
        var baseUrl = _status?.BaseUrl;
        return string.IsNullOrWhiteSpace(baseUrl) ? "/monitor" : $"{baseUrl.TrimEnd('/')}/monitor";
    }

    public async Task RefreshAsync()
    {
        _isLoading = true;
        try
        {
            _status = await GatewayService.GetGatewayStatusAsync();
            if (_selectedProvider != LlmProviderType.OpenAiCompatible && GatewayService.ProviderType != LlmProviderType.OpenAiCompatible)
            {
                var models = await GatewayService.GetResidentModelsAsync();
                _residentModels = models.ToList();
            }
            else
            {
                _residentModels.Clear();
            }

            if (_selectedProvider == GatewayService.ProviderType)
            {
                var available = await ModelCatalogService.GetAvailableModelsAsync();
                _availableModels = available.ToList();
            }
            else if (_selectedProvider == LlmProviderType.OpenAiCompatible)
            {
                if (_verificationResult?.VerifiedModels != null && _verificationResult.VerifiedModels.Count > 0)
                {
                    _availableModels = _verificationResult.VerifiedModels.ToList();
                }
                else
                {
                    _availableModels.Clear();
                }
            }
            else
            {
                _availableModels.Clear();
            }
        }
        catch (Exception ex)
        {
            ToastService.Show("Gateway Query Error", ex.Message, ToastLevel.Warning);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ReclaimVramAsync()
    {
        _isReclaiming = true;
        try
        {
            var success = await GatewayService.ReclaimVramAsync();
            if (success)
            {
                var providerName = _status?.ProviderType == NightCodeForge.Core.Domain.LlmProviderType.OllamaRouter ? "OllamaRouter" : "Ollama";
                ToastService.Show("VRAM Reclaim Triggered", $"Sent non-destructive memory reclaim command to {providerName}.", ToastLevel.Success);
            }
            else
            {
                ToastService.Show("VRAM Reclaim Notice", "Reclaim request completed (no active resident models to free or endpoint not reachable).", ToastLevel.Info);
            }
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            ToastService.Show("VRAM Reclaim Error", ex.Message, ToastLevel.Error);
        }
        finally
        {
            _isReclaiming = false;
        }
    }

    private async Task TestConnectionAsync()
    {
        _isVerifying = true;
        try
        {
            _verificationResult = await ModelCatalogService.VerifyEndpointAsync();
            if (_verificationResult.VerifiedModels != null && _verificationResult.VerifiedModels.Count > 0)
            {
                _availableModels = _verificationResult.VerifiedModels.ToList();
            }

            if (_verificationResult.IsSuccess)
            {
                ToastService.Show("Endpoint Verified", 
                    _verificationResult.IsDiscoveryImplemented 
                        ? $"Successfully discovered {_verificationResult.DiscoveredCount} models from endpoint."
                        : "Endpoint reachable. Manual model configuration is active.", 
                    ToastLevel.Success);
            }
            else
            {
                ToastService.Show("Verification Issue", _verificationResult.ErrorMessage ?? "Could not discover models from endpoint.", ToastLevel.Warning);
            }
        }
        catch (Exception ex)
        {
            _verificationResult = new EndpointVerificationResult(false, false, 0, null, ErrorMessage: ex.Message);
            ToastService.Show("Verification Error", ex.Message, ToastLevel.Error);
        }
        finally
        {
            _isVerifying = false;
        }
    }

    private async Task SaveSettingsAsync()
    {
        _isSaving = true;
        try
        {
            await ConfigurationWriter.SaveProviderConfigurationAsync(opts =>
            {
                opts.ProviderType = _selectedProvider;
                if (_selectedProvider == LlmProviderType.OpenAiCompatible)
                {
                    opts.OpenAiCompatible ??= new();
                    opts.OpenAiCompatible.Endpoint = _openAiEndpoint;
                    opts.OpenAiCompatible.ApiKey = string.IsNullOrWhiteSpace(_openAiApiKey) ? null : _openAiApiKey;
                    opts.OpenAiCompatible.OrganizationId = string.IsNullOrWhiteSpace(_openAiOrgId) ? null : _openAiOrgId;
                    opts.OpenAiCompatible.AllowedModels = _allowedModels;
                }
                else
                {
                    opts.Endpoint = _ollamaEndpoint;
                }

                opts.DefaultModelId = string.IsNullOrWhiteSpace(_defaultModelId) ? null : _defaultModelId;
                if (_selectedProvider == LlmProviderType.OpenAiCompatible)
                {
                    if (_differentiateRoles)
                    {
                        opts.CoderModelId = string.IsNullOrWhiteSpace(_coderModelId) ? null : _coderModelId;
                        opts.ArchitectModelId = string.IsNullOrWhiteSpace(_architectModelId) ? null : _architectModelId;
                    }
                    else
                    {
                        opts.CoderModelId = null;
                        opts.ArchitectModelId = null;
                    }
                }
            });

            if (_selectedProvider == LlmProviderType.OpenAiCompatible)
            {
                await ConfigurationWriter.SaveAllowedModelsAsync(_allowedModels);
            }

            if (_selectedProvider != GatewayService.ProviderType)
            {
                ToastService.Show("Settings Saved", "LLM settings saved to config/config.json. Please restart NightCodeForge to activate the new provider.", ToastLevel.Warning);
            }
            else
            {
                ToastService.Show("Settings Saved", "LLM provider settings successfully saved to config/config.json.", ToastLevel.Success);
            }
        }
        catch (Exception ex)
        {
            ToastService.Show("Error Saving Settings", ex.Message, ToastLevel.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }
}

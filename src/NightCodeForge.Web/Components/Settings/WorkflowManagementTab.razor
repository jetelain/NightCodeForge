@namespace NightCodeForge.Web.Components.Settings
@using System.Text.Json
@using NightCodeForge.Core.Domain
@using NightCodeForge.Core.Repositories
@using NightCodeForge.Core.Workflow.Configuration
@using NightCodeForge.Web.Services
@inject IWorkflowRepository WorkflowRepository
@inject ToastService ToastService
@inject WorkspaceStateService WorkspaceState

<div class="forge-card mt-3" style="padding: 2rem;">
    <!-- Header with Action Controls -->
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem; flex-wrap: wrap; gap: 1.5rem;">
        <div>
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.35rem;">
                <span style="font-size: 1.75rem;">🔀</span>
                <h3 style="margin: 0; font-weight: 700; font-size: 1.35rem; color: var(--text-primary);">
                    Workflows &amp; Execution Stages
                </h3>
                @if (WorkspaceId.HasValue)
                {
                    <span class="forge-badge badge-indigo" style="padding: 0.3rem 0.75rem; font-size: 0.82rem;">
                        @(WorkspaceName ?? "Workspace Scoped")
                    </span>
                }
                else
                {
                    <span class="forge-badge badge-teal" style="padding: 0.3rem 0.75rem; font-size: 0.82rem;">
                        Global Pipelines
                    </span>
                }
            </div>
            <p style="margin: 0; font-size: 0.92rem; color: var(--text-secondary); line-height: 1.6; max-width: 820px;">
                Inspect autonomous agent pipelines, deterministic gate sequences, and stage parameters. Clone templates to create workspace-specific execution pipelines.
            </p>
        </div>

        <div style="display: flex; gap: 0.75rem; align-items: center;">
            <button type="button" class="forge-btn forge-btn-secondary" style="padding: 0.65rem 1.25rem; font-size: 0.92rem; font-weight: 600;" @onclick="LoadWorkflowsAsync" disabled="@_isLoading">
                🔄 Refresh
            </button>
        </div>
    </div>

    @if (_isLoading)
    {
        <div style="text-align: center; padding: 4rem 0; color: var(--text-muted);">
            <div style="font-size: 2rem; margin-bottom: 0.5rem;">⏳</div>
            <span>Loading workflows and stage configurations...</span>
        </div>
    }
    else if (!_workflows.Any())
    {
        <div style="text-align: center; padding: 3rem 0; color: var(--text-muted); background: var(--bg-surface); border-radius: var(--radius-md);">
            <span style="font-size: 2rem; display: block; margin-bottom: 0.5rem;">🔀</span>
            <span>No workflows found. Standard workflows will be created automatically upon workspace launch.</span>
        </div>
    }
    else
    {
        <div class="workflow-management-grid">
            <!-- Left Column: Available Workflows List -->
            <div style="display: flex; flex-direction: column; gap: 0.85rem;">
                <div style="font-weight: 700; font-size: 0.9rem; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.25rem;">
                    Available Workflows (@_workflows.Count)
                </div>

                @foreach (var wf in _workflows)
                {
                    var isSelected = _selectedWorkflow?.Id == wf.Id;
                    <div class="workflow-card-item @(isSelected ? "selected" : "")"
                         id="workflow-card-@wf.Id"
                         @onclick="() => SelectWorkflow(wf)">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.45rem;">
                            <div style="display: flex; align-items: center; gap: 0.5rem;">
                                <span style="font-size: 1.3rem;">@wf.Icon</span>
                                <span style="font-weight: 700; font-size: 1rem; color: var(--text-primary);">@wf.Name</span>
                            </div>
                            <div style="display: flex; gap: 0.35rem; align-items: center;">
                                @if (wf.IsDefault)
                                {
                                    <span class="forge-badge badge-teal" style="font-size: 0.72rem;">Default</span>
                                }
                                @if (wf.WorkspaceId.HasValue)
                                {
                                    <span class="forge-badge badge-indigo" style="font-size: 0.72rem;">Custom</span>
                                }
                                else
                                {
                                    <span class="forge-badge badge-zinc" style="font-size: 0.72rem;">Template</span>
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(wf.Description))
                        {
                            <p style="margin: 0 0 0.75rem 0; font-size: 0.84rem; color: var(--text-secondary); line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @wf.Description
                            </p>
                        }

                        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.78rem; color: var(--text-muted); border-top: 1px solid var(--border-subtle); padding-top: 0.6rem; margin-top: 0.3rem;">
                            <span><code>@wf.Code</code> • <strong>@wf.Stages.Count</strong> stages</span>
                            <button type="button"
                                    class="forge-btn forge-btn-secondary btn-clone-workflow"
                                    style="padding: 0.2rem 0.55rem; font-size: 0.74rem;"
                                    disabled="@_isCloning"
                                    @onclick="() => CloneWorkflowAsync(wf)"
                                    @onclick:stopPropagation="true"
                                    title="Clone this workflow into an editable workspace workflow">
                                📄 Clone
                            </button>
                        </div>
                    </div>
                }
            </div>

            <!-- Right Column: Interactive Stage Inspector -->
            <div>
                @if (_selectedWorkflow != null)
                {
                    <div class="card-surface" style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 1.5rem;">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border-subtle); flex-wrap: wrap; gap: 1rem;">
                            <div>
                                <div style="display: flex; align-items: center; gap: 0.65rem; margin-bottom: 0.35rem;">
                                    <span style="font-size: 1.5rem;">@_selectedWorkflow.Icon</span>
                                    <h4 style="margin: 0; font-size: 1.25rem; font-weight: 700; color: var(--text-primary);">
                                        @_selectedWorkflow.Name
                                    </h4>
                                    @if (_selectedWorkflow.IsDefault)
                                    {
                                        <span class="forge-badge badge-teal" style="font-size: 0.76rem;">Default System Pipeline</span>
                                    }
                                </div>
                                <div style="font-size: 0.84rem; color: var(--text-secondary); margin-bottom: 0.4rem;">
                                    @_selectedWorkflow.Description
                                </div>
                                <div style="font-size: 0.78rem; color: var(--text-muted); display: flex; gap: 1rem; flex-wrap: wrap;">
                                    <span>Code: <code>@_selectedWorkflow.Code</code></span>
                                    <span>Stages: <strong>@_selectedWorkflow.Stages.Count</strong></span>
                                    <span>Scope: <strong>@(_selectedWorkflow.WorkspaceId.HasValue ? $"Workspace #{_selectedWorkflow.WorkspaceId.Value}" : "Global Template")</strong></span>
                                </div>
                            </div>

                            <button type="button"
                                    class="forge-btn forge-btn-primary"
                                    style="padding: 0.4rem 0.9rem; font-size: 0.82rem;"
                                    disabled="@_isCloning"
                                    @onclick="() => CloneWorkflowAsync(_selectedWorkflow)">
                                @(_isCloning ? "Cloning..." : "📄 Clone Workflow")
                            </button>
                        </div>

                        <!-- Stage Sequence Tree / Card List -->
                        <div style="font-weight: 700; font-size: 0.95rem; color: var(--text-primary); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.4rem;">
                            <span>Ordered Stages Pipeline (@_selectedWorkflow.Stages.Count)</span>
                        </div>

                        @if (!_selectedWorkflow.Stages.Any())
                        {
                            <div style="text-align: center; padding: 2rem 0; color: var(--text-muted);">
                                No stages defined for this workflow.
                            </div>
                        }
                        else
                        {
                            <div style="display: flex; flex-direction: column; gap: 0.85rem;">
                                @foreach (var stage in _selectedWorkflow.Stages.OrderBy(s => s.SequenceOrder))
                                {
                                    var isAgentic = stage.Kind == WorkflowStageKind.Agentic;
                                    var isExpanded = _expandedStageIds.Contains(stage.Id);

                                    <div class="stage-inspector-item" id="stage-inspector-@stage.SequenceOrder">
                                        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; cursor: pointer;"
                                             @onclick="() => ToggleStageExpanded(stage.Id)">
                                            <div style="display: flex; align-items: center; gap: 0.65rem;">
                                                <span style="font-weight: 800; font-family: var(--font-mono); font-size: 0.85rem; color: var(--text-muted);">
                                                    #@stage.SequenceOrder
                                                </span>
                                                <span style="font-size: 1.25rem;">@stage.Icon</span>
                                                <span style="font-weight: 700; font-size: 0.95rem; color: var(--text-primary);">
                                                    @stage.DisplayName
                                                </span>
                                                <span class="step-badge @(isAgentic ? "badge-gpu" : "badge-cpu")" style="font-size: 0.72rem; padding: 0.15rem 0.5rem;">
                                                    @(isAgentic ? "⚡ GPU" : "⚙️ CPU")
                                                </span>
                                            </div>

                                            <div style="display: flex; align-items: center; gap: 0.75rem;">
                                                <code style="font-size: 0.78rem; color: var(--text-muted);">@stage.StageId</code>
                                                <span style="font-size: 0.85rem; color: var(--text-muted);">@(isExpanded ? "▲" : "▼")</span>
                                            </div>
                                        </div>

                                        <div style="margin-top: 0.6rem; font-size: 0.8rem; color: var(--text-secondary); display: flex; gap: 1.25rem; flex-wrap: wrap;">
                                            <span>Handler: <code>@stage.CsharpImplementationType</code></span>
                                            <span>Kind: <strong>@stage.Kind</strong></span>
                                        </div>

                                        @if (isExpanded)
                                        {
                                            <div style="margin-top: 1rem; padding-top: 0.85rem; border-top: 1px solid var(--border-subtle); display: flex; flex-direction: column; gap: 0.75rem;">
                                                @if (isAgentic)
                                                {
                                                    var agenticCfg = ParseAgenticConfig(stage.ConfigurationJson);
                                                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.75rem; background: var(--bg-input); padding: 0.75rem; border-radius: var(--radius-sm);">
                                                        <div>
                                                            <span style="font-size: 0.72rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600; display: block;">Agent Profile</span>
                                                            <span style="font-size: 0.84rem; color: var(--text-primary); font-weight: 500;">
                                                                @(string.IsNullOrWhiteSpace(agenticCfg.AgentProfileId) ? "Default Persona" : agenticCfg.AgentProfileId)
                                                            </span>
                                                        </div>
                                                        <div>
                                                            <span style="font-size: 0.72rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600; display: block;">Required Mode</span>
                                                            <span class="forge-badge badge-indigo" style="font-size: 0.74rem;">@agenticCfg.RequiredMode</span>
                                                        </div>
                                                        <div>
                                                            <span style="font-size: 0.72rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600; display: block;">Retries / Timeout</span>
                                                            <span style="font-size: 0.84rem; color: var(--text-primary);">
                                                                @agenticCfg.MaxRetries retries • @(agenticCfg.TimeoutMinutes?.ToString() ?? "30")m
                                                            </span>
                                                        </div>
                                                        @if (!string.IsNullOrWhiteSpace(agenticCfg.LoopBackStageId))
                                                        {
                                                            <div>
                                                                <span style="font-size: 0.72rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600; display: block;">Loop Back On Changes</span>
                                                                <code style="font-size: 0.82rem; color: var(--accent-amber);">@agenticCfg.LoopBackStageId</code>
                                                            </div>
                                                        }
                                                    </div>

                                                    @if (!string.IsNullOrWhiteSpace(agenticCfg.StageDirective))
                                                    {
                                                        <div>
                                                            <span style="font-size: 0.75rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; display: block; margin-bottom: 0.25rem;">Stage System Directive</span>
                                                            <div style="background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 0.65rem 0.85rem; font-size: 0.8rem; line-height: 1.5; color: var(--text-secondary); max-height: 160px; overflow-y: auto; white-space: pre-wrap;">@agenticCfg.StageDirective</div>
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    var detCfg = ParseDeterministicConfig(stage.ConfigurationJson);
                                                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.75rem; background: var(--bg-input); padding: 0.75rem; border-radius: var(--radius-sm);">
                                                        <div>
                                                            <span style="font-size: 0.72rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600; display: block;">Action</span>
                                                            <span style="font-size: 0.84rem; color: var(--accent-teal); font-weight: 600;">@detCfg.Action</span>
                                                        </div>
                                                        <div>
                                                            <span style="font-size: 0.72rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600; display: block;">Fail Policy</span>
                                                            <span class="forge-badge @(detCfg.FailOnError ? "badge-crimson" : "badge-zinc")" style="font-size: 0.74rem;">
                                                                @(detCfg.FailOnError ? "Blocks Progression" : "Tolerates Failure")
                                                            </span>
                                                        </div>
                                                        <div>
                                                            <span style="font-size: 0.72rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600; display: block;">Timeout</span>
                                                            <span style="font-size: 0.84rem; color: var(--text-primary);">@detCfg.TimeoutSeconds s</span>
                                                        </div>
                                                        @if (!string.IsNullOrWhiteSpace(detCfg.LoopBackStageId))
                                                        {
                                                            <div>
                                                                <span style="font-size: 0.72rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600; display: block;">Loop Back Stage</span>
                                                                <code style="font-size: 0.82rem; color: var(--accent-amber);">@detCfg.LoopBackStageId</code>
                                                            </div>
                                                        }
                                                    </div>

                                                    @if (detCfg.ExtraParameters != null && detCfg.ExtraParameters.Any())
                                                    {
                                                        <div>
                                                            <span style="font-size: 0.75rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; display: block; margin-bottom: 0.35rem;">Execution Parameters</span>
                                                            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                                                                @foreach (var kvp in detCfg.ExtraParameters)
                                                                {
                                                                    <span class="forge-badge badge-zinc" style="font-size: 0.76rem; font-family: var(--font-mono);">
                                                                        @kvp.Key: <strong>@kvp.Value</strong>
                                                                    </span>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                }

                                                <details style="margin-top: 0.25rem;">
                                                    <summary style="font-size: 0.76rem; color: var(--text-muted); cursor: pointer;">
                                                        View Raw Configuration Payload (JSON)
                                                    </summary>
                                                    <pre class="stage-config-json-viewer" style="margin-top: 0.5rem;">@stage.ConfigurationJson</pre>
                                                </details>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int? WorkspaceId { get; set; }
    [Parameter] public string? WorkspaceName { get; set; }

    private List<WorkflowDefinition> _workflows = new();
    private WorkflowDefinition? _selectedWorkflow;
    private bool _isLoading = true;
    private bool _isCloning = false;
    private HashSet<int> _expandedStageIds = new();

    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNameCaseInsensitive = true
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadWorkflowsAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadWorkflowsAsync();
    }

    private async Task LoadWorkflowsAsync()
    {
        _isLoading = true;
        try
        {
            var list = await WorkflowRepository.GetWorkflowsAsync(WorkspaceId);
            _workflows = list.ToList();

            if (_selectedWorkflow == null || !_workflows.Any(w => w.Id == _selectedWorkflow.Id))
            {
                _selectedWorkflow = _workflows.FirstOrDefault(w => w.IsDefault) ?? _workflows.FirstOrDefault();
            }
            else
            {
                _selectedWorkflow = _workflows.FirstOrDefault(w => w.Id == _selectedWorkflow.Id);
            }

            // Expand all stages by default for easy inspection
            if (_selectedWorkflow != null)
            {
                foreach (var s in _selectedWorkflow.Stages)
                {
                    _expandedStageIds.Add(s.Id);
                }
            }
        }
        catch (Exception ex)
        {
            ToastService.Show("Loading Error", ex.Message, ToastLevel.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void SelectWorkflow(WorkflowDefinition wf)
    {
        _selectedWorkflow = wf;
        _expandedStageIds.Clear();
        foreach (var s in wf.Stages)
        {
            _expandedStageIds.Add(s.Id);
        }
    }

    private void ToggleStageExpanded(int stageId)
    {
        if (_expandedStageIds.Contains(stageId))
        {
            _expandedStageIds.Remove(stageId);
        }
        else
        {
            _expandedStageIds.Add(stageId);
        }
    }

    public async Task CloneWorkflowAsync(WorkflowDefinition source)
    {
        if (source == null || _isCloning) return;

        _isCloning = true;
        try
        {
            var uniqueSuffix = DateTime.UtcNow.ToString("MMdd-HHmm");
            var clone = new WorkflowDefinition
            {
                Name = $"Copy of {source.Name}",
                Code = $"{source.Code}-copy-{uniqueSuffix}",
                Icon = source.Icon,
                Description = $"Custom workspace copy cloned from {source.Name}.",
                IsDefault = false,
                WorkspaceId = WorkspaceId,
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow,
                Stages = source.Stages
                    .OrderBy(s => s.SequenceOrder)
                    .Select(s => new StageDefinition
                    {
                        StageId = s.StageId,
                        DisplayName = s.DisplayName,
                        Icon = s.Icon,
                        SequenceOrder = s.SequenceOrder,
                        Kind = s.Kind,
                        CsharpImplementationType = s.CsharpImplementationType,
                        ConfigurationJson = s.ConfigurationJson,
                        CreatedAt = DateTime.UtcNow
                    })
                    .ToList()
            };

            foreach (var st in clone.Stages)
            {
                st.Workflow = clone;
            }

            var created = await WorkflowRepository.CreateWorkflowAsync(clone);
            ToastService.Show("Workflow Cloned", $"Successfully cloned workflow as '{created.Name}'.", ToastLevel.Success);
            await LoadWorkflowsAsync();
            _selectedWorkflow = _workflows.FirstOrDefault(w => w.Id == created.Id) ?? created;
            SelectWorkflow(_selectedWorkflow);
        }
        catch (Exception ex)
        {
            ToastService.Show("Clone Error", ex.Message, ToastLevel.Error);
        }
        finally
        {
            _isCloning = false;
        }
    }

    private static AgenticStageConfig ParseAgenticConfig(string json)
    {
        try
        {
            return JsonSerializer.Deserialize<AgenticStageConfig>(json, JsonOptions) ?? new AgenticStageConfig();
        }
        catch
        {
            return new AgenticStageConfig();
        }
    }

    private static DeterministicStageConfig ParseDeterministicConfig(string json)
    {
        try
        {
            return JsonSerializer.Deserialize<DeterministicStageConfig>(json, JsonOptions) ?? new DeterministicStageConfig();
        }
        catch
        {
            return new DeterministicStageConfig();
        }
    }
}

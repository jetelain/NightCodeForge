@namespace NightCodeForge.Web.Components.Settings
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.DependencyInjection
@using NightCodeForge.Core.Domain
@using NightCodeForge.Infrastructure.Data
@inject IServiceScopeFactory ScopeFactory

<div class="forge-card mt-3">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
        <div>
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
                <span style="font-size: 1.25rem;">📊</span>
                <h3 style="font-weight: 600; font-size: 1.2rem; margin: 0;">A/B Testing &amp; Optimization Comparator</h3>
                <span class="forge-badge badge-indigo">Empirical Evaluation</span>
            </div>
            <p style="margin: 0; font-size: 0.875rem; color: var(--text-secondary); max-width: 720px;">
                Evaluate token efficiency, turn counts, and execution latency across historical stage executions to empirically measure the benefit of local LLM optimizations.
            </p>
        </div>
    </div>

    <div style="background: var(--bg-surface-elevated, rgba(255,255,255,0.03)); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 1.25rem;">
        <div style="display: flex; gap: 1.5rem; margin-bottom: 1.5rem; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 240px;">
                <label style="font-size: 0.85rem; font-weight: 600; color: var(--text-secondary); display: block; margin-bottom: 0.35rem;">
                    Profile A (Baseline)
                </label>
                <select class="forge-input" style="width: 100%;" @bind="_selectedProfileA">
                    @foreach (var p in _availableProfiles)
                    {
                        <option value="@p">@p</option>
                    }
                </select>
            </div>

            <div style="flex: 1; min-width: 240px;">
                <label style="font-size: 0.85rem; font-weight: 600; color: var(--text-secondary); display: block; margin-bottom: 0.35rem;">
                    Profile B (Experimental)
                </label>
                <select class="forge-input" style="width: 100%;" @bind="_selectedProfileB">
                    @foreach (var p in _availableProfiles)
                    {
                        <option value="@p">@p</option>
                    }
                </select>
            </div>
        </div>

        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; font-size: 0.875rem;">
                <thead>
                    <tr style="border-bottom: 1px solid var(--border-subtle); text-align: left; color: var(--text-secondary);">
                        <th style="padding: 0.75rem 0.5rem;">Metric</th>
                        <th style="padding: 0.75rem 0.5rem;">Profile A (@_selectedProfileA)</th>
                        <th style="padding: 0.75rem 0.5rem;">Profile B (@_selectedProfileB)</th>
                        <th style="padding: 0.75rem 0.5rem;">Delta</th>
                    </tr>
                </thead>
                <tbody>
                    <tr style="border-bottom: 1px solid var(--border-subtle);">
                        <td style="padding: 0.75rem 0.5rem; font-weight: 600; color: var(--text-primary);">Avg Prompt Tokens</td>
                        <td style="padding: 0.75rem 0.5rem; font-family: var(--font-mono); color: var(--text-secondary);">@GetAvgPromptTokens(_selectedProfileA).ToString("N0")</td>
                        <td style="padding: 0.75rem 0.5rem; font-family: var(--font-mono); color: var(--text-secondary);">@GetAvgPromptTokens(_selectedProfileB).ToString("N0")</td>
                        <td style="padding: 0.75rem 0.5rem;">
                            <span class="forge-badge badge-teal">Token reduction</span>
                        </td>
                    </tr>
                    <tr style="border-bottom: 1px solid var(--border-subtle);">
                        <td style="padding: 0.75rem 0.5rem; font-weight: 600; color: var(--text-primary);">Avg Duration (ms)</td>
                        <td style="padding: 0.75rem 0.5rem; font-family: var(--font-mono); color: var(--text-secondary);">@GetAvgDuration(_selectedProfileA).ToString("N0") ms</td>
                        <td style="padding: 0.75rem 0.5rem; font-family: var(--font-mono); color: var(--text-secondary);">@GetAvgDuration(_selectedProfileB).ToString("N0") ms</td>
                        <td style="padding: 0.75rem 0.5rem;">
                            <span class="forge-badge badge-indigo">Execution speed</span>
                        </td>
                    </tr>
                    <tr style="border-bottom: 1px solid var(--border-subtle);">
                        <td style="padding: 0.75rem 0.5rem; font-weight: 600; color: var(--text-primary);">Recorded Stage Runs</td>
                        <td style="padding: 0.75rem 0.5rem; font-family: var(--font-mono); color: var(--text-secondary);">@GetRunCount(_selectedProfileA)</td>
                        <td style="padding: 0.75rem 0.5rem; font-family: var(--font-mono); color: var(--text-secondary);">@GetRunCount(_selectedProfileB)</td>
                        <td style="padding: 0.75rem 0.5rem;">
                            <span class="forge-badge badge-gray">Sample size</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<string> _availableProfiles = new() { StandardStageIds.Implementation, "ideation", StandardStageIds.TaskReview, StandardStageIds.CodeReviewAndFix, StandardStageIds.Triage };
    private string _selectedProfileA = StandardStageIds.Implementation;
    private string _selectedProfileB = "ideation";
    private List<StageExecutionRecord> _records = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            _records = await db.StageExecutionRecords.ToListAsync();
        }
        catch
        {
            // Non-fatal if empty
        }
    }

    private double GetAvgPromptTokens(string profileId)
    {
        var runs = _records.Where(r => r.AgentProfileId == profileId).ToList();
        return runs.Count > 0 ? runs.Average(r => (double)r.PromptTokens) : 0;
    }

    private double GetAvgDuration(string profileId)
    {
        var runs = _records.Where(r => r.AgentProfileId == profileId).ToList();
        return runs.Count > 0 ? runs.Average(r => (double)r.DurationMs) : 0;
    }

    private int GetRunCount(string profileId)
    {
        return _records.Count(r => r.AgentProfileId == profileId);
    }
}

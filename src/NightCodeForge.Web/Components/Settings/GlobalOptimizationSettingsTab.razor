@namespace NightCodeForge.Web.Components.Settings
@using NightCodeForge.Core.Domain
@using NightCodeForge.Core.Interfaces
@using NightCodeForge.Web.Services
@inject IGlobalOptimizationSettingsService GlobalOptService
@inject ToastService ToastService

<div class="forge-card mt-3">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
        <div>
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
                <span style="font-size: 1.25rem;">⚡</span>
                <h3 style="font-weight: 600; font-size: 1.2rem; margin: 0;">Global Local LLM Optimizations</h3>
                <span class="forge-badge badge-teal">Inherited Globally</span>
            </div>
            <p style="margin: 0; font-size: 0.875rem; color: var(--text-secondary); max-width: 720px;">
                Configure system-wide optimization flags and context compaction thresholds. These settings apply globally across all agent runs, pipeline stages, and ideation sessions unless explicitly overridden on an individual profile.
            </p>
        </div>
        <div style="display: flex; gap: 0.75rem;">
            <button type="button" class="forge-btn forge-btn-outline" @onclick="ResetToDefaults" disabled="@_isSaving">
                ↺ Reset to Defaults
            </button>
            <button type="button" class="forge-btn forge-btn-primary" @onclick="SaveSettingsAsync" disabled="@_isSaving">
                @if (_isSaving)
                {
                    <span>Saving...</span>
                }
                else
                {
                    <span>💾 Save Global Settings</span>
                }
            </button>
        </div>
    </div>



    <!-- Section 2: Deterministic & Grammar Optimizations -->
    <div style="background: var(--bg-surface-elevated, rgba(255,255,255,0.03)); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 1.25rem;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.75rem;">
            <div>
                <h4 style="font-size: 1rem; font-weight: 600; margin: 0 0 0.25rem 0; color: var(--text-primary);">
                    🛡️ Runtime Safety, Grammar &amp; Cache Alignment
                </h4>
                <p style="margin: 0; font-size: 0.8rem; color: var(--text-secondary);">
                    Deterministic compilation safeguards, structural decoding constraints, and KV cache hit optimization.
                </p>
            </div>
            <span class="forge-badge badge-teal">Execution Engine</span>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.25rem;">


            <!-- Guided Grammar Decoding -->
            <div style="background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 1rem; display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                        <label style="font-weight: 600; font-size: 0.9rem; color: var(--text-primary); cursor: pointer; display: flex; align-items: center; gap: 0.5rem;" for="chkGuidedGrammar">
                            <input id="chkGuidedGrammar" type="checkbox" @bind="_flags.GuidedGrammarDecoding" style="width: 1.1rem; height: 1.1rem; cursor: pointer;" />
                            Guided Grammar Decoding
                        </label>
                        <span class="forge-badge @(_flags.GuidedGrammarDecoding ? "badge-teal" : "badge-gray")">
                            @(_flags.GuidedGrammarDecoding ? "Active" : "Off")
                        </span>
                    </div>
                    <p style="margin: 0; font-size: 0.8rem; color: var(--text-secondary); line-height: 1.4;">
                        Enforces strict JSON schema / GBNF grammar constraints at the Ollama/vLLM sampler level to guarantee syntactic tool argument validity.
                    </p>
                </div>
            </div>

            <!-- Deterministic Symbol Map -->
            <div style="background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 1rem; display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                        <label style="font-weight: 600; font-size: 0.9rem; color: var(--text-primary); cursor: pointer; display: flex; align-items: center; gap: 0.5rem;" for="chkSymbolMap">
                            <input id="chkSymbolMap" type="checkbox" @bind="_flags.DeterministicSymbolMap" style="width: 1.1rem; height: 1.1rem; cursor: pointer;" />
                            Deterministic Symbol Map
                        </label>
                        <span class="forge-badge @(_flags.DeterministicSymbolMap ? "badge-teal" : "badge-gray")">
                            @(_flags.DeterministicSymbolMap ? "Active" : "Off")
                        </span>
                    </div>
                    <p style="margin: 0; font-size: 0.8rem; color: var(--text-secondary); line-height: 1.4;">
                        Pre-indexes workspace classes, interfaces, and methods via Roslyn/ctags and deterministically injects matching symbols into prompts.
                    </p>
                </div>
            </div>

            <!-- Structured Diagnostic Extraction -->
            <div style="background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 1rem; display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                        <label style="font-weight: 600; font-size: 0.9rem; color: var(--text-primary); cursor: pointer; display: flex; align-items: center; gap: 0.5rem;" for="chkStructuredDiagnostics">
                            <input id="chkStructuredDiagnostics" type="checkbox" @bind="_flags.StructuredDiagnosticExtraction" style="width: 1.1rem; height: 1.1rem; cursor: pointer;" />
                            Structured Diagnostic Extraction
                        </label>
                        <span class="forge-badge @(_flags.StructuredDiagnosticExtraction ? "badge-teal" : "badge-gray")">
                            @(_flags.StructuredDiagnosticExtraction ? "Active" : "Off")
                        </span>
                    </div>
                    <p style="margin: 0; font-size: 0.8rem; color: var(--text-secondary); line-height: 1.4;">
                        Parses raw MSBuild compiler outputs (CS\d+) and test assertions into concise structured summaries, eliminating redundant build log dump tokens.
                    </p>
                </div>
            </div>

            <!-- JIT Model Preload -->
            <div style="background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 1rem; display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                        <label style="font-weight: 600; font-size: 0.9rem; color: var(--text-primary); cursor: pointer; display: flex; align-items: center; gap: 0.5rem;" for="chkJitPreload">
                            <input id="chkJitPreload" type="checkbox" @bind="_flags.JitModelPreload" style="width: 1.1rem; height: 1.1rem; cursor: pointer;" />
                            JIT Model Preload
                        </label>
                        <span class="forge-badge @(_flags.JitModelPreload ? "badge-teal" : "badge-gray")">
                            @(_flags.JitModelPreload ? "Active" : "Off")
                        </span>
                    </div>
                    <p style="margin: 0; font-size: 0.8rem; color: var(--text-secondary); line-height: 1.4;">
                        Asynchronously pre-loads the next stage's model weights into VRAM during CPU-bound deterministic build and test gates to hide PCIe model swapping latency.
                    </p>
                </div>
            </div>

            <!-- Synthetic Conversation Priming -->
            <div style="background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 1rem; display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                        <label style="font-weight: 600; font-size: 0.9rem; color: var(--text-primary); cursor: pointer; display: flex; align-items: center; gap: 0.5rem;" for="chkSyntheticPriming">
                            <input id="chkSyntheticPriming" type="checkbox" @bind="_flags.SyntheticConversationPriming" style="width: 1.1rem; height: 1.1rem; cursor: pointer;" />
                            Synthetic Conversation Priming
                        </label>
                        <span class="forge-badge @(_flags.SyntheticConversationPriming ? "badge-teal" : "badge-gray")">
                            @(_flags.SyntheticConversationPriming ? "Active" : "Off")
                        </span>
                    </div>
                    <p style="margin: 0; font-size: 0.8rem; color: var(--text-secondary); line-height: 1.4;">
                        Pre-seeds agent ChatHistory with synthetic bash tool call/result pairs from prior deterministic stages to eliminate redundant exploratory build/test tool calls.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private LocalOptimizationFlags _flags = new();
    private bool _isSaving;

    protected override void OnInitialized()
    {
        _flags = GlobalOptService.GetFlags().Clone();
    }

    private async Task SaveSettingsAsync()
    {
        if (_isSaving) return;
        _isSaving = true;

        try
        {


            await GlobalOptService.UpdateFlagsAsync(_flags);
            ToastService.Show("Global Optimizations Saved", "Optimization flags and tuning parameters updated successfully.", ToastLevel.Success);
        }
        catch (Exception ex)
        {
            ToastService.Show("Error Saving Settings", ex.Message, ToastLevel.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void ResetToDefaults()
    {
        _flags = new LocalOptimizationFlags();
        ToastService.Show("Defaults Restored", "Optimization settings reset to recommended defaults. Click 'Save' to persist.", ToastLevel.Info);
    }
}

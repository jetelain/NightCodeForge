@namespace NightCodeForge.Web.Components.Settings
@using NightCodeForge.Core.Domain
@using NightCodeForge.Core.Interfaces
@using NightCodeForge.Web.Services
@inject IGlobalOptimizationSettingsService GlobalOptService
@inject ToastService ToastService

<div class="forge-card mt-3">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
        <div>
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
                <span style="font-size: 1.25rem;">⚡</span>
                <h3 style="font-weight: 600; font-size: 1.2rem; margin: 0;">Global Local LLM Optimizations</h3>
                <span class="forge-badge badge-teal">Inherited Globally</span>
            </div>
            <p style="margin: 0; font-size: 0.875rem; color: var(--text-secondary); max-width: 720px;">
                Configure system-wide optimization flags and context compaction thresholds. These settings apply globally across all agent runs, pipeline stages, and ideation sessions unless explicitly overridden on an individual profile.
            </p>
        </div>
        <div style="display: flex; gap: 0.75rem;">
            <button type="button" class="forge-btn forge-btn-outline" @onclick="ResetToDefaults" disabled="_isSaving">
                ↺ Reset to Defaults
            </button>
            <button type="button" class="forge-btn forge-btn-primary" @onclick="SaveSettingsAsync" disabled="_isSaving">
                @if (_isSaving)
                {
                    <span>Saving...</span>
                }
                else
                {
                    <span>💾 Save Global Settings</span>
                }
            </button>
        </div>
    </div>

    <!-- Section 1: Memory Compaction & Token Preservation Tuning -->
    <div style="background: var(--bg-surface-elevated, rgba(255,255,255,0.03)); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 1.25rem; margin-bottom: 1.5rem;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.75rem;">
            <div>
                <h4 style="font-size: 1rem; font-weight: 600; margin: 0 0 0.25rem 0; color: var(--text-primary);">
                    🧠 Context Window Compaction &amp; Sliding Window Tuning
                </h4>
                <p style="margin: 0; font-size: 0.8rem; color: var(--text-secondary);">
                    Mitigate quadratic context inflation on local SLMs (DeepSeek-R1, QwQ, Qwen2.5-Coder) without losing critical recent reasoning or function results.
                </p>
            </div>
            <span class="forge-badge badge-indigo">Token Savers</span>
        </div>

        <!-- 1.1 Thinking Trace Compaction -->
        <div style="display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1.25rem; padding-bottom: 1.25rem; border-bottom: 1px dashed var(--border-subtle);">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem;">
                <div style="flex: 1;">
                    <label style="font-weight: 600; font-size: 0.9rem; color: var(--text-primary); cursor: pointer; display: flex; align-items: center; gap: 0.5rem;" for="chkThinkingCompaction">
                        <input id="chkThinkingCompaction" type="checkbox" @bind="_flags.ThinkingTraceCompaction" style="width: 1.1rem; height: 1.1rem; cursor: pointer;" />
                        Thinking Trace Compaction (<span class="font-mono" style="font-size: 0.8rem; color: var(--accent-indigo);">&lt;think&gt;...&lt;/think&gt;</span>)
                    </label>
                    <p style="margin: 0.25rem 0 0 1.6rem; font-size: 0.8rem; color: var(--text-secondary);">
                        Prunes verbose internal reasoning traces from historical assistant turns outside the protected sliding window, cutting multi-turn token re-ingestion by 60%–80%.
                    </p>
                </div>
                <span class="forge-badge @(_flags.ThinkingTraceCompaction ? "badge-teal" : "badge-gray")">
                    @(_flags.ThinkingTraceCompaction ? "Enabled" : "Disabled")
                </span>
            </div>

            @if (_flags.ThinkingTraceCompaction)
            {
                <div style="margin-left: 1.6rem; background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 0.85rem; display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap;">
                    <div style="flex: 1; min-width: 250px;">
                        <label style="font-size: 0.8rem; font-weight: 600; color: var(--text-secondary); display: block; margin-bottom: 0.25rem;">
                            Protected Verbatim Turns Window (<span class="font-mono">ThinkingKeepVerbatimCount</span>)
                        </label>
                        <span style="font-size: 0.75rem; color: var(--text-muted); display: block;">
                            Retains full verbatim &lt;think&gt; chains for this many recent assistant turns before summarizing older turns into single-line stubs.
                        </span>
                    </div>
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <input type="number" min="1" max="1000" step="5" class="forge-input" style="width: 110px; text-align: right;" @bind="_flags.ThinkingKeepVerbatimCount" />
                        <span style="font-size: 0.8rem; color: var(--text-secondary);">turns</span>
                    </div>
                </div>
            }
        </div>

        <!-- 1.2 Tool Result Compactor -->
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem;">
                <div style="flex: 1;">
                    <label style="font-weight: 600; font-size: 0.9rem; color: var(--text-primary); cursor: pointer; display: flex; align-items: center; gap: 0.5rem;" for="chkToolCompaction">
                        <input id="chkToolCompaction" type="checkbox" @bind="_flags.CompactOlderToolResults" style="width: 1.1rem; height: 1.1rem; cursor: pointer;" />
                        Older Tool Result Compaction (<span class="font-mono" style="font-size: 0.8rem; color: var(--accent-indigo);">ToolResultCompactor</span>)
                    </label>
                    <p style="margin: 0.25rem 0 0 1.6rem; font-size: 0.8rem; color: var(--text-secondary);">
                        Replaces bulky tool outputs outside the recent sliding window with concise summaries, eliminating redundant build stdout and large file contents from prompt history.
                    </p>
                </div>
                <span class="forge-badge @(_flags.CompactOlderToolResults ? "badge-teal" : "badge-gray")">
                    @(_flags.CompactOlderToolResults ? "Enabled" : "Disabled")
                </span>
            </div>

            @if (_flags.CompactOlderToolResults)
            {
                <div style="margin-left: 1.6rem; background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 0.85rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
                    <div>
                        <label style="font-size: 0.8rem; font-weight: 600; color: var(--text-secondary); display: block; margin-bottom: 0.25rem;">
                            Protected Recent Tool Window (<span class="font-mono">ToolKeepVerbatimCount</span>)
                        </label>
                        <span style="font-size: 0.75rem; color: var(--text-muted); display: block; margin-bottom: 0.5rem;">
                            Number of recent tool executions kept completely verbatim.
                        </span>
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <input type="number" min="1" max="500" step="5" class="forge-input" style="width: 110px; text-align: right;" @bind="_flags.ToolKeepVerbatimCount" />
                            <span style="font-size: 0.8rem; color: var(--text-secondary);">results</span>
                        </div>
                    </div>

                    <div>
                        <label style="font-size: 0.8rem; font-weight: 600; color: var(--text-secondary); display: block; margin-bottom: 0.25rem;">
                            Compaction Threshold (<span class="font-mono">ToolMaxResultLength</span>)
                        </label>
                        <span style="font-size: 0.75rem; color: var(--text-muted); display: block; margin-bottom: 0.5rem;">
                            Outputs exceeding this length outside the window become eligible for truncation.
                        </span>
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <input type="number" min="200" max="50000" step="100" class="forge-input" style="width: 110px; text-align: right;" @bind="_flags.ToolMaxResultLength" />
                            <span style="font-size: 0.8rem; color: var(--text-secondary);">chars</span>
                        </div>
                    </div>

                    <div>
                        <label style="font-size: 0.8rem; font-weight: 600; color: var(--text-secondary); display: block; margin-bottom: 0.25rem;">
                            Truncated Head Retention (<span class="font-mono">ToolTruncateToLength</span>)
                        </label>
                        <span style="font-size: 0.75rem; color: var(--text-muted); display: block; margin-bottom: 0.5rem;">
                            Number of characters retained in the summary prefix before appending truncation notice.
                        </span>
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <input type="number" min="100" max="40000" step="50" class="forge-input" style="width: 110px; text-align: right;" @bind="_flags.ToolTruncateToLength" />
                            <span style="font-size: 0.8rem; color: var(--text-secondary);">chars</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Section 2: Deterministic & Grammar Optimizations -->
    <div style="background: var(--bg-surface-elevated, rgba(255,255,255,0.03)); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 1.25rem;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.75rem;">
            <div>
                <h4 style="font-size: 1rem; font-weight: 600; margin: 0 0 0.25rem 0; color: var(--text-primary);">
                    🛡️ Runtime Safety, Grammar &amp; Cache Alignment
                </h4>
                <p style="margin: 0; font-size: 0.8rem; color: var(--text-secondary);">
                    Deterministic compilation safeguards, structural decoding constraints, and KV cache hit optimization.
                </p>
            </div>
            <span class="forge-badge badge-teal">Execution Engine</span>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.25rem;">
            <!-- Loop Circuit Breaker -->
            <div style="background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 1rem; display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                        <label style="font-weight: 600; font-size: 0.9rem; color: var(--text-primary); cursor: pointer; display: flex; align-items: center; gap: 0.5rem;" for="chkCircuitBreaker">
                            <input id="chkCircuitBreaker" type="checkbox" @bind="_flags.LoopCircuitBreaker" style="width: 1.1rem; height: 1.1rem; cursor: pointer;" />
                            Loop Circuit Breaker
                        </label>
                        <span class="forge-badge @(_flags.LoopCircuitBreaker ? "badge-teal" : "badge-gray")">
                            @(_flags.LoopCircuitBreaker ? "Active" : "Off")
                        </span>
                    </div>
                    <p style="margin: 0; font-size: 0.8rem; color: var(--text-secondary); line-height: 1.4;">
                        Monitors live token generation for degenerate n-gram repetition loops and intercepts runaway duplicate tool calls before token limits expire.
                    </p>
                </div>
            </div>

            <!-- Guided Grammar Decoding -->
            <div style="background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 1rem; display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                        <label style="font-weight: 600; font-size: 0.9rem; color: var(--text-primary); cursor: pointer; display: flex; align-items: center; gap: 0.5rem;" for="chkGuidedGrammar">
                            <input id="chkGuidedGrammar" type="checkbox" @bind="_flags.GuidedGrammarDecoding" style="width: 1.1rem; height: 1.1rem; cursor: pointer;" />
                            Guided Grammar Decoding
                        </label>
                        <span class="forge-badge @(_flags.GuidedGrammarDecoding ? "badge-teal" : "badge-gray")">
                            @(_flags.GuidedGrammarDecoding ? "Active" : "Off")
                        </span>
                    </div>
                    <p style="margin: 0; font-size: 0.8rem; color: var(--text-secondary); line-height: 1.4;">
                        Enforces strict JSON schema / GBNF grammar constraints at the Ollama/vLLM sampler level to guarantee syntactic tool argument validity.
                    </p>
                </div>
            </div>

            <!-- Deterministic Symbol Map -->
            <div style="background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 1rem; display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                        <label style="font-weight: 600; font-size: 0.9rem; color: var(--text-primary); cursor: pointer; display: flex; align-items: center; gap: 0.5rem;" for="chkSymbolMap">
                            <input id="chkSymbolMap" type="checkbox" @bind="_flags.DeterministicSymbolMap" style="width: 1.1rem; height: 1.1rem; cursor: pointer;" />
                            Deterministic Symbol Map
                        </label>
                        <span class="forge-badge @(_flags.DeterministicSymbolMap ? "badge-teal" : "badge-gray")">
                            @(_flags.DeterministicSymbolMap ? "Active" : "Off")
                        </span>
                    </div>
                    <p style="margin: 0; font-size: 0.8rem; color: var(--text-secondary); line-height: 1.4;">
                        Pre-indexes workspace classes, interfaces, and methods via Roslyn/ctags and deterministically injects matching symbols into prompts.
                    </p>
                </div>
            </div>

            <!-- Structured Diagnostic Extraction -->
            <div style="background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 1rem; display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                        <label style="font-weight: 600; font-size: 0.9rem; color: var(--text-primary); cursor: pointer; display: flex; align-items: center; gap: 0.5rem;" for="chkStructuredDiagnostics">
                            <input id="chkStructuredDiagnostics" type="checkbox" @bind="_flags.StructuredDiagnosticExtraction" style="width: 1.1rem; height: 1.1rem; cursor: pointer;" />
                            Structured Diagnostic Extraction
                        </label>
                        <span class="forge-badge @(_flags.StructuredDiagnosticExtraction ? "badge-teal" : "badge-gray")">
                            @(_flags.StructuredDiagnosticExtraction ? "Active" : "Off")
                        </span>
                    </div>
                    <p style="margin: 0; font-size: 0.8rem; color: var(--text-secondary); line-height: 1.4;">
                        Parses raw MSBuild compiler outputs (CS\d+) and test assertions into concise structured summaries, eliminating redundant build log dump tokens.
                    </p>
                </div>
            </div>

            <!-- Prefix Stabilization -->
            <div style="background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 1rem; display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                        <label style="font-weight: 600; font-size: 0.9rem; color: var(--text-primary); cursor: pointer; display: flex; align-items: center; gap: 0.5rem;" for="chkPrefixStabilization">
                            <input id="chkPrefixStabilization" type="checkbox" @bind="_flags.PrefixStabilization" style="width: 1.1rem; height: 1.1rem; cursor: pointer;" />
                            Prompt Prefix Stabilization
                        </label>
                        <span class="forge-badge @(_flags.PrefixStabilization ? "badge-teal" : "badge-gray")">
                            @(_flags.PrefixStabilization ? "Active" : "Off")
                        </span>
                    </div>
                    <p style="margin: 0; font-size: 0.8rem; color: var(--text-secondary); line-height: 1.4;">
                        Enforces 4-layer byte-identical prompt prefix ordering (directives, tools, skills, project context) to maximize KV cache hit rates in llama.cpp / vLLM.
                    </p>
                </div>
            </div>

            <!-- JIT Model Preload -->
            <div style="background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 1rem; display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                        <label style="font-weight: 600; font-size: 0.9rem; color: var(--text-primary); cursor: pointer; display: flex; align-items: center; gap: 0.5rem;" for="chkJitPreload">
                            <input id="chkJitPreload" type="checkbox" @bind="_flags.JitModelPreload" style="width: 1.1rem; height: 1.1rem; cursor: pointer;" />
                            JIT Model Preload
                        </label>
                        <span class="forge-badge @(_flags.JitModelPreload ? "badge-teal" : "badge-gray")">
                            @(_flags.JitModelPreload ? "Active" : "Off")
                        </span>
                    </div>
                    <p style="margin: 0; font-size: 0.8rem; color: var(--text-secondary); line-height: 1.4;">
                        Asynchronously pre-loads the next stage's model weights into VRAM during CPU-bound deterministic build and test gates to hide PCIe model swapping latency.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private LocalOptimizationFlags _flags = new();
    private bool _isSaving;

    protected override void OnInitialized()
    {
        _flags = GlobalOptService.GetFlags().Clone();
    }

    private async Task SaveSettingsAsync()
    {
        if (_isSaving) return;
        _isSaving = true;

        try
        {
            // Sanitize inputs
            if (_flags.ThinkingKeepVerbatimCount < 1) _flags.ThinkingKeepVerbatimCount = 1;
            if (_flags.ToolKeepVerbatimCount < 1) _flags.ToolKeepVerbatimCount = 1;
            if (_flags.ToolMaxResultLength < 100) _flags.ToolMaxResultLength = 100;
            if (_flags.ToolTruncateToLength < 50) _flags.ToolTruncateToLength = 50;
            if (_flags.ToolTruncateToLength > _flags.ToolMaxResultLength)
            {
                _flags.ToolTruncateToLength = _flags.ToolMaxResultLength - 50;
            }

            await GlobalOptService.UpdateFlagsAsync(_flags);
            ToastService.Show("Global Optimizations Saved", "Optimization flags and tuning parameters updated successfully.", ToastLevel.Success);
        }
        catch (Exception ex)
        {
            ToastService.Show("Error Saving Settings", ex.Message, ToastLevel.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void ResetToDefaults()
    {
        _flags = new LocalOptimizationFlags();
        ToastService.Show("Defaults Restored", "Optimization settings reset to recommended defaults. Click 'Save' to persist.", ToastLevel.Info);
    }
}

@namespace NightCodeForge.Web.Components.Workspaces.Steps
@using NightCodeForge.Web.Models
@using NightCodeForge.Web.Services
@inject IWorkspaceIntakeUiService IntakeService

<div class="wizard-step-container">
    <div class="step-intro">
        <h4 class="step-title">📁 Repository Location &amp; Validation</h4>
        <p class="step-subtitle">Select a discovered local repository, enter a custom path, or onboard from a connected remote forge.</p>
    </div>

    <!-- Intake Channel Switcher -->
    <div class="intake-channel-tabs mb-4" role="tablist" aria-label="Repository intake source">
        <button id="intake-tab-local"
                type="button"
                role="tab"
                aria-selected="@(_activeChannel == IntakeChannel.Local)"
                class="intake-tab-btn @(_activeChannel == IntakeChannel.Local ? "active" : "")"
                @onclick="() => SelectChannelAsync(IntakeChannel.Local)">
            📁 Local Git Repositories
        </button>
        <button id="intake-tab-remote"
                type="button"
                role="tab"
                aria-selected="@(_activeChannel == IntakeChannel.Remote)"
                class="intake-tab-btn @(_activeChannel == IntakeChannel.Remote ? "active" : "")"
                @onclick="() => SelectChannelAsync(IntakeChannel.Remote)">
            ☁️ Remote Forge Projects
        </button>
    </div>

    @if (_activeChannel == IntakeChannel.Local)
    {
        <!-- Local Repository Auto-Discovery Picker -->
        <div class="local-discovery-panel mb-4">
            <div class="discovery-panel-header">
                <div>
                    <label class="form-label mb-0" for="local-repo-select">
                        Discovered Local Repositories
                    </label>
                    <span class="form-hint">
                        @if (_isLoadingLocal)
                        {
                            <span>Scanning standard developer folders...</span>
                        }
                        else
                        {
                            <span>@_localRepositories.Count repositor@(_localRepositories.Count == 1 ? "y" : "ies") discovered</span>
                        }
                    </span>
                </div>
                <button id="refresh-local-repos-btn"
                        type="button"
                        class="forge-btn forge-btn-secondary forge-btn-sm"
                        @onclick="() => LoadLocalRepositoriesAsync(forceRefresh: true)"
                        disabled="@_isLoadingLocal">
                    @if (_isLoadingLocal)
                    {
                        <span class="spinner-inline"></span>
                        <span>Refreshing...</span>
                    }
                    else
                    {
                        <span>🔄 Refresh Scanned Repos</span>
                    }
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(_localDiscoveryError))
            {
                <div class="clone-validation-error mt-2">
                    ⚠️ @_localDiscoveryError
                </div>
            }

            <div class="discovery-controls mt-2">
                <input id="local-repo-search-input"
                       type="text"
                       class="form-control-dark"
                       placeholder="Filter discovered repositories by name, branch, or path..."
                       value="@_localSearchQuery"
                       @oninput="HandleLocalSearchInput" />

                <select id="local-repo-select"
                        class="form-control-dark font-mono"
                        value="@Model.RepositoryPath"
                        @onchange="HandleLocalRepositorySelected">
                    <option value="">
                        -- Select a discovered Git repository (@_filteredLocalRepositories.Count shown) --
                    </option>
                    @foreach (var repo in _filteredLocalRepositories)
                    {
                        <option value="@repo.FullPath">@IntakeService.FormatLocalRepositoryLabel(repo)</option>
                    }
                </select>
            </div>
        </div>

        <!-- Repository Path Input Group -->
        <div class="form-group mb-4">
            <label class="form-label" for="repo-path-input">
                Repository Directory Path <span class="text-danger">*</span>
            </label>
            <div class="input-action-row">
                <input id="repo-path-input" 
                       type="text" 
                       class="form-control-dark font-mono flex-1" 
                       placeholder="e.g. C:\Users\Dev\source\repos\my-app or /home/dev/repos/my-app"
                       value="@Model.RepositoryPath" 
                       @oninput="HandlePathInput"
                       @onkeydown="HandleKeyDown" />
                <button type="button" 
                        class="forge-btn forge-btn-secondary" 
                        @onclick="OnProbeRequested"
                        disabled="@(string.IsNullOrWhiteSpace(Model.RepositoryPath) || IsProbing)">
                    @if (IsProbing)
                    {
                        <span class="spinner-inline"></span>
                        <span>Probing...</span>
                    }
                    else
                    {
                        <span>🔍 Probe Directory</span>
                    }
                </button>
            </div>
            <span class="form-hint">Absolute local path on the host operating system.</span>
            <div class="form-hint mt-2 text-muted">
                💡 <strong>Tip:</strong> Preparing an existing repository? Run <code>ncf init</code> in your repository root to deterministically configure <code>.gitignore</code>, <code>.editorconfig</code>, code stack presets, and packaged agent skills.
            </div>
        </div>

        <!-- Probe Feedback Panel -->
        @if (ProbeResult != null)
        {
            <div class="probe-feedback-card @(ProbeResult.IsGitRepository ? "probe-success" : (ProbeResult.Exists ? "probe-warning" : "probe-error"))">
                @if (!ProbeResult.Exists)
                {
                    <div class="probe-feedback-header">
                        <span class="feedback-icon">❌</span>
                        <div>
                            <strong class="feedback-title">Directory Not Found</strong>
                            <p class="feedback-desc">@(ProbeResult.WarningMessage ?? "The specified path does not exist on disk.")</p>
                        </div>
                    </div>
                    <div class="probe-action-row">
                        <button type="button" class="forge-btn forge-btn-outline" @onclick="OnInitGitRequested" disabled="@IsProbing">
                            📁 Create Directory &amp; Initialize Git
                        </button>
                    </div>
                }
                else if (!ProbeResult.IsGitRepository)
                {
                    <div class="probe-feedback-header">
                        <span class="feedback-icon">⚠️</span>
                        <div>
                            <strong class="feedback-title">No Git Repository Found</strong>
                            <p class="feedback-desc">Directory exists, but no Git worktree or <code>.git</code> metadata was detected.</p>
                        </div>
                    </div>
                    <div class="probe-action-row">
                        <button type="button" class="forge-btn forge-btn-primary" @onclick="OnInitGitRequested" disabled="@IsProbing">
                            ⚡ Initialize Git Repository (git init)
                        </button>
                    </div>
                }
                else
                {
                    <div class="probe-feedback-header">
                        <span class="feedback-icon">✅</span>
                        <div>
                            <strong class="feedback-title">Valid Git Repository Detected</strong>
                            <p class="feedback-desc">
                                Git worktree validated. Found @ProbeResult.AvailableBranches.Count local branch@(ProbeResult.AvailableBranches.Count == 1 ? "" : "es").
                            </p>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <!-- Remote Forge Projects Browser -->
        <div class="remote-forge-panel mb-4">
            @if (_isLoadingRemote)
            {
                <div class="probe-feedback-card probe-warning">
                    <div class="probe-feedback-header">
                        <span class="spinner-inline"></span>
                        <div>
                            <strong class="feedback-title">Querying Remote Forge</strong>
                            <p class="feedback-desc">Fetching accessible repositories and matching against local clones...</p>
                        </div>
                    </div>
                </div>
            }
            else if (_remoteState is null || !_remoteState.IsAuthenticated)
            {
                <div id="remote-connect-callout" class="probe-feedback-card probe-warning">
                    <div class="probe-feedback-header">
                        <span class="feedback-icon">☁️</span>
                        <div>
                            <strong class="feedback-title">Connect a Remote Forge</strong>
                            <p class="feedback-desc">
                                No remote hosting provider is currently authenticated. Connect @(_remoteState?.ProviderDisplayName ?? "GitHub") in Settings to browse accessible repositories, detect local copies, or clone private projects with 1 click.
                            </p>
                        </div>
                    </div>
                    <div class="probe-action-row">
                        <a class="forge-btn forge-btn-primary" href="/settings">⚙️ Connect @(_remoteState?.ProviderDisplayName ?? "GitHub") in Settings</a>
                    </div>
                </div>
            }
            else
            {
                <div class="discovery-panel-header mb-3">
                    <div class="remote-provider-identity">
                        <span class="feedback-icon">☁️</span>
                        <div>
                            <strong class="feedback-title">
                                @_remoteState.ProviderDisplayName
                                @if (!string.IsNullOrWhiteSpace(_remoteState.AuthenticatedUsername))
                                {
                                    <span class="forge-badge badge-teal ml-2">@@@_remoteState.AuthenticatedUsername</span>
                                }
                            </strong>
                            <span class="form-hint">@_remoteState.Repositories.Count accessible repositor@(_remoteState.Repositories.Count == 1 ? "y" : "ies")</span>
                        </div>
                    </div>
                    <button id="refresh-remote-repos-btn"
                            type="button"
                            class="forge-btn forge-btn-secondary forge-btn-sm"
                            @onclick="LoadRemoteRepositoriesAsync"
                            disabled="@_isLoadingRemote">
                        🔄 Refresh Remote Repos
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(_remoteState.ErrorMessage))
                {
                    <div class="probe-feedback-card probe-error mb-3">
                        <div class="probe-feedback-header">
                            <span class="feedback-icon">❌</span>
                            <div>
                                <strong class="feedback-title">Failed to Load Remote Repositories</strong>
                                <p class="feedback-desc">@_remoteState.ErrorMessage</p>
                            </div>
                        </div>
                    </div>
                }

                <div class="form-group mb-3">
                    <input id="remote-repo-search-input"
                           type="text"
                           class="form-control-dark"
                           placeholder="Filter remote repositories by name, owner, or description..."
                           value="@_remoteSearchQuery"
                           @oninput="HandleRemoteSearchInput" />
                </div>

                @if (_filteredRemoteRepositories.Count == 0)
                {
                    <div class="remote-empty-state">
                        No remote repositories match the current filter.
                    </div>
                }
                else
                {
                    <div class="remote-repo-list">
                        @foreach (var item in _filteredRemoteRepositories)
                        {
                            var isCloneOpen = _cloneCandidate?.Repository.Id == item.Repository.Id;
                            <div class="remote-repo-card @(isCloneOpen ? "selected" : "")">
                                <div class="remote-repo-card-main">
                                    <div class="remote-repo-info">
                                        <div class="remote-repo-title-row">
                                            <strong class="remote-repo-name">@item.Repository.FullName</strong>
                                            <span class="forge-badge @(item.Repository.IsPrivate ? "badge-private" : "badge-public")">
                                                @(item.Repository.IsPrivate ? "🔒 Private" : "🌐 Public")
                                            </span>
                                            <span class="forge-badge badge-branch">🌿 @item.Repository.DefaultBranch</span>
                                            @if (item.Repository.UpdatedAt.HasValue)
                                            {
                                                <span class="remote-repo-updated">Updated @item.Repository.UpdatedAt.Value.ToString("yyyy-MM-dd")</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(item.Repository.Description))
                                        {
                                            <p class="remote-repo-desc">@item.Repository.Description</p>
                                        }
                                        @if (item.LocalMatch is not null)
                                        {
                                            <div class="remote-local-status-row">
                                                <span class="forge-badge badge-local-match" title="@item.LocalMatch.FullPath">
                                                    ✅ Local copy found
                                                </span>
                                                <span class="font-mono remote-local-path">@item.LocalMatch.DisplayPath</span>
                                            </div>
                                        }
                                    </div>
                                    <div class="remote-repo-actions">
                                        @if (item.LocalMatch is not null)
                                        {
                                            <button type="button"
                                                    class="forge-btn forge-btn-primary remote-select-local-btn"
                                                    @onclick="() => SelectMatchedLocalRepositoryAsync(item)"
                                                    disabled="@(_isCloning || IsProbing)">
                                                Select Local Repository
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="forge-btn forge-btn-primary remote-clone-btn"
                                                    @onclick="() => OpenCloneDrawer(item)"
                                                    disabled="@_isCloning">
                                                📥 Clone &amp; Onboard
                                            </button>
                                        }
                                    </div>
                                </div>

                                @if (isCloneOpen)
                                {
                                    <div id="clone-drawer" class="clone-drawer mt-3">
                                        <div class="form-group">
                                            <label class="form-label" for="clone-target-path-input">
                                                Clone Target Directory <span class="text-danger">*</span>
                                            </label>
                                            <input id="clone-target-path-input"
                                                   type="text"
                                                   class="form-control-dark font-mono"
                                                   value="@_cloneTargetPath"
                                                   @oninput="HandleCloneTargetPathInput"
                                                   disabled="@_isCloning" />
                                            <span class="form-hint">Cloned using ephemeral @(_remoteState?.ProviderDisplayName ?? "remote forge") credentials without persisting tokens into .git/config.</span>
                                        </div>

                                        @if (_clonePathValidation is { IsValid: false })
                                        {
                                            <div id="clone-path-validation-error" class="clone-validation-error mt-2">
                                                ⚠️ @_clonePathValidation.ErrorMessage
                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(_cloneErrorMessage))
                                        {
                                            <div id="clone-execution-error" class="clone-validation-error mt-2">
                                                ❌ @_cloneErrorMessage
                                            </div>
                                        }

                                        <div class="clone-drawer-actions mt-3">
                                            <button type="button"
                                                    class="forge-btn forge-btn-secondary"
                                                    @onclick="CloseCloneDrawer"
                                                    disabled="@_isCloning">
                                                Cancel
                                            </button>
                                            <button id="confirm-clone-btn"
                                                    type="button"
                                                    class="forge-btn forge-btn-primary"
                                                    @onclick="ExecuteCloneAsync"
                                                    disabled="@(_isCloning || _clonePathValidation?.IsValid != true)">
                                                @if (_isCloning)
                                                {
                                                    <span class="spinner-inline"></span>
                                                    <span>Cloning...</span>
                                                }
                                                else
                                                {
                                                    <span>📥 Clone &amp; Continue</span>
                                                }
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>
    }

    <!-- Workspace Friendly Name -->
    <div class="form-group mt-4">
        <label class="form-label" for="workspace-name-input">
            Workspace Display Name <span class="text-danger">*</span>
        </label>
        <input id="workspace-name-input" 
               type="text" 
               class="form-control-dark" 
               placeholder="e.g. My Application" 
               @bind="Model.Name" 
               @bind:event="oninput" />
        <span class="form-hint">Friendly identifier displayed across top bar, telemetry dashboard, and task DAG.</span>
    </div>

    <!-- Workspace Branding & Visual Identity (Optional) -->
    <div class="form-group mt-4 p-3" style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); border-left: 4px solid @WorkspacePresentationHelper.ResolveColor(Model.ColorCode, "#6366f1");">
        <label class="form-label mb-2" style="font-weight: 600;">
            🎨 Visual Identity &amp; Motif (Optional)
        </label>
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; align-items: start;">
            <!-- Emoji Selection -->
            <div>
                <span class="form-hint mb-1" style="display: block;">Emoji Icon</span>
                <div style="display: flex; gap: 0.35rem; align-items: center; margin-bottom: 0.5rem;">
                    <span style="font-size: 1.35rem; min-width: 1.8rem; text-align: center;">@(WorkspacePresentationHelper.ResolveEmoji(Model.Emoji))</span>
                    <input type="text" class="form-control-dark font-mono" maxlength="16" style="max-width: 90px;" @bind="Model.Emoji" @bind:event="oninput" placeholder="📁" />
                </div>
                <div style="display: flex; flex-wrap: wrap; gap: 0.3rem;">
                    @foreach (var preset in WorkspacePresentationHelper.EmojiPresets.Take(6))
                    {
                        var isSelected = Model.Emoji == preset.Emoji;
                        <button type="button"
                                class="forge-btn @(isSelected ? "forge-btn-primary" : "forge-btn-outline")"
                                style="padding: 0.2rem 0.45rem; font-size: 0.95rem;"
                                title="@preset.Label"
                                @onclick="() => Model.Emoji = preset.Emoji">
                            @preset.Emoji
                        </button>
                    }
                </div>
            </div>

            <!-- Color Selection -->
            <div>
                <span class="form-hint mb-1" style="display: block;">Brand Color Accent</span>
                <div style="display: flex; gap: 0.35rem; align-items: center; margin-bottom: 0.5rem;">
                    <input type="color" value="@(WorkspacePresentationHelper.IsValidHexColor(Model.ColorCode) ? Model.ColorCode : "#6366f1")" @onchange="(e) => { if (e.Value is string c && !string.IsNullOrWhiteSpace(c)) Model.ColorCode = c; }" style="width: 34px; height: 32px; border: none; border-radius: 4px; cursor: pointer; background: transparent;" />
                    <input type="text" class="form-control-dark font-mono" maxlength="32" style="max-width: 110px;" @bind="Model.ColorCode" @bind:event="oninput" placeholder="#6366f1" />
                </div>
                <div style="display: flex; flex-wrap: wrap; gap: 0.4rem;">
                    @foreach (var preset in WorkspacePresentationHelper.ColorPresets.Take(6))
                    {
                        var isSelected = string.Equals(Model.ColorCode, preset.HexCode, StringComparison.OrdinalIgnoreCase);
                        <button type="button"
                                style="background: @preset.HexCode; width: 24px; height: 24px; border-radius: 50%; border: 2px solid @(isSelected ? "#ffffff" : "transparent"); cursor: pointer;"
                                title="@preset.Name"
                                @onclick="() => Model.ColorCode = preset.HexCode">
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private enum IntakeChannel
    {
        Local,
        Remote
    }

    [Parameter]
    public WorkspaceCreationModel Model { get; set; } = default!;

    [Parameter]
    public RepositoryProbeResult? ProbeResult { get; set; }

    [Parameter]
    public bool IsProbing { get; set; }

    [Parameter]
    public EventCallback OnProbeRequested { get; set; }

    [Parameter]
    public EventCallback OnInitGitRequested { get; set; }

    [Parameter]
    public EventCallback OnRemoteRepositoryOnboarded { get; set; }

    private IntakeChannel _activeChannel = IntakeChannel.Local;

    private bool _isLoadingLocal;
    private string? _localDiscoveryError;
    private string _localSearchQuery = string.Empty;
    private IReadOnlyList<LocalRepositoryOption> _localRepositories = Array.Empty<LocalRepositoryOption>();
    private IReadOnlyList<LocalRepositoryOption> _filteredLocalRepositories = Array.Empty<LocalRepositoryOption>();

    private bool _isLoadingRemote;
    private RemoteForgeState? _remoteState;
    private string _remoteSearchQuery = string.Empty;
    private IReadOnlyList<RemoteRepositoryItem> _filteredRemoteRepositories = Array.Empty<RemoteRepositoryItem>();

    private RemoteRepositoryItem? _cloneCandidate;
    private string _cloneTargetPath = string.Empty;
    private TargetPathValidationResult? _clonePathValidation;
    private bool _isCloning;
    private string? _cloneErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadLocalRepositoriesAsync(forceRefresh: false);
    }

    private async Task SelectChannelAsync(IntakeChannel channel)
    {
        _activeChannel = channel;
        if (channel == IntakeChannel.Remote && _remoteState is null && !_isLoadingRemote)
        {
            await LoadRemoteRepositoriesAsync();
        }
    }

    private async Task LoadLocalRepositoriesAsync(bool forceRefresh)
    {
        _isLoadingLocal = true;
        _localDiscoveryError = null;
        StateHasChanged();

        try
        {
            _localRepositories = await IntakeService.LoadLocalRepositoriesAsync(forceRefresh);
            _filteredLocalRepositories = IntakeService.FilterLocalRepositories(_localRepositories, _localSearchQuery);
            if (forceRefresh)
            {
                _remoteState = null;
                _filteredRemoteRepositories = Array.Empty<RemoteRepositoryItem>();
            }
        }
        catch (Exception ex)
        {
            _localDiscoveryError = ex.Message;
        }
        finally
        {
            _isLoadingLocal = false;
            StateHasChanged();
        }
    }

    private void HandleLocalSearchInput(ChangeEventArgs e)
    {
        _localSearchQuery = e.Value?.ToString() ?? string.Empty;
        _filteredLocalRepositories = IntakeService.FilterLocalRepositories(_localRepositories, _localSearchQuery);
    }

    private async Task HandleLocalRepositorySelected(ChangeEventArgs e)
    {
        var selectedPath = e.Value?.ToString() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(selectedPath))
        {
            return;
        }

        var pathComparison = OperatingSystem.IsWindows()
            ? StringComparison.OrdinalIgnoreCase
            : StringComparison.Ordinal;
        var selectedRepo = _localRepositories.FirstOrDefault(r =>
            string.Equals(r.FullPath, selectedPath, pathComparison));

        Model.RepositoryPath = selectedPath;
        Model.Name = selectedRepo?.Name ?? IntakeService.DeriveWorkspaceNameFromPath(selectedPath);
        Model.GitHubSettings = null;
        await OnProbeRequested.InvokeAsync();
    }

    private async Task LoadRemoteRepositoriesAsync()
    {
        _isLoadingRemote = true;
        StateHasChanged();

        try
        {
            _remoteState = await IntakeService.LoadRemoteForgeStateAsync(_localRepositories);
            _filteredRemoteRepositories = IntakeService.FilterRemoteRepositories(_remoteState.Repositories, _remoteSearchQuery);
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Exception ex)
        {
            _remoteState = new RemoteForgeState(
                HasAvailableProvider: true,
                IsAuthenticated: true,
                ActiveProviderType: null,
                ProviderDisplayName: _remoteState?.ProviderDisplayName ?? "Remote Forge",
                AuthenticatedUsername: null,
                Repositories: Array.Empty<RemoteRepositoryItem>(),
                ErrorMessage: ex.Message);
            _filteredRemoteRepositories = Array.Empty<RemoteRepositoryItem>();
        }
        finally
        {
            _isLoadingRemote = false;
            StateHasChanged();
        }
    }

    private void HandleRemoteSearchInput(ChangeEventArgs e)
    {
        _remoteSearchQuery = e.Value?.ToString() ?? string.Empty;
        if (_remoteState is not null)
        {
            _filteredRemoteRepositories = IntakeService.FilterRemoteRepositories(_remoteState.Repositories, _remoteSearchQuery);
        }
    }

    private async Task SelectMatchedLocalRepositoryAsync(RemoteRepositoryItem item)
    {
        if (item.LocalMatch is null)
        {
            return;
        }

        Model.RepositoryPath = item.LocalMatch.FullPath;
        Model.Name = string.IsNullOrWhiteSpace(Model.Name) ? item.Repository.Name : Model.Name;
        if (!string.IsNullOrWhiteSpace(item.Repository.DefaultBranch))
        {
            Model.DefaultBaseBranch = item.Repository.DefaultBranch;
        }
        Model.GitHubSettings = IntakeService.BuildGitHubSettingsIfApplicable(item.ProviderType, item.Repository);

        await OnRemoteRepositoryOnboarded.InvokeAsync();
    }

    private void OpenCloneDrawer(RemoteRepositoryItem item)
    {
        _cloneCandidate = item;
        _cloneErrorMessage = null;
        try
        {
            _cloneTargetPath = IntakeService.ResolveDefaultClonePath(item.Repository.Name);
        }
        catch (Exception ex)
        {
            _cloneTargetPath = string.Empty;
            _cloneErrorMessage = ex.Message;
        }

        _clonePathValidation = IntakeService.ValidateCloneTargetPath(_cloneTargetPath);
    }

    private void CloseCloneDrawer()
    {
        _cloneCandidate = null;
        _cloneTargetPath = string.Empty;
        _clonePathValidation = null;
        _cloneErrorMessage = null;
    }

    private void HandleCloneTargetPathInput(ChangeEventArgs e)
    {
        _cloneTargetPath = e.Value?.ToString() ?? string.Empty;
        _cloneErrorMessage = null;
        _clonePathValidation = IntakeService.ValidateCloneTargetPath(_cloneTargetPath);
    }

    private async Task ExecuteCloneAsync()
    {
        if (_cloneCandidate is null || _isCloning)
        {
            return;
        }

        _clonePathValidation = IntakeService.ValidateCloneTargetPath(_cloneTargetPath);
        if (!_clonePathValidation.IsValid)
        {
            return;
        }

        _isCloning = true;
        _cloneErrorMessage = null;
        StateHasChanged();

        try
        {
            var result = await IntakeService.CloneRemoteRepositoryAsync(
                _cloneCandidate.ProviderType,
                _cloneCandidate.Repository,
                _cloneTargetPath);

            if (!result.Success)
            {
                _cloneErrorMessage = result.ErrorMessage ?? "Failed to clone remote repository.";
                return;
            }

            Model.RepositoryPath = result.TargetPath;
            if (string.IsNullOrWhiteSpace(Model.Name))
            {
                Model.Name = result.SuggestedWorkspaceName;
            }
            Model.DefaultBaseBranch = result.DefaultBaseBranch;
            Model.GitHubSettings = result.GitHubSettings;
            CloseCloneDrawer();

            await OnRemoteRepositoryOnboarded.InvokeAsync();
        }
        catch (Exception ex)
        {
            _cloneErrorMessage = ex.Message;
        }
        finally
        {
            _isCloning = false;
            StateHasChanged();
        }
    }

    private void HandlePathInput(ChangeEventArgs e)
    {
        Model.RepositoryPath = e.Value?.ToString() ?? string.Empty;
        Model.GitHubSettings = null;
        if (string.IsNullOrWhiteSpace(Model.Name) && !string.IsNullOrWhiteSpace(Model.RepositoryPath))
        {
            Model.Name = IntakeService.DeriveWorkspaceNameFromPath(Model.RepositoryPath);
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(Model.RepositoryPath) && !IsProbing)
        {
            await OnProbeRequested.InvokeAsync();
        }
    }
}

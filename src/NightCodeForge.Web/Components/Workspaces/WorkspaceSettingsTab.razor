@namespace NightCodeForge.Web.Components.Workspaces
@using NightCodeForge.Core.Domain
@using NightCodeForge.Core.Interfaces
@using NightCodeForge.Core.Repositories
@using NightCodeForge.Web.Services
@inject WorkspaceStateService WorkspaceState
@inject IWorkspaceRepository WorkspaceRepo
@inject IWslMetadataService WslService
@inject IGitMirrorSyncService MirrorSyncService
@inject ToastService ToastService

<div class="forge-card mt-3" style="padding: 2rem;">
    <!-- Header -->
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem; flex-wrap: wrap; gap: 1.5rem;">
        <div>
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.35rem; flex-wrap: wrap;">
                <span style="font-size: 1.75rem;">🏢</span>
                <h3 style="font-weight: 700; font-size: 1.35rem; margin: 0; color: var(--text-primary);">
                    Repository &amp; Execution Confinement
                </h3>
                <span class="forge-badge badge-indigo" style="padding: 0.3rem 0.75rem; font-size: 0.82rem;">
                    Workspace Scoped
                </span>
            </div>
            <p style="margin: 0; font-size: 0.92rem; color: var(--text-secondary); line-height: 1.6; max-width: 820px;">
                Configure repository paths, base branches, container execution confinement, timeouts, and Git Ext4 mirror synchronization.
            </p>
        </div>
        <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
            <button type="button" class="forge-btn forge-btn-outline" style="padding: 0.65rem 1.25rem; font-size: 0.92rem;" @onclick="LaunchWizard">
                🧙 Creation Wizard
            </button>
            <button type="button" class="forge-btn forge-btn-primary" style="padding: 0.65rem 1.4rem; font-size: 0.92rem; font-weight: 600;" @onclick="SaveWorkspaceAsync" disabled="_isSaving || WorkspaceState.ActiveWorkspace == null">
                @(_isSaving ? "Saving..." : "💾 Save Workspace Settings")
            </button>
        </div>
    </div>

    @if (WorkspaceState.ActiveWorkspace != null)
    {
        var ws = WorkspaceState.ActiveWorkspace;

        <!-- Core Repository & Confinement Configuration -->
        <div class="forge-subcard" style="padding: 2rem; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); margin-bottom: 2rem; box-shadow: var(--shadow-sm);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 1rem; flex-wrap: wrap; gap: 0.75rem;">
                <div>
                    <strong style="font-size: 1.25rem; color: var(--text-primary); font-weight: 700;">@ws.Name</strong>
                    <span style="display: block; font-size: 0.85rem; color: var(--text-muted); margin-top: 0.2rem;">Execution sandbox parameters and build timeouts</span>
                </div>
                <span class="forge-badge badge-teal" style="font-size: 0.85rem; padding: 0.3rem 0.75rem;">ID: @ws.Id</span>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; font-size: 0.92rem;">
                <!-- Host Repository Path (Read-Only) -->
                <div>
                    <label class="forge-field-label">Host Repository Path</label>
                    <input type="text" class="forge-input font-mono" style="width: 100%;" value="@ws.RepositoryPath" readonly disabled />
                </div>

                <!-- Base Branch Target -->
                <div>
                    <label class="forge-field-label">Default Base Branch</label>
                    <input type="text" class="forge-input font-mono" style="width: 100%;" @bind="ws.DefaultBaseBranch" placeholder="e.g. main or master" />
                </div>

                <!-- Execution Mode -->
                <div>
                    <label class="forge-field-label">Execution Mode</label>
                    <select class="forge-input" style="width: 100%;" @bind="ws.ExecutionMode">
                        <option value="@ExecutionMode.BareHost">BareHost (Unrestricted Local Execution)</option>
                        <option value="@ExecutionMode.WslDirect">WslDirect (Native Linux inside WSL2)</option>
                        <option value="@ExecutionMode.ContainerSandbox">ContainerSandbox (Rootless Docker/Podman)</option>
                    </select>
                </div>

                <!-- Container Image (Visible when ContainerSandbox) -->
                <div>
                    <label class="forge-field-label">Container Image</label>
                    <input type="text" class="forge-input font-mono" style="width: 100%;" @bind="ws.ContainerImage" placeholder="mcr.microsoft.com/dotnet/sdk:8.0" />
                </div>

                <!-- Build Timeout -->
                <div>
                    <label class="forge-field-label">Build Timeout (Seconds)</label>
                    <input type="number" min="10" max="1800" step="15" class="forge-input font-mono" style="width: 100%;" @bind="ws.BuildTimeoutSeconds" />
                </div>

                <!-- Test Timeout -->
                <div>
                    <label class="forge-field-label">Test Timeout (Seconds)</label>
                    <input type="number" min="10" max="3600" step="30" class="forge-input font-mono" style="width: 100%;" @bind="ws.TestTimeoutSeconds" />
                </div>
            </div>
        </div>

        <!-- WSL2 & Container Environment Status -->
        <div class="forge-subcard" style="padding: 2rem; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); margin-bottom: 2rem; box-shadow: var(--shadow-sm);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 1rem; flex-wrap: wrap; gap: 1rem;">
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <span style="font-size: 1.5rem;">🐧</span>
                    <div>
                        <strong style="font-size: 1.15rem; color: var(--text-primary); font-weight: 700;">WSL2 Native Environment &amp; Toolchain</strong>
                        <span style="display: block; font-size: 0.85rem; color: var(--text-muted); margin-top: 0.15rem;">Host Linux distribution integration</span>
                    </div>
                </div>
                <button type="button" class="forge-btn forge-btn-outline" style="padding: 0.45rem 1rem; font-size: 0.85rem;" @onclick="ProbeWslAsync">
                    🔄 Re-probe WSL2
                </button>
            </div>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; margin-top: 1.25rem;">
                <div>
                    <label class="forge-field-label">Default Distribution</label>
                    <div class="font-mono" style="padding: 0.7rem 1rem; background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); color: var(--accent-teal); font-weight: 700; font-size: 0.95rem;">
                        @(_wslDistro ?? "Probing...")
                    </div>
                </div>
                <div>
                    <label class="forge-field-label">Linux User</label>
                    <div class="font-mono" style="padding: 0.7rem 1rem; background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); color: var(--text-primary); font-weight: 600; font-size: 0.95rem;">
                        @(_wslUser ?? "Probing...")
                    </div>
                </div>
                <div>
                    <label class="forge-field-label">WSL Container Runtime</label>
                    <label class="forge-checkbox-tile" style="margin-top: 0; min-height: 44px; display: flex; align-items: center; gap: 0.75rem; padding: 0.65rem 1rem;">
                        <input type="checkbox" @bind="ws.UseWslForContainers" style="width: 1.15rem; height: 1.15rem; cursor: pointer;" />
                        <span style="font-size: 0.92rem; font-weight: 600; color: var(--text-primary);">Use WSL2 For Containers</span>
                    </label>
                </div>
            </div>
        </div>

        <!-- Git Ext4 Mirror Status & Sync -->
        <div class="forge-subcard" style="padding: 2rem; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 1rem;">
                <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
                    <span style="font-size: 1.5rem;">🪞</span>
                    <strong style="font-size: 1.15rem; color: var(--text-primary); font-weight: 700;">Git Ext4 Mirror Synchronization</strong>
                    <span class="forge-badge badge-teal" style="font-size: 0.85rem; padding: 0.3rem 0.75rem;">updateInstead Active</span>
                </div>
                <button type="button" class="forge-btn forge-btn-primary" style="padding: 0.65rem 1.4rem; font-size: 0.92rem; font-weight: 600;" @onclick="SyncMirrorAsync" disabled="_isSyncing">
                    @(_isSyncing ? "Syncing Mirror..." : "🔄 Sync Ext4 Mirror Now")
                </button>
            </div>
            <p style="margin: 0 0 1.25rem 0; font-size: 0.92rem; color: var(--text-secondary); line-height: 1.6; max-width: 820px;">
                Isolated Linux Ext4 filesystem mirror preventing Windows NTFS lock contention and enabling lightning-fast container I/O.
            </p>
            <div class="font-mono" style="padding: 1rem 1.25rem; background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); font-size: 0.92rem; color: var(--text-primary); word-break: break-all;">
                @(ws.Ext4MirrorPath ?? "Standard Ext4 Clone Mirror (auto-provisioned)")
            </div>
        </div>
    }
    else
    {
        <div style="padding: 3.5rem 2rem; text-align: center; border: 2px dashed var(--border-subtle); border-radius: var(--radius-xl); background: var(--bg-surface);">
            <div style="font-size: 2.5rem; margin-bottom: 1rem;">🏢</div>
            <p style="font-size: 1.15rem; color: var(--text-secondary); margin-bottom: 1.5rem;">No active workspace selected.</p>
            <button type="button" class="forge-btn forge-btn-primary" style="padding: 0.65rem 1.4rem; font-size: 0.95rem; font-weight: 600;" @onclick="LaunchWizard">
                ➕ Onboard New Repository
            </button>
        </div>
    }
</div>

@code {
    private bool _isSaving;
    private bool _isSyncing;
    private string? _wslDistro;
    private string? _wslUser;

    protected override void OnInitialized()
    {
        ProbeWsl();
    }

    private void ProbeWsl()
    {
        try
        {
            _wslDistro = WslService.GetDefaultDistributionName();
            _wslUser = WslService.GetDefaultUserName();
        }
        catch (Exception)
        {
            _wslDistro = "Not Available";
            _wslUser = "N/A";
        }
    }

    private void ProbeWslAsync()
    {
        try
        {
            WslService.ClearCache();
            ProbeWsl();
            ToastService.Show("WSL2 Probed", $"Active distribution: {_wslDistro}", ToastLevel.Info);
        }
        catch (Exception ex)
        {
            ToastService.Show("WSL2 Probe Error", ex.Message, ToastLevel.Warning);
        }
    }

    private async Task SaveWorkspaceAsync()
    {
        if (WorkspaceState.ActiveWorkspace == null || _isSaving) return;
        _isSaving = true;

        try
        {
            await WorkspaceRepo.UpdateAsync(WorkspaceState.ActiveWorkspace);
            ToastService.Show("Workspace Settings Saved", "Repository execution confinement parameters updated.", ToastLevel.Success);
        }
        catch (Exception ex)
        {
            ToastService.Show("Error Saving Settings", ex.Message, ToastLevel.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SyncMirrorAsync()
    {
        if (WorkspaceState.ActiveWorkspace == null || _isSyncing) return;
        _isSyncing = true;

        try
        {
            var ws = WorkspaceState.ActiveWorkspace;
            if (!string.IsNullOrWhiteSpace(ws.Ext4MirrorPath))
            {
                await MirrorSyncService.FetchFromHostAsync(ws.Ext4MirrorPath, ws.DefaultBaseBranch);
                ToastService.Show("Git Mirror Synced", "Ext4 mirror successfully updated from host repository.", ToastLevel.Success);
            }
            else
            {
                ToastService.Show("No Mirror Path", "This workspace does not have an isolated Ext4 mirror path configured.", ToastLevel.Info);
            }
        }
        catch (Exception ex)
        {
            ToastService.Show("Mirror Sync Error", ex.Message, ToastLevel.Error);
        }
        finally
        {
            _isSyncing = false;
        }
    }

    private void LaunchWizard()
    {
        WorkspaceState.RequestOpenWizard();
    }
}

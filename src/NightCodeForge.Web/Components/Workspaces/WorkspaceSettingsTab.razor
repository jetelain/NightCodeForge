@namespace NightCodeForge.Web.Components.Workspaces
@using Microsoft.Extensions.Logging
@using NightCodeForge.Core.Domain
@using NightCodeForge.Core.Interfaces
@using NightCodeForge.Core.Repositories
@using NightCodeForge.Web.Services
@inject WorkspaceStateService WorkspaceState
@inject IWorkspaceRepository WorkspaceRepo
@inject IWslMetadataService WslService
@inject IGitMirrorSyncService MirrorSyncService
@inject IWorkspaceSkillsServiceFactory SkillsServiceFactory
@inject ILogger<WorkspaceSettingsTab> Logger
@inject ToastService ToastService

<div class="forge-card mt-3" style="padding: 2rem;">
    <!-- Header -->
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem; flex-wrap: wrap; gap: 1.5rem;">
        <div>
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.35rem; flex-wrap: wrap;">
                <span style="font-size: 1.75rem;">🏢</span>
                <h3 style="font-weight: 700; font-size: 1.35rem; margin: 0; color: var(--text-primary);">
                    Repository &amp; Execution Confinement
                </h3>
                <span class="forge-badge badge-indigo" style="padding: 0.3rem 0.75rem; font-size: 0.82rem;">
                    Workspace Scoped
                </span>
            </div>
            <p style="margin: 0; font-size: 0.92rem; color: var(--text-secondary); line-height: 1.6; max-width: 820px;">
                Configure repository paths, base branches, container execution confinement, timeouts, and Git Ext4 mirror synchronization.
            </p>
        </div>
        <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
            <button type="button" class="forge-btn forge-btn-outline" style="padding: 0.65rem 1.25rem; font-size: 0.92rem;" @onclick="LaunchWizard">
                🧙 Creation Wizard
            </button>
            <button type="button" class="forge-btn forge-btn-primary" style="padding: 0.65rem 1.4rem; font-size: 0.92rem; font-weight: 600;" @onclick="SaveWorkspaceAsync" disabled="@(_isSaving || WorkspaceState.ActiveWorkspace == null)">
                @(_isSaving ? "Saving..." : "💾 Save Workspace Settings")
            </button>
        </div>
    </div>

    @if (WorkspaceState.ActiveWorkspace != null)
    {
        var ws = WorkspaceState.ActiveWorkspace;

        <!-- Workspace Identity & Branding -->
        <div class="forge-subcard" id="workspace-identity-section" style="padding: 2rem; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); margin-bottom: 2rem; box-shadow: var(--shadow-sm); border-left: 5px solid @WorkspacePresentationHelper.ResolveColor(ws.ColorCode);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 1rem; flex-wrap: wrap; gap: 0.75rem;">
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <span style="font-size: 1.75rem;">🎨</span>
                    <div>
                        <strong style="font-size: 1.25rem; color: var(--text-primary); font-weight: 700;">Workspace Identity &amp; Branding</strong>
                        <span style="display: block; font-size: 0.85rem; color: var(--text-muted); margin-top: 0.2rem;">Customize display name, visual motif emoji, and accent branding color</span>
                    </div>
                </div>
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <span class="forge-badge" style="background: rgba(99, 102, 241, 0.15); color: var(--text-primary); border: 1px solid var(--border-subtle); font-size: 0.85rem;">
                        @(WorkspacePresentationHelper.ResolveEmoji(ws.Emoji)) @ws.Name
                    </span>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.75rem; margin-bottom: 1.5rem;">
                <!-- Workspace Name -->
                <div>
                    <label class="forge-field-label" for="workspace-name-edit">Workspace Name <span style="color: var(--accent-rose);">*</span></label>
                    <input id="workspace-name-edit" type="text" class="forge-input" style="width: 100%; font-weight: 600;" @bind="ws.Name" @bind:event="oninput" placeholder="e.g. My Workspace" />
                    @if (string.IsNullOrWhiteSpace(ws.Name))
                    {
                        <span class="text-danger" style="font-size: 0.8rem; margin-top: 0.35rem; display: block;">Workspace name is required.</span>
                    }
                </div>

                <!-- Custom Emoji & Input -->
                <div>
                    <label class="forge-field-label" for="workspace-emoji-input">Visual Emoji Icon</label>
                    <div style="display: flex; gap: 0.5rem; align-items: center;">
                        <span style="font-size: 1.5rem; min-width: 2.2rem; text-align: center;">@(WorkspacePresentationHelper.ResolveEmoji(ws.Emoji))</span>
                        <input id="workspace-emoji-input" type="text" maxlength="16" class="forge-input font-mono" style="max-width: 120px;" @bind="ws.Emoji" @bind:event="oninput" placeholder="e.g. 🚀" />
                        <button type="button" class="forge-btn forge-btn-secondary" style="padding: 0.4rem 0.75rem; font-size: 0.82rem;" @onclick="() => ws.Emoji = null" title="Reset to default folder">
                            Reset
                        </button>
                    </div>
                </div>

                <!-- Color Code Input & Color Picker -->
                <div>
                    <label class="forge-field-label" for="workspace-color-input">Color Code Accent</label>
                    <div style="display: flex; gap: 0.5rem; align-items: center;">
                        <input id="workspace-color-native" type="color" value="@(WorkspacePresentationHelper.IsValidHexColor(ws.ColorCode) ? ws.ColorCode : "#6366f1")" @onchange="OnNativeColorChanged" style="width: 42px; height: 38px; border: none; border-radius: 6px; cursor: pointer; background: transparent;" />
                        <input id="workspace-color-input" type="text" maxlength="32" class="forge-input font-mono" style="flex: 1;" @bind="ws.ColorCode" @bind:event="oninput" placeholder="#6366f1" />
                        <button type="button" class="forge-btn forge-btn-secondary" style="padding: 0.4rem 0.75rem; font-size: 0.82rem;" @onclick="() => ws.ColorCode = null" title="Reset to default theme color">
                            Reset
                        </button>
                    </div>
                </div>
            </div>

            <!-- Emoji Preset Quick Selection -->
            <div style="margin-bottom: 1.5rem;">
                <label class="forge-field-label" style="margin-bottom: 0.5rem; display: block;">Emoji Presets</label>
                <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                    @foreach (var preset in WorkspacePresentationHelper.EmojiPresets)
                    {
                        var isSelected = ws.Emoji == preset.Emoji;
                        <button type="button"
                                class="forge-btn @(isSelected ? "forge-btn-primary" : "forge-btn-outline")"
                                id="emoji-preset-@preset.Emoji"
                                style="padding: 0.35rem 0.75rem; font-size: 1.1rem; display: inline-flex; align-items: center; gap: 0.35rem;"
                                title="@preset.Label"
                                @onclick="() => ws.Emoji = preset.Emoji">
                            <span>@preset.Emoji</span>
                            <span style="font-size: 0.75rem; font-weight: normal;">@preset.Label.Split('/')[0].Trim()</span>
                        </button>
                    }
                </div>
            </div>

            <!-- Color Palette Preset Chips -->
            <div style="margin-bottom: 1.5rem;">
                <label class="forge-field-label" style="margin-bottom: 0.5rem; display: block;">Brand Color Palette</label>
                <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
                    @foreach (var preset in WorkspacePresentationHelper.ColorPresets)
                    {
                        var isSelected = string.Equals(ws.ColorCode, preset.HexCode, StringComparison.OrdinalIgnoreCase);
                        <button type="button"
                                class="color-preset-chip"
                                id="color-preset-@(preset.Name.Replace(" ", "-").ToLowerInvariant())"
                                style="background: @preset.HexCode; width: 36px; height: 36px; border-radius: 50%; border: 3px solid @(isSelected ? "#ffffff" : "transparent"); box-shadow: @(isSelected ? $"0 0 0 2px {preset.HexCode}" : "var(--shadow-sm)"); cursor: pointer; display: flex; align-items: center; justify-content: center; transition: transform 0.15s ease;"
                                title="@preset.Name (@preset.HexCode)"
                                @onclick="() => ws.ColorCode = preset.HexCode">
                            @if (isSelected)
                            {
                                <span style="color: #ffffff; font-size: 0.9rem; font-weight: bold; text-shadow: 0 1px 2px rgba(0,0,0,0.6);">✓</span>
                            }
                        </button>
                    }
                </div>
            </div>

            <!-- Live Identity Preview Card -->
            <div style="padding: 1.25rem; background: var(--bg-input); border-radius: var(--radius-md); border: 1px solid var(--border-subtle);">
                <div style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin-bottom: 0.75rem;">
                    Live Identity Preview (Top Navigation &amp; Dashboard Card)
                </div>
                <div style="display: flex; gap: 1.5rem; align-items: center; flex-wrap: wrap;">
                    <!-- Nav Bar Preview Mock -->
                    <div id="preview-navbar-mock" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.4rem 0.85rem; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); border-left: 4px solid @WorkspacePresentationHelper.ResolveColor(ws.ColorCode);">
                        <span style="font-size: 1.15rem;">@(WorkspacePresentationHelper.ResolveEmoji(ws.Emoji))</span>
                        <strong style="color: var(--text-primary); font-size: 0.9rem;">@(string.IsNullOrWhiteSpace(ws.Name) ? "Workspace" : ws.Name)</strong>
                    </div>

                    <!-- Dashboard Preview Mock -->
                    <div id="preview-dashboard-mock" style="display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.5rem 1rem; background: var(--bg-surface); border-radius: var(--radius-md); border: 1px solid var(--border-subtle); border-left: 4px solid @WorkspacePresentationHelper.ResolveColor(ws.ColorCode);">
                        <span style="font-size: 1.3rem;">@(WorkspacePresentationHelper.ResolveEmoji(ws.Emoji))</span>
                        <div>
                            <div style="font-size: 0.95rem; font-weight: 700; color: var(--text-primary);">@(string.IsNullOrWhiteSpace(ws.Name) ? "Workspace" : ws.Name)</div>
                            <div style="font-size: 0.75rem; color: var(--text-secondary);">@ws.DefaultBaseBranch</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Core Repository & Confinement Configuration -->
        <div class="forge-subcard" style="padding: 2rem; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); margin-bottom: 2rem; box-shadow: var(--shadow-sm);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 1rem; flex-wrap: wrap; gap: 0.75rem;">
                <div>
                    <strong style="font-size: 1.25rem; color: var(--text-primary); font-weight: 700;">@ws.Name</strong>
                    <span style="display: block; font-size: 0.85rem; color: var(--text-muted); margin-top: 0.2rem;">Execution sandbox parameters and build timeouts</span>
                </div>
                <span class="forge-badge badge-teal" style="font-size: 0.85rem; padding: 0.3rem 0.75rem;">ID: @ws.Id</span>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; font-size: 0.92rem;">
                <!-- Host Repository Path (Read-Only) -->
                <div>
                    <label class="forge-field-label">Host Repository Path</label>
                    <input type="text" class="forge-input font-mono" style="width: 100%;" value="@ws.RepositoryPath" readonly disabled />
                </div>

                <!-- Base Branch Target -->
                <div>
                    <label class="forge-field-label">Default Base Branch</label>
                    <input type="text" class="forge-input font-mono" style="width: 100%;" @bind="ws.DefaultBaseBranch" placeholder="e.g. main or master" />
                </div>

                <!-- Execution Mode -->
                <div>
                    <label class="forge-field-label">Execution Mode</label>
                    <select class="forge-input" style="width: 100%;" @bind="ws.ExecutionMode">
                        <option value="@ExecutionMode.BareHost">BareHost (Unrestricted Local Execution)</option>
                        <option value="@ExecutionMode.WslDirect">WslDirect (Native Linux inside WSL2)</option>
                        <option value="@ExecutionMode.ContainerSandbox">ContainerSandbox (Rootless Docker/Podman)</option>
                    </select>
                </div>

                <!-- Container Image (Visible when ContainerSandbox) -->
                <div>
                    <label class="forge-field-label">Container Image</label>
                    <input type="text" class="forge-input font-mono" style="width: 100%;" @bind="ws.ContainerImage" placeholder="mcr.microsoft.com/dotnet/sdk:8.0" />
                </div>

                <!-- Build Timeout -->
                <div>
                    <label class="forge-field-label">Build Timeout (Seconds)</label>
                    <input type="number" min="10" max="1800" step="15" class="forge-input font-mono" style="width: 100%;" @bind="ws.BuildTimeoutSeconds" />
                </div>

                <!-- Test Timeout -->
                <div>
                    <label class="forge-field-label">Test Timeout (Seconds)</label>
                    <input type="number" min="10" max="3600" step="30" class="forge-input font-mono" style="width: 100%;" @bind="ws.TestTimeoutSeconds" />
                </div>
            </div>
        </div>

        <!-- Global Skills Injection & Stack Tooling -->
        <div class="forge-subcard" style="padding: 2rem; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); margin-bottom: 2rem; box-shadow: var(--shadow-sm);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 1rem; flex-wrap: wrap; gap: 1rem;">
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <span style="font-size: 1.5rem;">🧰</span>
                    <div>
                        <strong style="font-size: 1.15rem; color: var(--text-primary); font-weight: 700;">Global Skills Injection &amp; Stack Tooling</strong>
                        <span style="display: block; font-size: 0.85rem; color: var(--text-muted); margin-top: 0.15rem;">Zero-pollution modular skill injection and toolchain provisioning</span>
                    </div>
                </div>
                <span class="forge-badge @_skillsStatus.BadgeClass" style="font-size: 0.85rem; padding: 0.35rem 0.8rem;">
                    @_skillsStatus.BadgeText
                </span>
            </div>

            <div style="margin-bottom: 1.5rem;">
                <label class="forge-field-label" for="global-skills-injection-mode">Injection Mode Override (Stored in Local Database - Zero Git Diffs)</label>
                <select id="global-skills-injection-mode" class="forge-input" style="width: 100%; max-width: 480px;" value="@ws.GlobalSkillsInjectionMode" @onchange="OnInjectionModeChanged">
                    <option value="@GlobalSkillsInjectionMode.Inherit">Inherit (Follow .nightcodeforge/config.json; default enabled)</option>
                    <option value="@GlobalSkillsInjectionMode.ForceEnabled">ForceEnabled (Always inject skills regardless of repository config)</option>
                    <option value="@GlobalSkillsInjectionMode.ForceDisabled">ForceDisabled (Suppress all skills injection for this repository)</option>
                </select>
            </div>

            <div>
                <label class="forge-field-label" style="margin-bottom: 0.5rem; display: block;">Candidate Stack Skills &amp; Local Exclusions</label>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem;">
                    @foreach (var skill in _skillsStatus.CandidateSkills)
                    {
                        var isChecked = !skill.IsLocallyDisabled;
                        var toggleId = $"skill-toggle-{skill.Name}";
                        <div style="background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 1rem; display: flex; align-items: flex-start; gap: 0.75rem;">
                            <input type="checkbox" id="@toggleId" checked="@isChecked" @onchange="(e) => OnSkillToggled(skill.Name, (bool)(e.Value ?? false))" style="margin-top: 0.25rem;" />
                            <div>
                                <div style="display: flex; align-items: center; gap: 0.5rem;">
                                    <label for="@toggleId" style="cursor: pointer; margin: 0;">
                                        <strong style="font-size: 0.9rem; font-family: monospace; color: var(--text-primary);">@skill.Name</strong>
                                    </label>
                                    @if (skill.IsActive)
                                    {
                                        <span class="forge-badge badge-teal" style="font-size: 0.7rem;">Active</span>
                                    }
                                    else
                                    {
                                        <span class="forge-badge badge-amber" style="font-size: 0.7rem;">Excluded</span>
                                    }
                                </div>
                                <p style="font-size: 0.8rem; color: var(--text-secondary); margin: 0.25rem 0 0 0; line-height: 1.3;">
                                    @skill.Description
                                </p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- WSL2 & Container Environment Status -->
        <div class="forge-subcard" style="padding: 2rem; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); margin-bottom: 2rem; box-shadow: var(--shadow-sm);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 1px solid var(--border-subtle); padding-bottom: 1rem; flex-wrap: wrap; gap: 1rem;">
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <span style="font-size: 1.5rem;">🐧</span>
                    <div>
                        <strong style="font-size: 1.15rem; color: var(--text-primary); font-weight: 700;">WSL2 Native Environment &amp; Toolchain</strong>
                        <span style="display: block; font-size: 0.85rem; color: var(--text-muted); margin-top: 0.15rem;">Host Linux distribution integration</span>
                    </div>
                </div>
                <button type="button" class="forge-btn forge-btn-outline" style="padding: 0.45rem 1rem; font-size: 0.85rem;" @onclick="ProbeWslAsync">
                    🔄 Re-probe WSL2
                </button>
            </div>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; margin-top: 1.25rem;">
                <div>
                    <label class="forge-field-label">Default Distribution</label>
                    <div class="font-mono" style="padding: 0.7rem 1rem; background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); color: var(--accent-teal); font-weight: 700; font-size: 0.95rem;">
                        @(_wslDistro ?? "Probing...")
                    </div>
                </div>
                <div>
                    <label class="forge-field-label">Linux User</label>
                    <div class="font-mono" style="padding: 0.7rem 1rem; background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); color: var(--text-primary); font-weight: 600; font-size: 0.95rem;">
                        @(_wslUser ?? "Probing...")
                    </div>
                </div>
                <div>
                    <label class="forge-field-label">WSL Container Runtime</label>
                    <label class="forge-checkbox-tile" style="margin-top: 0; min-height: 44px; display: flex; align-items: center; gap: 0.75rem; padding: 0.65rem 1rem;">
                        <input type="checkbox" @bind="ws.UseWslForContainers" style="width: 1.15rem; height: 1.15rem; cursor: pointer;" />
                        <span style="font-size: 0.92rem; font-weight: 600; color: var(--text-primary);">Use WSL2 For Containers</span>
                    </label>
                </div>
            </div>
        </div>

        <!-- Git Ext4 Mirror Status & Sync -->
        <div class="forge-subcard" style="padding: 2rem; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 1rem;">
                <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
                    <span style="font-size: 1.5rem;">🪞</span>
                    <strong style="font-size: 1.15rem; color: var(--text-primary); font-weight: 700;">Git Ext4 Mirror Synchronization</strong>
                    <span class="forge-badge badge-teal" style="font-size: 0.85rem; padding: 0.3rem 0.75rem;">updateInstead Active</span>
                </div>
                <button type="button" class="forge-btn forge-btn-primary" style="padding: 0.65rem 1.4rem; font-size: 0.92rem; font-weight: 600;" @onclick="SyncMirrorAsync" disabled="@_isSyncing">
                    @(_isSyncing ? "Syncing Mirror..." : "🔄 Sync Ext4 Mirror Now")
                </button>
            </div>
            <p style="margin: 0 0 1.25rem 0; font-size: 0.92rem; color: var(--text-secondary); line-height: 1.6; max-width: 820px;">
                Isolated Linux Ext4 filesystem mirror preventing Windows NTFS lock contention and enabling lightning-fast container I/O.
            </p>
            <div class="font-mono" style="padding: 1rem 1.25rem; background: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); font-size: 0.92rem; color: var(--text-primary); word-break: break-all;">
                @(ws.Ext4MirrorPath ?? "Standard Ext4 Clone Mirror (auto-provisioned)")
            </div>
        </div>
    }
    else
    {
        <div style="padding: 3.5rem 2rem; text-align: center; border: 2px dashed var(--border-subtle); border-radius: var(--radius-xl); background: var(--bg-surface);">
            <div style="font-size: 2.5rem; margin-bottom: 1rem;">🏢</div>
            <p style="font-size: 1.15rem; color: var(--text-secondary); margin-bottom: 1.5rem;">No active workspace selected.</p>
            <button type="button" class="forge-btn forge-btn-primary" style="padding: 0.65rem 1.4rem; font-size: 0.95rem; font-weight: 600;" @onclick="LaunchWizard">
                ➕ Onboard New Repository
            </button>
        </div>
    }
</div>

@code {
    private bool _isSaving;
    private bool _isSyncing;
    private string? _wslDistro;
    private string? _wslUser;
    private WorkspaceSkillsResolutionStatus _skillsStatus = new(true, "Probing...", "badge-teal", Array.Empty<WorkspaceSkillItem>());

    protected override void OnInitialized()
    {
        ProbeWsl();
    }

    protected override async Task OnInitializedAsync()
    {
        await RefreshSkillsStatusAsync();
    }

    private async Task RefreshSkillsStatusAsync()
    {
        var ws = WorkspaceState.ActiveWorkspace;
        if (ws == null || string.IsNullOrWhiteSpace(ws.RepositoryPath)) return;

        try
        {
            var skillsService = SkillsServiceFactory.Create(ws, ws.RepositoryPath);
            var candidates = await skillsService.GetCandidateSkillsAsync();
            var projectConfig = CodeStackPresets.ResolveConfig(ws.RepositoryPath);
            _skillsStatus = WorkspaceSkillsUiHelper.GetStatus(ws, projectConfig, candidates);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Failed to refresh workspace skills status for {WorkspaceId} at {RepoPath}", ws.Id, ws.RepositoryPath);
        }
    }

    private async Task OnInjectionModeChanged(ChangeEventArgs e)
    {
        var ws = WorkspaceState.ActiveWorkspace;
        if (ws == null) return;
        if (Enum.TryParse<GlobalSkillsInjectionMode>(e.Value?.ToString(), out var mode))
        {
            ws.GlobalSkillsInjectionMode = mode;
            await RefreshSkillsStatusAsync();
        }
    }

    private async Task OnSkillToggled(string skillName, bool isChecked)
    {
        var ws = WorkspaceState.ActiveWorkspace;
        if (ws == null) return;
        ws.DisabledGlobalSkillsJson = WorkspaceSkillsUiHelper.ToggleSkillExclusion(ws.DisabledGlobalSkillsJson, skillName, isExcluded: !isChecked);
        await RefreshSkillsStatusAsync();
    }

    private void ProbeWsl()
    {
        try
        {
            _wslDistro = WslService.GetDefaultDistributionName();
            _wslUser = WslService.GetDefaultUserName();
        }
        catch (Exception)
        {
            _wslDistro = "Not Available";
            _wslUser = "N/A";
        }
    }

    private void ProbeWslAsync()
    {
        try
        {
            WslService.ClearCache();
            ProbeWsl();
            ToastService.Show("WSL2 Probed", $"Active distribution: {_wslDistro}", ToastLevel.Info);
        }
        catch (Exception ex)
        {
            ToastService.Show("WSL2 Probe Error", ex.Message, ToastLevel.Warning);
        }
    }

    private void OnNativeColorChanged(ChangeEventArgs e)
    {
        var ws = WorkspaceState.ActiveWorkspace;
        if (ws != null && e.Value is string hex && !string.IsNullOrWhiteSpace(hex))
        {
            ws.ColorCode = hex;
        }
    }

    private async Task SaveWorkspaceAsync()
    {
        var ws = WorkspaceState.ActiveWorkspace;
        if (ws == null || _isSaving) return;

        if (string.IsNullOrWhiteSpace(ws.Name))
        {
            ToastService.Show("Invalid Name", "Workspace name cannot be empty.", ToastLevel.Warning);
            return;
        }

        _isSaving = true;

        try
        {
            await WorkspaceRepo.UpdateAsync(ws);
            WorkspaceState.NotifyWorkspaceUpdated(ws);
            ToastService.Show("Workspace branding updated.", "Repository execution confinement parameters updated.", ToastLevel.Success);
        }
        catch (Exception ex)
        {
            ToastService.Show("Error Saving Settings", ex.Message, ToastLevel.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SyncMirrorAsync()
    {
        if (WorkspaceState.ActiveWorkspace == null || _isSyncing) return;
        _isSyncing = true;

        try
        {
            var ws = WorkspaceState.ActiveWorkspace;
            if (!string.IsNullOrWhiteSpace(ws.Ext4MirrorPath))
            {
                await MirrorSyncService.PullFromHostAsync(ws.Ext4MirrorPath, ws.DefaultBaseBranch);
                ToastService.Show("Git Mirror Synced", "Ext4 mirror successfully updated from host repository.", ToastLevel.Success);
            }
            else
            {
                ToastService.Show("No Mirror Path", "This workspace does not have an isolated Ext4 mirror path configured.", ToastLevel.Info);
            }
        }
        catch (Exception ex)
        {
            ToastService.Show("Mirror Sync Error", ex.Message, ToastLevel.Error);
        }
        finally
        {
            _isSyncing = false;
        }
    }

    private void LaunchWizard()
    {
        WorkspaceState.RequestOpenWizard();
    }
}

@namespace NightCodeForge.Web.Components.Memory
@using NightCodeForge.Core.Memory
@using NightCodeForge.Web.Services
@inject IWorkspaceMemoryUiService MemoryService
@inject MemoryUpdateTracker UpdateTracker
@inject ToastService ToastService
@implements IDisposable

<div class="forge-modal-backdrop" id="memory-drawer-backdrop" @onclick="Close">
    <div class="forge-modal card-glass modal-lg" id="workspace-memory-drawer" @onclick:stopPropagation="true">
        <div class="modal-header d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-4">🧠</span>
                <h3 class="mb-0">Workspace Memory</h3>
            </div>
            <button class="btn-icon" id="close-memory-drawer-btn" @onclick="Close" title="Close Drawer">✕</button>
        </div>

        <div class="modal-body">
            <div class="d-flex gap-2 mb-3" role="tablist">
                <button type="button" id="memory-tab-local" role="tab"
                        class="forge-btn-ghost @(_scope == AgentMemoryScope.LocalWorkspace ? "active" : "")"
                        @onclick="() => SelectScopeAsync(AgentMemoryScope.LocalWorkspace)">Local Workspace Memory</button>
                <button type="button" id="memory-tab-shared" role="tab"
                        class="forge-btn-ghost @(_scope == AgentMemoryScope.SharedRepository ? "active" : "")"
                        @onclick="() => SelectScopeAsync(AgentMemoryScope.SharedRepository)">Committed Repository Memory</button>
            </div>

            @if (_error != null)
            {
                <div class="alert alert-warning" id="memory-error">@_error</div>
            }

            <div class="d-flex gap-3">
                <div class="memory-file-list" style="min-width: 15rem;">
                    @if (_scope == AgentMemoryScope.LocalWorkspace)
                    {
                        <div class="d-flex gap-1 mb-2">
                            <input type="text" id="memory-new-file-name" class="form-control-dark" placeholder="new-topic.md" @bind="_newFileName" />
                            <button type="button" id="memory-create-btn" class="forge-btn-ghost" @onclick="CreateNewAsync">＋ New</button>
                        </div>
                    }
                    else
                    {
                        <div class="text-muted small mb-2" id="memory-committed-readonly-note">
                            Read-only view of the committed files in your repository working tree. Edit and commit them from your IDE.
                        </div>
                    }

                    @if (_files.Count == 0)
                    {
                        <div class="text-muted small" id="memory-empty">No memory files.</div>
                    }
                    @foreach (var file in _files)
                    {
                        <button type="button"
                                class="memory-file-item forge-btn-ghost d-block text-start w-100 @(file.RelativePath == _selectedPath ? "active" : "")"
                                data-testid="memory-file-item"
                                @onclick="() => SelectFileAsync(file.RelativePath)">
                            <div class="font-mono">@file.RelativePath</div>
                            @if (!string.IsNullOrEmpty(file.Summary))
                            {
                                <div class="small text-muted">@file.Summary</div>
                            }
                            <div class="small text-muted">@file.LineCount lines · @file.SizeBytes B</div>
                        </button>
                    }
                </div>

                <div class="memory-file-viewer flex-grow-1" style="min-width: 0;">
                    @if (_selectedPath == null)
                    {
                        <div class="text-muted">Select a memory file to inspect it.</div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong class="font-mono" id="memory-selected-path">@_selectedPath</strong>
                            <div class="d-flex gap-1">
                                @if (!_isEditing)
                                {
                                    <button type="button" id="memory-toggle-raw-btn" class="forge-btn-ghost" @onclick="ToggleRaw">@(_showRaw ? "Rendered" : "Raw")</button>
                                    @if (_scope == AgentMemoryScope.LocalWorkspace)
                                    {
                                        <button type="button" id="memory-edit-btn" class="forge-btn-ghost" @onclick="StartEdit">✏️ Edit</button>
                                        <button type="button" id="memory-delete-btn" class="forge-btn-ghost" @onclick="() => _confirmDelete = true">🗑️ Delete</button>
                                    }
                                }
                            </div>
                        </div>

                        @if (ActiveBudget != null)
                        {
                            <div class="small mb-2 @(ActiveBudget.IsOverBudget ? "text-danger" : "text-muted")" id="memory-budget-meter">
                                @ActiveBudget.Lines / @ActiveBudget.MaxLines lines · @ActiveBudget.Bytes / @ActiveBudget.MaxBytes bytes
                                @if (ActiveBudget.IsOverBudget)
                                {
                                    <span> — over budget, the pinned memory will be truncated.</span>
                                }
                            </div>
                        }

                        @if (_confirmDelete)
                        {
                            <div class="alert alert-warning" id="memory-delete-confirm">
                                Delete <code>@_selectedPath</code>?
                                <button type="button" id="memory-delete-confirm-btn" class="forge-btn-ghost" @onclick="DeleteAsync">Confirm delete</button>
                                <button type="button" id="memory-delete-cancel-btn" class="forge-btn-ghost" @onclick="() => _confirmDelete = false">Cancel</button>
                            </div>
                        }

                        @if (_isEditing)
                        {
                            <textarea id="memory-editor" class="form-control-dark font-mono w-100" rows="18" @bind="_editorContent" @bind:event="oninput"></textarea>
                            <div class="d-flex gap-2 mt-2">
                                <button type="button" id="memory-save-btn" class="forge-btn-primary" disabled="@_isSaving" @onclick="SaveAsync">💾 Save</button>
                                <button type="button" id="memory-cancel-edit-btn" class="forge-btn-ghost" @onclick="CancelEdit">Cancel</button>
                            </div>
                        }
                        else if (_showRaw)
                        {
                            <pre id="memory-raw" class="font-mono">@_content</pre>
                        }
                        else
                        {
                            <div id="memory-rendered" class="markdown-body">@MarkdownHelper.ToMarkupString(_content)</div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public int WorkspaceId { get; set; }
    [Parameter] public AgentMemoryScope InitialScope { get; set; } = AgentMemoryScope.LocalWorkspace;
    [Parameter] public string? InitialRelativePath { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private AgentMemoryScope _scope = AgentMemoryScope.LocalWorkspace;
    private IReadOnlyList<MemoryFileEntry> _files = [];
    private string? _selectedPath;
    private string _content = string.Empty;
    private string _editorContent = string.Empty;
    private string _newFileName = string.Empty;
    private string? _error;
    private bool _showRaw;
    private bool _isEditing;
    private bool _isSaving;
    private bool _confirmDelete;
    private bool _isNewFile;
    private bool _disposed;
    private MemoryBudget? _budget;

    private bool IsPinnedSelected => MemoryPresentationHelper.IsPinnedMemoryFile(_selectedPath);

    private MemoryBudget? ActiveBudget => IsPinnedSelected
        ? (_isEditing ? MemoryPresentationHelper.ComputeBudget(_editorContent) : _budget)
        : null;

    protected override async Task OnInitializedAsync()
    {
        UpdateTracker.OnMemoryUpdated += HandleMemoryUpdated;
        _scope = InitialScope == AgentMemoryScope.None ? AgentMemoryScope.LocalWorkspace : InitialScope;
        await RefreshAsync();
        if (InitialRelativePath != null)
        {
            await SelectFileAsync(InitialRelativePath);
        }
    }

    private async Task RefreshAsync()
    {
        await RunAsync(async () => _files = await MemoryService.ListAsync(WorkspaceId, _scope));
    }

    private async Task SelectScopeAsync(AgentMemoryScope scope)
    {
        _scope = scope;
        ResetSelection();
        await RefreshAsync();
    }

    private async Task SelectFileAsync(string relativePath)
    {
        ResetSelection();
        await RunAsync(async () =>
        {
            var file = await MemoryService.ReadAsync(WorkspaceId, _scope, relativePath);
            _selectedPath = relativePath;
            _content = file.Content;
            _budget = MemoryPresentationHelper.ComputeBudget(file.Content);
        });
    }

    private void ResetSelection()
    {
        _selectedPath = null;
        _content = string.Empty;
        _isEditing = false;
        _confirmDelete = false;
        _isNewFile = false;
        _budget = null;
        _error = null;
    }

    private void ToggleRaw() => _showRaw = !_showRaw;

    private void StartEdit()
    {
        _editorContent = _content;
        _isEditing = true;
    }

    private void CancelEdit()
    {
        _isEditing = false;
        if (_isNewFile)
        {
            ResetSelection();
        }
    }

    private async Task CreateNewAsync()
    {
        _error = null;
        var candidate = _newFileName.Trim();
        await RunAsync(() =>
        {
            MemoryService.ValidateLocalFileName(candidate);
            if (_files.Any(f => string.Equals(f.RelativePath, candidate, StringComparison.OrdinalIgnoreCase)))
            {
                _error = $"'{candidate}' already exists.";
                return Task.CompletedTask;
            }

            ResetSelection();
            _selectedPath = candidate;
            _isNewFile = true;
            _editorContent = string.Empty;
            _isEditing = true;
            _newFileName = string.Empty;
            return Task.CompletedTask;
        });
    }

    private async Task SaveAsync()
    {
        if (_selectedPath == null) return;
        _isSaving = true;
        try
        {
            await RunAsync(async () =>
            {
                var kind = await MemoryService.SaveLocalAsync(WorkspaceId, _selectedPath, _editorContent);
                ToastService.Show("Memory saved", $"{kind} {_selectedPath}", ToastLevel.Success);
                _content = _editorContent;
                _budget = MemoryPresentationHelper.ComputeBudget(_content);
                _isEditing = false;
                _isNewFile = false;
                _files = await MemoryService.ListAsync(WorkspaceId, _scope);
            });
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (_selectedPath == null) return;
        var path = _selectedPath;
        await RunAsync(async () =>
        {
            await MemoryService.DeleteLocalAsync(WorkspaceId, path);
            ToastService.Show("Memory deleted", path, ToastLevel.Success);
            ResetSelection();
            _files = await MemoryService.ListAsync(WorkspaceId, _scope);
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (Exception ex) when (ex is MemoryValidationException or MemoryFileNotFoundException or MemoryWorkspaceNotFoundException)
        {
            _error = ex.Message;
        }
    }

    private void HandleMemoryUpdated(MemoryUpdateNotice notice)
    {
        if (_disposed || notice.WorkspaceId != WorkspaceId || notice.Scope != _scope)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            if (_disposed)
            {
                return;
            }

            await RefreshAsync();
            if (!_isEditing && _selectedPath != null && string.Equals(_selectedPath, notice.RelativePath, StringComparison.OrdinalIgnoreCase))
            {
                if (notice.ChangeKind == AgentMemoryChangeKind.Deleted)
                {
                    ResetSelection();
                }
                else
                {
                    await SelectFileAsync(_selectedPath);
                }
            }

            StateHasChanged();
        });
    }

    private async Task Close() => await OnClosed.InvokeAsync();

    public void Dispose()
    {
        _disposed = true;
        UpdateTracker.OnMemoryUpdated -= HandleMemoryUpdated;
    }
}

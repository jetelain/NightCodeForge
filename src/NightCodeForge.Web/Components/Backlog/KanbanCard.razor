@namespace NightCodeForge.Web.Components.Backlog
@using NightCodeForge.Core.Domain

<div class="kanban-card task-card card-glass @(Task.IsWaitingForHuman ? "card-waiting-human" : "")"
     @onclick="HandleClick"
     role="button"
     tabindex="0"
     aria-label="ForgeTask #@Task.Id: @Task.Title">

    <!-- Card Top Bar -->
    <div class="card-top-bar">
        <div style="display: flex; align-items: center; gap: 0.4rem;">
            <span class="card-id font-mono">#@Task.Id</span>
            <span class="forge-badge badge-priority-@Task.Priority" title="Priority @Task.Priority">
                P@(Task.Priority)
            </span>
        </div>
        <span class="forge-badge @(Task.MergeMode == MergeMode.Automatic ? "badge-teal" : "badge-indigo")" style="font-size: 0.7rem; padding: 2px 6px;">
            @(Task.MergeMode == MergeMode.Automatic ? "Auto" : "Manual")
        </span>
    </div>

    <!-- Title & Description Preview -->
    <h4 class="card-title">@Task.Title</h4>
    @if (!string.IsNullOrWhiteSpace(Task.Description))
    {
        <p class="card-desc-snippet">@TruncateDescription(Task.Description, 100)</p>
    }

    <!-- Status & Gating Indicators -->
    <div class="card-status-row">
        @if (Task.IsWaitingForHuman)
        {
            <span class="badge-waiting-human" title="Execution paused awaiting human input">
                <span class="pulse-dot-amber"></span>
                <span>Waiting for Human</span>
            </span>
        }
        else if (Task.Status == TaskOverallStatus.Open)
        {
            var blockers = GetBlockers();
            if (blockers.Count > 0)
            {
                var blockerText = string.Join(", ", blockers.Select(b => $"#{b.Id} {b.Title}"));
                <span class="badge-blocked" title="Blocked by: @blockerText">
                    🔒 Blocked (@blockers.Count)
                </span>
            }
            else
            {
                <span class="badge-ready" title="All dependencies closed; ready for inference execution">
                    🟢 Ready for Inference
                </span>
            }
        }
        else if (Task.Status == TaskOverallStatus.Reviewed || Task.Status == TaskOverallStatus.Implemented)
        {
            <span class="forge-badge badge-purple" style="font-size: 0.75rem;">
                @(string.IsNullOrWhiteSpace(Task.CurrentStageId) ? Task.Status.ToString() : Task.CurrentStageId)
            </span>
        }
        else if (Task.Status == TaskOverallStatus.Ready)
        {
            <span class="forge-badge badge-teal" style="font-size: 0.75rem;">
                Ready for Review
            </span>
        }
        else if (Task.Status == TaskOverallStatus.Closed)
        {
            <span class="forge-badge badge-emerald" style="font-size: 0.75rem;">
                ✅ Closed
            </span>
        }
        else if (Task.Status == TaskOverallStatus.Rejected)
        {
            <span class="forge-badge badge-crimson" style="font-size: 0.75rem;">
                Archived
            </span>
        }
        else if (Task.Status == TaskOverallStatus.Failed)
        {
            <span class="forge-badge badge-crimson" style="font-size: 0.75rem;">
                Failed
            </span>
        }
    </div>

    <!-- Card Bottom Actions -->
    <div class="card-actions-row">
        @if (Task.Status == TaskOverallStatus.Suggested)
        {
            <button type="button"
                    class="forge-btn forge-btn-primary btn-xs promote-btn"
                    @onclick="HandlePromote"
                    @onclick:stopPropagation="true">
                🚀 Triage
            </button>
        }
        <button type="button"
                class="forge-btn forge-btn-secondary btn-xs"
                @onclick="HandleLinkDependencies"
                @onclick:stopPropagation="true"
                title="Manage Dependencies">
            🔗 @(PrerequisiteIds.Count > 0 ? $"{PrerequisiteIds.Count} Prereqs" : "Link")
        </button>
        <button type="button"
                class="forge-btn forge-btn-secondary btn-xs"
                @onclick="HandleClick"
                @onclick:stopPropagation="true">
            Details
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ForgeTask Task { get; set; } = default!;
    [Parameter] public IReadOnlyList<ForgeTask> AllTasks { get; set; } = Array.Empty<ForgeTask>();
    [Parameter] public IReadOnlyList<int> PrerequisiteIds { get; set; } = Array.Empty<int>();
    [Parameter] public EventCallback<ForgeTask> OnClick { get; set; }
    [Parameter] public EventCallback<ForgeTask> OnPromote { get; set; }
    [Parameter] public EventCallback<ForgeTask> OnLinkDependencies { get; set; }

    private List<ForgeTask> GetBlockers()
    {
        var blockers = new List<ForgeTask>();
        foreach (var prereqId in PrerequisiteIds)
        {
            var prereq = AllTasks.FirstOrDefault(t => t.Id == prereqId);
            if (prereq == null || prereq.Status != TaskOverallStatus.Closed)
            {
                blockers.Add(prereq ?? new ForgeTask { Id = prereqId, Title = $"Task #{prereqId}" });
            }
        }
        return blockers;
    }

    private async Task HandleClick() => await OnClick.InvokeAsync(Task);
    private async Task HandlePromote() => await OnPromote.InvokeAsync(Task);
    private async Task HandleLinkDependencies() => await OnLinkDependencies.InvokeAsync(Task);

    private static string TruncateDescription(string desc, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(desc) || desc.Length <= maxLength) return desc;
        return desc.Substring(0, maxLength).TrimEnd() + "...";
    }
}

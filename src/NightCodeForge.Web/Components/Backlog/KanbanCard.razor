@namespace NightCodeForge.Web.Components.Backlog
@using NightCodeForge.Core.Domain
@using NightCodeForge.Core.Repositories
@using NightCodeForge.Core.Services
@using NightCodeForge.Web.Services
@inject IServiceProvider ServiceProvider

<div class="kanban-card task-card card-glass @(Task.IsWaitingForHuman ? "card-waiting-human" : "")"
     @onclick="HandleClick"
     role="button"
     tabindex="0"
     aria-label="ForgeTask #@Task.Id: @Task.Title">

    <!-- Card Top Bar -->
    <div class="card-top-bar">
        <div style="display: flex; align-items: center; gap: 0.4rem;">
            <span class="card-id font-mono">#@Task.Id</span>

            <!-- Inline Priority Popover Selector -->
            <div class="priority-badge-wrapper" style="position: relative; display: inline-block;">
                <button type="button"
                        class="forge-badge badge-priority-@Task.Priority priority-popover-btn"
                        @onclick="TogglePriorityMenu"
                        @onclick:stopPropagation="true"
                        title="Click to change priority (Current: P@Task.Priority - @TaskPriority.GetLabel(Task.Priority))"
                        style="cursor: pointer; border: 1px solid var(--border-subtle); display: inline-flex; align-items: center; gap: 2px; padding: 2px 6px; font-size: 0.75rem;">
                    <span>P@(Task.Priority)</span>
                    <span style="font-size: 0.65rem; opacity: 0.7;">▾</span>
                </button>

                @if (_showPriorityMenu)
                {
                    <div class="priority-popover card-glass"
                         @onclick:stopPropagation="true"
                         style="position: absolute; top: calc(100% + 4px); left: 0; z-index: 50; min-width: 140px; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); box-shadow: var(--shadow-lg); padding: 4px; display: flex; flex-direction: column; gap: 2px;">
                        @foreach (var p in TaskPriority.All)
                        {
                            var isCurrent = Task.Priority == p;
                            <button type="button"
                                    class="priority-menu-item @(isCurrent ? "active" : "")"
                                    @onclick="() => SelectPriorityAsync(p)"
                                    style="display: flex; align-items: center; justify-content: space-between; padding: 4px 8px; border: none; border-radius: var(--radius-sm); background: @(isCurrent ? "rgba(99, 102, 241, 0.2)" : "transparent"); color: var(--text-primary); cursor: pointer; font-size: 0.78rem; text-align: left;">
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <span class="badge-dot" style="width: 7px; height: 7px; border-radius: 50%; background: @TaskPriority.GetBadgeColor(p);"></span>
                                    <span style="font-weight: @(isCurrent ? "700" : "500");">P@(p)</span>
                                    <span style="color: var(--text-muted); font-size: 0.72rem;">@TaskPriority.GetLabel(p)</span>
                                </div>
                                @if (isCurrent)
                                {
                                    <span style="color: var(--accent-indigo); font-size: 0.75rem;">✓</span>
                                }
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
        <span class="forge-badge @(Task.MergeMode == MergeMode.Automatic ? "badge-teal" : "badge-indigo")" style="font-size: 0.7rem; padding: 2px 6px;">
            @(Task.MergeMode == MergeMode.Automatic ? "Auto" : "Manual")
        </span>
    </div>

    <!-- Title & Description Preview -->
    <h4 class="card-title">@Task.Title</h4>
    @if (!string.IsNullOrWhiteSpace(Task.Description))
    {
        <p class="card-desc-snippet">@TruncateDescription(Task.Description, 100)</p>
    }

    <!-- Status & Gating Indicators -->
    <div class="card-status-row">
        @if (Task.IsWaitingForHuman)
        {
            <span class="badge-waiting-human" title="Execution paused awaiting human input">
                <span class="pulse-dot-amber"></span>
                <span>Waiting for Human</span>
            </span>
        }
        else if (Task.Status == TaskOverallStatus.Closed)
        {
            <span class="forge-badge badge-emerald" style="font-size: 0.75rem;">
                ✅ Closed
            </span>
        }
        else if (Task.Status == TaskOverallStatus.Rejected)
        {
            <span class="forge-badge badge-crimson" style="font-size: 0.75rem;">
                Archived
            </span>
        }
        else if (Task.Status == TaskOverallStatus.Failed)
        {
            <span class="forge-badge badge-crimson" style="font-size: 0.75rem;">
                Failed
            </span>
        }
        else if (Task.Status == TaskOverallStatus.Ready)
        {
            <span class="forge-badge badge-teal" style="font-size: 0.75rem;">
                Ready for Review
            </span>
        }
        else if (!string.IsNullOrWhiteSpace(Task.CurrentStageId) || Task.Status == TaskOverallStatus.Reviewed || Task.Status == TaskOverallStatus.Implemented)
        {
            <span class="forge-badge badge-purple" style="font-size: 0.75rem;">
                @(string.IsNullOrWhiteSpace(Task.CurrentStageId) ? Task.Status.ToString() : Task.CurrentStageId)
            </span>
        }
        else if (Task.Status == TaskOverallStatus.Open)
        {
            var blockers = GetBlockers();
            if (blockers.Count > 0)
            {
                var blockerText = string.Join(", ", blockers.Select(b => $"#{b.Id} {b.Title}"));
                <span class="badge-blocked" title="Blocked by: @blockerText">
                    🔒 Blocked (@blockers.Count)
                </span>
            }
            else
            {
                <span class="badge-ready" title="All dependencies closed; ready for inference execution">
                    🟢 Ready for Inference
                </span>
            }
        }
    </div>

    <!-- Card Bottom Actions -->
    <div class="card-actions-row">
        @if (Task.Status == TaskOverallStatus.Suggested)
        {
            <button type="button"
                    class="forge-btn forge-btn-primary btn-xs promote-btn"
                    @onclick="HandlePromote"
                    @onclick:stopPropagation="true">
                🚀 Triage
            </button>
        }
        @if (Task.Status != TaskOverallStatus.Closed && Task.Status != TaskOverallStatus.Rejected)
        {
            <button type="button"
                    class="forge-btn forge-btn-danger btn-xs reject-btn"
                    @onclick="HandleReject"
                    @onclick:stopPropagation="true"
                    title="Reject Task">
                🗑️ Reject
            </button>
        }
        <button type="button"
                class="forge-btn forge-btn-secondary btn-xs"
                @onclick="HandleLinkDependencies"
                @onclick:stopPropagation="true"
                title="Manage Dependencies">
            🔗 @(PrerequisiteIds.Count > 0 ? $"{PrerequisiteIds.Count} Prereqs" : "Link")
        </button>
        <button type="button"
                class="forge-btn forge-btn-secondary btn-xs"
                @onclick="HandleClick"
                @onclick:stopPropagation="true">
            Details
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ForgeTask Task { get; set; } = default!;
    [Parameter] public IReadOnlyList<ForgeTask> AllTasks { get; set; } = Array.Empty<ForgeTask>();
    [Parameter] public IReadOnlyList<int> PrerequisiteIds { get; set; } = Array.Empty<int>();
    [Parameter] public EventCallback<ForgeTask> OnClick { get; set; }
    [Parameter] public EventCallback<ForgeTask> OnPromote { get; set; }
    [Parameter] public EventCallback<ForgeTask> OnReject { get; set; }
    [Parameter] public EventCallback<ForgeTask> OnLinkDependencies { get; set; }
    [Parameter] public EventCallback<(ForgeTask Task, int NewPriority)> OnPriorityChanged { get; set; }

    private bool _showPriorityMenu;

    private void TogglePriorityMenu()
    {
        _showPriorityMenu = !_showPriorityMenu;
    }

    private async Task SelectPriorityAsync(int newPriority)
    {
        _showPriorityMenu = false;
        if (Task.Priority == newPriority) return;

        var oldPriority = Task.Priority;
        Task.Priority = newPriority;
        Task.UpdatedAt = DateTime.UtcNow;

        var taskRepo = ServiceProvider.GetService<ITaskRepository>();
        if (taskRepo != null)
        {
            try
            {
                await taskRepo.UpdateWithHistoryAsync(
                    Task,
                    dependsOn: PrerequisiteIds,
                    changedBy: AuditActors.User,
                    reason: $"Updated Priority from P{oldPriority} to P{newPriority}");

                var workspaceRepo = ServiceProvider.GetService<IWorkspaceRepository>();
                var markdownSync = ServiceProvider.GetService<ITaskMarkdownSyncService>();
                if (workspaceRepo != null && markdownSync != null)
                {
                    try
                    {
                        var workspace = await workspaceRepo.GetByIdAsync(Task.WorkspaceId);
                        if (workspace != null && !string.IsNullOrWhiteSpace(workspace.RepositoryPath) && Directory.Exists(workspace.RepositoryPath))
                        {
                            await markdownSync.SyncTaskToDiskAsync(Task, workspace.RepositoryPath);
                        }
                    }
                    catch (Exception ex)
                    {
                        var logger = ServiceProvider.GetService<ILogger<KanbanCard>>();
                        logger?.LogWarning(ex, "Failed to sync markdown on quick priority update for Task #{TaskId}", Task.Id);
                    }
                }

                var devQueue = ServiceProvider.GetService<IDevQueueService>();
                var toastService = ServiceProvider.GetService<ToastService>();

                if (newPriority == TaskPriority.Critical)
                {
                    bool promoted = false;
                    if (devQueue != null) promoted = await devQueue.PromoteToUrgentAsync(Task.Id);
                    var detail = promoted ? "(llm-urgent)" : "";
                    toastService?.Show("Priority Escalated", $"Task #{Task.Id} escalated to P1 Critical {detail}.".Trim(), ToastLevel.Success);
                }
                else
                {
                    if (devQueue != null) await devQueue.ReorderInferenceQueueByPriorityAsync();
                    toastService?.Show("Priority Updated", $"Task #{Task.Id} set to P{newPriority} ({TaskPriority.GetLabel(newPriority)}).", ToastLevel.Success);
                }
            }
            catch (Exception ex)
            {
                var toastService = ServiceProvider.GetService<ToastService>();
                toastService?.Show("Update Failed", ex.Message, ToastLevel.Error);
            }
        }

        await OnPriorityChanged.InvokeAsync((Task, newPriority));
    }

    private List<ForgeTask> GetBlockers()
    {
        var blockers = new List<ForgeTask>();
        foreach (var prereqId in PrerequisiteIds)
        {
            var prereq = AllTasks.FirstOrDefault(t => t.Id == prereqId);
            if (prereq == null || prereq.Status != TaskOverallStatus.Closed)
            {
                blockers.Add(prereq ?? new ForgeTask { Id = prereqId, Title = $"Task #{prereqId}" });
            }
        }
        return blockers;
    }

    private async Task HandleClick() => await OnClick.InvokeAsync(Task);
    private async Task HandlePromote() => await OnPromote.InvokeAsync(Task);
    private async Task HandleReject() => await OnReject.InvokeAsync(Task);
    private async Task HandleLinkDependencies() => await OnLinkDependencies.InvokeAsync(Task);

    private static string TruncateDescription(string desc, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(desc) || desc.Length <= maxLength) return desc;
        return desc.Substring(0, maxLength).TrimEnd() + "...";
    }
}

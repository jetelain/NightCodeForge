@namespace NightCodeForge.Web.Components.Backlog
@using NightCodeForge.Core.Domain
@using NightCodeForge.Core.Repositories
@using NightCodeForge.Core.Services
@using NightCodeForge.Web.Services
@inject ITaskRepository TaskRepository
@inject IDevQueueService DevQueueService
@inject ITaskMutationService TaskMutationService
@inject ToastService ToastService
@inject IServiceProvider ServiceProvider
@inject ILogger<TaskDetailDrawer> Logger

@if (IsOpen && Task != null)
{
    <div class="task-drawer-overlay" @onclick="Close">
        <aside class="task-drawer card-glass" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-label="Task Details">
            <!-- Header -->
            <div class="task-drawer-header">
                <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem;">
                    <div>
                        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
                            <span class="font-mono text-secondary" style="font-weight: 700; font-size: 1rem;">#@Task.Id</span>
                            <span class="forge-badge @GetStatusBadgeClass(Task.Status)">@Task.Status</span>
                            <span class="forge-badge badge-priority-@Task.Priority">P@(Task.Priority)</span>
                            <span class="forge-badge @(Task.MergeMode == MergeMode.Automatic ? "badge-teal" : "badge-indigo")">
                                @(Task.MergeMode == MergeMode.Automatic ? "Auto-Merge" : "Manual Review")
                            </span>
                        </div>
                        @if (_isEditingTitle)
                        {
                            <div class="edit-title-box" style="display: flex; gap: 0.5rem; align-items: center; margin-top: 0.35rem;">
                                <input class="form-control-dark font-mono" style="font-size: 1rem; font-weight: 600; padding: 0.3rem 0.6rem; flex: 1;"
                                       @bind="_editedTitle" />
                                <button type="button" class="forge-btn forge-btn-secondary btn-xs" @onclick="CancelEditingTitle" disabled="@_isSavingTitle">Cancel</button>
                                <button type="button" class="forge-btn forge-btn-primary btn-xs" @onclick="SaveTitleAsync" disabled="@_isSavingTitle">
                                    @(_isSavingTitle ? "Saving..." : "Save")
                                </button>
                            </div>
                        }
                        else
                        {
                            <div style="display: flex; align-items: center; gap: 0.5rem;">
                                <h2 style="font-size: 1.25rem; font-weight: 600; margin: 0; line-height: 1.3; color: var(--text-primary);">
                                    @Task.Title
                                </h2>
                                <button type="button" class="forge-btn forge-btn-secondary btn-xs edit-title-btn" style="padding: 0.15rem 0.45rem; font-size: 0.72rem;" @onclick="StartEditingTitle" title="Edit task title">
                                    ✏️
                                </button>
                            </div>
                        }
                    </div>
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <a href="/inspector/@Task.Id" class="forge-btn forge-btn-secondary" style="padding: 0.25rem 0.6rem; font-size: 0.78rem; text-decoration: none;">
                            🔍 Inspect
                        </a>
                        <button type="button" class="btn-icon" @onclick="Close" aria-label="Close drawer">✕</button>
                    </div>
                </div>

                @if (Task.IsWaitingForHuman)
                {
                    <div class="human-waiting-alert" style="margin-top: 0.75rem; background: rgba(245, 158, 11, 0.15); border: 1px solid var(--accent-amber); border-radius: var(--radius-md); padding: 0.6rem 0.85rem; display: flex; align-items: center; gap: 0.5rem; color: #fde68a; font-size: 0.85rem;">
                        <span class="pulse-dot-amber"></span>
                        <div>
                            <strong>Paused: Awaiting Human Clarification</strong>
                            <div style="font-size: 0.8rem; color: #fef3c7;">Stage: @(Task.InterruptedStageId ?? "Unknown") | Agent: @(Task.InterruptedAgentProfileId ?? "Default")</div>
                        </div>
                    </div>
                }
            </div>

            <!-- Drawer Body -->
            <div class="task-drawer-body">
                <!-- Drawer Sub-Navigation Tabs -->
                <div class="drawer-nav-tabs" style="display: flex; gap: 0.5rem; border-bottom: 1px solid var(--border-subtle); margin-bottom: 1rem; padding-bottom: 0.5rem;">
                    <button type="button"
                            class="forge-btn @(_activeDrawerTab == "details" ? "forge-btn-primary" : "forge-btn-secondary") btn-xs"
                            style="padding: 0.35rem 0.75rem; font-size: 0.82rem;"
                            @onclick='() => _activeDrawerTab = "details"'>
                        📋 Task Details
                    </button>
                    <button type="button"
                            class="forge-btn @(_activeDrawerTab == "history" ? "forge-btn-primary" : "forge-btn-secondary") btn-xs"
                            style="padding: 0.35rem 0.75rem; font-size: 0.82rem;"
                            @onclick='() => _activeDrawerTab = "history"'>
                        🕰️ Revisions &amp; History
                    </button>
                </div>

                @if (_activeDrawerTab == "history")
                {
                    <TaskHistoryTimeline TaskId="Task.Id" />
                }
                else
                {
                    <!-- Interactive Priority & Merge Mode Section -->
                    <div class="drawer-section priority-mergemode-controls card-glass" style="background: var(--bg-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 0.85rem; margin-bottom: 1rem;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                        <!-- Editable Priority -->
                        <div>
                            <label class="meta-label" style="display: block; margin-bottom: 0.35rem; font-weight: 600; color: var(--text-primary); font-size: 0.82rem;">
                                Priority Level
                            </label>
                            <div class="priority-chip-row" style="display: flex; gap: 0.3rem; flex-wrap: wrap;">
                                @foreach (var p in TaskPriority.All)
                                {
                                    var isSelected = Task.Priority == p;
                                    <button type="button"
                                            class="forge-btn btn-xs priority-chip-btn @(isSelected ? "selected" : "")"
                                            style="border: 1px solid @(isSelected ? TaskPriority.GetBadgeColor(p) : "var(--border-subtle)"); background: @(isSelected ? "rgba(32, 36, 51, 0.95)" : "var(--bg-input)"); color: @(isSelected ? "#fff" : "var(--text-secondary)"); cursor: pointer; padding: 0.25rem 0.5rem; border-radius: var(--radius-sm); font-size: 0.78rem; font-weight: @(isSelected ? "700" : "500"); display: flex; align-items: center; gap: 0.3rem;"
                                            @onclick="() => UpdatePriorityAsync(p)"
                                            disabled="@_isUpdatingPriority"
                                            title="@TaskPriority.GetDescription(p)">
                                        <span class="badge-dot" style="width: 8px; height: 8px; border-radius: 50%; background: @TaskPriority.GetBadgeColor(p); display: inline-block;"></span>
                                        <span>P@(p)</span>
                                    </button>
                                }
                            </div>
                            <small class="text-secondary" style="display: block; margin-top: 0.3rem; font-size: 0.75rem;">
                                @TaskPriority.GetLabel(Task.Priority)
                            </small>
                        </div>

                        <!-- Editable MergeMode -->
                        <div>
                            <label class="meta-label" style="display: block; margin-bottom: 0.35rem; font-weight: 600; color: var(--text-primary); font-size: 0.82rem;">
                                Merge Delivery Mode
                            </label>
                            <div style="display: flex; gap: 0.35rem;">
                                <button type="button"
                                        class="forge-btn btn-xs @(Task.MergeMode == MergeMode.ManualReviewRequired ? "forge-btn-primary" : "forge-btn-secondary")"
                                        style="padding: 0.25rem 0.55rem; font-size: 0.78rem;"
                                        @onclick="() => UpdateMergeModeAsync(MergeMode.ManualReviewRequired)"
                                        disabled="@_isUpdatingMergeMode"
                                        title="Pauses at Ready for human review in Review Room">
                                    🔍 Manual
                                </button>
                                <button type="button"
                                        class="forge-btn btn-xs @(Task.MergeMode == MergeMode.Automatic ? "forge-btn-primary" : "forge-btn-secondary")"
                                        style="padding: 0.25rem 0.55rem; font-size: 0.78rem;"
                                        @onclick="() => UpdateMergeModeAsync(MergeMode.Automatic)"
                                        disabled="@_isUpdatingMergeMode"
                                        title="Auto-squashes and merges to base branch upon reaching Ready">
                                    ⚡ Auto
                                </button>
                            </div>
                            <small class="text-secondary" style="display: block; margin-top: 0.3rem; font-size: 0.75rem;">
                                @MergeModeHelper.GetLabel(Task.MergeMode)
                            </small>
                        </div>
                    </div>
                </div>

                <!-- Metadata Grid -->
                <div class="task-metadata-grid">
                    <div class="meta-item">
                        <span class="meta-label">Current Stage</span>
                        <span class="meta-val font-mono">@(string.IsNullOrWhiteSpace(Task.CurrentStageId) ? "None" : Task.CurrentStageId)</span>
                    </div>
                    <div class="meta-item">
                        <div style="display: flex; align-items: center; justify-content: space-between;">
                            <span class="meta-label">Base Branch</span>
                            @if (Task.Status != TaskOverallStatus.Closed && !_isEditingBaseBranch)
                            {
                                <button type="button" class="forge-btn forge-btn-secondary btn-xs edit-basebranch-btn" style="padding: 0.1rem 0.35rem; font-size: 0.7rem;" @onclick="StartEditingBaseBranch" title="Edit base branch">
                                    ✏️
                                </button>
                            }
                        </div>
                        @if (_isEditingBaseBranch)
                        {
                            <div class="edit-basebranch-box" style="display: flex; gap: 0.35rem; align-items: center; margin-top: 0.3rem;">
                                <input class="form-control-dark font-mono form-control-sm" style="font-size: 0.82rem; padding: 0.2rem 0.45rem; flex: 1;"
                                       @bind="_editedBaseBranch" placeholder="e.g. main or master" />
                                <button type="button" class="forge-btn forge-btn-secondary btn-xs" style="padding: 0.15rem 0.4rem; font-size: 0.72rem;" @onclick="CancelEditingBaseBranch" disabled="@_isSavingBaseBranch">Cancel</button>
                                <button type="button" class="forge-btn forge-btn-primary btn-xs" style="padding: 0.15rem 0.5rem; font-size: 0.72rem;" @onclick="SaveBaseBranchAsync" disabled="@_isSavingBaseBranch">
                                    @(_isSavingBaseBranch ? "..." : "Save")
                                </button>
                            </div>
                        }
                        else
                        {
                            <span class="meta-val font-mono">@Task.BaseBranch</span>
                        }
                    </div>
                    <div class="meta-item">
                        <span class="meta-label">Feature Branch</span>
                        <span class="meta-val font-mono">@(string.IsNullOrWhiteSpace(Task.FeatureBranch) ? "forge/task-" + Task.Id : Task.FeatureBranch)</span>
                    </div>
                    <div class="meta-item">
                        <span class="meta-label">Created At</span>
                        <span class="meta-val">@Task.CreatedAt.ToLocalTime().ToString("g")</span>
                    </div>
                </div>

                <!-- Description -->
                <div class="drawer-section">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                        <h4 class="section-title" style="margin: 0;">Description &amp; Specification</h4>
                        @if (!_isEditingDescription)
                        {
                            <button type="button" class="forge-btn forge-btn-secondary btn-xs" style="padding: 0.2rem 0.55rem; font-size: 0.76rem;" @onclick="StartEditingDescription">
                                ✏️ Edit
                            </button>
                        }
                    </div>

                    @if (_isEditingDescription)
                    {
                        <div class="edit-description-box" style="margin-top: 0.5rem;">
                            <textarea class="form-control-dark font-mono" rows="6" style="width: 100%; font-size: 0.85rem; padding: 0.65rem;"
                                      @bind="_editedDescription"
                                      placeholder="Task description and acceptance criteria in Markdown..."></textarea>
                            <div style="display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 0.5rem;">
                                <button type="button" class="forge-btn forge-btn-secondary btn-xs" @onclick="CancelEditingDescription" disabled="@_isSavingDescription">
                                    Cancel
                                </button>
                                <button type="button" class="forge-btn forge-btn-primary btn-xs" @onclick="SaveDescriptionAsync" disabled="@_isSavingDescription">
                                    @(_isSavingDescription ? "Saving..." : "Save Changes")
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="description-view">
                            @if (string.IsNullOrWhiteSpace(Task.Description))
                            {
                                <span class="text-muted">No description provided.</span>
                            }
                            else
                            {
                                <div class="formatted-desc forge-markdown">
                                    @MarkdownHelper.ToMarkupString(Task.Description)
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Prerequisites Gating -->
                <div class="drawer-section">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                        <h4 class="section-title" style="margin: 0;">
                            Prerequisites (@PrerequisiteIds.Count)
                        </h4>
                        <button type="button" class="forge-btn forge-btn-secondary btn-sm" @onclick="HandleLinkDependencies">
                            ✏️ Edit
                        </button>
                    </div>

                    @if (PrerequisiteIds.Count == 0)
                    {
                        <div class="text-muted" style="font-size: 0.85rem; padding: 0.5rem 0;">
                            No prerequisites configured. Eligible to execute immediately when Open.
                        </div>
                    }
                    else
                    {
                        <div class="dependency-list">
                            @foreach (var prereqId in PrerequisiteIds)
                            {
                                var prereqTask = AllTasks.FirstOrDefault(t => t.Id == prereqId);
                                var isClosed = prereqTask?.Status == TaskOverallStatus.Closed;
                                <div class="dependency-item @(isClosed ? "satisfied" : "blocking")">
                                    <div style="display: flex; align-items: center; gap: 0.5rem; min-width: 0;">
                                        <span class="font-mono text-secondary">#@prereqId</span>
                                        <span class="dep-title">@(prereqTask?.Title ?? "Task #" + prereqId)</span>
                                    </div>
                                    <div style="display: flex; align-items: center; gap: 0.4rem; flex-shrink: 0;">
                                        @if (isClosed)
                                        {
                                            <span class="forge-badge badge-emerald" style="font-size: 0.75rem;">✅ Satisfied</span>
                                        }
                                        else
                                        {
                                            <span class="forge-badge badge-amber" style="font-size: 0.75rem;">🔒 Blocking</span>
                                            <span class="forge-badge @GetStatusBadgeClass(prereqTask?.Status ?? TaskOverallStatus.Open)" style="font-size: 0.75rem;">
                                                @(prereqTask?.Status.ToString() ?? "Open")
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Dependent Tasks (Downstream) -->
                @if (DependentIds.Count > 0)
                {
                    <div class="drawer-section">
                        <h4 class="section-title">Downstream Dependents (@DependentIds.Count)</h4>
                        <div class="dependency-list">
                            @foreach (var depId in DependentIds)
                            {
                                var depTask = AllTasks.FirstOrDefault(t => t.Id == depId);
                                <div class="dependency-item neutral">
                                    <div style="display: flex; align-items: center; gap: 0.5rem; min-width: 0;">
                                        <span class="font-mono text-secondary">#@depId</span>
                                        <span class="dep-title">@(depTask?.Title ?? "Task #" + depId)</span>
                                    </div>
                                    <span class="forge-badge @GetStatusBadgeClass(depTask?.Status ?? TaskOverallStatus.Open)" style="font-size: 0.75rem;">
                                        @(depTask?.Status.ToString() ?? "Open")
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Execution Timeline -->
                @if (Task.ExecutionRecords != null && Task.ExecutionRecords.Count > 0)
                {
                    <div class="drawer-section">
                        <h4 class="section-title">Execution History</h4>
                        <div class="records-timeline">
                            @foreach (var rec in Task.ExecutionRecords.OrderByDescending(r => r.StartedAt))
                            {
                                <div class="timeline-item">
                                    <div class="timeline-badge @(rec.Status == StageExecutionStatus.Completed ? "success" : "failed")"></div>
                                    <div class="timeline-content">
                                        <div style="display: flex; justify-content: space-between; align-items: center;">
                                            <strong>@rec.StageId</strong>
                                            <span class="text-muted" style="font-size: 0.75rem;">@(rec.DurationMs)ms</span>
                                        </div>
                                        <div style="font-size: 0.8rem; color: var(--text-secondary);">
                                            Agent: @rec.AgentProfileId | Model: @rec.ModelName
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Execution Logs -->
                @if (Task.ExecutionLogs != null && Task.ExecutionLogs.Count > 0)
                {
                    <div class="drawer-section">
                        <h4 class="section-title">Recent Execution Logs</h4>
                        <div class="execution-logs-box font-mono">
                            @foreach (var log in Task.ExecutionLogs.OrderByDescending(l => l.Timestamp).Take(20))
                            {
                                <div class="log-line">
                                    <span class="text-muted">[@log.Timestamp.ToString("HH:mm:ss")]</span>
                                    <span class="log-level-@log.Level.ToString().ToLowerInvariant()">[@log.Level]</span>
                                    <span>@log.Message</span>
                                </div>
                            }
                        </div>
                    </div>
                }
                }
            </div>

            <!-- Drawer Footer Actions -->
            <div class="task-drawer-footer">
                @if (Task.Status == TaskOverallStatus.Suggested)
                {
                    <button type="button" class="forge-btn forge-btn-primary" @onclick="HandlePromote">
                        🚀 Promote / Triage
                    </button>
                }
                @if (Task.Status != TaskOverallStatus.Closed && Task.Status != TaskOverallStatus.Rejected)
                {
                    <button type="button" class="forge-btn forge-btn-danger" id="btn-drawer-reject-task" @onclick="() => _showRejectModal = true">
                        🗑️ Reject Task
                    </button>
                }
                <a href="/inspector/@Task.Id" class="forge-btn forge-btn-secondary" style="font-size: 0.82rem; text-decoration: none;">
                    🔍 Inspect Execution &amp; Stages
                </a>
                <button type="button" class="forge-btn forge-btn-secondary" @onclick="HandleLinkDependencies">
                    🔗 Link Dependencies
                </button>
                <button type="button" class="forge-btn forge-btn-secondary" @onclick="Close">
                    Close
                </button>
            </div>
        </aside>

        <TaskRejectionModal IsOpen="_showRejectModal"
                            TargetTask="Task"
                            OnClosed="() => _showRejectModal = false"
                            OnRejected="HandleTaskRejected" />
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public ForgeTask? Task { get; set; }
    [Parameter] public IReadOnlyList<ForgeTask> AllTasks { get; set; } = Array.Empty<ForgeTask>();
    [Parameter] public IReadOnlyList<int> PrerequisiteIds { get; set; } = Array.Empty<int>();
    [Parameter] public IReadOnlyList<int> DependentIds { get; set; } = Array.Empty<int>();
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<ForgeTask> OnPromoteClicked { get; set; }
    [Parameter] public EventCallback<ForgeTask> OnLinkDependenciesClicked { get; set; }
    [Parameter] public EventCallback<ForgeTask> OnTaskUpdated { get; set; }

    private bool _showRejectModal;
    private bool _isUpdatingPriority;
    private bool _isUpdatingMergeMode;
    private string _activeDrawerTab = "details";

    private async Task HandleTaskRejected(ForgeTask rejectedTask)
    {
        _showRejectModal = false;
        await OnTaskUpdated.InvokeAsync(rejectedTask);
    }
    private bool _isEditingDescription;
    private bool _isSavingDescription;
    private string _editedDescription = string.Empty;

    private async Task UpdatePriorityAsync(int newPriority)
    {
        if (Task == null || Task.Priority == newPriority || _isUpdatingPriority) return;

        _isUpdatingPriority = true;
        try
        {
            await TaskMutationService.UpdatePriorityAsync(Task, newPriority, PrerequisiteIds);

            if (newPriority == TaskPriority.Critical)
            {
                var promoted = await DevQueueService.PromoteToUrgentAsync(Task.Id);
                var detail = promoted ? "(llm-urgent)" : "";
                ToastService.Show("Priority Escalated", $"Task #{Task.Id} escalated to P1 Critical {detail}.".Trim(), ToastLevel.Success);
            }
            else
            {
                await DevQueueService.ReorderInferenceQueueByPriorityAsync();
                ToastService.Show("Priority Updated", $"Task #{Task.Id} priority updated to P{newPriority} ({TaskPriority.GetLabel(newPriority)}).", ToastLevel.Success);
            }

            await OnTaskUpdated.InvokeAsync(Task);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to update priority for Task #{TaskId}", Task.Id);
            ToastService.Show("Priority Update Failed", ex.Message, ToastLevel.Error);
        }
        finally
        {
            _isUpdatingPriority = false;
        }
    }

    private async Task UpdateMergeModeAsync(MergeMode newMode)
    {
        if (Task == null || Task.MergeMode == newMode || _isUpdatingMergeMode) return;

        _isUpdatingMergeMode = true;
        try
        {
            await TaskMutationService.UpdateMergeModeAsync(Task, newMode, PrerequisiteIds);
            ToastService.Show("Merge Mode Updated", $"Task #{Task.Id} merge mode set to {MergeModeHelper.GetLabel(newMode)}.", ToastLevel.Success);
            await OnTaskUpdated.InvokeAsync(Task);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to update MergeMode for Task #{TaskId}", Task.Id);
            ToastService.Show("Merge Mode Update Failed", ex.Message, ToastLevel.Error);
        }
        finally
        {
            _isUpdatingMergeMode = false;
        }
    }

    private void StartEditingDescription()
    {
        _editedDescription = Task?.Description ?? string.Empty;
        _isEditingDescription = true;
    }

    private void CancelEditingDescription()
    {
        _isEditingDescription = false;
        _editedDescription = string.Empty;
    }

    private async Task SaveDescriptionAsync()
    {
        if (Task == null || _isSavingDescription) return;

        var newDesc = _editedDescription.Trim();
        if (string.Equals(Task.Description, newDesc, StringComparison.Ordinal))
        {
            _isEditingDescription = false;
            return;
        }

        _isSavingDescription = true;
        try
        {
            await TaskMutationService.UpdateDescriptionAsync(Task, newDesc, PrerequisiteIds);
            ToastService.Show("Description Updated", $"Task #{Task.Id} description updated.", ToastLevel.Success);
            _isEditingDescription = false;
            await OnTaskUpdated.InvokeAsync(Task);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to update description for Task #{TaskId}", Task.Id);
            ToastService.Show("Update Failed", ex.Message, ToastLevel.Error);
        }
        finally
        {
            _isSavingDescription = false;
        }
    }

    private async Task Close()
    {
        IsOpen = false;
        _isEditingTitle = false;
        _isEditingDescription = false;
        _isEditingBaseBranch = false;
        _activeDrawerTab = "details";
        await OnClose.InvokeAsync();
    }

    private bool _isEditingBaseBranch;
    private bool _isSavingBaseBranch;
    private string _editedBaseBranch = string.Empty;

    private void StartEditingBaseBranch()
    {
        _editedBaseBranch = Task?.BaseBranch ?? string.Empty;
        _isEditingBaseBranch = true;
    }

    private void CancelEditingBaseBranch()
    {
        _isEditingBaseBranch = false;
        _editedBaseBranch = string.Empty;
    }

    private async Task SaveBaseBranchAsync()
    {
        if (Task == null || _isSavingBaseBranch) return;

        var newBaseBranch = _editedBaseBranch.Trim();
        if (string.IsNullOrWhiteSpace(newBaseBranch))
        {
            ToastService.Show("Invalid Base Branch", "Base branch cannot be empty.", ToastLevel.Warning);
            return;
        }

        if (string.Equals(Task.BaseBranch, newBaseBranch, StringComparison.Ordinal))
        {
            _isEditingBaseBranch = false;
            return;
        }

        _isSavingBaseBranch = true;
        try
        {
            await TaskMutationService.UpdateBaseBranchAsync(Task, newBaseBranch, PrerequisiteIds);
            ToastService.Show("Base Branch Updated", $"Task #{Task.Id} base branch set to '{newBaseBranch}'.", ToastLevel.Success);
            _isEditingBaseBranch = false;
            await OnTaskUpdated.InvokeAsync(Task);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to update base branch for Task #{TaskId}", Task.Id);
            ToastService.Show("Base Branch Update Failed", ex.Message, ToastLevel.Error);
        }
        finally
        {
            _isSavingBaseBranch = false;
        }
    }

    private bool _isEditingTitle;
    private bool _isSavingTitle;
    private string _editedTitle = string.Empty;

    private void StartEditingTitle()
    {
        _editedTitle = Task?.Title ?? string.Empty;
        _isEditingTitle = true;
    }

    private void CancelEditingTitle()
    {
        _isEditingTitle = false;
        _editedTitle = string.Empty;
    }

    private async Task SaveTitleAsync()
    {
        if (Task == null || _isSavingTitle) return;

        var newTitle = _editedTitle.Trim();
        if (string.IsNullOrWhiteSpace(newTitle))
        {
            ToastService.Show("Invalid Title", "Task title cannot be empty.", ToastLevel.Warning);
            return;
        }

        if (string.Equals(Task.Title, newTitle, StringComparison.Ordinal))
        {
            _isEditingTitle = false;
            return;
        }

        _isSavingTitle = true;
        try
        {
            await TaskMutationService.UpdateTitleAsync(Task, newTitle, PrerequisiteIds);
            ToastService.Show("Title Updated", $"Task #{Task.Id} title updated.", ToastLevel.Success);
            _isEditingTitle = false;
            await OnTaskUpdated.InvokeAsync(Task);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to update title for Task #{TaskId}", Task.Id);
            ToastService.Show("Title Update Failed", ex.Message, ToastLevel.Error);
        }
        finally
        {
            _isSavingTitle = false;
        }
    }

    private async Task HandlePromote()
    {
        if (Task != null)
        {
            await OnPromoteClicked.InvokeAsync(Task);
        }
    }

    private async Task HandleLinkDependencies()
    {
        if (Task != null)
        {
            await OnLinkDependenciesClicked.InvokeAsync(Task);
        }
    }

    private static string GetStatusBadgeClass(TaskOverallStatus status) => status switch
    {
        TaskOverallStatus.Suggested => "badge-amber",
        TaskOverallStatus.Open => "badge-indigo",
        TaskOverallStatus.Reviewed => "badge-purple",
        TaskOverallStatus.Implemented => "badge-purple",
        TaskOverallStatus.Ready => "badge-teal",
        TaskOverallStatus.Closed => "badge-emerald",
        TaskOverallStatus.Rejected => "badge-crimson",
        TaskOverallStatus.Failed => "badge-crimson",
        _ => "badge-secondary"
    };
}

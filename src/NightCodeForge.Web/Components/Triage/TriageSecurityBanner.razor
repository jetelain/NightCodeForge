@namespace NightCodeForge.Web.Components.Triage

<div class="security-banner card-surface p-3 mb-4 d-flex justify-content-between align-items-center" id="triage-security-banner">
    <div class="d-flex align-items-center gap-3">
        <div class="security-shield-icon">
            <span class="security-shield">🔒</span>
        </div>
        <div>
            <div class="d-flex align-items-center gap-2">
                <strong class="security-tier-title">Sandbox Security Tier: RestrictedReadOnly</strong>
                <span class="badge-branch-tag font-mono">Branch: @(string.IsNullOrWhiteSpace(BaseBranch) ? "main" : BaseBranch)</span>
            </div>
            <div class="security-isolation-badges d-flex align-items-center flex-wrap gap-2 mt-1">
                <span class="badge-isolation">
                    <span class="isolation-dot"></span>
                    <span>Filesystem: Read-Only (<code>:ro</code>)</span>
                </span>
                <span class="badge-isolation">
                    <span class="isolation-dot"></span>
                    <span>Network: None (<code>--network none</code>)</span>
                </span>
                <span class="badge-isolation">
                    <span class="isolation-dot"></span>
                    <span>Capabilities: Drop All (<code>--cap-drop=ALL</code>)</span>
                </span>
                <span class="badge-isolation">
                    <span class="isolation-dot"></span>
                    <span>Agent Mode: Read-Only</span>
                </span>
            </div>
        </div>
    </div>
    <div class="security-shield-badge">
        <span class="badge-secure">
            <span class="secure-icon">🛡️</span>
            <span>INJECTION PROTECTED</span>
        </span>
    </div>
</div>

@code {
    [Parameter]
    public string? BaseBranch { get; set; } = "main";
}

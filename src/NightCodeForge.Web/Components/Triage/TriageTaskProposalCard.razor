@namespace NightCodeForge.Web.Components.Triage
@using NightCodeForge.Core.Domain
@using NightCodeForge.Web.Services

<div class="task-card-preview" id="triage-task-proposal-@Task.Id">
    <div class="task-proposal-header">
        <div class="task-proposal-meta">
            <span class="badge-suggested">Suggested</span>
            <span class="task-id-badge font-mono">#@Task.Id</span>
        </div>
        <div class="task-proposal-actions">
            <span class="forge-badge badge-priority-@Task.Priority" title="@TaskPriority.GetLabel(Task.Priority)">
                P@(Task.Priority)
            </span>
            <a href="@WorkspaceUrlHelper.BuildPath(Task.WorkspaceId > 0 ? Task.WorkspaceId : null, "backlog")" class="forge-btn forge-btn-outline btn-xs" title="Open Backlog Kanban">
                Open in Backlog ➔
            </a>
        </div>
    </div>

    <h4 class="task-proposal-title">@Task.Title</h4>

    <p class="task-proposal-desc">
        @GetDisplayDescription()
    </p>

    <div class="task-proposal-footer">
        <div class="task-proposal-tags">
            <span class="badge-tag branch-tag">
                <span>Branch:</span>
                <code class="font-mono">@(string.IsNullOrWhiteSpace(Task.FeatureBranch) ? Task.BaseBranch : Task.FeatureBranch)</code>
            </span>
            <span class="badge-tag stage-tag">
                <span>Stage:</span>
                <span class="font-mono">@Task.CurrentStageId</span>
            </span>
            <span class="badge-tag mode-tag">
                <span>Merge:</span>
                <span>@Task.MergeMode</span>
            </span>
        </div>
        <span class="task-created-time font-mono">
            @Task.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
        </span>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public ForgeTask Task { get; set; } = null!;

    private string GetDisplayDescription()
    {
        if (string.IsNullOrWhiteSpace(Task.Description))
            return "No description provided.";

        if (Task.Description.Length <= 280)
            return Task.Description;

        return Task.Description.Substring(0, 277) + "...";
    }
}

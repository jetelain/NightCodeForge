@namespace NightCodeForge.Web.Components.Triage
@using NightCodeForge.Core.Domain

<div class="task-card-preview card-glass p-3 mb-3" id="triage-task-proposal-@Task.Id">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="d-flex align-items-center gap-2">
            <span class="badge-suggested">Suggested</span>
            <span class="task-id-badge font-mono">#@Task.Id</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge-tag priority-badge">P@(Task.Priority)</span>
            <a href="/backlog" class="btn btn-xs btn-outline-indigo" title="Open Backlog Kanban">
                Open in Backlog ➔
            </a>
        </div>
    </div>

    <h4 class="task-proposal-title mt-1 mb-2">@Task.Title</h4>

    <p class="task-proposal-desc text-secondary small mb-3">
        @GetDisplayDescription()
    </p>

    <div class="task-proposal-footer d-flex align-items-center justify-content-between flex-wrap gap-2 pt-2">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="badge-tag branch-tag">
                <span>Branch:</span>
                <code class="font-mono">@(string.IsNullOrWhiteSpace(Task.FeatureBranch) ? Task.BaseBranch : Task.FeatureBranch)</code>
            </span>
            <span class="badge-tag stage-tag">
                <span>Stage:</span>
                <span class="font-mono">@Task.CurrentStageId</span>
            </span>
            <span class="badge-tag mode-tag">
                <span>Merge:</span>
                <span>@Task.MergeMode</span>
            </span>
        </div>
        <span class="task-created-time font-mono text-muted small">
            @Task.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
        </span>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public ForgeTask Task { get; set; } = null!;

    private string GetDisplayDescription()
    {
        if (string.IsNullOrWhiteSpace(Task.Description))
            return "No description provided.";

        if (Task.Description.Length <= 280)
            return Task.Description;

        return Task.Description.Substring(0, 277) + "...";
    }
}

@namespace NightCodeForge.Web.Components.Inbox
@using System.Text.Json
@using NightCodeForge.Core.Domain
@using NightCodeForge.Core.Workflow
@using NightCodeForge.Web.Components.Monitoring
@inject ITaskOrchestrator TaskOrchestrator
@inject ToastService ToastService
@inject WorkerStateService WorkerState

@if (IsSingleQuestion)
{
    var singleQ = EffectiveQuestions[0];
    <AgentQuestionTurnCard Questions="@(new[] { new QuestionItem(singleQ.Prompt, singleQ.Rationale, GetOptions(singleQ)) })"
                           QuestionIds="@(new[] { singleQ.Id })"
                           TaskId="@singleQ.TaskId"
                           TaskTitle="@(singleQ.ForgeTask?.Title ?? $"Task #{singleQ.TaskId}")"
                           WorkspaceName="@singleQ.ForgeTask?.Workspace?.Name"
                           StageId="@singleQ.StageId"
                           AgentProfileId="@singleQ.AgentProfileId"
                           AskedAt="@singleQ.AskedAt"
                           QuestionId="@singleQ.Id"
                           IsWaitingForAnswer="true"
                           OnAnswerSubmitted="(ans) => SubmitSingleAnswerAsync(singleQ, ans)" />
}
else if (EffectiveQuestions.Count > 1)
{
    var firstQ = EffectiveQuestions[0];
    var batchIdentifier = firstQ.BatchId ?? firstQ.TaskId.ToString();
    var batchItems = EffectiveQuestions.Select(q => new QuestionItem(q.Prompt, q.Rationale, GetOptions(q))).ToList();
    var qIds = EffectiveQuestions.Select(q => q.Id).ToList();

    <AgentQuestionTurnCard Questions="@batchItems"
                           QuestionIds="@qIds"
                           BatchIdentifier="@batchIdentifier"
                           TaskId="@firstQ.TaskId"
                           TaskTitle="@(firstQ.ForgeTask?.Title ?? $"Task #{firstQ.TaskId}")"
                           WorkspaceName="@firstQ.ForgeTask?.Workspace?.Name"
                           StageId="@firstQ.StageId"
                           AgentProfileId="@firstQ.AgentProfileId"
                           AskedAt="@firstQ.AskedAt"
                           QuestionId="@firstQ.Id"
                           IsWaitingForAnswer="true"
                           OnBatchAnswersSubmitted="SubmitBatchAnswersAsync" />
}

@code {
    [Parameter] public Question? Question { get; set; }
    [Parameter] public IReadOnlyList<Question>? Questions { get; set; }
    [Parameter] public EventCallback<int> OnAnswerSubmitted { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<int>> OnBatchSubmitted { get; set; }

    private IReadOnlyList<Question> EffectiveQuestions
    {
        get
        {
            if (Questions is { Count: > 0 }) return Questions;
            if (Question != null) return new[] { Question };
            return Array.Empty<Question>();
        }
    }

    private bool IsSingleQuestion => EffectiveQuestions.Count == 1;

    private List<string> GetOptions(Question q)
    {
        if (string.IsNullOrWhiteSpace(q.OptionsJson))
            return new List<string>();

        try
        {
            return JsonSerializer.Deserialize<List<string>>(q.OptionsJson) ?? new List<string>();
        }
        catch
        {
            return new List<string>();
        }
    }

    private async Task SubmitSingleAnswerAsync(Question q, string answer)
    {
        if (string.IsNullOrWhiteSpace(answer)) return;

        try
        {
            await TaskOrchestrator.SubmitHumanAnswerAsync(q.Id, answer);
            ToastService.Show("Clarification Submitted", $"ForgeTask #{q.TaskId} resumed on llm-urgent queue.", ToastLevel.Success);
            WorkerState.UpdatePendingQuestions(Math.Max(0, WorkerState.Current.PendingQuestionCount - 1));
            await OnAnswerSubmitted.InvokeAsync(q.Id);
        }
        catch (Exception ex)
        {
            ToastService.Show("Submission Failed", $"Error submitting answer: {ex.Message}", ToastLevel.Error);
        }
    }

    private async Task SubmitBatchAnswersAsync(IReadOnlyDictionary<int, string> batchAnswers)
    {
        if (EffectiveQuestions.Count == 0) return;

        try
        {
            var firstQ = EffectiveQuestions[0];
            var dict = new Dictionary<int, string>();
            for (int i = 0; i < EffectiveQuestions.Count; i++)
            {
                var q = EffectiveQuestions[i];
                if (batchAnswers.TryGetValue(i, out var ans) && !string.IsNullOrWhiteSpace(ans))
                {
                    dict[q.Id] = ans;
                }
            }

            if (dict.Count < EffectiveQuestions.Count)
            {
                ToastService.Show("Incomplete Answers", "Please answer all clarification questions in the batch before submitting.", ToastLevel.Warning);
                return;
            }

            await TaskOrchestrator.SubmitAnswersAsync(firstQ.TaskId, dict);
            ToastService.Show("Clarification Submitted", $"ForgeTask #{firstQ.TaskId} resumed on llm-urgent queue.", ToastLevel.Success);
            WorkerState.UpdatePendingQuestions(Math.Max(0, WorkerState.Current.PendingQuestionCount - EffectiveQuestions.Count));

            var submittedIds = dict.Keys.ToList();
            await OnBatchSubmitted.InvokeAsync(submittedIds);
            foreach (var id in submittedIds)
            {
                await OnAnswerSubmitted.InvokeAsync(id);
            }
        }
        catch (Exception ex)
        {
            ToastService.Show("Submission Failed", $"Error submitting answers: {ex.Message}", ToastLevel.Error);
        }
    }
}
